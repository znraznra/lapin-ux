[Icon Theme]
Name=Lapin UX
Comment=Lapin UX: Fluent UI System Icons (MIT, Microsoft) for symbolic icons; app icons from Win11
Inherits=Win11,hicolor,breeze,Adwaita
Example=folder

Directories=scalable/apps,symbolic/actions,symbolic/apps,symbolic/categories,symbolic/devices,symbolic/emblems,symbolic/mimes,symbolic/places,symbolic/status

[symbolic/actions]
Context=Actions
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[symbolic/apps]
Context=Applications
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[symbolic/categories]
Context=Categories
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[symbolic/devices]
Context=Devices
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[symbolic/emblems]
Context=Emblems
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[symbolic/mimes]
Context=MimeTypes
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[symbolic/places]
Context=Places
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[symbolic/status]
Context=Status
Size=16
MinSize=8
MaxSize=512
Type=Scalable

# Settings shows the Win11 theme's settings gear inside Lapin UX (COSMIC's own
# session keeps COSMIC's icon: this theme is only used in Lapin UX).
[scalable/apps]
Context=Applications
Size=64
MinSize=8
MaxSize=512
Type=Scalable
