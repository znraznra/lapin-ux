#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# Adapted from cosmic-session's start-cosmic (GPL-3.0-only).
# Started by the display manager for the "Lapin UX" session.
set -e

# Keep a log of this session (and the previous one) for bug reports:
#   ~/.local/state/lapin-ux/session.log
# Opened first, so a failure anywhere below is recorded (#100: under greetd the
# script ended before the log existed and left no trace). The re-exec through the
# login shell below appends to the same file instead of rotating it again.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/lapin-ux"
if mkdir -p "$LOG_DIR" 2>/dev/null; then
    if [ "${1}" != "--in-login-shell" ] && [ -f "$LOG_DIR/session.log" ]; then
        mv -f "$LOG_DIR/session.log" "$LOG_DIR/session.previous.log"
    fi
    exec >>"$LOG_DIR/session.log" 2>&1
fi
# shellcheck disable=SC2154
trap 'rc=$?; [ "$rc" = 0 ] || echo "start-lapin-ux stopped (exit $rc), last step: ${STEP:-start}"' EXIT
echo "=== Lapin UX session start $(date -Iseconds) (pid $$, shell ${SHELL:-none}, args: $*) ==="

# Right after sign-in (greetd, unlike GDM) the user's systemd manager can still
# be coming up; wait a few seconds for it, and never let a missing one stop the
# session: the steps below that talk to it are best effort.
STEP="waiting for the user manager"
if command -v systemctl >/dev/null; then
    n=0
    until systemctl --user show-environment >/dev/null 2>&1 || [ "$n" -ge 50 ]; do
        n=$((n + 1)); sleep 0.1
    done
    [ "$n" -ge 50 ] && echo "warning: the user's systemd manager did not answer after 5 s"
fi

STEP="resetting failed units"
if command -v systemctl >/dev/null; then
    # A previous session may have left failed units behind; reset them so
    # they do not block this one.
    for unit in $(systemctl --user --no-legend --state=failed --plain list-units | cut -f1 -d' '); do
        partof="$(systemctl --user show -p PartOf --value "$unit")"
        for target in lapin-ux-session.target graphical-session.target; do
            if [ "$partof" = "$target" ]; then
                systemctl --user reset-failed "$unit"
                break
            fi
        done
    done
fi

# Pick up the user's environment from their login shell (PATH, etc.).
if [ -n "${SHELL}" ] && [ "${1}" != "--in-login-shell" ]; then
    exec "${SHELL}" -l -c "${0} --in-login-shell"
fi

# cosmic-greeter (greetd) passes the .desktop file's DesktopNames as is, with
# ";" between the names, and takes everything up to the first ":" as the session
# name, so XDG_CURRENT_DESKTOP arrives as "LapinUX;COSMIC". The list must be
# separated by ":" or nothing sees "LapinUX" in it (the session gate in
# Lapin's apps, the portals).
STEP="setting up the environment"
case "${XDG_CURRENT_DESKTOP:-}" in *\;*) XDG_CURRENT_DESKTOP=$(printf '%s' "$XDG_CURRENT_DESKTOP" | tr ';' ':' | sed 's/:*$//') ;; esac
case "${XDG_SESSION_DESKTOP:-}" in *\;*) XDG_SESSION_DESKTOP=${XDG_SESSION_DESKTOP%%;*} ;; esac
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:=LapinUX:COSMIC}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:=LapinUX}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:=wayland}"
export _JAVA_AWT_WM_NONREPARENTING=1
export GDK_BACKEND=wayland,x11
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export QT_ENABLE_HIGHDPI_SCALING=1
export ELECTRON_OZONE_PLATFORM_HINT=auto

# Qt apps follow the desktop theme if a bridge is installed.
if [ -z "$QT_QPA_PLATFORMTHEME" ]; then
    for dir in /usr/lib/qt6/plugins /usr/lib/*/qt6/plugins; do
        if [ -f "$dir/platformthemes/libcutecosmictheme.so" ]; then
            export QT_QPA_PLATFORMTHEME=cosmic
            break
        elif [ -f "$dir/platformthemes/libqt6ct.so" ]; then
            export QT_QPA_PLATFORMTHEME=qt6ct
        fi
    done
fi

# Passwords and SSH keys (if gnome-keyring is installed and enabled by PAM).
if [ -d "$XDG_RUNTIME_DIR/keyring" ] && command -v gnome-keyring-daemon >/dev/null 2>&1; then
    eval "$(gnome-keyring-daemon --start --components=pkcs11,secrets,ssh 2>/dev/null)"
    if [ -z "$SSH_AUTH_SOCK" ]; then
        for sock in "$XDG_RUNTIME_DIR/gcr/ssh" "$XDG_RUNTIME_DIR/keyring/ssh"; do
            [ -S "$sock" ] && export SSH_AUTH_SOCK="$sock" && break
        done
    fi
fi

# Selawik as the interface font (and Fluent Emoji for emoji) only in this
# session: the system's font setup plus Lapin UX's rule. Other desktops never
# see it.
if [ -f /usr/share/lapin-ux/fonts.conf ] && [ -z "${FONTCONFIG_FILE:-}" ]; then
    export FONTCONFIG_FILE=/usr/share/lapin-ux/fonts.conf
fi

# Graphics path for Lapin's apps (#34, #32). On Intel Arc cards, wgpu's
# Vulkan path leaves stale pictures on the taskbar (ghosting, a flickering
# overflow flyout); its OpenGL path draws them correctly. Other GPUs keep the
# default. LAPIN_UX_WGPU_BACKEND (vulkan, gl, …) overrides the choice.
intel_arc() {
    for dev in /sys/class/drm/card[0-9]*/device; do
        vendor=$(cat "$dev/vendor" 2>/dev/null); id=$(cat "$dev/device" 2>/dev/null)
        driver=$(basename "$(readlink "$dev/driver" 2>/dev/null)")
        [ "$vendor" = 0x8086 ] || continue
        # Arc A-series (0x56xx), B-series (0xe2xx), or anything on the xe driver.
        case "$id" in 0x56*|0xe2*) return 0 ;; esac
        [ "$driver" = xe ] && return 0
    done
    return 1
}
if [ -n "${LAPIN_UX_WGPU_BACKEND:-}" ]; then
    export WGPU_BACKEND="$LAPIN_UX_WGPU_BACKEND"
elif [ -z "${WGPU_BACKEND:-}" ] && intel_arc; then
    export WGPU_BACKEND=gl
fi

# Mouse pointer size from Settings > Accessibility > Mouse pointer (#24): the
# compositor and apps read it once when they start. Only this session's
# environment; other desktops keep their own.
POINTER_SIZE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/dev.lapinux.Shell/v1/pointer_size"
if [ -z "${XCURSOR_SIZE:-}" ] && [ -f "$POINTER_SIZE_FILE" ]; then
    POINTER_SIZE=$(tr -dc '0-9' < "$POINTER_SIZE_FILE")
    if [ -n "$POINTER_SIZE" ] && [ "$POINTER_SIZE" -ge 16 ] && [ "$POINTER_SIZE" -le 128 ]; then
        export XCURSOR_SIZE="$POINTER_SIZE"
    fi
fi

STEP="importing the environment"
if command -v systemctl >/dev/null; then
    systemctl --user import-environment XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP SSH_AUTH_SOCK || echo "warning: could not hand the environment to systemd"
    if [ -n "${FONTCONFIG_FILE:-}" ]; then systemctl --user import-environment FONTCONFIG_FILE || true; fi
    if [ -n "${XCURSOR_SIZE:-}" ]; then systemctl --user import-environment XCURSOR_SIZE || true; fi
    if [ -n "${WGPU_BACKEND:-}" ]; then systemctl --user import-environment WGPU_BACKEND || true; fi
fi
STEP="starting the session"

echo "graphics: WGPU_BACKEND=${WGPU_BACKEND:-default}"
pacman -Q lapin-ux-desktop-git 2>/dev/null || true   # which build this is
# Crash reports with a backtrace (each Lapin program also writes
# crash-<program>.txt next to this log). Set here because the login shell
# doesn't always pass the user's own setting on (GDM + fish, #29).
export RUST_BACKTRACE="${RUST_BACKTRACE:-1}"

# Before Lapin UX changes any desktop setting the first time, remember the
# originals so lapin-ux-uninstall can put them back (does nothing afterwards).
# While this session runs, the clean-up service leaves its settings alone.
MARK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/lapin-ux-session.pid"
echo $$ > "$MARK" 2>/dev/null || true

lapin-ux-uninstall --snapshot || true
# Remember the GTK/COSMIC font, icon and pointer other desktops use; they get
# them back when this session ends (and, if it didn't end cleanly, when one of
# them starts: the lapin-ux-desktop-settings user service at every login, and
# /etc/xdg/autostart/lapin-ux-other-desktops.desktop).
lapin-ux-desktop-settings enter || true

status=0
if [ -z "${DBUS_SESSION_BUS_ADDRESS}" ]; then
    dbus-run-session -- lapin-ux-session || status=$?
else
    lapin-ux-session || status=$?
fi
echo "=== Lapin UX session end $(date -Iseconds) (status $status) ==="
rm -f "$MARK"
lapin-ux-desktop-settings leave || true
exit "$status"
