From: Lapin UX
Subject: [PATCH] iced: screen readers see the widget tree (Lapin UX #44)

The a11y feature built accesskit adapters but never sent them anything
but an empty window. Send the widget tree after each redraw while a
screen reader listens, pass window focus to the adapter, remove a
window's adapter when its Wayland surface goes, and let Stack report
its layers.
---
diff --git a/widget/src/stack.rs b/widget/src/stack.rs
index e85bf2af..5f930f03 100644
--- a/widget/src/stack.rs
+++ b/widget/src/stack.rs
@@ -299,6 +299,26 @@ where
             .unwrap_or_default()
     }
 
+    #[cfg(feature = "a11y")]
+    /// get the a11y nodes for the widget (every layer, bottom first)
+    fn a11y_nodes(
+        &self,
+        layout: Layout<'_>,
+        state: &Tree,
+        cursor: mouse::Cursor,
+    ) -> iced_accessibility::A11yTree {
+        use iced_accessibility::A11yTree;
+        A11yTree::join(
+            self.children
+                .iter()
+                .zip(layout.children())
+                .zip(state.children.iter())
+                .map(|((c, c_layout), state)| {
+                    c.as_widget().a11y_nodes(c_layout, state, cursor)
+                }),
+        )
+    }
+
     fn draw(
         &self,
         tree: &Tree,
