@@ -623,6 +623,43 @@ where
                             Control::Cleanup(id) => {
                                 _ = self.adapters.remove(&id);
                             }
+                            #[cfg(feature = "a11y")]
+                            Control::A11yFocus(id, window, focused) => {
+                                if let Some((_, adapter)) =
+                                    self.adapters.get_mut(&id)
+                                {
+                                    adapter.process_event(
+                                        window.as_ref(),
+                                        &WindowEvent::Focused(focused),
+                                    );
+                                }
+                            }
+                            #[cfg(feature = "a11y")]
+                            Control::A11yUpdate(id, tree) => {
+                                use iced_accessibility::accesskit::{
+                                    Node, NodeId, Role, Tree, TreeId,
+                                    TreeUpdate,
+                                };
+                                use iced_accessibility::{A11yNode, A11yTree};
+                                if let Some((node_id, adapter)) =
+                                    self.adapters.get_mut(&id)
+                                {
+                                    let root_id = NodeId(*node_id);
+                                    let window = A11yTree::node_with_child_tree(
+                                        A11yNode::new(
+                                            Node::new(Role::Window),
+                                            *node_id,
+                                        ),
+                                        tree,
+                                    );
+                                    adapter.update_if_active(|| TreeUpdate {
+                                        tree_id: TreeId::ROOT,
+                                        nodes: window.into(),
+                                        tree: Some(Tree::new(root_id)),
+                                        focus: root_id,
+                                    });
+                                }
+                            }
                         },
                         _ => {
                             break;
