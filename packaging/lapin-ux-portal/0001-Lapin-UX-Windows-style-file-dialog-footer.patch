+/// Lapin UX: Windows' 4 px push-button corners (the theme's largest radius
+/// stays round for toggles and sliders).
+fn lapin_button(kind: fn() -> widget::button::ButtonClass) -> widget::button::ButtonClass {
+    use widget::button::Catalog;
+    fn square(mut s: widget::button::Style) -> widget::button::Style {
+        s.border_radius = 4.0.into();
+        s
+    }
+    widget::button::ButtonClass::Custom {
+        active: Box::new(move |f, t| square(t.active(f, false, &kind()))),
+        disabled: Box::new(move |t| square(t.disabled(&kind()))),
+        hovered: Box::new(move |f, t| square(t.hovered(f, false, &kind()))),
+        pressed: Box::new(move |f, t| square(t.pressed(f, false, &kind()))),
+    }
+}
