+    fn lapin_button_view(&self) -> Element<'_, Message> {
+        // Lapin UX: Windows-style bottom of the dialog:
+        //   File name: [ name ............ ] [ type filter v ]
+        //                                     [ Open ] [ Cancel ]
+        let cosmic_theme::Spacing {
+            space_xxxs,
+            space_xxs,
+            space_xs,
+            space_s,
+            space_l,
+            ..
+        } = theme::spacing();
+        let label_width = Length::Fixed(110.0);
+
+        let mut has_selected = false;
+        let mut selected_names = Vec::new();
+        if let Some(items) = self.tab.items_opt() {
+            for item in items {
+                if item.selected {
+                    has_selected = true;
+                    selected_names.push(item.name.clone());
+                }
+            }
+        }
+
+        let mut col = widget::column::with_capacity(4).spacing(space_xs);
+
+        let name_field: Element<'_, Message> = if let DialogKind::SaveFile { filename } = &self.flags.kind {
+            widget::text_input("", filename)
+                .id(self.filename_id.clone())
+                .double_click_select_delimiter('.')
+                .on_input(Message::Filename)
+                .on_submit(|_| Message::Save(false))
+                .width(Length::Fill)
+                .into()
+        } else {
+            let shown = match selected_names.len() {
+                0 => String::new(),
+                1 => selected_names[0].clone(),
+                _ => selected_names.iter().map(|n| format!("\"{n}\"")).collect::<Vec<_>>().join(" "),
+            };
+            widget::text_input("", shown).width(Length::Fill).into()
+        };
+        let mut name_row = widget::row::with_capacity(3)
+            .align_y(Alignment::Center)
+            .spacing(space_xxs)
+            .push(widget::text::body(if self.flags.kind.is_dir() { "Folder:" } else { "File name:" }).width(label_width))
+            .push(name_field);
+        let save = self.flags.kind.save();
+        if !self.filters.is_empty() && !save {
+            name_row = name_row.push(
+                // Fills its slot, so it ends where Cancel ends, as in Windows.
+                widget::container(widget::dropdown(&self.filters, self.filter_selected, Message::Filter).width(Length::Fill))
+                    .width(Length::Fixed(240.0)),
+            );
+        }
+        col = col.push(name_row);
+        if !self.filters.is_empty() && save {
+            col = col.push(
+                widget::row::with_capacity(2)
+                    .align_y(Alignment::Center)
+                    .spacing(space_xxs)
+                    .push(widget::text::body("Save as type:").width(label_width))
+                    .push(widget::container(widget::dropdown(&self.filters, self.filter_selected, Message::Filter).width(Length::Fill)).width(Length::Fill)),
+            );
+        }
+
+        if !self.choices.is_empty() {
+            let mut row = widget::row::with_capacity(self.choices.len() * 2)
+                .align_y(Alignment::Center)
+                .spacing(space_xxs)
+                .push(widget::space::horizontal().width(label_width));
+            for (choice_i, choice) in self.choices.iter().enumerate() {
+                match choice {
+                    DialogChoice::CheckBox { label, value, .. } => {
+                        row = row.push(
+                            widget::checkbox(*value)
+                                .label(label)
+                                .on_toggle(move |checked| Message::Choice(choice_i, usize::from(checked))),
+                        );
+                    }
+                    DialogChoice::ComboBox { label, options, selected, .. } => {
+                        row = row.push(widget::text::heading(label));
+                        row = row.push(widget::dropdown(options, *selected, move |option_i| Message::Choice(choice_i, option_i)));
+                    }
+                }
+            }
+            col = col.push(row);
+        }
+
+        let accept = widget::button::custom(
+            widget::row::with_children([Element::from(&self.accept_label)])
+                .padding([0, space_s])
+                .width(Length::Shrink)
+                .height(space_l)
+                .spacing(space_xxxs)
+                .align_y(Alignment::Center),
+        )
+        .padding(0)
+        .on_press_maybe(if save {
+            if let DialogKind::SaveFile { filename } = &self.flags.kind {
+                (!filename.is_empty()).then_some(Message::Save(false))
+            } else {
+                None
+            }
+        } else if has_selected || self.flags.kind.is_dir() {
+            Some(Message::Open)
+        } else {
+            None
+        })
+        .width(Length::Fixed(110.0))
+        .class(lapin_button(|| widget::button::ButtonClass::Suggested));
+        col = col.push(
+            widget::row::with_capacity(3)
+                .align_y(Alignment::Center)
+                .spacing(space_xxs)
+                .push(widget::space::horizontal())
+                .push(accept)
+                .push(
+                    widget::button::standard(fl!("cancel"))
+                        .on_press(Message::Cancel)
+                        .width(Length::Fixed(110.0))
+                        .class(lapin_button(|| widget::button::ButtonClass::Standard)),
+                ),
+        );
+
+        widget::layer_container(col)
+            .layer(cosmic_theme::Layer::Primary)
+            .padding([space_xs, space_s])
+            .into()
+    }
