+/// Lapin UX: its file dialog look only in a Lapin UX session
+/// (XDG_CURRENT_DESKTOP has LapinUX, or LAPIN_UX_DIALOG=1); COSMIC keeps its own.
+pub fn lapin_session() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var("XDG_CURRENT_DESKTOP").is_ok_and(|d| d.split(':').any(|d| d == "LapinUX"))
+            || std::env::var("LAPIN_UX_DIALOG").is_ok_and(|v| v == "1")
+    })
+}
