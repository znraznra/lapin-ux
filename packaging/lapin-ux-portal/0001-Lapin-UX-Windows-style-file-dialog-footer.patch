From 5b15393b0616d283563c6e8887d3d7518358db6a Mon Sep 17 00:00:00 2001
From: Lapin UX <arnz.lee16@gmail.com>
Date: Mon, 19 Oct 2026 21:34:36 +0800
Subject: [PATCH] Lapin UX: Windows-style file dialog footer

File name / Save as type rows with the type filter beside the name,
Open/Save then Cancel at the bottom right; folders first; no preview pane
by default.
---
 src/config.rs |   4 +-
 src/dialog.rs | 210 ++++++++++++++++++++++++++++++--------------------
 2 files changed, 127 insertions(+), 87 deletions(-)

diff --git a/src/config.rs b/src/config.rs
index 617c459..a761a38 100644
--- a/src/config.rs
+++ b/src/config.rs
@@ -324,9 +324,9 @@ pub struct DialogConfig {
 impl Default for DialogConfig {
     fn default() -> Self {
         Self {
-            folders_first: false,
+            folders_first: true,
             icon_sizes: IconSizes::default(),
-            show_details: true,
+            show_details: false,
             show_hidden: false,
             view: View::List,
         }
diff --git a/src/dialog.rs b/src/dialog.rs
index d0037d2..5b14238 100644
--- a/src/dialog.rs
+++ b/src/dialog.rs
@@ -571,8 +571,27 @@ struct App {
     type_select_last_key: Option<Instant>,
 }
 
+/// Lapin UX: Windows' 4 px push-button corners (the theme's largest radius
+/// stays round for toggles and sliders).
+fn lapin_button(kind: fn() -> widget::button::ButtonClass) -> widget::button::ButtonClass {
+    use widget::button::Catalog;
+    fn square(mut s: widget::button::Style) -> widget::button::Style {
+        s.border_radius = 4.0.into();
+        s
+    }
+    widget::button::ButtonClass::Custom {
+        active: Box::new(move |f, t| square(t.active(f, false, &kind()))),
+        disabled: Box::new(move |t| square(t.disabled(&kind()))),
+        hovered: Box::new(move |f, t| square(t.hovered(f, false, &kind()))),
+        pressed: Box::new(move |f, t| square(t.pressed(f, false, &kind()))),
+    }
+}
+
 impl App {
     fn button_view(&self) -> Element<'_, Message> {
+        // Lapin UX: Windows-style bottom of the dialog:
+        //   File name: [ name ............ ] [ type filter v ]
+        //                                     [ Open ] [ Cancel ]
         let cosmic_theme::Spacing {
             space_xxxs,
             space_xxs,
@@ -581,107 +600,123 @@ impl App {
             space_l,
             ..
