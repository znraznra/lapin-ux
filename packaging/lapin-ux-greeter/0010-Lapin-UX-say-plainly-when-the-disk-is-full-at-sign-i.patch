 Cargo.toml                 |  1 +
 i18n/en/cosmic_greeter.ftl |  1 +
 src/greeter.rs             | 19 +++++++++++++++++--
 src/greeter/ipc.rs         |  6 ++++++
 src/lapin.rs               | 32 ++++++++++++++++++++++++++++++++
 6 files changed, 58 insertions(+), 2 deletions(-)

