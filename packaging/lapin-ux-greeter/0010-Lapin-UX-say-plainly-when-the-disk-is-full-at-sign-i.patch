diff --git a/src/greeter/ipc.rs b/src/greeter/ipc.rs
index 4e92afe..220d90b 100644
--- a/src/greeter/ipc.rs
+++ b/src/greeter/ipc.rs
@@ -16,6 +16,12 @@ use crate::{common, fl};
 fn greetd_error_to_message(error_type: greetd_ipc::ErrorType, description: &str) -> String {
     use greetd_ipc::ErrorType;
 
+    // Lapin UX: a full disk breaks sign-in in ways PAM reports as a wrong
+    // password or a generic failure, so say it plainly instead.
+    if crate::lapin::sign_in_blocked_by_full_disk(description) {
+        return fl!("disk-full");
+    }
+
     match error_type {
         ErrorType::AuthError => {
             // For authentication errors, check description for specific error types
diff --git a/src/lapin.rs b/src/lapin.rs
index 61310f5..4a9b6f1 100644
--- a/src/lapin.rs
+++ b/src/lapin.rs
@@ -378,3 +378,35 @@ pub fn ensure_osk() {
         }
     }
 }
+
+/// Free space below which sign-in is likely to fail (a session needs to write
+/// its logs, config and crash reports): 1 MiB.
+const LOW_SPACE_BYTES: u64 = 1024 * 1024;
+
+/// True when an error text from greetd, PAM or a config write says the disk
+/// is full (ENOSPC).
+pub fn says_disk_full(text: &str) -> bool {
+    let t = text.to_ascii_lowercase();
+    t.contains("no space left") || t.contains("enospc") || t.contains("os error 28")
+}
+
+/// True when the folder's disk has almost no free space left for normal users.
+/// Returns false when the check itself fails, so a sign-in error is never
+/// blamed on the disk by mistake.
+pub fn disk_nearly_full(path: &str) -> bool {
+    let Ok(c_path) = std::ffi::CString::new(path) else {
+        return false;
+    };
+    let mut stat: libc::statvfs = unsafe { std::mem::zeroed() };
+    // SAFETY: c_path is a valid NUL-terminated string and stat is a valid out pointer.
+    if unsafe { libc::statvfs(c_path.as_ptr(), &mut stat) } != 0 {
+        return false;
+    }
+    (stat.f_bavail as u64).saturating_mul(stat.f_frsize as u64) < LOW_SPACE_BYTES
+}
+
+/// True when signing in is failing because the disk is full: the error text
+/// says so, or the home or state disk is out of space.
+pub fn sign_in_blocked_by_full_disk(text: &str) -> bool {
+    says_disk_full(text) || disk_nearly_full("/home") || disk_nearly_full("/var")
+}
