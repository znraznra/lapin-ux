+impl App {
+    fn lapin_corner(&self) -> iced::widget::Row<'_, Message, cosmic::Theme> {
+        let open = |d: Dropdown| self.dropdown_opt == Some(d);
+        let a11y = vec![
+            (fl!("accessibility", "screen-reader"), Some(self.accessibility.screen_reader.is_some()), Message::ScreenReader(self.accessibility.screen_reader.is_none())),
+            (fl!("accessibility", "magnifier"), Some(self.accessibility.magnifier), Message::Magnifier(!self.accessibility.magnifier)),
+            (fl!("accessibility", "high-contrast"), Some(self.accessibility.high_contrast), Message::HighContrast(!self.accessibility.high_contrast)),
+            (fl!("accessibility", "invert-colors"), Some(self.accessibility.invert_colors), Message::InvertColors(!self.accessibility.invert_colors)),
+            (fl!("on-screen-keyboard"), None, Message::Common(common::Message::OnScreenKeyboard)),
+        ];
+        let mut row = iced::widget::row![crate::lapin::corner_flyout(
+            "preferences-desktop-accessibility-symbolic",
+            open(Dropdown::Accessibility),
+            Message::DropdownToggle(Dropdown::Accessibility),
+            Some("Accessibility"),
+            a11y,
+        )];
+        if self.common.active_layouts.len() > 1 {
+            let layouts = self
+                .common
+                .active_layouts
+                .iter()
+                .enumerate()
+                .map(|(i, l)| (l.description.clone(), Some(i == self.common.current_keyboard_layout), Message::KeyboardLayout(i)))
+                .collect();
+            row = row.push(crate::lapin::corner_flyout(
+                "input-keyboard-symbolic",
+                open(Dropdown::Keyboard),
+                Message::DropdownToggle(Dropdown::Keyboard),
+                Some("Keyboard layout"),
+                layouts,
+            ));
+        }
+        if !self.session_names.is_empty() {
+            let sessions = self
+                .session_names
+                .iter()
+                .map(|n| (n.clone(), Some(*n == self.selected_session), Message::Session(n.clone())))
+                .collect();
+            row = row.push(crate::lapin::corner_flyout(
+                "emblem-system-symbolic",
+                open(Dropdown::Session),
+                Message::DropdownToggle(Dropdown::Session),
+                Some("Desktop session"),
+                sessions,
+            ));
+        }
+        if self.flags.logind_available {
+            let power = vec![
+                ("Sleep".to_string(), None, Message::Suspend),
+                (fl!("shutdown"), None, Message::Shutdown),
+                (fl!("restart"), None, Message::Restart),
+            ];
+            row = row.push(crate::lapin::corner_flyout(
+                "system-shutdown-symbolic",
+                open(Dropdown::Power),
+                Message::DropdownToggle(Dropdown::Power),
+                None,
+                power,
+            ));
+        }
+        row.spacing(4.0).align_y(Alignment::Center)
+    }
+}
