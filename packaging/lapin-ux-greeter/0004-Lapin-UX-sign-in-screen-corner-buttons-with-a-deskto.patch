diff --git a/src/lapin.rs b/src/lapin.rs
index 2db1dd4..5330371 100644
--- a/src/lapin.rs
+++ b/src/lapin.rs
@@ -141,6 +141,67 @@ pub fn corner_button<'a, M: Clone + 'static>(icon: &'static str, msg: Option<M>)
         .into()
 }
 
+/// A corner button that opens a flyout above it (accessibility, the
+/// desktop session, power), as on Windows' sign-in screen. `items` are
+/// (label, checked, message); `toggle` opens and closes it.
+pub fn corner_flyout<'a, M: Clone + 'static>(
+    icon: &'static str,
+    open: bool,
+    toggle: M,
+    title: Option<&'a str>,
+    items: Vec<(String, Option<bool>, M)>,
+) -> Element<'a, M> {
+    let button = widget::button::custom(widget::icon::from_name(icon).size(20))
+        .padding(10.0)
+        .class(theme::Button::Custom {
+            active: Box::new(move |_, _| bg_style(if open { 0.2 } else { 0.0 })),
+            disabled: Box::new(|_| bg_style(0.0)),
+            hovered: Box::new(|_, _| bg_style(0.15)),
+            pressed: Box::new(|_, _| bg_style(0.25)),
+        })
+        .on_press(toggle.clone());
+    if !open {
+        return button.into();
+    }
+    let mut list = widget::column::with_capacity(items.len() + 1).spacing(2);
+    if let Some(t) = title {
+        list = list.push(widget::container(widget::text::caption(t.to_string()).font(font(iced::font::Weight::Semibold))).padding([6, 12, 4, 12]));
+    }
+    for (label, checked, msg) in items {
+        let check: Element<'a, M> = match checked {
+            Some(true) => widget::icon::from_name("object-select-symbolic").size(16).into(),
+            _ => widget::space::horizontal().width(Length::Fixed(16.0)).into(),
+        };
+        let row = widget::row::with_capacity(2)
+            .spacing(10)
+            .align_y(Alignment::Center)
+            .push_maybe(checked.is_some().then_some(check))
+            .push(widget::text::body(label).font(font(iced::font::Weight::Normal)));
+        list = list.push(
+            widget::button::custom(row)
+                .padding([8, 12])
+                .width(Length::Fill)
+                .class(list_button(false))
+                .on_press(msg),
+        );
+    }
+    let flyout = widget::container(list)
+        .padding(4)
+        .width(Length::Fixed(260.0))
+        .class(theme::Container::custom(|_| widget::container::Style {
+            background: Some(Background::Color(Color::from_rgba(0.13, 0.13, 0.14, 0.96))),
+            border: Border { radius: 8.0.into(), width: 1.0, color: Color::from_rgba(1.0, 1.0, 1.0, 0.1) },
+            text_color: Some(Color::WHITE),
+            icon_color: Some(Color::WHITE),
+            ..Default::default()
+        }));
+    widget::popover(button)
+        .popup(widget::container(flyout).padding([0, 0, 8, 0]))
+        .position(widget::popover::Position::Top)
+        .on_close(toggle)
+        .into()
+}
+
 fn bg_style(alpha: f32) -> widget::button::Style {
     widget::button::Style {
         background: (alpha > 0.0).then_some(Background::Color(Color::from_rgba(1.0, 1.0, 1.0, alpha))),
