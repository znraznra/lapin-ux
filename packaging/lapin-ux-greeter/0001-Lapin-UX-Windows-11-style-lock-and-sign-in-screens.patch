+//! Shows Lapin UX's lock and sign-in faces in a normal window, for checking
+//! the design without locking the session: `cargo run --example lapin_preview [signin]`.
+use cosmic::app::{Core, Settings, Task};
+use cosmic::iced::{Length, Size};
+use cosmic::{Element, widget};
+use cosmic_greeter::lapin;
+
+#[derive(Clone, Debug)]
+enum Msg {
+    Reveal,
+    Input(String),
+}
+
+struct App {
+    core: Core,
+    signin: bool,
+    value: String,
+    bg: widget::image::Handle,
+}
+
+impl cosmic::Application for App {
+    type Executor = cosmic::executor::Default;
+    type Flags = bool;
+    type Message = Msg;
+    const APP_ID: &'static str = "dev.lapinux.LockPreview";
+    fn core(&self) -> &Core { &self.core }
+    fn core_mut(&mut self) -> &mut Core { &mut self.core }
+    fn init(mut core: Core, signin: bool) -> (Self, Task<Msg>) {
+        core.window.show_headerbar = false;
+        let bg = widget::image::Handle::from_path(std::env::var("LAPIN_BG").unwrap_or_else(|_| "/usr/share/backgrounds/lapin-ux/lapin-ux-dark.jpg".into()));
+        (App { core, signin, value: String::new(), bg }, Task::none())
+    }
+    fn update(&mut self, m: Msg) -> Task<Msg> {
+        match m { Msg::Reveal => self.signin = true, Msg::Input(s) => self.value = s }
+        Task::none()
+    }
+    fn view(&self) -> Element<'_, Msg> {
+        // Size the faces for the window, as the real screens are sized for the output.
+        let (signin, value, bg) = (self.signin, self.value.clone(), self.bg.clone());
+        widget::responsive(move |size| face(signin, value.clone(), bg.clone(), lapin::scale(size.height))).into()
+    }
+}
+
+fn face<'a>(signin: bool, value: String, bg: widget::image::Handle, scale: f32) -> Element<'a, Msg> {
+    {
+        let status: Element<'_, Msg> = widget::row::with_children(vec![
+            widget::icon::from_name("network-wireless-signal-excellent-symbolic").size(20).into(),
+            widget::icon::from_name("battery-good-symbolic").size(20).into(),
+            widget::text("73%").into(),
+        ]).spacing(8).into();
+        let face = if !signin {
+            lapin::lock_face("8:42".into(), "Monday, October 19".into(), widget::container(status).class(cosmic::theme::Container::custom(|_| widget::container::Style { text_color: Some(cosmic::iced::Color::WHITE), icon_color: Some(cosmic::iced::Color::WHITE), ..Default::default() })).into(), Msg::Reveal, scale)
+        } else {
+            let input = widget::secure_input("Password", value, None, true).on_input(Msg::Input).password();
+            let corner = widget::row::with_children(vec![
+                status,
+                lapin::corner_button("preferences-desktop-accessibility-symbolic", Some(Msg::Reveal)),
+                lapin::corner_button("system-shutdown-symbolic", Some(Msg::Reveal)),
+            ]).spacing(8).align_y(cosmic::iced::Alignment::Center);
+            lapin::sign_in(lapin::avatar(None, lapin::PICTURE * scale), "Alex Lee".into(), input.into(), widget::text("").into(), widget::space::horizontal().width(0).into(), corner.into(), scale)
+        };
+        widget::container(
+            cosmic::iced::widget::stack![
+                widget::image(bg).width(Length::Fill).height(Length::Fill).content_fit(cosmic::iced::ContentFit::Cover),
+                face,
+            ]
+        ).width(Length::Fill).height(Length::Fill).into()
+    }
+}
+
+fn main() -> cosmic::iced::Result {
+    let signin = std::env::args().any(|a| a == "signin");
+    cosmic::app::run::<App>(Settings::default().size(Size::new(1200.0, 720.0)).client_decorations(false), signin)
+}
