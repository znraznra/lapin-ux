diff --git a/src/lapin.rs b/src/lapin.rs
new file mode 100644
index 0000000..d3d9214
--- /dev/null
+++ b/src/lapin.rs
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Lapin UX's Windows 11-style faces for the lock and sign-in screens:
+//! the lock screen is a big clock and date over the wallpaper; clicking or
+//! typing slides to the sign-in panel (picture, name, password) over a
+//! dimmed wallpaper, with network, battery and power at the bottom right.
+
+use cosmic::iced::{self, Alignment, Background, Border, Color, Length};
+use cosmic::{Element, theme, widget};
+
+/// Text colour on the wallpaper (white with a soft shadow look).
+fn on_wallpaper() -> theme::Text {
+    theme::Text::Color(Color::WHITE)
+}
+
+/// Sizes below are Windows 11's on a 1080-pixel-high screen; other screens
+/// (and the preview window) scale them by height.
+pub fn scale(screen_height: f32) -> f32 {
+    (screen_height / 1080.0).clamp(0.4, 2.0)
+}
+
+/// Account picture size on the sign-in panel.
+pub const PICTURE: f32 = 192.0;
+
+/// The lock screen: time and date, top centre.
+pub fn lock_face<'a, M: Clone + 'static>(time: String, date: String, status: Element<'a, M>, reveal: M, scale: f32) -> Element<'a, M> {
+    let clock = widget::column::with_capacity(2)
+        .push(widget::text(time).size(112.0 * scale).font(cosmic::font::semibold()).class(on_wallpaper()))
+        .push(widget::text(date).size(24.0 * scale).class(on_wallpaper()))
+        .align_x(Alignment::Center)
+        .spacing(0.0);
+    let page = widget::column::with_capacity(4)
+        .push(widget::space::vertical().height(Length::FillPortion(1)))
+        .push(widget::container(clock).width(Length::Fill).align_x(Alignment::Center))
+        .push(widget::space::vertical().height(Length::FillPortion(7)))
+        .push(widget::container(status).width(Length::Fill).align_x(Alignment::End).padding([0, 32, 28, 32]))
+        .width(Length::Fill)
+        .height(Length::Fill);
+    widget::mouse_area(page).on_press(reveal).into()
+}
+
+/// A round account picture (or a plain person glyph).
+pub fn avatar<'a, M: 'static>(icon: Option<&widget::image::Handle>, size: f32) -> Element<'a, M> {
+    match icon {
+        Some(h) => widget::image(h.clone())
+            .width(Length::Fixed(size))
+            .height(Length::Fixed(size))
+            .content_fit(iced::ContentFit::Cover)
+            .border_radius([size / 2.0; 4])
+            .into(),
+        None => widget::container(widget::icon::from_name("avatar-default-symbolic").size((size * 0.55) as u16))
+            .width(Length::Fixed(size))
+            .height(Length::Fixed(size))
+            .align_x(Alignment::Center)
+            .align_y(Alignment::Center)
+            .class(theme::Container::custom(move |_| widget::container::Style {
+                background: Some(Background::Color(Color::from_rgba(1.0, 1.0, 1.0, 0.18))),
+                border: Border { radius: (size / 2.0).into(), ..Default::default() },
+                icon_color: Some(Color::WHITE),
+                ..Default::default()
+            }))
+            .into(),
+    }
+}
+
+/// The sign-in panel: picture, name, the prompt (password box) and the
+/// message line under it, over a dimmed wallpaper.
+pub fn sign_in<'a, M: 'static>(
+    picture: Element<'a, M>,
+    name: String,
+    prompt: Element<'a, M>,
+    message: Element<'a, M>,
+    bottom_left: Element<'a, M>,
+    bottom_right: Element<'a, M>,
+    scale: f32,
+) -> Element<'a, M> {
+    let box_width = 296.0 * scale;
+    let panel = widget::column::with_capacity(5)
+        .push(picture)
+        .push(widget::text(name).size(28.0 * scale).class(on_wallpaper()))
+        .push(widget::space::vertical().height(Length::Fixed(4.0 * scale)))
+        .push(widget::container(prompt).width(Length::Fixed(box_width)))
+        .push(widget::container(message).width(Length::Fixed(box_width)).align_x(Alignment::Center))
+        .align_x(Alignment::Center)
+        .spacing(12.0 * scale);
+    // Windows centres the panel a little above the middle of the screen.
+    let page = widget::column::with_capacity(4)
+        .push(widget::space::vertical().height(Length::FillPortion(5)))
+        .push(widget::container(panel).width(Length::Fill).align_x(Alignment::Center))
+        .push(widget::space::vertical().height(Length::FillPortion(6)))
+        .push(
+            widget::row::with_capacity(3)
+                .push(bottom_left)
+                .push(widget::space::horizontal().width(Length::Fill))
+                .push(bottom_right)
+                .align_y(Alignment::End)
+                .padding([0, 32, 28, 32]),
+        )
+        .width(Length::Fill)
+        .height(Length::Fill);
+    widget::container(page)
+        .width(Length::Fill)
+        .height(Length::Fill)
+        .class(theme::Container::custom(|_| widget::container::Style {
+            // Windows blurs the wallpaper here; a dark veil reads the same.
+            background: Some(Background::Color(Color::from_rgba(0.0, 0.0, 0.0, 0.42))),
+            text_color: Some(Color::WHITE),
+            icon_color: Some(Color::WHITE),
+            ..Default::default()
+        }))
+        .into()
+}
+
+/// Round, translucent icon buttons (network, accessibility, power…).
+pub fn corner_button<'a, M: Clone + 'static>(icon: &'static str, msg: Option<M>) -> Element<'a, M> {
+    widget::button::custom(widget::icon::from_name(icon).size(20))
+        .padding(10.0)
+        .class(theme::Button::Custom {
+            active: Box::new(|_, _| bg_style(0.0)),
+            disabled: Box::new(|_| bg_style(0.0)),
+            hovered: Box::new(|_, _| bg_style(0.15)),
+            pressed: Box::new(|_, _| bg_style(0.25)),
+        })
+        .on_press_maybe(msg)
+        .into()
+}
+
+fn bg_style(alpha: f32) -> widget::button::Style {
+    widget::button::Style {
+        background: (alpha > 0.0).then_some(Background::Color(Color::from_rgba(1.0, 1.0, 1.0, alpha))),
+        border_radius: 6.0.into(),
+        icon_color: Some(Color::WHITE),
+        text_color: Some(Color::WHITE),
+        ..Default::default()
+    }
+}
+
+/// Windows' lock screen shows "8:42", not "8:42 PM".
+pub fn short_time(formatted: &str, military: bool) -> String {
+    if military {
+        return formatted.to_string();
+    }
+    let t: String = formatted.chars().take_while(|c| c.is_ascii_digit() || *c == ':').collect();
+    if t.is_empty() { formatted.to_string() } else { t }
+}
+
+/// A row in the user list: highlighted when it's the one signing in.
+pub fn list_button(selected: bool) -> theme::Button {
+    let style = move |hover: f32| widget::button::Style {
+        background: Some(Background::Color(Color::from_rgba(1.0, 1.0, 1.0, if selected { 0.22 } else { hover }))),
+        border_radius: 6.0.into(),
+        text_color: Some(Color::WHITE),
+        icon_color: Some(Color::WHITE),
+        ..Default::default()
+    };
+    theme::Button::Custom {
+        active: Box::new(move |_, _| style(0.0)),
+        disabled: Box::new(move |_| style(0.0)),
+        hovered: Box::new(move |_, _| style(0.12)),
+        pressed: Box::new(move |_, _| style(0.2)),
+    }
+}
