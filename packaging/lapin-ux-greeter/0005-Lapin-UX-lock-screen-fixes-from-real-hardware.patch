+/// The account picture cut to a circle (centre square, transparent
+/// corners), so it's round whatever its shape and however it's drawn.
+/// Falls back to the picture as it is if it can't be decoded.
+pub fn round_picture(bytes: Vec<u8>) -> widget::image::Handle {
+    const SIDE: u32 = 384;
+    let Ok(img) = image::load_from_memory(&bytes) else {
+        return widget::image::Handle::from_bytes(bytes);
+    };
+    let (w, h) = (img.width(), img.height());
+    let side = w.min(h).max(1);
+    let square = img.crop_imm((w - side) / 2, (h - side) / 2, side, side);
+    let mut rgba = square.resize_exact(SIDE, SIDE, image::imageops::FilterType::CatmullRom).to_rgba8();
+    let r = SIDE as f32 / 2.0;
+    for (x, y, px) in rgba.enumerate_pixels_mut() {
+        let dx = x as f32 + 0.5 - r;
+        let dy = y as f32 + 0.5 - r;
+        // One pixel of soft edge.
+        let cover = (r - (dx * dx + dy * dy).sqrt() + 0.5).clamp(0.0, 1.0);
+        px[3] = (px[3] as f32 * cover).round() as u8;
+    }
+    widget::image::Handle::from_rgba(SIDE, SIDE, rgba.into_raw())
+}
+
+/// The lock screen's touch keyboard button: cosmic-osk shows itself when
+/// its `always_shown` setting flips, but only if it's running. In Lapin UX
+/// it's started on demand, so start it here when it isn't.
+pub fn ensure_osk() {
+    let running = std::fs::read_dir("/proc").into_iter().flatten().flatten().any(|e| {
+        std::fs::read_to_string(e.path().join("comm")).is_ok_and(|c| c.trim() == "cosmic-osk")
+    });
+    if !running {
+        match std::process::Command::new("cosmic-osk").spawn() {
+            Ok(_) => tracing::info!("started cosmic-osk for the lock screen"),
+            Err(e) => tracing::warn!("couldn't start cosmic-osk: {e}"),
+        }
+    }
+}
