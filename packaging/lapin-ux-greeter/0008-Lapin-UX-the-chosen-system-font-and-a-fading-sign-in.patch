+/// How long the sign-in panel takes to appear or go (#54); the compositor
+/// grows the blur behind it over the same time.
+pub const FADE: std::time::Duration = std::time::Duration::from_millis(200);
+
+/// The move between the clock face (0) and the sign-in panel (1), eased.
+#[derive(Debug, Default)]
+pub struct Fade {
+    on: bool,
+    since: Option<std::time::Instant>,
+}
+
+impl Fade {
+    fn raw(&self, now: std::time::Instant) -> f32 {
+        let Some(since) = self.since else {
+            return if self.on { 1.0 } else { 0.0 };
+        };
+        let t = (now.saturating_duration_since(since).as_secs_f32() / FADE.as_secs_f32()).clamp(0.0, 1.0);
+        if self.on { t } else { 1.0 - t }
+    }
+
+    /// Head for the sign-in panel (true) or the clock face (false), from
+    /// wherever it is now.
+    pub fn set(&mut self, on: bool) {
+        if on == self.on {
+            return;
+        }
+        let now = std::time::Instant::now();
+        let p = self.raw(now);
+        let left = if on { p } else { 1.0 - p };
+        self.on = on;
+        self.since = Some(now - FADE.mul_f32(left));
+    }
+
+    /// Straight to a state, without animating (a new lock).
+    pub fn reset(&mut self, on: bool) {
+        *self = Self { on, since: None };
+    }
+
+    /// 0..=1 towards the sign-in panel, eased out.
+    pub fn progress(&self) -> f32 {
+        let p = self.raw(std::time::Instant::now());
+        1.0 - (1.0 - p) * (1.0 - p)
+    }
+
+    /// Still moving: frames are needed. Stops itself once it arrives.
+    pub fn running(&mut self) -> bool {
+        if self.since.is_some() {
+            let p = self.raw(std::time::Instant::now());
+            if (self.on && p >= 1.0) || (!self.on && p <= 0.0) {
+                self.since = None;
+            }
+        }
+        self.since.is_some()
+    }
+
+    pub fn is_running(&self) -> bool {
+        self.since.is_some()
+    }
+}
+
+/// What dims the wallpaper behind the sign-in panel at `t` (0..=1): a dark
+/// veil, or with the picture turned off for sign-in (Settings > Lock
+/// screen) a solid colour from the accent.
+fn backdrop(t: f32, plain: bool, theme: &cosmic::Theme) -> Color {
+    if plain {
+        let a: Color = theme.cosmic().accent_color().into();
+        Color::from_rgba(a.r * 0.35, a.g * 0.35, a.b * 0.35, t)
+    } else {
+        Color::from_rgba(0.0, 0.0, 0.0, 0.42 * t)
+    }
+}
+
+/// The clock face while the sign-in panel is going away: the backdrop
+/// fades out over it (#54).
+pub fn fading<'a, M: 'static>(content: Element<'a, M>, t: f32, plain: bool) -> Element<'a, M> {
+    if t <= 0.0 {
+        return content;
+    }
+    widget::container(content)
+        .width(Length::Fill)
+        .height(Length::Fill)
+        .class(theme::Container::custom(move |th| widget::container::Style {
+            background: Some(Background::Color(backdrop(t, plain, th))),
+            ..Default::default()
+        }))
+        .into()
+}
+
 /// Account picture size on the sign-in panel.
 pub const PICTURE: f32 = 192.0;
 
 /// The lock screen: time and date, top centre.
-/// Lapin UX's one system font, Selawik, by name: the sign-in screen runs
-/// as the greeter's own user, whose desktop settings don't choose a font.
+/// The default system font, Selawik, by name: the sign-in screen runs as
+/// the greeter's own user, whose desktop settings don't choose a font.
 pub const FONT_NAME: &str = "Selawik";
 
+static CHOSEN_FONT: std::sync::OnceLock<&'static str> = std::sync::OnceLock::new();
+
+/// The system font chosen in Settings > Personalization > Fonts (#62), for
+/// the lock screen (the user's own) or the sign-in screen (the last user's).
+/// Empty = Selawik. Set once, before the screens are drawn.
+pub fn set_font(family: &str) {
+    let family = family.trim();
+    if !family.is_empty() {
+        let _ = CHOSEN_FONT.set(Box::leak(family.to_string().into_boxed_str()));
+    }
+}
+
+pub fn font_name() -> &'static str {
+    CHOSEN_FONT.get().copied().unwrap_or(FONT_NAME)
+}
+
 pub fn font(weight: iced::font::Weight) -> iced::Font {
-    iced::Font { family: iced::font::Family::Name(FONT_NAME), weight, ..iced::Font::DEFAULT }
+    iced::Font { family: iced::font::Family::Name(font_name()), weight, ..iced::Font::DEFAULT }
