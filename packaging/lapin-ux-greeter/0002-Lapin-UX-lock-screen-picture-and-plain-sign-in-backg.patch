+    fn view_window(&self, surface_id: SurfaceId) -> Element<'_, Self::Message> {
+        // Lapin UX: with a lock screen picture chosen in Settings, draw it
+        // (otherwise the desktop background shows through, as upstream).
+        if self.flags.user_data.lapin_lock.wallpaper.is_some()
+            && let Some(img) = self.common.surface_images.get(&surface_id)
+        {
+            return widget::image(img)
+                .content_fit(iced::ContentFit::Cover)
+                .width(Length::Fill)
+                .height(Length::Fill)
+                .into();
+        }
