--- a/daemon/src/lib.rs
+++ b/daemon/src/lib.rs
@@ -97,6 +97,46 @@ pub struct UserData {
     pub time_applet_config: TimeAppletConfig,
     pub accessibility_zoom: ZoomConfig,
     pub kdl_output_lists: Vec<String>,
+    /// Lapin UX: Settings > Lock screen (picture, sign-in background).
+    #[serde(default)]
+    pub lapin_lock: LapinLock,
+}
+
+/// Lapin UX's lock screen settings, from the user's `dev.lapinux.Shell`
+/// config (written by Settings > Personalization > Lock screen).
+#[derive(Clone, Debug, Default, serde::Deserialize, serde::Serialize)]
+pub struct LapinLock {
+    /// The lock screen's own picture (None = the desktop background).
+    pub wallpaper: Option<PathBuf>,
+    /// "Show the lock screen background picture on the sign-in screen" off.
+    pub plain_signin: bool,
+}
+
+impl LapinLock {
+    /// Read as the user.
+    pub fn read() -> Self {
+        use cosmic_config::ConfigGet;
+        let Ok(c) = cosmic_config::Config::new("dev.lapinux.Shell", 1) else { return Self::default() };
+        let wallpaper = c
+            .get::<String>("lock_wallpaper")
+            .ok()
+            .filter(|p| !p.is_empty())
+            .map(PathBuf::from)
+            .filter(|p| p.is_file());
+        Self { wallpaper, plain_signin: c.get::<bool>("no_signin_picture").unwrap_or(false) }
+    }
+
+    /// Show the lock picture on every screen instead of the wallpaper.
+    pub fn apply(&self, bg: &mut BgState) {
+        if let Some(w) = &self.wallpaper {
+            for (_, source) in bg.wallpapers.iter_mut() {
+                *source = BgSource::Path(w.clone());
+            }
+            if bg.wallpapers.is_empty() {
+                bg.wallpapers.push((String::new(), BgSource::Path(w.clone())));
+            }
+        }
+    }
 }
 
