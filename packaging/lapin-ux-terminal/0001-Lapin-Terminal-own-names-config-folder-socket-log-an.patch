diff --git a/alacritty/src/lapin.rs b/alacritty/src/lapin.rs
new file mode 100644
index 00000000..e0053fe3
--- /dev/null
+++ b/alacritty/src/lapin.rs
@@ -0,0 +1,26 @@
+//! Lapin UX additions. Everything Lapin adds lives here, with a few call sites in upstream files,
+//! so rebasing onto a new Alacritty release stays small.
+
+use std::env;
+
+/// App ID, window class and config folder name of Lapin Terminal. Own names, so nothing collides
+/// with a user's `alacritty` package, config or running windows.
+pub const APP_ID: &str = "dev.lapinux.Terminal";
+
+/// Name shown in the title bar, Start search and Apps.
+pub const DISPLAY_NAME: &str = "Terminal";
+
+/// Config file name inside `$XDG_CONFIG_HOME/dev.lapinux.Terminal/`.
+pub const CONFIG_FILE: &str = "terminal";
+
+/// Whether Lapin's own look and behaviour is on: inside the Lapin UX session
+/// (`XDG_CURRENT_DESKTOP` contains `LapinUX`), or when `LAPIN_UX_TERMINAL=1` forces it.
+/// Outside it the app behaves like stock Alacritty (under its own names).
+#[allow(dead_code)]
+pub fn enabled() -> bool {
+    if env::var("LAPIN_UX_TERMINAL").is_ok_and(|v| v == "1") {
+        return true;
+    }
+    env::var("XDG_CURRENT_DESKTOP")
+        .is_ok_and(|desktops| desktops.split([':', ';']).any(|d| d == "LapinUX"))
+}
