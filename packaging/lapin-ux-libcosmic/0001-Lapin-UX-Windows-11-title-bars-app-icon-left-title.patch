         let is_ssd = self.is_ssd;
 
         // Take ownership of the regions to be packed.
-        let start = std::mem::take(&mut self.start);
+        let mut start = std::mem::take(&mut self.start);
         let center = std::mem::take(&mut self.center);
+        // Lapin UX: a plain title goes left with the app icon, as on Windows.
+        if crate::lapin::enabled() && center.is_empty() && !self.title.is_empty() {
+            start.insert(0, crate::lapin::title(std::mem::take(&mut self.title)));
+        }
         let mut end = std::mem::take(&mut self.end);
 
         // Also packs the window controls at the very end.
