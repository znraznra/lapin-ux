+// SPDX-License-Identifier: MPL-2.0
+//! Lapin UX: Windows 11 title bars for COSMIC apps.
+//!
+//! Windows puts the app's icon and the window title at the left of the title
+//! bar; COSMIC centres the title. Everything Lapin changes lives here so the
+//! patch to libcosmic is a few call sites. It only takes effect in a Lapin UX
+//! session, so the same build looks stock under COSMIC.
+
+use std::sync::OnceLock;
+
+use crate::{Element, iced, widget};
+
+static APP_ID: OnceLock<String> = OnceLock::new();
+
+/// Remembers the running app's id, for its icon in the title bar.
+pub fn set_app_id(id: &str) {
+    let _ = APP_ID.set(id.to_string());
+}
+
+/// True in a Lapin UX session (`XDG_CURRENT_DESKTOP` lists `LapinUX`), or
+/// when `LAPIN_UX_TITLEBAR=1` forces it.
+pub fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var("LAPIN_UX_TITLEBAR").is_ok_and(|v| v == "1")
+            || std::env::var("XDG_CURRENT_DESKTOP").is_ok_and(|d| d.split(':').any(|p| p.eq_ignore_ascii_case("LapinUX")))
+    })
+}
+
+/// The app's icon and the title, left-aligned, as on Windows 11.
+pub fn title<'a, M: 'static>(title: std::borrow::Cow<'a, str>) -> Element<'a, M> {
+    let mut row = widget::row::with_capacity(2).spacing(10).align_y(iced::Alignment::Center).padding([0, 0, 0, 6]);
+    if let Some(id) = APP_ID.get() {
+        row = row.push(widget::icon::from_name(id.as_str()).size(16));
+    }
+    row.push(
+        widget::text::body(title)
+            .wrapping(iced_core::text::Wrapping::None)
+            .ellipsize(iced_core::text::Ellipsize::End(iced_core::text::EllipsizeHeightLimit::Lines(1))),
+    )
+    .into()
+}
