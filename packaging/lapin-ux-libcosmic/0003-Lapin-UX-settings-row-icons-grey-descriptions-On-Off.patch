-        item_row(vec![
-            text(title).wrapping(Wrapping::Word).into(),
-            space::horizontal().into(),
-            widget,
-        ])
+        let mut children = Vec::with_capacity(4);
+        children.extend(crate::lapin::item_icon(&title));
+        children.extend([text(title).wrapping(Wrapping::Word).into(), space::horizontal().into(), widget]);
+        item_row(children)
     }
 
     inner(title.into(), widget.into())
@@ -118,7 +117,7 @@ impl<'a, Message: Clone + 'static> Item<'a, Message> {
             column::with_capacity(2)
                 .spacing(2)
                 .push(text::body(self.title).wrapping(Wrapping::Word))
-                .push(text::caption(description).wrapping(Wrapping::Word))
+                .push(crate::lapin::quiet(text::caption(description).wrapping(Wrapping::Word)))
                 .width(Length::Fill)
                 .into()
         } else {
@@ -131,6 +130,8 @@ impl<'a, Message: Clone + 'static> Item<'a, Message> {
         let mut contents = Vec::with_capacity(3);
         if let Some(icon) = self.icon.take() {
             contents.push(icon);
+        } else {
+            contents.extend(crate::lapin::item_icon(&self.title));
         }
         contents.push(self.label());
         contents.push(widget);
@@ -148,11 +149,12 @@ impl<'a, Message: Clone + 'static> Item<'a, Message> {
     ) -> list::ListButton<'a, Message> {
         let on_press = message(!is_checked);
         list::button(
-            self.control(
+            self.control(crate::lapin::on_off(
+                is_checked,
                 crate::widget::toggler(is_checked)
                     .width(Length::Shrink)
                     .on_toggle(message),
-            ),
+            )),
         )
         .on_press(on_press)
     }
@@ -164,11 +166,12 @@ impl<'a, Message: Clone + 'static> Item<'a, Message> {
     ) -> list::ListButton<'a, Message> {
         let on_press = message.as_ref().map(|f| f(!is_checked));
         list::button(
-            self.control(
+            self.control(crate::lapin::on_off(
+                is_checked,
                 crate::widget::toggler(is_checked)
                     .width(Length::Shrink)
                     .on_toggle_maybe(message),
-            ),
+            )),
         )
         .on_press_maybe(on_press)
     }
