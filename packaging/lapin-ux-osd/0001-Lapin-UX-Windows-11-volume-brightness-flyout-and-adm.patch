index 0000000..7ab9796
--- /dev/null
+++ b/src/lapin.rs
@@ -0,0 +1,239 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Lapin UX: Windows 11 looks for cosmic-osd's pop-ups.
+//!
+//! Everything Lapin draws lives here, so the patch to COSMIC's own files is
+//! a handful of call sites and survives COSMIC updates with little rework.
+//! - `value_osd`: the volume / brightness flyout (icon, thin bar, number).
+//! - `admin_prompt`: the admin permission prompt, over a dimmed screen.
+
+use std::collections::HashMap;
+
+use cosmic::iced::{self, Alignment, Background, Border, Color, Length};
+use cosmic::{Element, theme, widget};
+
+/// Lapin UX's look only in a Lapin UX session (XDG_CURRENT_DESKTOP has
+/// LapinUX), so COSMIC's own session keeps COSMIC's pop-ups and prompt.
+/// LAPIN_UX_OSD=1 forces it on (and the preview switch implies it).
+pub fn enabled() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var("XDG_CURRENT_DESKTOP").is_ok_and(|d| d.split(':').any(|d| d == "LapinUX"))
+            || std::env::var("LAPIN_UX_OSD").is_ok_and(|v| v == "1")
+            || std::env::var_os("LAPIN_OSD_PREVIEW").is_some()
+    })
+}
+
+/// Gap between the taskbar and a pop-up, as for Start and quick settings.
+pub const POPUP_GAP: i32 = 12;
+
+const FLYOUT_RADIUS: f32 = 8.0;
+const BUTTON_RADIUS: f32 = 4.0;
+
+fn flyout_style(t: &cosmic::Theme) -> widget::container::Style {
+    let c = t.cosmic();
+    widget::container::Style {
+        text_color: Some(c.background(t.transparent).on.into()),
+        icon_color: Some(c.background(t.transparent).on.into()),
+        background: Some(Color::from(c.background(t.transparent).base).into()),
+        border: Border { radius: FLYOUT_RADIUS.into(), width: 1.0, color: c.bg_divider().into() },
+        ..Default::default()
+    }
+}
+
+/// Windows 11's volume / brightness flyout: icon, a thin accent bar and the
+/// value, in a small rounded box above the taskbar.
+pub fn value_osd<'a, M: Clone + 'static>(icon_name: &'static str, value: u32, max: f32) -> Element<'a, M> {
+    let progress = (value as f32 / max).clamp(0.0, 1.0);
+    let bar = if max > 100.0 {
+        widget::determinate_linear(progress).markers([100.0 / max])
+    } else {
+        widget::determinate_linear(progress)
+    }
+    .girth(4)
+    .width(Length::Fixed(124.0));
+    widget::container(
+        iced::widget::row![
+            widget::icon::from_name(icon_name).size(16),
+            bar,
+            widget::text::body(value.to_string()).width(Length::Fixed(28.0)).align_x(Alignment::End),
+        ]
+        .spacing(12)
+        .align_y(Alignment::Center),
+    )
+    .padding([0, 16])
+    .height(Length::Fixed(48.0))
+    .align_y(Alignment::Center)
+    .class(theme::Container::custom(flyout_style))
+    .into()
+}
+
+/// What the admin prompt shows and the messages its controls send.
+pub struct AdminPrompt<'a, M> {
+    /// polkit's own sentence, e.g. "Authentication is required to install software".
+    pub message: &'a str,
+    pub icon_name: Option<&'a str>,
+    pub action_id: &'a str,
+    pub details: &'a HashMap<String, String>,
+    pub user: &'a str,
+    pub password: Element<'a, M>,
+    pub error: Option<&'a str>,
+    pub details_open: bool,
+    pub toggle_details: M,
+    /// `None` while the password is being checked.
+    pub yes: Option<M>,
+    pub no: Option<M>,
+}
+
+fn win_button(suggested: bool) -> theme::Button {
+    let kind = move || if suggested { theme::Button::Suggested } else { theme::Button::Standard };
+    let square = |mut s: widget::button::Style| {
+        s.border_radius = BUTTON_RADIUS.into();
+        s
+    };
+    use widget::button::Catalog;
+    theme::Button::Custom {
+        active: Box::new(move |f, t| square(t.active(f, false, &kind()))),
+        disabled: Box::new(move |t| square(t.disabled(&kind()))),
+        hovered: Box::new(move |f, t| square(t.hovered(f, false, &kind()))),
+        pressed: Box::new(move |f, t| square(t.pressed(f, false, &kind()))),
+    }
+}
+
+fn prompt_button<'a, M: Clone + 'a>(label: &'a str, suggested: bool, msg: Option<M>) -> Element<'a, M> {
+    widget::button::custom(widget::container(widget::text::body(label)).center_x(Length::Fill).center_y(Length::Fill))
+        .width(Length::Fill)
+        .height(Length::Fixed(32.0))
+        .padding(0)
+        .class(win_button(suggested))
+        .on_press_maybe(msg)
+        .into()
+}
+
+/// The app that asked: pkexec passes the program; otherwise polkit's message.
+fn asker(details: &HashMap<String, String>, message: &str) -> String {
+    details
+        .get("program")
+        .and_then(|p| std::path::Path::new(p).file_name())
+        .map(|n| n.to_string_lossy().into_owned())
+        .unwrap_or_else(|| message.to_string())
+}
+
+/// Windows' admin permission prompt: the screen dims, and a card in the
+/// middle asks whether to allow the app to make changes. Linux always asks
+/// for a password, so the card ends with the password box above Yes / No.
+pub fn admin_prompt<'a, M: Clone + 'static>(p: AdminPrompt<'a, M>) -> Element<'a, M> {
+    let active = theme::active();
+    let quiet = theme::Text::Color(Color::from(active.cosmic().background(false).on).scale_alpha(0.75));
+    let name = asker(p.details, p.message);
+    let mut app = widget::column::with_capacity(4).spacing(2);
+    app = app.push(widget::text::heading(name.clone()));
+    if name != p.message {
+        app = app.push(widget::text::body(p.message).class(quiet.clone()));
+    }
+    let mut body = widget::column::with_capacity(8).spacing(12);
+    body = body.push(
+        widget::text::title4("Do you want to allow this app to make changes to your device?")
+            .width(Length::Fill),
+    );
+    body = body.push(
+        iced::widget::row![
+            widget::icon::from_name(p.icon_name.unwrap_or("dialog-password-symbolic")).size(32),
+            app,
+        ]
+        .spacing(12)
+        .align_y(Alignment::Center),
+    );
+    if p.details_open {
+        let mut more = widget::column::with_capacity(4).spacing(2);
+        more = more.push(widget::text::caption(format!("Action: {}", p.action_id)).class(quiet.clone()));
+        if let Some(cmd) = p.details.get("command_line") {
+            more = more.push(widget::text::caption(format!("Command: {cmd}")).class(quiet.clone()));
+        }
+        body = body.push(more);
+    }
+    body = body.push(
+        widget::button::link(if p.details_open { "Hide details" } else { "Show more details" })
+            .padding(0)
+            .on_press(p.toggle_details),
+    );
+    body = body.push(widget::text::body(format!("To continue, enter the password for {}.", p.user)));
+    body = body.push(p.password);
+    if let Some(e) = p.error {
+        body = body.push(widget::text::body(e).class(theme::Text::Color(Color::from_rgb(0.95, 0.35, 0.35))));
+    }
+    let footer = widget::container(
+        iced::widget::row![prompt_button("Yes", true, p.yes), prompt_button("No", false, p.no)].spacing(8),
+    )
+    .padding(24)
+    .class(theme::Container::custom(|t| {
+        let c = t.cosmic();
+        widget::container::Style {
+            background: Some(Color::from(c.primary(t.transparent).base).into()),
+            border: Border { radius: [0.0, 0.0, FLYOUT_RADIUS, FLYOUT_RADIUS].into(), ..Default::default() },
+            ..Default::default()
+        }
+    }));
+    let card = widget::container(
+        widget::column::with_children(vec![
+            widget::container(
+                widget::column::with_children(vec![
+                    widget::text::body("Admin permission").class(quiet).into(),
+                    body.into(),
+                ])
+                .spacing(8),
+            )
+            .padding([20, 24, 24, 24])
+            .into(),
+            footer.into(),
+        ]),
+    )
+    .width(Length::Fixed(456.0))
+    .class(theme::Container::custom(flyout_style));
+    // The dimmed screen behind the card, as Windows' secure desktop.
+    widget::container(card)
+        .center(Length::Fill)
+        .class(theme::Container::custom(|_| widget::container::Style {
+            background: Some(Background::Color(Color::from_rgba(0.0, 0.0, 0.0, 0.55))),
+            ..Default::default()
+        }))
+        .into()
+}
+
+/// Cookie of the preview prompt: no polkit behind it, so it isn't closed
+/// when the password helper can't start.
+pub const PREVIEW_COOKIE: &str = "lapin-ux-preview";
+
+/// What `LAPIN_OSD_PREVIEW` asks to show at start, for checking the look
+/// without changing the volume or asking polkit (volume, brightness, admin).
+pub enum Preview {
+    Value(crate::components::osd_indicator::Params),
+    Admin(crate::components::polkit_dialog::Params),
+}
+
+pub fn preview() -> Option<Preview> {
+    use crate::components::{audio::model::NodeVolume, osd_indicator::Params, polkit_dialog};
+    match std::env::var("LAPIN_OSD_PREVIEW").ok()?.as_str() {
+        "volume" => Some(Preview::Value(Params::SinkVolume(NodeVolume { volume: 46, mute: false }))),
+        "brightness" => Some(Preview::Value(Params::DisplayBrightnessExact(0.7))),
+        "admin" => {
+            let (tx, _rx) = tokio::sync::oneshot::channel();
+            let details = [("program".to_string(), "/usr/bin/pacman".to_string()), ("command_line".to_string(), "/usr/bin/pacman -Syu".to_string())]
+                .into_iter()
+                .collect();
+            Some(Preview::Admin(polkit_dialog::Params {
+                pw_name: whoami(),
+                action_id: "org.archlinux.pkexec.pacman".into(),
+                message: "Authentication is required to update software".into(),
+                icon_name: Some("system-software-update".into()),
+                details,
+                cookie: PREVIEW_COOKIE.into(),
+                response_sender: std::sync::Arc::new(std::sync::Mutex::new(Some(tx))),
+            }))
+        }
+        _ => None,
+    }
+}
+
+fn whoami() -> String {
+    std::env::var("USER").unwrap_or_else(|_| "user".into())
+}
