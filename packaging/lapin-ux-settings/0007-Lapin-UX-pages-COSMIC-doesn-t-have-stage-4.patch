--- /dev/null
+++ b/cosmic-settings/src/lapin/apps.rs
@@ -0,0 +1,438 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Apps > Installed apps, as on Windows: every app with its icon, version,
+//! install date and size, a search box, Sort by, and "…" > Uninstall.
+//! Apps from Arch packages are removed with pacman (through the admin
+//! prompt), Flatpak apps with flatpak. Parts of the desktop itself can't be
+//! uninstalled here, as in Start.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+use cosmic::iced::{Alignment, Length};
+use cosmic::widget::{self, column, icon, row, text};
+use cosmic::{Apply, Element, Task};
+use cosmic_settings_page::{self as page, Section, section};
+use slotmap::SlotMap;
+
+use super::rows::{self, PMsg};
+use super::settings::Msg as SMsg;
+use super::style;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Kind {
+    /// An Arch package (its name, once looked up).
+    Package(Option<String>),
+    Flatpak { app_id: String, user: bool },
+    /// Put in place by hand (~/.local): nothing safe to remove it with.
+    Local,
+}
+
+#[derive(Clone, Debug)]
+pub struct App {
+    pub id: String,
+    pub name: String,
+    pub icon: String,
+    pub path: PathBuf,
+    pub kind: Kind,
+    pub version: Option<String>,
+    pub size: Option<u64>,
+    /// Seconds since 1970.
+    pub installed: Option<i64>,
+}
+
+impl App {
+    fn removable(&self) -> bool {
+        match &self.kind {
+            Kind::Package(Some(p)) => !protected(p),
+            Kind::Package(None) | Kind::Local => false,
+            Kind::Flatpak { .. } => true,
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum Msg {
+    Loaded(Vec<App>),
+    Query(String),
+    Sort(usize),
+    /// The "…" menu of this app (None closes it).
+    Menu(Option<String>),
+    /// "Uninstall" in the menu: ask first, as Windows does.
+    Ask(String),
+    Uninstall(String),
+    Done(String, Result<(), String>),
+}
+
+const SORTS: [&str; 5] = ["Name (A to Z)", "Name (Z to A)", "Size (large to small)", "Size (small to large)", "Install date"];
+
+#[derive(Default)]
+pub struct Page {
+    entity: page::Entity,
+    loading: bool,
+    apps: Vec<App>,
+    query: String,
+    sort: usize,
+    menu: Option<String>,
+    confirm: Option<String>,
+    busy: Option<String>,
+    problem: Option<String>,
+}
+
+impl page::Page<PMsg> for Page {
+    fn set_id(&mut self, entity: page::Entity) {
+        self.entity = entity;
+    }
+    fn info(&self) -> page::Info {
+        page::Info::new("lapin-installed-apps", "view-app-grid-symbolic")
+            .title("Installed apps")
+            .description("Uninstall and manage apps")
+    }
+    fn content(&self, sections: &mut SlotMap<section::Entity, Section<PMsg>>) -> Option<page::Content> {
+        Some(vec![sections.insert(Section::default().view::<Page>(|_, page, _| view(page)))])
+    }
+    fn on_enter(&mut self) -> Task<PMsg> {
+        self.loading = self.apps.is_empty();
+        self.menu = None;
+        self.confirm = None;
+        load_task()
+    }
+}
+
+impl page::AutoBind<PMsg> for Page {}
+
+fn m(msg: Msg) -> PMsg {
+    PMsg::Lapin(SMsg::Apps(msg))
+}
+
+fn load_task() -> Task<PMsg> {
+    Task::future(async { m(Msg::Loaded(load().await)) })
+}
+
+pub fn update(pages: &mut cosmic_settings_page::Binder<PMsg>, msg: Msg) -> cosmic::app::Task<crate::Message> {
+    let Some(p) = pages.page_mut::<Page>() else { return Task::none() };
+    match msg {
+        Msg::Loaded(apps) => {
+            p.loading = false;
+            p.apps = apps;
+        }
+        Msg::Query(q) => p.query = q,
+        Msg::Sort(i) => p.sort = i.min(SORTS.len() - 1),
+        Msg::Menu(id) => {
+            p.menu = id;
+            p.confirm = None;
+        }
+        Msg::Ask(id) => {
+            p.menu = None;
+            p.confirm = Some(id);
+        }
+        Msg::Uninstall(id) => {
+            p.confirm = None;
+            p.problem = None;
+            let Some(app) = p.apps.iter().find(|a| a.id == id).cloned() else { return Task::none() };
+            p.busy = Some(id.clone());
+            return cosmic::task::future(async move {
+                let r = uninstall(&app).await;
+                crate::Message::PageMessage(m(Msg::Done(id, r)))
+            });
+        }
+        Msg::Done(id, r) => {
+            p.busy = None;
+            match r {
+                Ok(()) => p.apps.retain(|a| a.id != id),
+                Err(e) => p.problem = Some(e),
+            }
+            return load_task().map(crate::Message::PageMessage).map(cosmic::Action::App);
+        }
+    }
+    Task::none()
+}
+
+fn sorted(p: &Page) -> Vec<&App> {
+    let q = p.query.to_lowercase();
+    let mut v: Vec<&App> = p.apps.iter().filter(|a| q.is_empty() || a.name.to_lowercase().contains(&q)).collect();
+    match p.sort {
+        1 => v.sort_by(|a, b| b.name.to_lowercase().cmp(&a.name.to_lowercase())),
+        2 => v.sort_by(|a, b| b.size.unwrap_or(0).cmp(&a.size.unwrap_or(0))),
+        3 => v.sort_by(|a, b| a.size.unwrap_or(0).cmp(&b.size.unwrap_or(0))),
+        4 => v.sort_by(|a, b| b.installed.unwrap_or(0).cmp(&a.installed.unwrap_or(0))),
+        _ => v.sort_by(|a, b| a.name.to_lowercase().cmp(&b.name.to_lowercase())),
+    }
+    v
+}
+
+fn date(secs: i64) -> String {
+    chrono::DateTime::from_timestamp(secs, 0)
+        .map(|d| d.with_timezone(&chrono::Local).format("%-m/%-d/%Y").to_string())
+        .unwrap_or_default()
+}
+
+fn view(p: &Page) -> Element<'_, PMsg> {
+    let list = sorted(p);
+    let search = widget::search_input("Search apps", &p.query)
+        .on_input(|q| m(Msg::Query(q)))
+        .on_clear(m(Msg::Query(String::new())))
+        .width(Length::Fixed(300.0));
+    let sort = row::with_capacity(2)
+        .spacing(8)
+        .align_y(Alignment::Center)
+        .push(text::body("Sort by:"))
+        .push(widget::dropdown(&SORTS, Some(p.sort), |i| m(Msg::Sort(i))));
+    let tools = row::with_capacity(3)
+        .spacing(12)
+        .align_y(Alignment::Center)
+        .push(search)
+        .push(widget::space::horizontal())
+        .push(sort);
+    let count = if p.loading {
+        "Finding apps…".to_string()
+    } else if list.len() == 1 {
+        "1 app found".to_string()
+    } else {
+        format!("{} apps found", list.len())
+    };
+    let mut page = column::with_capacity(4).spacing(12).push(tools).push(text::caption(count).class(style::quiet()));
+    if let Some(e) = &p.problem {
+        page = page.push(text::body(format!("Couldn't uninstall: {e}")).class(cosmic::theme::Text::Accent));
+    }
+    let rows: Vec<rows::Item<'_>> = list.into_iter().map(|a| app_row(p, a)).collect();
+    if !rows.is_empty() {
+        page = page.push(rows::section("", rows));
+    }
+    page.into()
+}
+
+fn app_row<'a>(p: &'a Page, a: &'a App) -> rows::Item<'a> {
+    let mut details: Vec<String> = Vec::new();
+    if let Some(v) = &a.version {
+        details.push(v.clone());
+    }
+    details.push(match &a.kind {
+        Kind::Flatpak { .. } => "Flatpak".into(),
+        Kind::Package(_) => "System package".into(),
+        Kind::Local => "Installed for you".into(),
+    });
+    if let Some(t) = a.installed {
+        details.push(date(t));
+    }
+    let busy = p.busy.as_deref() == Some(a.id.as_str());
+    let size = text::body(if busy { "Uninstalling…".into() } else { a.size.map(rows::size).unwrap_or_default() });
+    let dots = widget::button::icon(icon::from_name("view-more-horizontal-symbolic").size(16))
+        .on_press_maybe((!busy).then(|| m(Msg::Menu(Some(a.id.clone())))));
+    let dots: Element<'a, PMsg> = if p.menu.as_deref() == Some(a.id.as_str()) {
+        let uninstall = widget::button::custom(text::body("Uninstall").apply(widget::container).padding([6, 16]))
+            .class(style::nav_item(false))
+            .width(Length::Fixed(180.0))
+            .on_press_maybe(a.removable().then(|| m(Msg::Ask(a.id.clone()))));
+        let menu = column::with_capacity(2).push(uninstall);
+        widget::popover(dots)
+            .popup(widget::container(menu).padding(4).class(style::card()))
+            .on_close(m(Msg::Menu(None)))
+            .position(widget::popover::Position::Bottom)
+            .into()
+    } else if p.confirm.as_deref() == Some(a.id.as_str()) {
+        let ask = column::with_capacity(2)
+            .spacing(12)
+            .width(Length::Fixed(300.0))
+            .push(text::body("This app and its related info will be uninstalled."))
+            .push(
+                row::with_capacity(2)
+                    .push(widget::space::horizontal())
+                    .push(widget::button::suggested("Uninstall").on_press(m(Msg::Uninstall(a.id.clone())))),
+            );
+        widget::popover(dots)
+            .popup(widget::container(ask).padding(16).class(style::card()))
+            .on_close(m(Msg::Menu(None)))
+            .position(widget::popover::Position::Bottom)
+            .into()
+    } else {
+        dots.into()
+    };
+    let control = row::with_capacity(2).spacing(16).align_y(Alignment::Center).push(size).push(dots);
+    let glyph: Element<'a, PMsg> = icon::from_name(a.icon.clone())
+        .fallback(Some(icon::IconFallback::Names(vec!["application-x-executable".into()])))
+        .size(32)
+        .into();
+    let line = row::with_capacity(3)
+        .spacing(16)
+        .align_y(Alignment::Center)
+        .push(glyph)
+        .push(rows::words(a.name.clone(), details.join("  |  ")))
+        .push(control);
+    use cosmic::widget::list_column::IntoListItem;
+    Element::from(line).into_list_item()
+}
+
+/// Packages that must never be removed here (they'd take the desktop down).
+pub fn protected(pkg: &str) -> bool {
+    pkg.starts_with("cosmic-")
+        || pkg.starts_with("lapin-ux")
+        || matches!(pkg, "networkmanager" | "systemd" | "pacman" | "glibc" | "linux" | "bash" | "sudo" | "polkit" | "dbus" | "wireplumber" | "pipewire")
+}
+
+fn kind_of(path: &Path, home: &Path) -> Kind {
+    let p = path.to_string_lossy();
+    if p.contains("/flatpak/exports/share/applications/") {
+        let user = path.starts_with(home.join(".local/share/flatpak"));
+        let app_id = path.file_stem().map(|s| s.to_string_lossy().into_owned()).unwrap_or_default();
+        return Kind::Flatpak { app_id, user };
+    }
+    if path.starts_with(home) {
+        return Kind::Local;
+    }
+    Kind::Package(None)
+}
+
+/// Every app Start shows, with what pacman and flatpak know about it.
+pub async fn load() -> Vec<App> {
+    let home = dirs::home_dir().unwrap_or_default();
+    let locales = freedesktop_desktop_entry::get_languages_from_env();
+    let mut seen = std::collections::HashSet::new();
+    let mut apps: Vec<App> = freedesktop_desktop_entry::desktop_entries(&locales)
+        .into_iter()
+        .filter(|e| e.desktop_entry("Type").is_none_or(|t| t == "Application") && !e.no_display() && !e.hidden())
+        .filter(|e| seen.insert(e.appid.clone()))
+        .map(|e| App {
+            id: e.appid.clone(),
+            name: e.name(&locales).map(|n| n.into_owned()).unwrap_or_else(|| e.appid.clone()),
+            icon: e.icon().unwrap_or("application-x-executable").to_string(),
+            kind: kind_of(&e.path, &home),
+            path: e.path.clone(),
+            version: None,
+            size: None,
+            installed: None,
+        })
+        .collect();
+
+    // Arch packages: who owns each launcher, then each package's details.
+    let files: Vec<String> = apps
+        .iter()
+        .filter(|a| matches!(a.kind, Kind::Package(_)))
+        .map(|a| a.path.to_string_lossy().into_owned())
+        .collect();
+    if !files.is_empty() {
+        let mut args = vec!["-Qo"];
+        args.extend(files.iter().map(String::as_str));
+        // pacman exits non-zero when some file has no owner; use what it said.
+        let out = tokio::process::Command::new("pacman").args(&args).env("LC_ALL", "C").output().await.ok();
+        let owners = out.map(|o| parse_owners(&String::from_utf8_lossy(&o.stdout))).unwrap_or_default();
+        let pkgs: Vec<String> = {
+            let mut v: Vec<String> = owners.values().map(|(p, _)| p.clone()).collect();
+            v.sort();
+            v.dedup();
+            v
+        };
+        let info = if pkgs.is_empty() {
+            HashMap::new()
+        } else {
+            let mut a = vec!["-Qi"];
+            a.extend(pkgs.iter().map(String::as_str));
+            rows::output("pacman", &a).await.map(|o| parse_info(&o)).unwrap_or_default()
+        };
+        for app in &mut apps {
+            if let Some((pkg, ver)) = owners.get(&*app.path.to_string_lossy()) {
+                app.kind = Kind::Package(Some(pkg.clone()));
+                app.version = Some(ver.clone());
+                if let Some((size, date)) = info.get(pkg) {
+                    app.size = *size;
+                    app.installed = *date;
+                }
+            }
+        }
+    }
+
+    // Flatpak apps.
+    if apps.iter().any(|a| matches!(a.kind, Kind::Flatpak { .. }))
+        && let Ok(out) = rows::output("flatpak", &["list", "--app", "--columns=application,version,size"]).await
+    {
+        let info: HashMap<String, (String, Option<u64>)> = out
+            .lines()
+            .filter_map(|l| {
+                let mut it = l.split('\t');
+                let id = it.next()?.trim().to_string();
+                let ver = it.next().unwrap_or_default().trim().to_string();
+                let size = it.next().and_then(rows::parse_size);
+                (!id.is_empty()).then_some((id, (ver, size)))
+            })
+            .collect();
+        for app in &mut apps {
+            if let Kind::Flatpak { app_id, user } = &app.kind {
+                if let Some((ver, size)) = info.get(app_id) {
+                    app.version = (!ver.is_empty()).then(|| ver.clone());
+                    app.size = *size;
+                }
+                let base = if *user { home.join(".local/share/flatpak/app") } else { PathBuf::from("/var/lib/flatpak/app") };
+                app.installed = std::fs::metadata(base.join(app_id))
+                    .and_then(|m| m.modified())
+                    .ok()
+                    .and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok())
+                    .map(|d| d.as_secs() as i64);
+            }
+        }
+    }
+    apps
+}
+
+/// `pacman -Qo` lines: "/usr/share/applications/x.desktop is owned by pkg 1.0-1".
+pub fn parse_owners(out: &str) -> HashMap<String, (String, String)> {
+    out.lines()
+        .filter_map(|l| {
+            let (file, rest) = l.split_once(" is owned by ")?;
+            let mut it = rest.split_whitespace();
+            Some((file.trim().to_string(), (it.next()?.to_string(), it.next().unwrap_or_default().to_string())))
+        })
+        .collect()
+}
+
+/// `pacman -Qi` blocks: package → (installed size, install date).
+pub fn parse_info(out: &str) -> HashMap<String, (Option<u64>, Option<i64>)> {
+    let mut map = HashMap::new();
+    for block in out.split("\n\n") {
+        let field = |k: &str| {
+            block.lines().find_map(|l| {
+                let (key, v) = l.split_once(':')?;
+                (key.trim() == k).then(|| v.trim().to_string())
+            })
+        };
+        let Some(name) = field("Name") else { continue };
+        let size = field("Installed Size").and_then(|s| rows::parse_size(&s));
+        let date = field("Install Date").and_then(|d| {
+            chrono::NaiveDateTime::parse_from_str(&d, "%a %b %e %H:%M:%S %Y")
+                .or_else(|_| chrono::NaiveDateTime::parse_from_str(&d, "%a %d %b %Y %I:%M:%S %p %Z"))
+                .ok()
+                .map(|t| t.and_utc().timestamp())
+        });
+        map.insert(name, (size, date));
+    }
+    map
+}
+
+async fn uninstall(app: &App) -> Result<(), String> {
+    match &app.kind {
+        Kind::Flatpak { app_id, user } => {
+            let scope = if *user { "--user" } else { "--system" };
+            rows::output("flatpak", &["uninstall", scope, "--noninteractive", "-y", app_id]).await.map(drop)
+        }
+        Kind::Package(Some(pkg)) if !protected(pkg) => {
+            // -Rs also removes dependencies nothing else needs.
+            rows::output("pkexec", &["pacman", "-Rs", "--noconfirm", pkg]).await.map(drop)
+        }
+        Kind::Package(Some(pkg)) => Err(format!("{pkg} is part of the desktop and can't be removed here.")),
+        _ => Err("This app wasn't installed by a package manager.".into()),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pacman_output() {
+        let o = parse_owners("/usr/share/applications/firefox.desktop is owned by firefox 131.0-1\nerror: No package owns /x\n");
+        assert_eq!(o["/usr/share/applications/firefox.desktop"], ("firefox".into(), "131.0-1".into()));
+        let i = parse_info("Name            : firefox\nInstalled Size  : 245.67 MiB\nInstall Date    : Mon Oct 14 21:12:44 2024\n\nName : gimp\n");
+        assert_eq!(i["firefox"].0, Some((245.67 * 1048576.0) as u64));
+        assert!(i["firefox"].1.is_some());
+        assert_eq!(i["gimp"], (None, None));
+        assert!(protected("cosmic-files") && !protected("firefox"));
+    }
+}
