@@ -0,0 +1,354 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Accounts > Sign-in options, as on Windows: "Ways to sign in" with
+//! Fingerprint recognition (through fprintd, when the PC has a reader) and
+//! Password (Change). The new password is set through AccountsService; the
+//! admin prompt asks for the current one first.
+
+use cosmic::iced::{Alignment, Length};
+use cosmic::widget::{self, column, row, text};
+use cosmic::{Element, Task};
+use cosmic_settings_page::{self as page, Binder, Section, section};
+use futures::StreamExt;
+use slotmap::SlotMap;
+
+use super::rows::{self, PMsg};
+use super::settings::Msg as SMsg;
+
+const FPRINT: &str = "net.reactivated.Fprint";
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Reader {
+    /// The reader's D-Bus path.
+    pub device: String,
+    pub name: String,
+    pub enrolled: Vec<String>,
+}
+
+#[derive(Clone, Debug)]
+pub enum Msg {
+    Reader(Option<Reader>),
+    // Password
+    ChangePassword,
+    New(String),
+    Confirm(String),
+    Hint(String),
+    Reveal,
+    Save,
+    Saved(Result<(), String>),
+    Cancel,
+    // Fingerprint
+    SetUp,
+    Enroll(String, bool),
+    RemoveFingers,
+    Removed,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+enum Dialog {
+    Password { new: String, confirm: String, hint: String, reveal: bool, saving: bool, problem: Option<String> },
+    Fingerprint { stage: u32, message: String, done: bool },
+}
+
+#[derive(Default)]
+pub struct Page {
+    entity: page::Entity,
+    reader: Option<Reader>,
+    looked: bool,
+    dialog: Option<Dialog>,
+    changed: bool,
+}
+
+fn m(msg: Msg) -> PMsg {
+    PMsg::Lapin(SMsg::SignIn(msg))
+}
+
+fn login() -> String {
+    std::env::var("USER").ok().filter(|u| !u.is_empty()).unwrap_or_else(|| super::view::Account::default().name)
+}
+
+impl page::Page<PMsg> for Page {
+    fn set_id(&mut self, entity: page::Entity) {
+        self.entity = entity;
+    }
+    fn info(&self) -> page::Info {
+        page::Info::new("lapin-signin", "dialog-password-symbolic").title("Sign-in options").description("Fingerprint, password")
+    }
+    fn content(&self, sections: &mut SlotMap<section::Entity, Section<PMsg>>) -> Option<page::Content> {
+        Some(vec![sections.insert(Section::default().title("Ways to sign in").view::<Page>(|_, page, s| view(page, &s.title)))])
+    }
+    fn on_enter(&mut self) -> Task<PMsg> {
+        self.changed = false;
+        Task::future(async { m(Msg::Reader(reader().await)) })
+    }
+    fn dialog(&self) -> Option<Element<'_, PMsg>> {
+        match self.dialog.as_ref()? {
+            Dialog::Password { new, confirm, hint, reveal, saving, problem } => {
+                let mismatch = !new.is_empty() && !confirm.is_empty() && new != confirm;
+                let ok = !new.is_empty() && new == confirm && !saving;
+                let mut body = column::with_capacity(5)
+                    .spacing(12)
+                    .push(widget::secure_input("New password", new.as_str(), Some(m(Msg::Reveal)), !reveal).on_input(|v| m(Msg::New(v))))
+                    .push(widget::secure_input("Confirm password", confirm.as_str(), Some(m(Msg::Reveal)), !reveal).on_input(|v| m(Msg::Confirm(v))))
+                    .push(widget::text_input("Password hint", hint.as_str()).on_input(|v| m(Msg::Hint(v))));
+                if mismatch {
+                    body = body.push(text::caption("The passwords don't match.").class(cosmic::theme::Text::Accent));
+                }
+                if let Some(e) = problem {
+                    body = body.push(text::caption(e.clone()).class(cosmic::theme::Text::Accent));
+                }
+                Some(
+                    widget::dialog()
+                        .title("Change your password")
+                        .body("You'll be asked for your current password before the new one is saved.")
+                        .control(body)
+                        .primary_action(widget::button::suggested(if *saving { "Saving…" } else { "Save" }).on_press_maybe(ok.then(|| m(Msg::Save))))
+                        .secondary_action(widget::button::standard("Cancel").on_press(m(Msg::Cancel)))
+                        .into(),
+                )
+            }
+            Dialog::Fingerprint { stage, message, done } => {
+                let body = column::with_capacity(2)
+                    .spacing(12)
+                    .push(text::body(message.clone()))
+                    .push(widget::progress_bar::determinate_linear(if *done { 1.0 } else { (*stage as f32 / 10.0).min(0.95) }).girth(6).width(Length::Fill));
+                Some(
+                    widget::dialog()
+                        .title("Fingerprint setup")
+                        .control(body)
+                        .primary_action(widget::button::suggested(if *done { "Done" } else { "Cancel" }).on_press(m(Msg::Cancel)))
+                        .into(),
+                )
+            }
+        }
+    }
+}
+impl page::AutoBind<PMsg> for Page {}
+
+fn view<'a>(p: &'a Page, title: &'a str) -> Element<'a, PMsg> {
+    let finger: rows::Item<'a> = match &p.reader {
+        Some(r) if r.enrolled.is_empty() => rows::button("fingerprint-symbolic", "Fingerprint recognition", "Sign in with your fingerprint reader", "Set up", Some(m(Msg::SetUp))),
+        Some(r) => {
+            let n = r.enrolled.len();
+            let buttons = row::with_capacity(2)
+                .spacing(8)
+                .push(widget::button::standard("Add another finger").on_press(m(Msg::SetUp)))
+                .push(widget::button::standard("Remove").on_press(m(Msg::RemoveFingers)));
+            rows::with(
+                "fingerprint-symbolic",
+                "Fingerprint recognition",
+                if n == 1 { "You can sign in with 1 fingerprint".to_string() } else { format!("You can sign in with {n} fingerprints") },
+                buttons.into(),
+            )
+        }
+        None => rows::with(
+            "fingerprint-symbolic",
+            "Fingerprint recognition",
+            if p.looked { "This option is currently unavailable" } else { "Looking for a fingerprint reader…" },
+            widget::Space::new().width(0).into(),
+        ),
+    };
+    let password = rows::with(
+        "dialog-password-symbolic",
+        "Password",
+        if p.changed { "Your password was changed" } else { "Sign in with your account's password" },
+        row::with_capacity(2)
+            .spacing(12)
+            .align_y(Alignment::Center)
+            .push_maybe(p.changed.then(|| cosmic::widget::icon::from_name("object-select-symbolic").size(16).icon()))
+            .push(widget::button::standard("Change").on_press(m(Msg::ChangePassword)))
+            .into(),
+    );
+    column::with_capacity(1).width(Length::Fill).push(rows::section(title, vec![finger, password])).into()
+}
+
+pub fn update(pages: &mut Binder<PMsg>, msg: Msg) -> cosmic::app::Task<crate::Message> {
+    let Some(p) = pages.page_mut::<Page>() else { return Task::none() };
+    match msg {
+        Msg::Reader(r) => {
+            p.reader = r;
+            p.looked = true;
+        }
+        Msg::ChangePassword => {
+            p.dialog = Some(Dialog::Password { new: String::new(), confirm: String::new(), hint: String::new(), reveal: false, saving: false, problem: None })
+        }
+        Msg::New(v) => {
+            if let Some(Dialog::Password { new, problem, .. }) = &mut p.dialog {
+                *new = v;
+                *problem = None;
+            }
+        }
+        Msg::Confirm(v) => {
+            if let Some(Dialog::Password { confirm, problem, .. }) = &mut p.dialog {
+                *confirm = v;
+                *problem = None;
+            }
+        }
+        Msg::Hint(v) => {
+            if let Some(Dialog::Password { hint, .. }) = &mut p.dialog {
+                *hint = v;
+            }
+        }
+        Msg::Reveal => {
+            if let Some(Dialog::Password { reveal, .. }) = &mut p.dialog {
+                *reveal = !*reveal;
+            }
+        }
+        Msg::Save => {
+            if let Some(Dialog::Password { new, hint, saving, .. }) = &mut p.dialog {
+                *saving = true;
+                let (new, hint) = (new.clone(), hint.clone());
+                return cosmic::task::future(async move {
+                    let r = set_password(&new, &hint).await;
+                    crate::Message::PageMessage(m(Msg::Saved(r)))
+                });
+            }
+        }
+        Msg::Saved(Ok(())) => {
+            p.dialog = None;
+            p.changed = true;
+        }
+        Msg::Saved(Err(e)) => {
+            if let Some(Dialog::Password { saving, problem, .. }) = &mut p.dialog {
+                *saving = false;
+                *problem = Some(e);
+            }
+        }
+        Msg::Cancel => {
+            p.dialog = None;
+            return cosmic::task::future(async { crate::Message::PageMessage(m(Msg::Reader(reader().await))) });
+        }
+        Msg::SetUp => {
+            let Some(r) = p.reader.clone() else { return Task::none() };
+            p.dialog = Some(Dialog::Fingerprint { stage: 0, message: "Touch the fingerprint reader with the finger you want to use.".into(), done: false });
+            return enroll(r);
+        }
+        Msg::Enroll(status, done) => {
+            if let Some(Dialog::Fingerprint { stage, message, done: d }) = &mut p.dialog {
+                *message = enroll_text(&status).to_string();
+                if status == "enroll-stage-passed" {
+                    *stage += 1;
+                }
+                *d = done && status == "enroll-completed";
+                if done && status != "enroll-completed" {
+                    *message = format!("{} Select Cancel and try again.", enroll_text(&status));
+                }
+            }
+        }
+        Msg::RemoveFingers => {
+            let Some(r) = p.reader.clone() else { return Task::none() };
+            return cosmic::task::future(async move {
+                let _ = remove_fingers(&r).await;
+                crate::Message::PageMessage(m(Msg::Removed))
+            });
+        }
+        Msg::Removed => return cosmic::task::future(async { crate::Message::PageMessage(m(Msg::Reader(reader().await))) }),
+    }
+    Task::none()
+}
+
+fn enroll_text(status: &str) -> &'static str {
+    match status {
+        "enroll-stage-passed" => "Lift your finger, then touch the reader again.",
+        "enroll-completed" => "All set! You can now use your fingerprint to sign in.",
+        "enroll-retry-scan" => "Try again.",
+        "enroll-swipe-too-short" => "That was too short. Try again.",
+        "enroll-finger-not-centered" => "Center your finger on the reader and try again.",
+        "enroll-remove-and-retry" => "Lift your finger and try again.",
+        "enroll-data-full" => "The reader can't store more fingerprints.",
+        "enroll-duplicate" => "That fingerprint is already set up.",
+        _ => "The fingerprint couldn't be read.",
+    }
+}
+
+/// The default fingerprint reader and the fingers already set up.
+async fn reader() -> Option<Reader> {
+    let conn = zbus::Connection::system().await.ok()?;
+    let reply = conn
+        .call_method(Some(FPRINT), "/net/reactivated/Fprint/Manager", Some("net.reactivated.Fprint.Manager"), "GetDefaultDevice", &())
+        .await
+        .ok()?;
+    let device: zbus::zvariant::OwnedObjectPath = reply.body().deserialize().ok()?;
+    let proxy = zbus::Proxy::new(&conn, FPRINT, device.clone(), "net.reactivated.Fprint.Device").await.ok()?;
+    let name: String = proxy.get_property("name").await.unwrap_or_default();
+    let enrolled: Vec<String> = proxy.call("ListEnrolledFingers", &(login(),)).await.unwrap_or_default();
+    Some(Reader { device: device.to_string(), name, enrolled })
+}
+
+/// Which finger to set up next: Windows doesn't ask, so the first unused.
+fn next_finger(enrolled: &[String]) -> &'static str {
+    const FINGERS: [&str; 10] = [
+        "right-index-finger", "left-index-finger", "right-thumb", "left-thumb", "right-middle-finger",
+        "left-middle-finger", "right-ring-finger", "left-ring-finger", "right-little-finger", "left-little-finger",
+    ];
+    FINGERS.into_iter().find(|f| !enrolled.iter().any(|e| e == f)).unwrap_or(FINGERS[0])
+}
+
+fn enroll(r: Reader) -> cosmic::app::Task<crate::Message> {
+    let s = cosmic::iced::stream::channel(16, move |mut out: futures::channel::mpsc::Sender<PMsg>| async move {
+        use futures::SinkExt;
+        let fail = |e: &str| (e.to_string(), true);
+        let result: Result<(), (String, bool)> = async {
+            let conn = zbus::Connection::system().await.map_err(|_| fail("enroll-failed"))?;
+            let proxy = zbus::Proxy::new(&conn, FPRINT, r.device.as_str(), "net.reactivated.Fprint.Device").await.map_err(|_| fail("enroll-failed"))?;
+            let mut signals = proxy.receive_signal("EnrollStatus").await.map_err(|_| fail("enroll-failed"))?;
+            proxy.call_method("Claim", &(login(),)).await.map_err(|_| fail("enroll-failed"))?;
+            let started = proxy.call_method("EnrollStart", &(next_finger(&r.enrolled),)).await;
+            if started.is_err() {
+                let _ = proxy.call_method("Release", &()).await;
+                return Err(fail("enroll-failed"));
+            }
+            while let Some(sig) = signals.next().await {
+                let Ok((status, done)) = sig.body().deserialize::<(String, bool)>() else { continue };
+                let _ = out.send(m(Msg::Enroll(status, done))).await;
+                if done {
+                    break;
+                }
+            }
+            let _ = proxy.call_method("EnrollStop", &()).await;
+            let _ = proxy.call_method("Release", &()).await;
+            Ok(())
+        }
+        .await;
+        if let Err((status, done)) = result {
+            let _ = out.send(m(Msg::Enroll(status, done))).await;
+        }
+    });
+    Task::run(s, |msg| cosmic::Action::App(crate::Message::PageMessage(msg)))
+}
+
+async fn remove_fingers(r: &Reader) -> Result<(), zbus::Error> {
+    let conn = zbus::Connection::system().await?;
+    let proxy = zbus::Proxy::new(&conn, FPRINT, r.device.as_str(), "net.reactivated.Fprint.Device").await?;
+    proxy.call_method("Claim", &(login(),)).await?;
+    let r = proxy.call_method("DeleteEnrolledFingers2", &()).await;
+    let _ = proxy.call_method("Release", &()).await;
+    r.map(drop)
+}
+
+async fn set_password(new: &str, hint: &str) -> Result<(), String> {
+    let conn = zbus::Connection::system().await.map_err(|e| e.to_string())?;
+    let user: zbus::zvariant::OwnedObjectPath = conn
+        .call_method(Some("org.freedesktop.Accounts"), "/org/freedesktop/Accounts", Some("org.freedesktop.Accounts"), "FindUserByName", &(login(),))
+        .await
+        .map_err(|e| e.to_string())?
+        .body()
+        .deserialize()
+        .map_err(|e| e.to_string())?;
+    let hashed = crate::pages::system::users::hash_password(new);
+    conn.call_method(Some("org.freedesktop.Accounts"), user.as_str(), Some("org.freedesktop.Accounts.User"), "SetPassword", &(hashed, hint))
+        .await
+        .map(drop)
+        .map_err(|e| match &e {
+            zbus::Error::MethodError(name, _, _) if name.as_str().ends_with("PermissionDenied") => "Your password wasn't changed.".into(),
+            _ => "Your password couldn't be changed.".to_string(),
+        })
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn fingers() {
+        assert_eq!(super::next_finger(&[]), "right-index-finger");
+        assert_eq!(super::next_finger(&["right-index-finger".into()]), "left-index-finger");
+    }
+}
diff --git a/cosmic-settings/src/lapin/storage.rs b/cosmic-settings/src/lapin/storage.rs
new file mode 100644
index 0000000..de36210
--- /dev/null
+++ b/cosmic-settings/src/lapin/storage.rs
@@ -0,0 +1,433 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! System > Storage, as on Windows: the disk's used and free space, then
+//! what is using it (apps, temporary files, documents, pictures…), each
+//! with a bar. Temporary files opens a page to clean them up.
+
+use std::path::PathBuf;
+
+use cosmic::iced::{Alignment, Length};
+use cosmic::widget::{self, column, icon, row, text};
+use cosmic::{Apply, Element, Task};
+use cosmic_settings_page::{self as page, Binder, Section, section};
+use slotmap::SlotMap;
+
+use super::rows::{self, PMsg};
+use super::settings::Msg as SMsg;
+use super::style;
+
+#[derive(Clone, Debug, Default)]
+pub struct Usage {
+    pub total: u64,
+    pub used: u64,
+    pub free: u64,
+    /// (name, icon, bytes, what clicking opens)
+    pub categories: Vec<Category>,
+}
+
+#[derive(Clone, Debug)]
+pub struct Category {
+    pub name: &'static str,
+    pub icon: &'static str,
+    pub bytes: u64,
+    pub open: Open,
+}
+
+#[derive(Clone, Debug)]
+pub enum Open {
+    Folder(PathBuf),
+    Page(&'static str),
+    Nothing,
+}
+
+/// The temporary files Windows offers to remove, Linux's version of each.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Temp {
+    RecycleBin,
+    Thumbnails,
+    AppCache,
+    PackageCache,
+    Downloads,
+}
+
+impl Temp {
+    pub const ALL: [Temp; 5] = [Temp::PackageCache, Temp::RecycleBin, Temp::Thumbnails, Temp::AppCache, Temp::Downloads];
+    fn title(self) -> &'static str {
+        match self {
+            Temp::RecycleBin => "Recycle Bin",
+            Temp::Thumbnails => "Thumbnails",
+            Temp::AppCache => "Temporary app files",
+            Temp::PackageCache => "Update cleanup",
+            Temp::Downloads => "Downloads",
+        }
+    }
+    fn description(self) -> &'static str {
+        match self {
+            Temp::RecycleBin => "The Recycle Bin holds files you've deleted. They're removed for good when you empty it.",
+            Temp::Thumbnails => "Small pictures of your files that are made again when they're needed.",
+            Temp::AppCache => "Files apps keep to start and load faster. Apps make them again as needed.",
+            Temp::PackageCache => "Downloaded copies of system updates that are already installed. You'll be asked for your password.",
+            Temp::Downloads => "Everything in your Downloads folder. Make sure you don't need these files first.",
+        }
+    }
+    /// Checked when the page opens, as on Windows (Downloads isn't).
+    fn default_on(self) -> bool {
+        !matches!(self, Temp::Downloads)
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum Msg {
+    Measured(Usage),
+    Temps(Vec<(Temp, u64)>),
+    Check(Temp, bool),
+    Remove,
+    Removed(Result<(), String>),
+    Open(Open),
+}
+
+#[derive(Default)]
+pub struct Page {
+    entity: page::Entity,
+    usage: Option<Usage>,
+}
+
+#[derive(Default)]
+pub struct TempPage {
+    entity: page::Entity,
+    sizes: Option<Vec<(Temp, u64)>>,
+    checked: Vec<Temp>,
+    removing: bool,
+    problem: Option<String>,
+}
+
+fn m(msg: Msg) -> PMsg {
+    PMsg::Lapin(SMsg::Storage(msg))
+}
+
+impl page::Page<PMsg> for Page {
+    fn set_id(&mut self, entity: page::Entity) {
+        self.entity = entity;
+    }
+    fn info(&self) -> page::Info {
+        page::Info::new("lapin-storage", "drive-harddisk-symbolic").title("Storage").description("Storage space, drives, cleanup")
+    }
+    fn content(&self, sections: &mut SlotMap<section::Entity, Section<PMsg>>) -> Option<page::Content> {
+        Some(vec![sections.insert(Section::default().view::<Page>(|binder, page, _| view(binder, page)))])
+    }
+    fn on_enter(&mut self) -> Task<PMsg> {
+        Task::future(async { m(Msg::Measured(measure().await)) })
+    }
+}
+impl page::AutoBind<PMsg> for Page {}
+
+impl page::Page<PMsg> for TempPage {
+    fn set_id(&mut self, entity: page::Entity) {
+        self.entity = entity;
+    }
+    fn info(&self) -> page::Info {
+        page::Info::new("lapin-storage-temp", "user-trash-symbolic").title("Temporary files").description("Files you can remove to free up space")
+    }
+    fn content(&self, sections: &mut SlotMap<section::Entity, Section<PMsg>>) -> Option<page::Content> {
+        Some(vec![sections.insert(Section::default().view::<TempPage>(|_, page, _| temp_view(page)))])
+    }
+    fn on_enter(&mut self) -> Task<PMsg> {
+        self.sizes = None;
+        self.problem = None;
+        self.checked = Temp::ALL.iter().copied().filter(|t| t.default_on()).collect();
+        Task::future(async { m(Msg::Temps(temp_sizes().await)) })
+    }
+}
+impl page::AutoBind<PMsg> for TempPage {}
+
+pub fn update(pages: &mut Binder<PMsg>, msg: Msg) -> cosmic::app::Task<crate::Message> {
+    match msg {
+        Msg::Measured(u) => {
+            if let Some(p) = pages.page_mut::<Page>() {
+                p.usage = Some(u);
+            }
+        }
+        Msg::Temps(t) => {
+            if let Some(p) = pages.page_mut::<TempPage>() {
+                p.sizes = Some(t);
+                p.removing = false;
+            }
+        }
+        Msg::Check(t, on) => {
+            if let Some(p) = pages.page_mut::<TempPage>() {
+                p.checked.retain(|c| *c != t);
+                if on {
+                    p.checked.push(t);
+                }
+            }
+        }
+        Msg::Remove => {
+            let Some(p) = pages.page_mut::<TempPage>() else { return Task::none() };
+            p.removing = true;
+            p.problem = None;
+            let which = p.checked.clone();
+            return cosmic::task::future(async move {
+                let r = remove(&which).await;
+                crate::Message::PageMessage(m(Msg::Removed(r)))
+            });
+        }
+        Msg::Removed(r) => {
+            if let Some(p) = pages.page_mut::<TempPage>() {
+                p.problem = r.err();
+            }
+            return cosmic::task::future(async { crate::Message::PageMessage(m(Msg::Temps(temp_sizes().await))) });
+        }
+        Msg::Open(Open::Folder(path)) => {
+            let _ = std::process::Command::new("xdg-open").arg(path).spawn();
+        }
+        Msg::Open(Open::Page(id)) => {
+            if let Some((e, _)) = pages.find_page_by_id(id) {
+                return cosmic::task::message(crate::Message::Page(e));
+            }
+        }
+        Msg::Open(Open::Nothing) => {}
+    }
+    Task::none()
+}
+
+fn bar<'a>(fraction: f32, height: f32) -> Element<'a, PMsg> {
+    widget::progress_bar::determinate_linear(fraction.clamp(0.0, 1.0)).girth(height).width(Length::Fill).into()
+}
+
+fn view<'a>(_binder: &'a Binder<PMsg>, p: &'a Page) -> Element<'a, PMsg> {
+    let Some(u) = &p.usage else {
+        return column::with_capacity(2)
+            .spacing(12)
+            .push(text::body("Looking at what's using space…").class(style::quiet()))
+            .push(widget::progress_bar::indeterminate_linear().girth(4).width(Length::Fill))
+            .into();
+    };
+    let used_frac = if u.total > 0 { u.used as f32 / u.total as f32 } else { 0.0 };
+    let disk = column::with_capacity(3)
+        .spacing(8)
+        .push(
+            row::with_capacity(3)
+                .align_y(Alignment::Center)
+                .push(text::title4("Local Disk (/)").width(Length::Fill))
+                .push(text::body(format!("{} used", rows::size(u.used)))),
+        )
+        .push(bar(used_frac, 8.0))
+        .push(text::caption(format!("{} free of {}", rows::size(u.free), rows::size(u.total))).class(style::quiet()));
+    let disk = widget::container(disk).padding([16, 16]).width(Length::Fill).class(style::card());
+
+    let biggest = u.categories.iter().map(|c| c.bytes).max().unwrap_or(1).max(1);
+    let cats: Vec<rows::Item<'a>> = u
+        .categories
+        .iter()
+        .map(|c| {
+            let line = row::with_capacity(4)
+                .spacing(16)
+                .align_y(Alignment::Center)
+                .push(icon::from_name(c.icon).size(20).icon())
+                .push(
+                    column::with_capacity(2)
+                        .spacing(6)
+                        .push(
+                            row::with_capacity(2)
+                                .push(text::body(c.name).width(Length::Fill))
+                                .push(text::body(rows::size(c.bytes))),
+                        )
+                        .push(bar(c.bytes as f32 / u.used.max(biggest) as f32, 4.0))
+                        .width(Length::Fill),
+                )
+                .push(icon::from_name("go-next-symbolic").size(16).icon());
+            let msg = match &c.open {
+                Open::Nothing => None,
+                o => Some(m(Msg::Open(o.clone()))),
+            };
+            use cosmic::widget::list_column::IntoListItem;
+            widget::settings::item_row(vec![line.into()]).apply(widget::list::button).on_press_maybe(msg).into_list_item()
+        })
+        .collect();
+    column::with_capacity(3)
+        .spacing(24)
+        .push(disk)
+        .push(rows::section("", cats))
+        .into()
+}
+
+fn temp_view(p: &TempPage) -> Element<'_, PMsg> {
+    let Some(sizes) = &p.sizes else {
+        return column::with_capacity(2)
+            .spacing(12)
+            .push(text::body("Scanning…").class(style::quiet()))
+            .push(widget::progress_bar::indeterminate_linear().girth(4).width(Length::Fill))
+            .into();
+    };
+    let selected: u64 = sizes.iter().filter(|(t, _)| p.checked.contains(t)).map(|(_, s)| *s).sum();
+    let top = row::with_capacity(3)
+        .spacing(16)
+        .align_y(Alignment::Center)
+        .push(
+            column::with_capacity(2)
+                .spacing(2)
+                .push(text::body(format!("Total selected: {}", rows::size(selected))))
+                .push(text::caption("Files you can remove to free up space").class(style::quiet()))
+                .width(Length::Fill),
+        )
+        .push(
+            widget::button::suggested(if p.removing { "Removing…" } else { "Remove files" })
+                .on_press_maybe((!p.removing && selected > 0).then(|| m(Msg::Remove))),
+        );
+    let items: Vec<rows::Item<'_>> = sizes
+        .iter()
+        .map(|(t, s)| {
+            let t = *t;
+            let line = row::with_capacity(3)
+                .spacing(16)
+                .align_y(Alignment::Start)
+                .push(widget::checkbox(p.checked.contains(&t)).on_toggle(move |on| m(Msg::Check(t, on))))
+                .push(rows::words(t.title(), t.description()))
+                .push(text::body(rows::size(*s)));
+            use cosmic::widget::list_column::IntoListItem;
+            Element::from(line).into_list_item()
+        })
+        .collect();
+    let mut c = column::with_capacity(3).spacing(16).push(top);
+    if let Some(e) = &p.problem {
+        c = c.push(text::body(format!("Some files couldn't be removed: {e}")).class(cosmic::theme::Text::Accent));
+    }
+    c.push(rows::section("", items)).into()
+}
+
+/// Bytes used by a folder (0 if it's missing).
+async fn du(path: &std::path::Path) -> u64 {
+    if !path.exists() {
+        return 0;
+    }
+    tokio::process::Command::new("du")
+        .args(["-sb", "--one-file-system"])
+        .arg(path)
+        .output()
+        .await
+        .ok()
+        .and_then(|o| String::from_utf8_lossy(&o.stdout).split_whitespace().next().and_then(|n| n.parse().ok()))
+        .unwrap_or(0)
+}
+
+fn user_dir(kind: fn() -> Option<PathBuf>, fallback: &str) -> PathBuf {
+    kind().unwrap_or_else(|| dirs::home_dir().unwrap_or_default().join(fallback))
+}
+
+async fn measure() -> Usage {
+    let home = dirs::home_dir().unwrap_or_default();
+    let (mut total, mut used, mut free) = (0, 0, 0);
+    if let Ok(out) = rows::output("df", &["-B1", "--output=size,used,avail", "/"]).await
+        && let Some(line) = out.lines().nth(1)
+    {
+        let v: Vec<u64> = line.split_whitespace().filter_map(|n| n.parse().ok()).collect();
+        if v.len() == 3 {
+            (total, used, free) = (v[0], v[1], v[2]);
+        }
+    }
+    let apps = du(std::path::Path::new("/usr")).await
+        + du(std::path::Path::new("/opt")).await
+        + du(std::path::Path::new("/var/lib/flatpak")).await
+        + du(&home.join(".local/share/flatpak")).await;
+    let temp = temp_sizes().await.iter().filter(|(t, _)| *t != Temp::Downloads).map(|(_, s)| *s).sum::<u64>();
+    let mut cats = vec![
+        Category { name: "Installed apps", icon: "view-app-grid-symbolic", bytes: apps, open: Open::Page("lapin-installed-apps") },
+        Category { name: "Temporary files", icon: "user-trash-symbolic", bytes: temp, open: Open::Page("lapin-storage-temp") },
+    ];
+    for (name, ic, dir) in [
+        ("Documents", "folder-documents-symbolic", user_dir(dirs::document_dir, "Documents")),
+        ("Pictures", "folder-pictures-symbolic", user_dir(dirs::picture_dir, "Pictures")),
+        ("Videos", "folder-videos-symbolic", user_dir(dirs::video_dir, "Videos")),
+        ("Music", "folder-music-symbolic", user_dir(dirs::audio_dir, "Music")),
+        ("Downloads", "folder-download-symbolic", user_dir(dirs::download_dir, "Downloads")),
+        ("Desktop", "user-desktop-symbolic", user_dir(dirs::desktop_dir, "Desktop")),
+    ] {
+        let bytes = du(&dir).await;
+        cats.push(Category { name, icon: ic, bytes, open: Open::Folder(dir) });
+    }
+    let counted: u64 = cats.iter().map(|c| c.bytes).sum();
+    cats.push(Category { name: "System & other", icon: "drive-harddisk-system-symbolic", bytes: used.saturating_sub(counted), open: Open::Nothing });
+    cats.sort_by(|a, b| b.bytes.cmp(&a.bytes));
+    Usage { total, used, free, categories: cats }
+}
+
+fn temp_path(t: Temp) -> Vec<PathBuf> {
+    let home = dirs::home_dir().unwrap_or_default();
+    let cache = dirs::cache_dir().unwrap_or_else(|| home.join(".cache"));
+    let data = dirs::data_dir().unwrap_or_else(|| home.join(".local/share"));
+    match t {
+        Temp::RecycleBin => vec![data.join("Trash/files"), data.join("Trash/info")],
+        Temp::Thumbnails => vec![cache.join("thumbnails")],
+        Temp::AppCache => vec![cache],
+        Temp::PackageCache => vec![PathBuf::from("/var/cache/pacman/pkg")],
+        Temp::Downloads => vec![user_dir(dirs::download_dir, "Downloads")],
+    }
+}
+
+async fn temp_sizes() -> Vec<(Temp, u64)> {
+    let mut out = Vec::new();
+    for t in Temp::ALL {
+        let mut s = 0;
+        for p in temp_path(t) {
+            s += du(&p).await;
+        }
+        // App files are counted without the thumbnails, which have their own row.
+        if t == Temp::AppCache {
+            for p in temp_path(Temp::Thumbnails) {
+                s = s.saturating_sub(du(&p).await);
+            }
+        }
+        out.push((t, s));
+    }
+    out
+}
+
+/// Empties a folder without removing the folder itself.
+async fn empty(dir: &std::path::Path, keep: &[&str]) -> Result<(), String> {
+    let Ok(mut rd) = tokio::fs::read_dir(dir).await else { return Ok(()) };
+    let mut problem = None;
+    while let Ok(Some(e)) = rd.next_entry().await {
+        if keep.iter().any(|k| e.file_name() == *k) {
+            continue;
+        }
+        let p = e.path();
+        let r = if e.file_type().await.is_ok_and(|t| t.is_dir()) { tokio::fs::remove_dir_all(&p).await } else { tokio::fs::remove_file(&p).await };
+        if let Err(err) = r {
+            problem = Some(format!("{}: {err}", p.display()));
+        }
+    }
+    problem.map_or(Ok(()), Err)
+}
+
+async fn remove(which: &[Temp]) -> Result<(), String> {
+    let mut problem = None;
+    for t in which {
+        let r = match t {
+            // Old package files need the admin prompt; paccache (pacman-contrib,
+            // which Update already uses) keeps nothing that's installed.
+            Temp::PackageCache => rows::output("pkexec", &["paccache", "-rk0"]).await.map(drop),
+            Temp::AppCache => {
+                let mut r = Ok(());
+                for p in temp_path(*t) {
+                    // Thumbnails are their own choice.
+                    if let Err(e) = empty(&p, &["thumbnails"]).await {
+                        r = Err(e);
+                    }
+                }
+                r
+            }
+            _ => {
+                let mut r = Ok(());
+                for p in temp_path(*t) {
+                    if let Err(e) = empty(&p, &[]).await {
+                        r = Err(e);
+                    }
+                }
+                r
+            }
+        };
+        if let Err(e) = r {
+            problem = Some(e);
+        }
+    }
+    problem.map_or(Ok(()), Err)
+}
