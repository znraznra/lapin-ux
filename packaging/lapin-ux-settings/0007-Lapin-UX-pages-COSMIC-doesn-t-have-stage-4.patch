--- /dev/null
+++ b/cosmic-settings/src/lapin/privacy.rs
@@ -0,0 +1,408 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Privacy & security, as on Windows: Security (device encryption), the
+//! desktop's own permissions (recent activity), and App permissions —
+//! Location, Camera, Microphone, Screenshots and Background apps — with a
+//! switch for each app that has asked. App permissions are the ones apps
+//! ask for through the desktop portal (Flatpak apps), kept in the portal's
+//! permission store; apps installed as Arch packages aren't sandboxed and
+//! don't ask.
+
+use std::collections::HashMap;
+
+use cosmic::iced::{Alignment, Length};
+use cosmic::widget::{self, column, icon, row, text};
+use cosmic::{Element, Task};
+use cosmic_settings_page::{self as page, Binder, Section, section};
+use slotmap::SlotMap;
+
+use super::rows::{self, PMsg};
+use super::settings::Msg as SMsg;
+use super::style;
+
+/// One kind of app permission and where the portal keeps it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Perm {
+    Location,
+    Camera,
+    Microphone,
+    Screenshot,
+    Background,
+}
+
+impl Perm {
+    pub const ALL: [Perm; 5] = [Perm::Location, Perm::Camera, Perm::Microphone, Perm::Screenshot, Perm::Background];
+    pub fn id(self) -> &'static str {
+        match self {
+            Perm::Location => "lapin-privacy-location",
+            Perm::Camera => "lapin-privacy-camera",
+            Perm::Microphone => "lapin-privacy-microphone",
+            Perm::Screenshot => "lapin-privacy-screenshots",
+            Perm::Background => "lapin-privacy-background",
+        }
+    }
+    pub fn title(self) -> &'static str {
+        match self {
+            Perm::Location => "Location",
+            Perm::Camera => "Camera",
+            Perm::Microphone => "Microphone",
+            Perm::Screenshot => "Screenshots and screen recording",
+            Perm::Background => "Background apps",
+        }
+    }
+    fn icon(self) -> &'static str {
+        match self {
+            Perm::Location => "find-location-symbolic",
+            Perm::Camera => "camera-web-symbolic",
+            Perm::Microphone => "audio-input-microphone-symbolic",
+            Perm::Screenshot => "applets-screenshooter-symbolic",
+            Perm::Background => "preferences-system-windows-symbolic",
+        }
+    }
+    fn heading(self) -> &'static str {
+        match self {
+            Perm::Location => "Let apps access your location",
+            Perm::Camera => "Let apps access your camera",
+            Perm::Microphone => "Let apps access your microphone",
+            Perm::Screenshot => "Let apps take screenshots of your screen",
+            Perm::Background => "Let apps keep running in the background",
+        }
+    }
+    /// The permission store's table and entry.
+    fn store(self) -> (&'static str, &'static str) {
+        match self {
+            Perm::Location => ("location", "location"),
+            Perm::Camera => ("devices", "camera"),
+            Perm::Microphone => ("devices", "microphone"),
+            Perm::Screenshot => ("screenshot", "screenshot"),
+            Perm::Background => ("background", "background"),
+        }
+    }
+    fn allowed(self, values: &[String]) -> bool {
+        match self {
+            // Location keeps an accuracy level ("NONE" = no access).
+            Perm::Location => values.first().is_some_and(|v| v != "NONE"),
+            _ => values.first().is_some_and(|v| v == "yes"),
+        }
+    }
+    fn values(self, on: bool) -> Vec<String> {
+        match self {
+            Perm::Location => {
+                let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0);
+                vec![if on { "EXACT" } else { "NONE" }.into(), now.to_string()]
+            }
+            _ => vec![if on { "yes" } else { "no" }.into()],
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum Msg {
+    Loaded(Perm, Vec<(String, bool)>),
+    Set(Perm, String, bool),
+    Encryption(Option<bool>),
+    ClearActivity,
+    Cleared,
+}
+
+/// Apps that asked for one permission, and whether each is allowed.
+#[derive(Default)]
+struct Apps(Vec<(String, bool)>);
+
+macro_rules! perm_page {
+    ($name:ident, $perm:expr) => {
+        #[derive(Default)]
+        pub struct $name {
+            entity: page::Entity,
+            apps: Option<Apps>,
+        }
+        impl page::Page<PMsg> for $name {
+            fn set_id(&mut self, entity: page::Entity) {
+                self.entity = entity;
+            }
+            fn info(&self) -> page::Info {
+                page::Info::new($perm.id(), $perm.icon()).title($perm.title())
+            }
+            fn content(&self, sections: &mut SlotMap<section::Entity, Section<PMsg>>) -> Option<page::Content> {
+                Some(vec![sections.insert(Section::default().view::<$name>(|_, page, _| perm_view($perm, page.apps.as_ref())))])
+            }
+            fn on_enter(&mut self) -> Task<PMsg> {
+                Task::future(async { m(Msg::Loaded($perm, lookup($perm).await)) })
+            }
+        }
+        impl page::AutoBind<PMsg> for $name {}
+    };
+}
+
+perm_page!(LocationPage, Perm::Location);
+perm_page!(CameraPage, Perm::Camera);
+perm_page!(MicrophonePage, Perm::Microphone);
+perm_page!(ScreenshotPage, Perm::Screenshot);
+perm_page!(BackgroundPage, Perm::Background);
+
+/// Privacy & security itself (the sidebar entry).
+#[derive(Default)]
+pub struct Page {
+    entity: page::Entity,
+    encrypted: Option<bool>,
+}
+
+/// Privacy & security > Recent activity.
+#[derive(Default)]
+pub struct ActivityPage {
+    entity: page::Entity,
+    cleared: bool,
+}
+
+fn m(msg: Msg) -> PMsg {
+    PMsg::Lapin(SMsg::Privacy(msg))
+}
+
+impl page::Page<PMsg> for Page {
+    fn set_id(&mut self, entity: page::Entity) {
+        self.entity = entity;
+    }
+    fn info(&self) -> page::Info {
+        page::Info::new(super::categories::PRIVACY_ID, "firewall").title("Privacy & security").description("Security and app permissions")
+    }
+    fn content(&self, sections: &mut SlotMap<section::Entity, Section<PMsg>>) -> Option<page::Content> {
+        Some(vec![
+            sections.insert(Section::default().title("Security").view::<Page>(|_, page, s| security(page, &s.title))),
+            sections.insert(Section::default().title("Lapin UX permissions").view::<Page>(|binder, _, s| {
+                let open = |id: &str| binder.find_page_by_id(id).map(|(e, _)| PMsg::Page(e));
+                rows::section(
+                    &s.title,
+                    vec![rows::nav("document-open-recent-symbolic", "Recent activity", "Recently opened files in Start and jump lists", open("lapin-privacy-activity"))],
+                )
+            })),
+            sections.insert(Section::default().title("App permissions").view::<Page>(|binder, _, s| {
+                let open = |id: &str| binder.find_page_by_id(id).map(|(e, _)| PMsg::Page(e));
+                let mut list: Vec<rows::Item<'_>> = Perm::ALL.iter().map(|p| rows::nav(p.icon(), p.title(), "", open(p.id()))).collect();
+                list.push(rows::nav("preferences-system-notifications-symbolic", "Notifications", "", open("lapin-notifications")));
+                rows::section(&s.title, list)
+            })),
+        ])
+    }
+    fn on_enter(&mut self) -> Task<PMsg> {
+        Task::future(async { m(Msg::Encryption(root_encrypted().await)) })
+    }
+}
+impl page::AutoBind<PMsg> for Page {}
+
+impl page::Page<PMsg> for ActivityPage {
+    fn set_id(&mut self, entity: page::Entity) {
+        self.entity = entity;
+    }
+    fn info(&self) -> page::Info {
+        page::Info::new("lapin-privacy-activity", "document-open-recent-symbolic").title("Recent activity")
+    }
+    fn content(&self, sections: &mut SlotMap<section::Entity, Section<PMsg>>) -> Option<page::Content> {
+        Some(vec![sections.insert(Section::default().view::<ActivityPage>(|binder, page, _| activity(binder, page)))])
+    }
+    fn on_enter(&mut self) -> Task<PMsg> {
+        self.cleared = false;
+        Task::none()
+    }
+}
+impl page::AutoBind<PMsg> for ActivityPage {}
+
+fn security<'a>(p: &'a Page, title: &'a str) -> Element<'a, PMsg> {
+    let (status, desc) = match p.encrypted {
+        Some(true) => ("On", "Your files are protected by encrypting the disk Lapin UX runs from"),
+        Some(false) => ("Off", "The disk Lapin UX runs from isn't encrypted. Encryption is chosen when Linux is installed"),
+        None => ("", "Checking…"),
+    };
+    rows::section(
+        title,
+        vec![rows::with("security-high-symbolic", "Device encryption", desc, text::body(status).class(style::quiet()).into())],
+    )
+}
+
+fn activity<'a>(binder: &'a Binder<PMsg>, p: &'a ActivityPage) -> Element<'a, PMsg> {
+    let on = binder.resource::<super::settings::Prefs>().is_none_or(|s| s.recent_items);
+    let clear = row::with_capacity(2)
+        .spacing(12)
+        .align_y(Alignment::Center)
+        .push_maybe(p.cleared.then(|| icon::from_name("object-select-symbolic").size(16).icon()))
+        .push(widget::button::standard("Clear history").on_press(m(Msg::ClearActivity)));
+    rows::section(
+        "",
+        vec![
+            rows::switch(
+                "document-open-recent-symbolic",
+                "Store my recent files on this device",
+                "Show recently opened files in Start and in apps' jump lists",
+                on,
+                |v| PMsg::Lapin(SMsg::RecentItems(v)),
+            ),
+            rows::with("edit-clear-history-symbolic", "Clear activity history", "Forget the list of files you opened recently", clear.into()),
+        ],
+    )
+}
+
+fn perm_view(perm: Perm, apps: Option<&Apps>) -> Element<'static, PMsg> {
+    let rows_: Vec<rows::Item<'static>> = match apps {
+        None => vec![rows::note("Looking for apps…")],
+        Some(a) if a.0.is_empty() => vec![rows::note(format!(
+            "No apps have asked for this yet. Apps installed from Flatpak ask the first time they need it; other apps don't need to ask."
+        ))],
+        Some(a) => a
+            .0
+            .iter()
+            .map(|(app, on)| {
+                let (name, ic) = app_name(app);
+                let app = app.clone();
+                let on = *on;
+                let t = row::with_capacity(2)
+                    .spacing(12)
+                    .align_y(Alignment::Center)
+                    .push(text::body(if on { "On" } else { "Off" }))
+                    .push(widget::toggler(on).on_toggle(move |v| m(Msg::Set(perm, app.clone(), v))));
+                let line = row::with_capacity(3)
+                    .spacing(16)
+                    .align_y(Alignment::Center)
+                    .push(icon::from_name(ic).fallback(Some(icon::IconFallback::Names(vec!["application-x-executable".into()]))).size(24))
+                    .push(text::body(name).width(Length::Fill))
+                    .push(t);
+                use cosmic::widget::list_column::IntoListItem;
+                Element::from(line).into_list_item()
+            })
+            .collect(),
+    };
+    column::with_capacity(1).push(rows::section(perm.heading(), rows_)).into()
+}
+
+/// An app's name and icon from its launcher (Flatpak ids are launcher names).
+pub(crate) fn app_name(id: &str) -> (String, String) {
+    static CACHE: std::sync::LazyLock<std::sync::Mutex<HashMap<String, (String, String)>>> = std::sync::LazyLock::new(Default::default);
+    if let Some(v) = CACHE.lock().ok().and_then(|c| c.get(id).cloned()) {
+        return v;
+    }
+    let locales = freedesktop_desktop_entry::get_languages_from_env();
+    let found = freedesktop_desktop_entry::Iter::new(freedesktop_desktop_entry::default_paths())
+        .find(|p| p.file_stem().is_some_and(|s| s == id))
+        .and_then(|p| freedesktop_desktop_entry::DesktopEntry::from_path(p, Some(&locales)).ok())
+        .map(|e| (e.name(&locales).map(|n| n.into_owned()).unwrap_or_else(|| id.to_string()), e.icon().unwrap_or(id).to_string()))
+        .unwrap_or_else(|| (pretty(id), id.to_string()));
+    if let Ok(mut c) = CACHE.lock() {
+        c.insert(id.to_string(), found.clone());
+    }
+    found
+}
+
+/// "com.discordapp.Discord" → "Discord" when there's no launcher to ask.
+fn pretty(id: &str) -> String {
+    let last = id.rsplit('.').next().unwrap_or(id);
+    let mut c = last.chars();
+    c.next().map(|f| f.to_uppercase().chain(c).collect()).unwrap_or_default()
+}
+
+const STORE: &str = "org.freedesktop.impl.portal.PermissionStore";
+const STORE_PATH: &str = "/org/freedesktop/impl/portal/PermissionStore";
+
+async fn lookup(perm: Perm) -> Vec<(String, bool)> {
+    let (table, id) = perm.store();
+    let Ok(conn) = zbus::Connection::session().await else { return Vec::new() };
+    let Ok(reply) = conn.call_method(Some(STORE), STORE_PATH, Some(STORE), "Lookup", &(table, id)).await else { return Vec::new() };
+    let Ok((perms, _data)) = reply.body().deserialize::<(HashMap<String, Vec<String>>, zbus::zvariant::OwnedValue)>() else {
+        return Vec::new();
+    };
+    let mut v: Vec<(String, bool)> = perms.into_iter().filter(|(app, _)| !app.is_empty()).map(|(app, vals)| {
+        let on = perm.allowed(&vals);
+        (app, on)
+    }).collect();
+    v.sort_by_key(|(app, _)| app_name(app).0.to_lowercase());
+    v
+}
+
+async fn set(perm: Perm, app: String, on: bool) {
+    let (table, id) = perm.store();
+    let Ok(conn) = zbus::Connection::session().await else { return };
+    let values = perm.values(on);
+    let _ = conn.call_method(Some(STORE), STORE_PATH, Some(STORE), "SetPermission", &(table, true, id, app.as_str(), values)).await;
+}
+
+/// Whether the disk "/" lives on is encrypted (LUKS under it).
+async fn root_encrypted() -> Option<bool> {
+    let out = rows::output("lsblk", &["-s", "-n", "-o", "TYPE", "-r", "--", &findmnt_root().await?]).await.ok()?;
+    Some(out.lines().any(|t| t.trim() == "crypt"))
+}
+
+async fn findmnt_root() -> Option<String> {
+    let out = rows::output("findmnt", &["-n", "-o", "SOURCE", "/"]).await.ok()?;
+    // btrfs shows "/dev/x[/@]".
+    Some(out.trim().split('[').next()?.to_string()).filter(|s| s.starts_with("/dev/"))
+}
+
+pub fn update(pages: &mut Binder<PMsg>, msg: Msg) -> cosmic::app::Task<crate::Message> {
+    match msg {
+        Msg::Loaded(perm, list) => {
+            let apps = Some(Apps(list));
+            match perm {
+                Perm::Location => pages.page_mut::<LocationPage>().map(|p| p.apps = apps),
+                Perm::Camera => pages.page_mut::<CameraPage>().map(|p| p.apps = apps),
+                Perm::Microphone => pages.page_mut::<MicrophonePage>().map(|p| p.apps = apps),
+                Perm::Screenshot => pages.page_mut::<ScreenshotPage>().map(|p| p.apps = apps),
+                Perm::Background => pages.page_mut::<BackgroundPage>().map(|p| p.apps = apps),
+            };
+        }
+        Msg::Set(perm, app, on) => {
+            let flip = |a: &mut Option<Apps>| {
+                if let Some(Apps(list)) = a
+                    && let Some(e) = list.iter_mut().find(|(n, _)| *n == app)
+                {
+                    e.1 = on;
+                }
+            };
+            match perm {
+                Perm::Location => pages.page_mut::<LocationPage>().map(|p| flip(&mut p.apps)),
+                Perm::Camera => pages.page_mut::<CameraPage>().map(|p| flip(&mut p.apps)),
+                Perm::Microphone => pages.page_mut::<MicrophonePage>().map(|p| flip(&mut p.apps)),
+                Perm::Screenshot => pages.page_mut::<ScreenshotPage>().map(|p| flip(&mut p.apps)),
+                Perm::Background => pages.page_mut::<BackgroundPage>().map(|p| flip(&mut p.apps)),
+            };
+            return cosmic::task::future(async move {
+                set(perm, app, on).await;
+                crate::Message::None
+            });
+        }
+        Msg::Encryption(e) => {
+            if let Some(p) = pages.page_mut::<Page>() {
+                p.encrypted = e;
+            }
+        }
+        Msg::ClearActivity => {
+            // The recently-used list every desktop shares (Start's
+            // Recommended and jump lists read it).
+            if let Some(f) = dirs::data_dir().map(|d| d.join("recently-used.xbel")) {
+                let _ = std::fs::write(
+                    f,
+                    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xbel version=\"1.0\" xmlns:bookmark=\"http://www.freedesktop.org/standards/desktop-bookmarks\" xmlns:mime=\"http://www.freedesktop.org/standards/shared-mime-info\">\n</xbel>\n",
+                );
+            }
+            if let Some(p) = pages.page_mut::<ActivityPage>() {
+                p.cleared = true;
+            }
+        }
+        Msg::Cleared => {}
+    }
+    Task::none()
+}
+
+pub fn register(pages: &mut Binder<PMsg>) {
+    let _ = pages.register::<LocationPage>();
+    let _ = pages.register::<CameraPage>();
+    let _ = pages.register::<MicrophonePage>();
+    let _ = pages.register::<ScreenshotPage>();
+    let _ = pages.register::<BackgroundPage>();
+    let _ = pages.register::<ActivityPage>();
+}
+
+/// Sub-pages of Privacy & security (for nesting under it).
+pub const SUB_PAGES: [&str; 6] = [
+    "lapin-privacy-location",
+    "lapin-privacy-camera",
+    "lapin-privacy-microphone",
+    "lapin-privacy-screenshots",
+    "lapin-privacy-background",
+    "lapin-privacy-activity",
+];
