+// SPDX-License-Identifier: GPL-3.0-only
+//! Update, inside Settings as on Windows: checks Arch packages (pacman),
+//! Flatpak apps and device firmware (fwupd), installs them all with one
+//! button (the admin prompt asks for your password), shows each update's
+//! progress, Update history, and offers a restart when needed. The same
+//! checks as Lapin's Update app, which now opens this page.
+
+use cosmic::iced::{Alignment, Length, stream};
+use cosmic::widget::{self, column, icon, row, text};
+use cosmic::{Apply, Element, Task};
+use cosmic_settings_page::{self as page, Binder, Section, section};
+use slotmap::SlotMap;
+use tokio::io::{AsyncBufReadExt, BufReader};
+
+use super::rows::{self, PMsg};
+use super::settings::Msg as SMsg;
+use super::style;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Update {
+    pub name: String,
+    pub from: String,
+    pub to: String,
+    pub kind: Kind,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Kind {
+    System,
+    App,
+    Firmware,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum State {
+    Checking,
+    UpToDate,
+    Available,
+    Installing,
+    /// Finished; whether a restart is needed.
+    Done(bool),
+    Failed(String),
+}
+
+#[derive(Clone, Debug)]
+pub enum Msg {
+    Check,
+    Checked(Vec<Update>, Option<String>),
+    Install,
+    Line(String),
+    Installed(Result<(), String>),
+    Restart,
+    Details(bool),
+    History(Vec<String>),
+}
+
+pub struct Page {
+    entity: page::Entity,
+    pub state: State,
+    updates: Vec<Update>,
+    checked_at: Option<i64>,
+    log: Vec<String>,
+    details: bool,
+    started: bool,
+}
+
+impl Default for Page {
+    fn default() -> Self {
+        Page { entity: page::Entity::default(), state: State::UpToDate, updates: Vec::new(), checked_at: None, log: Vec::new(), details: false, started: false }
+    }
+}
+
+#[derive(Default)]
+pub struct HistoryPage {
+    entity: page::Entity,
+    lines: Option<Vec<String>>,
+}
+
+fn m(msg: Msg) -> PMsg {
+    PMsg::Lapin(SMsg::Update(msg))
+}
+
+impl page::Page<PMsg> for Page {
+    fn set_id(&mut self, entity: page::Entity) {
+        self.entity = entity;
+    }
+    fn info(&self) -> page::Info {
+        page::Info::new(super::categories::UPDATE_ID, super::view::UPDATE_ICON)
+            .title("Update")
+            .description("Updates for your system, apps and firmware")
+    }
+    fn content(&self, sections: &mut SlotMap<section::Entity, Section<PMsg>>) -> Option<page::Content> {
+        Some(vec![
+            sections.insert(Section::default().view::<Page>(|_, page, _| hero(page))),
+            sections.insert(Section::default().view::<Page>(|binder, page, _| more(binder, page))),
+        ])
+    }
+    fn on_enter(&mut self) -> Task<PMsg> {
+        self.checked_at = last_check();
+        // Check once when the page first opens, as Windows does.
+        if !self.started {
+            self.started = true;
+            self.state = State::Checking;
+            return Task::future(async {
+                let (list, problem) = check().await;
+                m(Msg::Checked(list, problem))
+            });
+        }
+        Task::none()
+    }
+}
+impl page::AutoBind<PMsg> for Page {}
+
+impl page::Page<PMsg> for HistoryPage {
+    fn set_id(&mut self, entity: page::Entity) {
+        self.entity = entity;
+    }
+    fn info(&self) -> page::Info {
+        page::Info::new("lapin-update-history", "document-open-recent-symbolic").title("Update history").description("What was updated and when")
+    }
+    fn content(&self, sections: &mut SlotMap<section::Entity, Section<PMsg>>) -> Option<page::Content> {
+        Some(vec![sections.insert(Section::default().view::<HistoryPage>(|_, page, _| history_view(page)))])
+    }
+    fn on_enter(&mut self) -> Task<PMsg> {
+        Task::future(async { m(Msg::History(tokio::task::spawn_blocking(history).await.unwrap_or_default())) })
+    }
+}
+impl page::AutoBind<PMsg> for HistoryPage {}
+
+pub fn update(pages: &mut Binder<PMsg>, msg: Msg) -> cosmic::app::Task<crate::Message> {
+    if let Msg::History(lines) = msg {
+        if let Some(h) = pages.page_mut::<HistoryPage>() {
+            h.lines = Some(lines);
+        }
+        return Task::none();
+    }
+    let Some(p) = pages.page_mut::<Page>() else { return Task::none() };
+    match msg {
+        Msg::Check => {
+            p.state = State::Checking;
+            return cosmic::task::future(async {
+                let (list, problem) = check().await;
+                crate::Message::PageMessage(m(Msg::Checked(list, problem)))
+            });
+        }
+        Msg::Checked(list, problem) => {
+            p.checked_at = last_check().or(p.checked_at);
+            p.updates = list;
+            p.state = match problem {
+                Some(e) if p.updates.is_empty() => State::Failed(e),
+                _ if p.updates.is_empty() => State::UpToDate,
+                _ => State::Available,
+            };
+        }
+        Msg::Install => {
+            p.state = State::Installing;
+            p.log.clear();
+            let system = p.updates.iter().any(|u| u.kind == Kind::System);
+            let apps = p.updates.iter().any(|u| u.kind == Kind::App);
+            let firmware = p.updates.iter().any(|u| u.kind == Kind::Firmware);
+            return install(system, apps, firmware);
+        }
+        Msg::Line(l) => {
+            p.log.push(l);
+            if p.log.len() > 2000 {
+                p.log.drain(..500);
+            }
+        }
+        Msg::Installed(r) => {
+            p.state = match r {
+                Ok(()) => State::Done(needs_restart(&p.updates)),
+                Err(e) => State::Failed(e),
+            };
+            if matches!(p.state, State::Done(_)) {
+                p.updates.clear();
+            }
+        }
+        Msg::Restart => {
+            let _ = std::process::Command::new("systemctl").arg("reboot").spawn();
+        }
+        Msg::Details(on) => p.details = on,
+        Msg::History(_) => {}
+    }
+    Task::none()
+}
+
+fn last_checked(at: Option<i64>) -> String {
+    let Some(t) = at else { return String::new() };
+    let Some(when) = chrono::DateTime::from_timestamp(t, 0).map(|d| d.with_timezone(&chrono::Local)) else { return String::new() };
+    let today = chrono::Local::now().date_naive();
+    let day = if when.date_naive() == today {
+        "today".to_string()
+    } else if Some(when.date_naive()) == today.pred_opt() {
+        "yesterday".to_string()
+    } else {
+        when.format("%-m/%-d/%Y").to_string()
+    };
+    format!("Last checked: {day}, {}", when.format("%-I:%M %p"))
+}
+
+fn hero(p: &Page) -> Element<'_, PMsg> {
+    let (title, sub): (String, String) = match &p.state {
+        State::Checking => ("Checking for updates…".into(), last_checked(p.checked_at)),
+        State::UpToDate => ("You're up to date".into(), last_checked(p.checked_at)),
+        State::Available => (
+            "Updates available".into(),
+            format!("{}  ·  {}", if p.updates.len() == 1 { "1 update is ready".to_string() } else { format!("{} updates are ready", p.updates.len()) }, last_checked(p.checked_at)),
+        ),
+        State::Installing => ("Installing updates".into(), p.log.last().cloned().unwrap_or_else(|| "Getting things ready…".into())),
+        State::Done(true) => ("Restart required".into(), "Restart your PC to finish installing updates.".into()),
+        State::Done(false) => ("You're up to date".into(), "Updates were installed.".into()),
+        State::Failed(e) => ("Updates couldn't be installed".into(), e.clone()),
+    };
+    let glyph = match &p.state {
+        State::Done(true) => "system-reboot-symbolic",
+        State::Failed(_) => "dialog-warning-symbolic",
+        _ => "",
+    };
+    let picture: Element<'_, PMsg> = if glyph.is_empty() {
+        icon(super::view::colour_icon_handle(super::view::UPDATE_ICON)).size(64).into()
+    } else {
+        icon::from_name(glyph).size(48).apply(widget::container).center_x(64).into()
+    };
+    let action: Element<'_, PMsg> = match &p.state {
+        State::Checking | State::Installing => widget::Space::new().width(0).into(),
+        State::Available => widget::button::suggested("Download & install all").on_press(m(Msg::Install)).into(),
+        State::Done(true) => widget::button::suggested("Restart now").on_press(m(Msg::Restart)).into(),
+        _ => widget::button::suggested("Check for updates").on_press(m(Msg::Check)).into(),
+    };
+    let top = row::with_capacity(3)
+        .spacing(20)
+        .align_y(Alignment::Center)
+        .push(picture)
+        .push(
+            column::with_capacity(2)
+                .spacing(4)
+                .push(text::title3(title))
+                .push(text::body(sub).class(style::quiet()))
+                .width(Length::Fill),
+        )
+        .push(action);
+    let mut c = column::with_capacity(4).spacing(16).push(top.apply(widget::container).padding([0, 0, 8, 0]));
+    if matches!(p.state, State::Checking | State::Installing) {
+        c = c.push(widget::progress_bar::indeterminate_linear().girth(4).width(Length::Fill));
+    }
+    if matches!(p.state, State::Available | State::Installing) && !p.updates.is_empty() {
+        let status = if p.state == State::Installing { "Installing" } else { "Pending install" };
+        let list: Vec<rows::Item<'_>> = p
+            .updates
+            .iter()
+            .map(|u| {
+                let version = if u.from.is_empty() { u.to.clone() } else { format!("{} → {}", u.from, u.to) };
+                let what = match u.kind {
+                    Kind::System => "System update",
+                    Kind::App => "App update",
+                    Kind::Firmware => "Firmware",
+                };
+                let name = if u.kind == Kind::App { super::privacy::app_name(&u.name).0 } else { u.name.clone() };
+                rows::with("", name, format!("{what}  ·  {version}"), text::body(status).class(style::quiet()).into())
+            })
+            .collect();
+        c = c.push(rows::section("", list));
+    }
+    if !p.log.is_empty() {
+        c = c.push(widget::button::text(if p.details { "Hide details" } else { "Show details" }).on_press(m(Msg::Details(!p.details))));
+        if p.details {
+            let lines: Vec<Element<'_, PMsg>> = p.log.iter().rev().take(200).rev().map(|l| text::caption(l.clone()).into()).collect();
+            c = c.push(widget::container(column::with_children(lines).spacing(2)).padding(16).width(Length::Fill).class(style::card()));
+        }
+    }
+    c.into()
+}
+
+fn more<'a>(binder: &'a Binder<PMsg>, _p: &'a Page) -> Element<'a, PMsg> {
+    let history = binder.find_page_by_id("lapin-update-history").map(|(e, _)| PMsg::Page(e));
+    rows::section(
+        "More options",
+        vec![rows::nav("document-open-recent-symbolic", "Update history", "What was updated and when", history)],
+    )
+}
+
+fn history_view(p: &HistoryPage) -> Element<'_, PMsg> {
+    match &p.lines {
+        None => text::body("Reading update history…").class(style::quiet()).into(),
+        Some(l) if l.is_empty() => rows::section("", vec![rows::note("No updates yet.")]),
+        Some(lines) => {
+            // Grouped by day, newest first, like Windows' "Update history".
+            let mut groups: Vec<(String, Vec<rows::Item<'_>>)> = Vec::new();
+            for l in lines {
+                let (day, what) = l.split_once("  ").unwrap_or(("", l.as_str()));
+                let (verb, rest) = what.split_once(' ').unwrap_or((what, ""));
+                let name = rest.split_whitespace().next().unwrap_or(rest).to_string();
+                let detail = rest.trim_start_matches(&name).trim().trim_matches(|c| c == '(' || c == ')').replace(" -> ", " → ");
+                let label = match verb {
+                    "upgraded" => "Successfully updated",
+                    "installed" => "Successfully installed",
+                    _ => verb,
+                };
+                let item = rows::with("", name, detail, text::caption(label).class(style::quiet()).into());
+                match groups.last_mut() {
+                    Some((d, items)) if d == day => items.push(item),
+                    _ => groups.push((day.to_string(), vec![item])),
+                }
+            }
+            let mut c = column::with_capacity(groups.len()).spacing(24);
+            for (day, items) in groups.into_iter().take(60) {
+                let title = chrono::NaiveDate::parse_from_str(&day, "%Y-%m-%d").map(|d| d.format("%-m/%-d/%Y").to_string()).unwrap_or(day);
+                c = c.push(column::with_capacity(2).spacing(8).push(text::heading(title)).push(rows::section("", items)));
+            }
+            c.into()
+        }
+    }
+}
+
+// --- Checking and installing (same as lapin-ux-update) -------------------------
+
+/// `checkupdates` lines: "linux 6.11.1-1 -> 6.11.2-1".
+pub fn parse_checkupdates(out: &str) -> Vec<Update> {
+    out.lines()
+        .filter_map(|l| {
+            let v: Vec<&str> = l.split_whitespace().collect();
+            (v.len() == 4 && v[2] == "->").then(|| Update { name: v[0].into(), from: v[1].into(), to: v[3].into(), kind: Kind::System })
+        })
+        .collect()
+}
+
+/// `flatpak remote-ls --updates --columns=application,version` lines.
+pub fn parse_flatpak(out: &str) -> Vec<Update> {
+    out.lines()
+        .filter(|l| !l.trim().is_empty() && !l.starts_with("Application"))
+        .filter_map(|l| {
+            let mut it = l.split('\t');
+            let name = it.next()?.trim().to_string();
+            let to = it.next().unwrap_or_default().trim().to_string();
+            (!name.is_empty()).then_some(Update { name, from: String::new(), to, kind: Kind::App })
+        })
+        .collect()
+}
+
+/// `fwupdmgr get-updates --json`: one update per device, to its newest
+/// release. A small reader for fwupd's regular JSON: for each object in
+/// "Devices", its own "Name" and "Version", and the first "Version" inside
+/// its "Releases".
+pub fn parse_fwupd(json: &str) -> Vec<Update> {
+    let Some(start) = json.find("\"Devices\"").and_then(|i| json[i..].find('[').map(|j| i + j + 1)) else { return Vec::new() };
+    let b = json.as_bytes();
+    let mut out = Vec::new();
+    let (mut i, mut depth) = (start, 0usize);
+    // Per device: (name, version, newest release), the key last read, and
+    // whether we're inside its "Releases".
+    let mut dev: (String, String, Option<String>) = Default::default();
+    let mut key = String::new();
+    let mut in_releases = false;
+    let mut releases_depth = 0usize;
+    while i < b.len() {
+        match b[i] {
+            b'"' => {
+                let mut j = i + 1;
+                let mut s = String::new();
+                while j < b.len() && b[j] != b'"' {
+                    if b[j] == b'\\' {
+                        j += 1;
+                    }
+                    if j < b.len() {
+                        s.push(b[j] as char);
+                    }
+                    j += 1;
+                }
+                let is_key = json[j + 1..].trim_start().starts_with(':');
+                if is_key {
+                    key = s;
+                    if depth == 1 && key == "Releases" {
+                        in_releases = true;
+                        releases_depth = depth;
+                    }
+                } else if depth == 1 && !in_releases {
+                    match key.as_str() {
+                        "Name" => dev.0 = s,
+                        "Version" => dev.1 = s,
+                        _ => {}
+                    }
+                } else if in_releases && depth == releases_depth + 1 && key == "Version" && dev.2.is_none() {
+                    dev.2 = Some(s);
+                }
+                i = j;
+            }
+            b'{' => depth += 1,
+            b'}' => {
+                depth = depth.saturating_sub(1);
+                if depth == 0 {
+                    let (name, from, to) = std::mem::take(&mut dev);
+                    if let Some(to) = to.filter(|t| !t.is_empty()) {
+                        out.push(Update { name, from, to, kind: Kind::Firmware });
+                    }
+                    in_releases = false;
+                }
+            }
+            b']' if in_releases && depth == releases_depth => in_releases = false,
+            b']' if depth == 0 => break,
+            _ => {}
+        }
+        i += 1;
+    }
+    out
+}
+
+/// Updates that only take effect after a restart.
+pub fn needs_restart(updates: &[Update]) -> bool {
+    const CORE: &[&str] = &["linux", "linux-lts", "linux-zen", "linux-hardened", "systemd", "glibc", "mesa", "nvidia", "amd-ucode", "intel-ucode", "lapin-ux-comp", "cosmic-comp"];
+    updates.iter().any(|u| {
+        u.kind == Kind::Firmware || u.kind == Kind::System && (CORE.contains(&u.name.as_str()) || u.name.starts_with("linux-firmware") || u.name.starts_with("nvidia"))
+    })
+}
+
+fn last_check_file() -> Option<std::path::PathBuf> {
+    let state = std::env::var_os("XDG_STATE_HOME")
+        .map(std::path::PathBuf::from)
+        .filter(|p| p.is_absolute())
+        .or_else(|| dirs::home_dir().map(|h| h.join(".local/state")))?;
+    Some(state.join("lapin-ux/update-last-check"))
+}
+
+fn last_check() -> Option<i64> {
+    std::fs::read_to_string(last_check_file()?).ok()?.trim().parse().ok()
+}
+
+fn record_check() {
+    let Some(file) = last_check_file() else { return };
+    let secs = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0);
+    if let Some(dir) = file.parent() {
+        let _ = std::fs::create_dir_all(dir);
+    }
+    let _ = std::fs::write(file, secs.to_string());
+}
+
+async fn check() -> (Vec<Update>, Option<String>) {
+    let mut list = Vec::new();
+    let mut problem = None;
+    match tokio::process::Command::new("checkupdates").output().await {
+        // checkupdates exits 2 when there's nothing to update.
+        Ok(o) if o.status.success() || o.status.code() == Some(2) => list.extend(parse_checkupdates(&String::from_utf8_lossy(&o.stdout))),
+        Ok(o) => problem = Some(String::from_utf8_lossy(&o.stderr).trim().to_string()),
+        Err(_) => problem = Some("checkupdates isn't installed (pacman-contrib).".into()),
+    }
+    if let Ok(o) = tokio::process::Command::new("flatpak").args(["remote-ls", "--updates", "--columns=application,version"]).output().await
+        && o.status.success()
+    {
+        list.extend(parse_flatpak(&String::from_utf8_lossy(&o.stdout)));
+    }
+    if let Ok(o) = tokio::process::Command::new("fwupdmgr")
+        .args(["get-updates", "--json", "--no-unreported-check", "--no-metadata-check"])
+        .output()
+        .await
+    {
+        list.extend(parse_fwupd(&String::from_utf8_lossy(&o.stdout)));
+    }
+    if problem.is_none() {
+        record_check();
+    }
+    (list, problem)
+}
+
+async fn run_streamed(out: &mut futures::channel::mpsc::Sender<PMsg>, cmd: &str, args: &[&str]) -> Result<(), String> {
+    use futures::SinkExt;
+    let mut child = tokio::process::Command::new(cmd)
+        .args(args)
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .spawn()
+        .map_err(|e| format!("{cmd}: {e}"))?;
+    let stdout = child.stdout.take().ok_or("no output")?;
+    let stderr = child.stderr.take().ok_or("no output")?;
+    let mut lines = BufReader::new(stdout).lines();
+    let mut errs = BufReader::new(stderr).lines();
+    let mut last_err = String::new();
+    loop {
+        tokio::select! {
+            l = lines.next_line() => match l {
+                Ok(Some(l)) => { let _ = out.send(m(Msg::Line(l))).await; }
+                _ => break,
+            },
+            e = errs.next_line() => if let Ok(Some(e)) = e {
+                last_err = e.clone();
+                let _ = out.send(m(Msg::Line(e))).await;
+            },
+        }
+    }
+    let status = child.wait().await.map_err(|e| e.to_string())?;
+    if status.success() {
+        Ok(())
+    } else if matches!(status.code(), Some(126 | 127)) {
+        Err("The update wasn't authorised.".into())
+    } else {
+        Err(if last_err.is_empty() { format!("{cmd} failed") } else { last_err })
+    }
+}
+
+fn install(system: bool, apps: bool, firmware: bool) -> cosmic::app::Task<crate::Message> {
+    let s = stream::channel(64, move |mut out: futures::channel::mpsc::Sender<PMsg>| async move {
+        use futures::SinkExt;
+        let mut result = Ok(());
+        if system {
+            result = run_streamed(&mut out, "pkexec", &["pacman", "-Syu", "--noconfirm"]).await;
+        }
+        if result.is_ok() && apps {
+            result = run_streamed(&mut out, "flatpak", &["update", "-y", "--noninteractive"]).await;
+        }
+        if result.is_ok() && firmware {
+            result = run_streamed(&mut out, "fwupdmgr", &["update", "-y", "--no-reboot-check", "--no-unreported-check", "--no-metadata-check"]).await;
+        }
+        let _ = out.send(m(Msg::Installed(result))).await;
+    });
+    Task::run(s, |msg| cosmic::Action::App(crate::Message::PageMessage(msg)))
+}
+
+/// pacman's log, newest first: "2026-10-21  upgraded firefox (131.0-1 -> 131.0.2-1)".
+fn history() -> Vec<String> {
+    let log = std::fs::read_to_string("/var/log/pacman.log").unwrap_or_default();
+    let mut v: Vec<String> = log
+        .lines()
+        .filter(|l| l.contains("[ALPM] upgraded ") || l.contains("[ALPM] installed "))
+        .map(|l| {
+            let date = l.get(1..11).unwrap_or_default();
+            let what = l.split("[ALPM] ").nth(1).unwrap_or(l);
+            format!("{date}  {what}")
+        })
+        .collect();
+    v.reverse();
+    v.truncate(300);
+    v
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses() {
+        let u = parse_checkupdates("linux 6.11.1.arch1-1 -> 6.11.2.arch1-1\nfirefox 131.0-1 -> 131.0.2-1\n\n");
+        assert_eq!(u.len(), 2);
+        assert!(needs_restart(&u));
+        let f = parse_flatpak("org.gimp.GIMP\t2.10.38\n");
+        assert_eq!(f[0].kind, Kind::App);
+        assert!(!needs_restart(&f));
+    }
+
+    #[test]
+    fn firmware() {
+        let json = r#"{"Devices":[
+            {"Name":"System Firmware","DeviceId":"a","Version":"1.20","Releases":[{"Version":"1.22","Summary":"UEFI"},{"Version":"1.21"}]},
+            {"Name":"Dock","DeviceId":"b","Version":"3","Releases":[]},
+            {"Name":"SSD","Version":"2.0"}]}"#;
+        let u = parse_fwupd(json);
+        assert_eq!(u.len(), 1, "{u:?}");
+        assert_eq!((u[0].name.as_str(), u[0].from.as_str(), u[0].to.as_str()), ("System Firmware", "1.20", "1.22"));
+        assert!(parse_fwupd("No updates").is_empty());
+    }
+}
