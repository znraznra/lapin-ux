@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Small row builders shared by Lapin's own pages, in Windows' shape: an
+//! outline icon, a title with a grey description under it, and a control
+//! or an arrow at the right.
+
+use cosmic::iced::{Alignment, Length};
+use cosmic::widget::{self, column, icon, list, settings, text};
+use cosmic::{Apply, Element};
+use cosmic::widget::list_column::{IntoListItem, ListItem};
+
+use super::style;
+
+pub type PMsg = crate::pages::Message;
+pub type Item<'a> = ListItem<'a, PMsg>;
+
+/// Title over a grey description.
+pub fn words<'a, M: 'static>(title: impl Into<String>, description: impl Into<String>) -> Element<'a, M> {
+    let d: String = description.into();
+    let mut c = column::with_capacity(2).spacing(2).push(text::body(title.into()));
+    if !d.is_empty() {
+        c = c.push(text::caption(d).class(style::quiet()));
+    }
+    c.width(Length::Fill).into()
+}
+
+fn lead<'a, M: 'static>(icon_name: &str) -> Element<'a, M> {
+    icon::from_name(icon_name.to_string()).size(20).icon().into()
+}
+
+/// A row that opens another page (or does something) when clicked.
+pub fn nav<'a>(icon_name: &str, title: impl Into<String>, description: impl Into<String>, msg: Option<PMsg>) -> Item<'a> {
+    let mut children = Vec::with_capacity(3);
+    if !icon_name.is_empty() {
+        children.push(lead(icon_name));
+    }
+    children.push(words(title, description));
+    children.push(icon::from_name("go-next-symbolic").size(16).icon().into());
+    settings::item_row(children).apply(list::button).on_press_maybe(msg).into_list_item()
+}
+
+/// A row that opens another page, with a status ("On", "3 apps") before
+/// the arrow.
+pub fn nav_with<'a>(icon_name: &str, title: impl Into<String>, description: impl Into<String>, status: impl Into<String>, msg: Option<PMsg>) -> Item<'a> {
+    let mut children = Vec::with_capacity(4);
+    if !icon_name.is_empty() {
+        children.push(lead(icon_name));
+    }
+    children.push(words(title, description));
+    children.push(text::body(status.into()).class(style::quiet()).into());
+    children.push(icon::from_name("go-next-symbolic").size(16).icon().into());
+    settings::item_row(children).apply(list::button).on_press_maybe(msg).into_list_item()
+}
+
+/// A row with any control at the right.
+pub fn with<'a>(icon_name: &str, title: impl Into<String>, description: impl Into<String>, control: Element<'a, PMsg>) -> Item<'a> {
+    let mut children = Vec::with_capacity(3);
+    if !icon_name.is_empty() {
+        children.push(lead(icon_name));
+    }
+    children.push(words(title, description));
+    children.push(control);
+    Element::from(settings::item_row(children)).into_list_item()
+}
+
+/// A row with a switch and On/Off at the right.
+pub fn switch<'a>(icon_name: &str, title: impl Into<String>, description: impl Into<String>, on: bool, f: impl Fn(bool) -> PMsg + 'a) -> Item<'a> {
+    let t = widget::row::with_capacity(2)
+        .spacing(12)
+        .align_y(Alignment::Center)
+        .push(text::body(if on { "On" } else { "Off" }))
+        .push(widget::toggler(on).on_toggle(f));
+    with(icon_name, title, description, t.into())
+}
+
+/// A row with a standard button at the right.
+pub fn button<'a>(icon_name: &str, title: impl Into<String>, description: impl Into<String>, label: impl Into<String>, msg: Option<PMsg>) -> Item<'a> {
+    with(icon_name, title, description, widget::button::standard(label.into()).on_press_maybe(msg).into())
+}
+
+/// A plain line of grey text inside a section (empty lists, notes).
+pub fn note<'a>(s: impl Into<String>) -> Item<'a> {
+    Element::from(text::body(s.into()).class(style::quiet())).into_list_item()
+}
+
+/// Folds rows into a settings section with an optional title.
+pub fn section<'a>(title: &'a str, rows: Vec<Item<'a>>) -> Element<'a, PMsg> {
+    let mut sec = settings::section();
+    if !title.is_empty() {
+        sec = sec.title(title);
+    }
+    rows.into_iter()
+        .fold(sec, |s, r| match r {
+            ListItem::Element(e) => s.add(e),
+            ListItem::Button(b) => s.add(b),
+        })
+        .into()
+}
+
+/// Bytes as Windows writes them: "512 KB", "3.4 MB", "1.25 GB".
+pub fn size(bytes: u64) -> String {
+    const UNITS: [&str; 5] = ["bytes", "KB", "MB", "GB", "TB"];
+    let mut v = bytes as f64;
+    let mut u = 0;
+    while v >= 1024.0 && u < UNITS.len() - 1 {
+        v /= 1024.0;
+        u += 1;
+    }
+    match u {
+        0 => format!("{bytes} bytes"),
+        _ if v >= 100.0 => format!("{v:.0} {}", UNITS[u]),
+        _ if v >= 10.0 => format!("{v:.1} {}", UNITS[u]),
+        _ => format!("{v:.2} {}", UNITS[u]),
+    }
+}
+
+/// "245.67 MiB", "1.2 GB", "980 kB" → bytes.
+pub fn parse_size(s: &str) -> Option<u64> {
+    let s = s.trim().replace('\u{a0}', " ");
+    let (num, unit) = match s.find(|c: char| c.is_alphabetic()) {
+        Some(i) => (s[..i].trim(), s[i..].trim()),
+        None => (s.as_str(), "B"),
+    };
+    let n: f64 = num.replace(',', ".").parse().ok()?;
+    let mul: f64 = match unit.to_ascii_lowercase().as_str() {
+        "b" | "bytes" | "byte" => 1.0,
+        "kib" | "kb" | "k" => 1024.0,
+        "mib" | "mb" | "m" => 1024.0 * 1024.0,
+        "gib" | "gb" | "g" => 1024.0 * 1024.0 * 1024.0,
+        "tib" | "tb" | "t" => 1024.0_f64.powi(4),
+        _ => return None,
+    };
+    Some((n * mul) as u64)
+}
+
+/// Runs a command and returns its standard output, or its last error line.
+pub async fn output(cmd: &str, args: &[&str]) -> Result<String, String> {
+    let out = tokio::process::Command::new(cmd)
+        .args(args)
+        .env("LC_ALL", "C")
+        .output()
+        .await
+        .map_err(|e| format!("{cmd}: {e}"))?;
+    if out.status.success() {
+        Ok(String::from_utf8_lossy(&out.stdout).into_owned())
+    } else {
+        let err = String::from_utf8_lossy(&out.stderr).trim().to_string();
+        // pkexec: 126 = the password prompt was dismissed, 127 = not allowed.
+        Err(match out.status.code() {
+            Some(126) => "Cancelled.".into(),
+            Some(127) => "Not authorized.".into(),
+            _ if err.is_empty() => format!("{cmd} failed"),
+            _ => err.lines().last().unwrap_or_default().to_string(),
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn sizes() {
+        assert_eq!(size(512), "512 bytes");
+        assert_eq!(size(3 * 1024 * 1024 + 400 * 1024), "3.39 MB");
+        assert_eq!(size(250 * 1024 * 1024), "250 MB");
+        assert_eq!(parse_size("245.67 MiB"), Some((245.67 * 1048576.0) as u64));
+        assert_eq!(parse_size("1.2\u{a0}GB"), Some((1.2 * 1073741824.0) as u64));
+        assert_eq!(parse_size("980 kB"), Some(980 * 1024));
+        assert_eq!(parse_size("nonsense"), None);
+    }
+}
