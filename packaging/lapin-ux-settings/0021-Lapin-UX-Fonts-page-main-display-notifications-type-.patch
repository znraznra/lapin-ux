+pub fn display_one(outputs: &[(String, String, (i32, i32))]) -> Option<usize> {
+    outputs.iter().enumerate().min_by(|(i, (a, ..)), (j, (b, ..))| a.cmp(b).then(i.cmp(j))).map(|(i, _)| i)
