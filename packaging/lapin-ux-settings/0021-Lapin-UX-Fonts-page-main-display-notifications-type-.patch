+/// A notification from Settings (#31: the main display changed).
+pub fn notify(summary: String, body: String) -> cosmic::Task<crate::app::Message> {
+    cosmic::Task::future(async move {
+        if let Ok(conn) = zbus::Connection::session().await {
+            let hints: std::collections::HashMap<&str, zbus::zvariant::Value<'_>> = std::collections::HashMap::new();
+            let _ = conn
+                .call_method(
+                    Some("org.freedesktop.Notifications"),
+                    "/org/freedesktop/Notifications",
+                    Some("org.freedesktop.Notifications"),
+                    "Notify",
+                    &(
+                        "Settings",
+                        0u32,
+                        "preferences-desktop-display-symbolic",
+                        summary.as_str(),
+                        body.as_str(),
+                        Vec::<&str>::new(),
+                        hints,
+                        5000i32,
+                    ),
+                )
+                .await;
+        }
+        crate::app::Message::None
+    })
 }
 
