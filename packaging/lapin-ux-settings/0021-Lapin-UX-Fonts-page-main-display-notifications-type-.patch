+            "  <alias binding=\"strong\"><family>sans-serif</family><prefer><family>{f}</family></prefer></alias>\n\
+             \x20 <alias binding=\"strong\"><family>system-ui</family><prefer><family>{f}</family></prefer></alias>\n"
+        )
+    };
