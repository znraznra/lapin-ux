+/// Installed font families: (interface, monospace), the lists COSMIC's own
+/// font pickers use.
+fn font_lists() -> &'static (Vec<&'static str>, Vec<&'static str>) {
+    static LISTS: std::sync::OnceLock<(Vec<&'static str>, Vec<&'static str>)> = std::sync::OnceLock::new();
+    LISTS.get_or_init(|| {
+        let (interface, mono) = crate::pages::desktop::appearance::font_config::load_font_families();
+        let leak = |v: Vec<std::sync::Arc<str>>| v.into_iter().map(|f| &*Box::leak(f.to_string().into_boxed_str())).collect();
+        (leak(interface), leak(mono))
+    })
+}
+
+/// COSMIC's interface or monospace font (shared with COSMIC's session, so
+/// the per-session swap keeps Lapin's choice separate).
+fn set_font(key: &str, family: &str) {
+    use cosmic::config::{CosmicTk, FontConfig};
+    if let Ok(config) = CosmicTk::config() {
+        let font = FontConfig {
+            family: family.to_string(),
+            weight: cosmic::iced::font::Weight::Normal,
+            style: cosmic::iced::font::Style::Normal,
+            stretch: cosmic::iced::font::Stretch::Normal,
+        };
+        let _ = config.set(key, font);
+    }
+}
