@@ -0,0 +1,231 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! "Find a setting", as on Windows: typing shows suggestions in a list under
+//! the box (each opens its page); Enter or "Show all results" shows every
+//! match as rows on a "Search results" page. Matches come from every page's
+//! name and description, every searchable line of COSMIC's pages, and the
+//! names of the settings on Lapin's own pages.
+
+use cosmic::iced::{Alignment, Length};
+use cosmic::widget::{self, button, column, container, icon, row, text};
+use cosmic::{Apply, Element};
+use cosmic_settings_page::{Binder, Entity};
+
+use super::{Msg, style};
+use crate::app::Message;
+
+/// One thing that can be found.
+#[derive(Clone, Debug)]
+pub struct Entry {
+    pub label: String,
+    /// "System > Display" (where it lives).
+    pub path: String,
+    pub icon: String,
+    pub page: Entity,
+    /// Extra words that find it (the page's description).
+    pub keywords: String,
+}
+
+/// Settings on Lapin's own pages, by page id: (page, setting name).
+const LAPIN_ROWS: &[(&str, &str)] = &[
+    ("lapin-taskbar", "Taskbar alignment"),
+    ("lapin-taskbar", "Automatically hide the taskbar"),
+    ("lapin-taskbar", "Combine taskbar buttons and hide labels"),
+    ("lapin-taskbar", "Show smaller taskbar buttons"),
+    ("lapin-taskbar", "Show my taskbar on all displays"),
+    ("lapin-taskbar", "Show the Search box on the taskbar"),
+    ("lapin-taskbar", "Touch keyboard button"),
+    ("lapin-taskbar", "Show desktop corner"),
+    ("lapin-taskbar", "Show seconds in system tray clock"),
+    ("lapin-start", "Show web results in search"),
+    ("lapin-start", "Search engine"),
+    ("lapin-start", "Show recently opened items in Start and jump lists"),
+    ("lapin-night-light", "Night light strength"),
+    ("lapin-night-light", "Schedule night light"),
+    ("lapin-notifications", "Do not disturb"),
+    ("lapin-notifications", "Turn on do not disturb automatically"),
+    ("lapin-notifications", "Notifications from apps"),
+    ("lapin-multitasking", "Snap windows"),
+    ("lapin-multitasking", "Snap assist"),
+    ("lapin-clipboard", "Clipboard history"),
+    ("lapin-clipboard", "Clear clipboard data"),
+    ("lapin-lock-screen", "Personalize your lock screen"),
+    ("lapin-lock-screen", "Lock screen picture"),
+    ("lapin-lock-screen", "Show the lock screen background picture on the sign-in screen"),
+    ("lapin-storage", "Free up space"),
+    ("lapin-storage-temp", "Temporary files"),
+    ("lapin-storage-temp", "Empty Recycle Bin"),
+    ("lapin-installed-apps", "Uninstall an app"),
+    ("lapin-signin", "Facial recognition"),
+    ("lapin-signin", "Fingerprint recognition"),
+    ("lapin-signin", "Change your password"),
+    ("lapin-privacy", "Device encryption"),
+    ("lapin-privacy-location", "Location permissions"),
+    ("lapin-privacy-camera", "Camera permissions"),
+    ("lapin-privacy-microphone", "Microphone permissions"),
+    ("lapin-privacy-screenshots", "Screenshot permissions"),
+    ("lapin-privacy-background", "Background apps"),
+    ("lapin-privacy-activity", "Clear activity history"),
+    ("lapin-update", "Check for updates"),
+    ("lapin-update", "Firmware updates"),
+    ("lapin-update-history", "Update history"),
+    ("about", "Rename this PC"),
+    ("about", "Device specifications"),
+];
+
+fn path(pages: &Binder<crate::pages::Message>, page: Entity, include_self: bool) -> String {
+    let mut chain = Vec::new();
+    let mut at = if include_self { Some(page) } else { pages.info.get(page).and_then(|i| i.parent) };
+    while let Some(p) = at {
+        let Some(info) = pages.info.get(p) else { break };
+        chain.push(info.title.clone());
+        at = info.parent;
+    }
+    chain.reverse();
+    chain.join(" > ")
+}
+
+/// Everything findable, built once the pages are in place.
+pub fn build(pages: &Binder<crate::pages::Message>, home: Entity) -> Vec<Entry> {
+    let mut out = Vec::new();
+    for (page, info) in pages.info.iter() {
+        if page == home || info.title.is_empty() {
+            continue;
+        }
+        // Only pages reachable from the sidebar (placed in a category).
+        let mut top = page;
+        while let Some(p) = pages.info.get(top).and_then(|i| i.parent) {
+            top = p;
+        }
+        let in_sidebar = pages.info.get(top).is_some_and(|i| i.id.starts_with("lapin-")) || top == page && info.id.starts_with("lapin-");
+        if !in_sidebar {
+            continue;
+        }
+        out.push(Entry {
+            label: info.title.clone(),
+            path: path(pages, page, false),
+            icon: info.icon_name.to_string(),
+            page,
+            keywords: info.description.to_lowercase(),
+        });
+        // COSMIC's searchable lines on this page.
+        if let Some(content) = pages.content(page) {
+            for &s in content {
+                let Some(section) = pages.sections.get(s) else { continue };
+                if section.search_ignore {
+                    continue;
+                }
+                // Section titles, and the setting names among its lines
+                // (single words there are mostly choices like "Slow").
+                let lines = std::iter::once((true, section.title.clone())).chain(section.descriptions.iter().map(|(_, d)| (false, d.clone())));
+                for (is_title, line) in lines {
+                    let line = line.trim().trim_end_matches(':').trim().to_string();
+                    if line.len() < 3 || line.len() > 70 || line.eq_ignore_ascii_case(&info.title) {
+                        continue;
+                    }
+                    if !is_title && line.split_whitespace().count() < 2 {
+                        continue;
+                    }
+                    out.push(Entry { label: line, path: path(pages, page, true), icon: info.icon_name.to_string(), page, keywords: String::new() });
+                }
+            }
+        }
+    }
+    for (id, label) in LAPIN_ROWS {
+        if let Some((page, info)) = pages.find_page_by_id(id) {
+            out.push(Entry { label: label.to_string(), path: path(pages, page, true), icon: info.icon_name.to_string(), page, keywords: String::new() });
+        }
+    }
+    // One entry per name and page.
+    let mut seen = std::collections::HashSet::new();
+    out.retain(|e| seen.insert((e.label.to_lowercase(), e.page)));
+    out
+}
+
+/// Matches for `query`, best first: names starting with it, then names with
+/// a word starting with it, then names containing it, then descriptions.
+pub fn find<'a>(index: &'a [Entry], query: &str) -> Vec<&'a Entry> {
+    let q = query.trim().to_lowercase();
+    if q.is_empty() {
+        return Vec::new();
+    }
+    let mut hits: Vec<(u8, &Entry)> = index
+        .iter()
+        .filter_map(|e| {
+            let l = e.label.to_lowercase();
+            let rank = if l.starts_with(&q) {
+                0
+            } else if l.split(|c: char| !c.is_alphanumeric()).any(|w| w.starts_with(&q)) {
+                1
+            } else if l.contains(&q) {
+                2
+            } else if e.keywords.contains(&q) {
+                3
+            } else {
+                return None;
+            };
+            Some((rank, e))
+        })
+        .collect();
+    hits.sort_by(|a, b| a.0.cmp(&b.0).then(a.1.label.len().cmp(&b.1.label.len())).then(a.1.label.cmp(&b.1.label)));
+    hits.into_iter().map(|(_, e)| e).collect()
+}
+
+/// How many suggestions the list under the box shows.
+pub const SUGGESTIONS: usize = 8;
+
+/// The list under "Find a setting".
+pub fn suggestions<'a>(index: &'a [Entry], query: &str) -> Element<'a, Message> {
+    let hits = find(index, query);
+    let mut list = column::with_capacity(SUGGESTIONS + 1).spacing(2);
+    if hits.is_empty() {
+        list = list.push(container(text::body("No results").class(style::quiet())).padding([10, 12]));
+    }
+    for e in hits.iter().take(SUGGESTIONS) {
+        list = list.push(
+            button::custom(
+                row::with_capacity(2)
+                    .spacing(12)
+                    .align_y(Alignment::Center)
+                    .push(icon::from_name(e.icon.clone()).size(16))
+                    .push(text::body(e.label.clone()).width(Length::Fill)),
+            )
+            .padding([8, 12])
+            .width(Length::Fill)
+            .class(style::nav_item(false))
+            .on_press(Message::Lapin(Msg::Pick(e.page))),
+        );
+    }
+    if hits.len() > SUGGESTIONS {
+        list = list.push(
+            button::custom(text::body("Show all results").class(cosmic::theme::Text::Accent))
+                .padding([8, 12])
+                .width(Length::Fill)
+                .class(style::nav_item(false))
+                .on_press(Message::Lapin(Msg::ShowResults)),
+        );
+    }
+    container(list).padding(4).width(Length::Fixed(400.0)).class(style::flyout()).into()
+}
+
+/// The "Search results" page (Enter, or "Show all results").
+pub fn results<'a>(index: &'a [Entry], query: &'a str) -> Element<'a, Message> {
+    let hits = find(index, query);
+    let head = container(text::title2(format!("Search results for \u{201C}{}\u{201D}", query.trim()))).padding([4, 0, 20, 0]);
+    let mut list = column::with_capacity(hits.len() + 1).spacing(4);
+    if hits.is_empty() {
+        list = list.push(text::body("No results. Try different words.").class(style::quiet()));
+    }
+    for e in hits {
+        list = list.push(super::view::page_row(&e.icon, e.label.as_str(), e.path.as_str(), Message::Lapin(Msg::Pick(e.page))));
+    }
+    column::with_capacity(2)
+        .push(head)
+        .push(list)
+        .max_width(super::CONTENT_MAX)
+        .width(Length::Fill)
+        .padding([8, 40, 32, 24])
+        .apply(widget::scrollable)
+        .height(Length::Fill)
+        .width(Length::Fill)
+        .into()
+}
