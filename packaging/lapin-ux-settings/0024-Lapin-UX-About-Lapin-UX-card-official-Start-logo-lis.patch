+/// Where the package puts Lapin UX's own data.
+const DATA: &str = "/usr/share/lapin-ux";
+const LICENSE: &str = "/usr/share/licenses/lapin-ux-desktop-git/LICENSE";
+
+/// One line of the credits: what, what for, under which licence, where from.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Credit {
+    pub name: String,
+    pub used_for: String,
+    pub licence: String,
+    pub url: Option<String>,
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct LapinInfo {
+    /// e.g. "0.1.0.r123.g5daa943" (written by the package).
+    pub version: String,
+    pub commit: Option<String>,
+    pub credits: Vec<Credit>,
+}
+
+/// The build commit inside a package version ("….g5daa943").
+pub fn commit_of(version: &str) -> Option<String> {
+    let g = version.rsplit('.').next()?.strip_prefix('g')?;
+    (g.len() >= 7 && g.chars().all(|c| c.is_ascii_hexdigit())).then(|| g.to_string())
+}
+
+/// The credits table in CREDITS.md (shipped with the package, the same file
+/// as in the repository): one row per asset, `| Asset | Used for | Licence |
+/// Where | Source |`, the source being a Markdown link.
+pub fn parse_credits(md: &str) -> Vec<Credit> {
+    let strip = |c: &str| c.trim().replace("**", "").replace('`', "");
+    md.lines()
+        .filter(|l| l.starts_with("| ") && !l.starts_with("| Asset") && !l.starts_with("|---"))
+        .filter_map(|l| {
+            let cells: Vec<&str> = l.trim_matches('|').split(" | ").collect();
+            let [name, used_for, licence, _where, source] = cells[..] else { return None };
+            let url = source.split_once("](").and_then(|(_, rest)| rest.split_once(')')).map(|(u, _)| u.to_string());
+            Some(Credit { name: strip(name), used_for: strip(used_for), licence: strip(licence), url })
+        })
+        .collect()
+}
+
+/// The optional pointer pack, when it's installed (it's downloaded on the
+/// user's computer, never shipped).
+fn pointer_pack_installed() -> bool {
+    let home = std::env::var_os("HOME").map(std::path::PathBuf::from).unwrap_or_default();
+    [home.join(".local/share/icons"), home.join(".icons"), "/usr/share/icons".into()]
+        .iter()
+        .filter_map(|d| std::fs::read_dir(d).ok())
+        .flatten()
+        .flatten()
+        .any(|e| e.file_name().to_string_lossy().starts_with("Cursor-Concept"))
+}
+
+impl LapinInfo {
+    pub fn read() -> Self {
+        let version = read(format!("{DATA}/version")).unwrap_or_default();
+        let mut credits = read(format!("{DATA}/CREDITS.md")).map(|m| parse_credits(&m)).unwrap_or_default();
+        credits.push(Credit {
+            name: "COSMIC, \u{a9} System76".into(),
+            used_for: "The compositor, Settings, pop-ups, lock screen and file dialogs Lapin UX builds on".into(),
+            licence: "GPL-3.0".into(),
+            url: Some("https://github.com/pop-os".into()),
+        });
+        if pointer_pack_installed() {
+            credits.push(Credit {
+                name: "Cursor Concept W11 Tail HDPi, designed by JepriCreations".into(),
+                used_for: "The extra mouse pointers (downloaded on this computer, not redistributed)".into(),
+                licence: "Personal use".into(),
+                url: Some("https://jepricreations.com".into()),
+            });
+        }
+        LapinInfo { commit: commit_of(&version), version, credits }
+    }
 }
 
