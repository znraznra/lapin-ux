+/// About Lapin UX (#63): version and build, credits, license, links.
+fn about_lapin(page: &Page) -> Element<'_, AboutMsg> {
+    let l = &page.lapin.extra.lapin;
+    let open = page.lapin.lapin_open;
+    let head = button::custom(
+        row::with_capacity(4)
+            .spacing(16)
+            .align_y(Alignment::Center)
+            .push(icon::from_name("dev.lapinux.Shell").size(24))
+            .push(text::body("About Lapin UX").width(Length::Fill))
+            .push(button::standard("Copy").on_press(msg(Msg::CopyLapin)))
+            .push(icon::from_name(if open { "pan-up-symbolic" } else { "pan-down-symbolic" }).size(16)),
+    )
+    .padding([14, 16])
+    .width(Length::Fill)
+    .class(super::style::nav_item(false))
+    .on_press(msg(Msg::ToggleLapin));
+    let mut col = column::with_capacity(8).push(head);
+    if open {
+        col = col.push(widget::divider::horizontal::default()).push(facts(lapin_rows(page)));
+        if let Some(c) = &l.commit {
+            col = col.push(
+                container(link(format!("Build {c} on GitHub"), Msg::Open(format!("{PROJECT}/commit/{c}")))).padding([0, 16, 12, 68]),
+            );
+        }
+        // Credits: one row per asset.
+        let mut credits = column::with_capacity(l.credits.len() + 1).spacing(12).push(text::heading("Credits"));
+        for c in &l.credits {
+            let mut info = column::with_capacity(2).spacing(2).push(text::body(c.name.clone())).push(
+                text::caption(format!("{} \u{b7} {}", c.used_for, c.licence)).class(super::style::quiet()),
+            );
+            if let Some(url) = &c.url {
+                info = info.push(link("Source".into(), Msg::Open(url.clone())));
+            }
+            credits = credits.push(info);
+        }
+        col = col.push(widget::divider::horizontal::default()).push(container(credits).padding([16, 16, 18, 68]).width(Length::Fill));
+        // License and the independence notice.
+        let licence = column::with_capacity(4)
+            .spacing(8)
+            .push(text::heading("License"))
+            .push(text::body(
+                "Lapin UX is free software: you can share and change it under the terms of the GNU General Public License, version 3 only. Each asset above keeps its own licence.",
+            ))
+            .push(
+                row::with_capacity(2)
+                    .spacing(24)
+                    .push(link("View license".into(), Msg::Open(LICENSE.into())))
+                    .push(link("gnu.org/licenses/gpl-3.0".into(), Msg::Open("https://www.gnu.org/licenses/gpl-3.0.html".into()))),
+            )
+            .push(
+                text::caption(
+                    "Lapin UX is an independent open-source project. It is not affiliated with, sponsored or endorsed by Microsoft, Canonical, System76 or any other trademark owner.",
+                )
+                .class(super::style::quiet()),
+            );
+        col = col.push(widget::divider::horizontal::default()).push(container(licence).padding([16, 16, 18, 68]).width(Length::Fill));
+        let strip = row::with_capacity(4)
+            .spacing(32)
+            .align_y(Alignment::Center)
+            .push(text::heading("Related links"))
+            .push(link("Project page".into(), Msg::Open(PROJECT.into())))
+            .push(link("Report a problem".into(), Msg::Open(format!("{PROJECT}/issues"))))
+            .push(link("Wiki".into(), Msg::Open(format!("{PROJECT}/wiki"))));
+        col = col.push(widget::divider::horizontal::default()).push(
+            container(strip).padding([16, 16]).width(Length::Fill).class(super::style::link_strip()),
+        );
+    }
+    card(col)
