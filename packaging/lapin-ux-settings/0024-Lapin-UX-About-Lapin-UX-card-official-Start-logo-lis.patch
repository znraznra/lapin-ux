+/// Folders pointer themes are installed in, most personal first.
+fn icon_dirs() -> Vec<std::path::PathBuf> {
+    let home = std::env::var_os("HOME").map(std::path::PathBuf::from).unwrap_or_default();
+    let data_home = std::env::var_os("XDG_DATA_HOME").map(std::path::PathBuf::from).unwrap_or_else(|| home.join(".local/share"));
+    let mut dirs = vec![data_home.join("icons"), home.join(".icons")];
+    let data_dirs = std::env::var("XDG_DATA_DIRS").unwrap_or_else(|_| "/usr/local/share:/usr/share".into());
+    dirs.extend(data_dirs.split(':').filter(|d| !d.is_empty()).map(|d| std::path::PathBuf::from(d).join("icons")));
+    dirs
+}
+
+/// Every installed pointer theme (a folder with `cursors/`), as (folder,
+/// name from its index.theme), sorted by name. The extra pointers (listed
+/// on their own) and the `default` link aren't included (#57).
+fn pointer_themes() -> &'static [(String, String)] {
+    static THEMES: std::sync::OnceLock<Vec<(String, String)>> = std::sync::OnceLock::new();
+    THEMES.get_or_init(|| {
+        let mut found: Vec<(String, String)> = Vec::new();
+        for dir in icon_dirs() {
+            let Ok(entries) = std::fs::read_dir(&dir) else { continue };
+            for e in entries.flatten() {
+                let folder = e.file_name().to_string_lossy().into_owned();
+                if folder == "default" || folder.starts_with("Cursor-Concept") || found.iter().any(|(f, _)| *f == folder) {
+                    continue;
+                }
+                if !e.path().join("cursors").is_dir() {
+                    continue;
+                }
+                let name = std::fs::read_to_string(e.path().join("index.theme"))
+                    .ok()
+                    .and_then(|t| t.lines().find_map(|l| l.strip_prefix("Name=").map(|n| n.trim().to_string())))
+                    .filter(|n| !n.is_empty())
+                    .unwrap_or_else(|| folder.clone());
+                found.push((folder, name));
+            }
+        }
+        found.sort_by_key(|(_, n)| n.to_lowercase());
+        found
+    })
+}
+
