@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Lapin UX: Windows 11's Settings layout on top of COSMIC Settings.
+//!
+//! Everything Lapin adds lives in this module. COSMIC's own pages are not
+//! edited: at start-up they are re-parented under Windows' categories, and
+//! the app's sidebar, page header and category pages are drawn here. The
+//! patch to COSMIC's files is a handful of hooks in `app.rs`, so it rebases
+//! easily onto new COSMIC releases. It only takes effect in a Lapin UX
+//! session (or with `LAPIN_UX_SETTINGS=1`); under COSMIC the app is stock.
+
+mod categories;
+mod style;
+mod view;
+
+pub use categories::{Layout, arrange};
+pub use view::{breadcrumb, category_view, header_start, home_view, sidebar};
+
+use std::sync::OnceLock;
+
+/// True in a Lapin UX session (`XDG_CURRENT_DESKTOP` lists `LapinUX`), or
+/// when `LAPIN_UX_SETTINGS=1` forces it.
+pub fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        if let Ok(v) = std::env::var("LAPIN_UX_SETTINGS") {
+            return v == "1";
+        }
+        std::env::var("XDG_CURRENT_DESKTOP")
+            .is_ok_and(|d| d.split(':').any(|p| p.eq_ignore_ascii_case("LapinUX")))
+    })
+}
+
+/// The window title, as on Windows.
+pub const TITLE: &str = "Settings";
+
+/// Messages from Lapin's parts of the window.
+#[derive(Clone, Debug)]
+pub enum Msg {
+    /// The title bar's back arrow.
+    Back,
+    /// Typing in the sidebar's "Find a setting" box.
+    Search(String),
+    /// Open the Update app (until Update moves into Settings, stage 4).
+    OpenUpdate,
+}
+
+/// Lapin's state inside the app.
+#[derive(Default)]
+pub struct State {
+    pub layout: Layout,
+    /// Pages visited, for the back arrow.
+    pub history: Vec<cosmic_settings_page::Entity>,
+    pub account: view::Account,
+    /// Set by Back so the page it opens isn't added to the history.
+    pub going_back: bool,
+}
+
+impl State {
+    /// Remember the page being left, for Back. Going back doesn't add to it.
+    pub fn visit(&mut self, from: cosmic_settings_page::Entity, to: cosmic_settings_page::Entity) {
+        if std::mem::take(&mut self.going_back) || from == to || from == cosmic_settings_page::Entity::default() {
+            return;
+        }
+        self.history.push(from);
+        if self.history.len() > 64 {
+            self.history.remove(0);
+        }
+    }
+}
+
+/// Opens Lapin UX's Update app.
+pub fn open_update() {
+    let _ = std::process::Command::new("lapin-ux-update").spawn();
+}
