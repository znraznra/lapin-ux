+// SPDX-License-Identifier: GPL-3.0-only
+//! Windows 11's categories, and which of COSMIC's pages go in each.
+
+use cosmic_settings_page::{self as page, Binder, Entity};
+
+use crate::pages::Message;
+
+/// A Windows category (System, Bluetooth & devices…) or Home: a page with no
+/// settings of its own, whose sub-pages are listed as rows.
+pub struct Category {
+    id: &'static str,
+    title: &'static str,
+    icon: &'static str,
+    description: &'static str,
+}
+
+impl page::Page<Message> for Category {
+    fn info(&self) -> page::Info {
+        page::Info::new(self.id, self.icon).title(self.title).description(self.description)
+    }
+}
+
+/// One of COSMIC's pages placed in a category, with Windows' name and
+/// description for it (`None` keeps COSMIC's).
+struct Child {
+    id: &'static str,
+    /// A Fluent outline icon, as Windows uses on its rows.
+    icon: &'static str,
+    title: Option<&'static str>,
+    description: Option<&'static str>,
+}
+
+const fn c(id: &'static str, icon: &'static str, title: &'static str, description: &'static str) -> Child {
+    Child { id, icon, title: Some(title), description: Some(description) }
+}
+
+const fn keep(id: &'static str, icon: &'static str) -> Child {
+    Child { id, icon, title: None, description: None }
+}
+
+struct Spec {
+    id: &'static str,
+    title: &'static str,
+    /// A full-colour icon from the Win11 icon theme.
+    icon: &'static str,
+    description: &'static str,
+    children: &'static [Child],
+}
+
+/// Windows 11's sidebar, top to bottom (Gaming is left out on purpose).
+/// Pages COSMIC has that Windows doesn't are kept for now at the end of the
+/// closest category; stage 3 moves them under "Advanced" or hides them.
+const SPECS: &[Spec] = &[
+    Spec {
+        id: "lapin-system",
+        title: "System",
+        icon: "cs-display",
+        description: "Display, sound, power, about",
+        children: &[
+            c("display", "preferences-desktop-display-symbolic", "Display", "Monitors, brightness, night light, display profile"),
+            c("sound", "audio-volume-high-symbolic", "Sound", "Volume levels, output, input, sound devices"),
+            c("power", "battery-full-symbolic", "Power & battery", "Sleep, battery usage, power mode"),
+            keep("window-management", "preferences-system-windows-symbolic"),
+            keep("workspaces", "view-grid-symbolic"),
+            c("about", "help-about-symbolic", "About", "Device specifications, rename this PC"),
+        ],
+    },
+    Spec {
+        id: "lapin-devices",
+        title: "Bluetooth & devices",
+        icon: "bluetooth",
+        description: "Bluetooth, mouse, touchpad, keyboard",
+        children: &[
+            c("bluetooth", "bluetooth-active-symbolic", "Bluetooth", "Pair, connect and remove devices"),
+            c("mouse", "input-mouse-symbolic", "Mouse", "Buttons, mouse pointer speed, scrolling"),
+            c("touchpad", "input-touchpad-symbolic", "Touchpad", "Taps, gestures, scrolling, zooming"),
+            c("keyboard", "input-keyboard-symbolic", "Keyboard", "Input sources, shortcuts, special characters"),
+            c("drawing-tablet", "input-tablet-symbolic", "Pen & tablet", "Tablet buttons, display mapping"),
+        ],
+    },
+    Spec {
+        id: "lapin-network",
+        title: "Network & internet",
+        icon: "preferences-system-network",
+        description: "Wi-Fi, Ethernet, VPN",
+        children: &[
+            c("wifi", "network-wireless-symbolic", "Wi-Fi", "Connect, manage known networks"),
+            c("wired", "network-wired-symbolic", "Ethernet", "Authentication, IP and DNS settings"),
+            c("vpn", "network-vpn-symbolic", "VPN", "Add, connect, manage"),
+        ],
+    },
+    Spec {
+        id: "lapin-personalization",
+        title: "Personalization",
+        icon: "cs-cat-appearance",
+        description: "Background, colors, themes",
+        children: &[
+            c("wallpaper", "preferences-desktop-wallpaper-symbolic", "Background", "Background images, color, slideshow"),
+            c("appearance", "preferences-color-symbolic", "Colors", "Accent color, transparency effects, light and dark mode"),
+            keep("panel", "user-desktop-symbolic"),
+            keep("dock", "view-app-grid-symbolic"),
+        ],
+    },
+    Spec {
+        id: "lapin-apps",
+        title: "Apps",
+        icon: "applications-all",
+        description: "Default apps, startup",
+        children: &[
+            c("default-apps", "preferences-desktop-default-applications-symbolic", "Default apps", "Defaults for file and link types"),
+            c("startup-apps", "system-run-symbolic", "Startup", "Apps that start automatically when you sign in"),
+            keep("legacy-applications", "window-new-symbolic"),
+        ],
+    },
+    Spec {
+        id: "lapin-accounts",
+        title: "Accounts",
+        icon: "cs-user-accounts",
+        description: "Your account, other users",
+        children: &[c("users", "system-users-symbolic", "Users", "Your account and other people who use this PC")],
+    },
+    Spec {
+        id: "lapin-time",
+        title: "Time & language",
+        icon: "preferences-desktop-locale",
+        description: "Date & time, language & region",
+        children: &[
+            c("time-date", "preferences-system-time-symbolic", "Date & time", "Time zone, automatic clock settings, calendar display"),
+            c("time-region", "preferences-desktop-locale-symbolic", "Language & region", "Display language, preferred languages, regional format"),
+        ],
+    },
+    Spec {
+        id: "lapin-accessibility",
+        title: "Accessibility",
+        icon: "cs-universal-access",
+        description: "Narrator, magnifier, contrast",
+        children: &[
+            c("accessibility", "preferences-desktop-accessibility-symbolic", "Vision", "Narrator, contrast, color filters, invert colors"),
+            c("accessibility_magnifier", "zoom-in-symbolic", "Magnifier", "Zoom level, zoom increment"),
+            c("accessibility_osk", "input-keyboard-symbolic", "Keyboard", "On-screen keyboard"),
+        ],
+    },
+    Spec {
+        id: "lapin-privacy",
+        title: "Privacy & security",
+        icon: "firewall",
+        description: "Security and app permissions",
+        children: &[],
+    },
+    Spec {
+        id: "lapin-update",
+        title: "Update",
+        icon: "system-software-update",
+        description: "Updates for your system, apps and firmware",
+        children: &[],
+    },
+];
+
+pub const HOME_ID: &str = "lapin-home";
+pub const PRIVACY_ID: &str = "lapin-privacy";
+pub const UPDATE_ID: &str = "lapin-update";
+
+/// COSMIC's group pages and the category that replaces each, so links to
+/// them (`cosmic-settings system`, Control Panel…) open the right place.
+const REDIRECTS: &[(&str, &str)] = &[
+    ("system", "lapin-system"),
+    ("desktop", "lapin-personalization"),
+    ("input-devices", "lapin-devices"),
+    ("network-and-wireless", "lapin-network"),
+    ("applications", "lapin-apps"),
+    ("time", "lapin-time"),
+];
+
+/// The sidebar's pages, in order.
+#[derive(Default)]
+pub struct Layout {
+    pub home: Entity,
+    pub categories: Vec<Entity>,
+    redirects: Vec<(Entity, Entity)>,
+}
+
+impl Layout {
+    /// The page to open instead of one of COSMIC's group pages.
+    pub fn redirect(&self, page: Entity) -> Entity {
+        self.redirects.iter().find(|(from, _)| *from == page).map_or(page, |(_, to)| *to)
+    }
+
+    /// The sidebar entry a page belongs to (its top-most ancestor).
+    pub fn top_of(&self, pages: &Binder<Message>, mut page: Entity) -> Entity {
+        while let Some(parent) = pages.info.get(page).and_then(|i| i.parent) {
+            page = parent;
+        }
+        page
+    }
+
+    pub fn is_category(&self, page: Entity) -> bool {
+        page == self.home || self.categories.contains(&page)
+    }
+}
+
+/// Adds Home and the categories, and moves COSMIC's pages under them.
+/// Pages COSMIC doesn't have on this machine (no touchpad support compiled,
+/// say) are simply skipped.
+pub fn arrange(pages: &mut Binder<Message>) -> Layout {
+    let home = pages.register_page(Category {
+        id: HOME_ID,
+        title: "Home",
+        icon: "go-home-symbolic",
+        description: "Recommended settings",
+    });
+    let mut layout = Layout { home, categories: Vec::with_capacity(SPECS.len()), redirects: Vec::new() };
+    for spec in SPECS {
+        let cat = pages.register_page(Category {
+            id: spec.id,
+            title: spec.title,
+            icon: spec.icon,
+            description: spec.description,
+        });
+        let mut kids = Vec::with_capacity(spec.children.len());
+        for child in spec.children {
+            let Some((entity, _)) = pages.find_page_by_id(child.id) else { continue };
+            // Out of its old parent's list…
+            if let Some(old) = pages.info[entity].parent {
+                if let Some(list) = pages.sub_pages.get_mut(old) {
+                    list.retain(|e| *e != entity);
+                }
+            }
+            // …into the category, with Windows' wording.
+            let info = &mut pages.info[entity];
+            info.parent = Some(cat);
+            if let Some(t) = child.title {
+                info.title = t.to_string();
+            }
+            if let Some(d) = child.description {
+                info.description = d.to_string();
+            }
+            info.icon_name = child.icon.into();
+            kids.push(entity);
+        }
+        pages.sub_pages.insert(cat, kids);
+        layout.categories.push(cat);
+    }
+    for (from, to) in REDIRECTS {
+        if let (Some((f, _)), Some((t, _))) = (pages.find_page_by_id(from), pages.find_page_by_id(to)) {
+            layout.redirects.push((f, t));
+        }
+    }
+    layout
+}
+
+/// The category's colour icon (the Win11 icon theme's file, if installed).
+pub fn icon_name(pages: &Binder<Message>, page: Entity) -> String {
+    pages.info.get(page).map(|i| i.icon_name.to_string()).unwrap_or_default()
+}
