+// SPDX-License-Identifier: GPL-3.0-only
+//! Windows 11 looks for Settings' sidebar and rows.
+
+use cosmic::iced::{Background, Border, Color};
+use cosmic::theme::{self, Button};
+use cosmic::widget::{self, button::Catalog};
+
+fn on_bg(t: &cosmic::Theme) -> Color {
+    t.cosmic().on_bg_color().into()
+}
+
+fn tint(t: &cosmic::Theme, alpha: f32) -> Option<Background> {
+    let mut c = on_bg(t);
+    c.a = alpha;
+    Some(Background::Color(c))
+}
+
+/// A sidebar entry: no fill, a soft fill on hover, a stronger one when open.
+pub fn nav_item(selected: bool) -> Button {
+    let fill = move |t: &cosmic::Theme, hover: bool, press: bool| {
+        let mut s = t.active(false, false, &Button::Text);
+        let a = match (selected, hover, press) {
+            (_, _, true) => 0.05,
+            (true, true, _) => 0.10,
+            (true, false, _) => 0.08,
+            (false, true, _) => 0.06,
+            (false, false, _) => 0.0,
+        };
+        s.background = tint(t, a);
+        s.border_radius = 4.0.into();
+        s.text_color = Some(on_bg(t));
+        s.icon_color = Some(on_bg(t));
+        s
+    };
+    Button::Custom {
+        active: Box::new(move |_, t| fill(t, false, false)),
+        disabled: Box::new(move |t| fill(t, false, false)),
+        hovered: Box::new(move |_, t| fill(t, true, false)),
+        pressed: Box::new(move |_, t| fill(t, true, true)),
+    }
+}
+
+/// A row on a category page: its own rounded card, lighter on hover.
+pub fn row_card() -> Button {
+    let fill = move |t: &cosmic::Theme, hover: bool, press: bool| {
+        let mut s = t.active(false, false, &Button::Text);
+        let c = t.cosmic();
+        let base: Color = c.background(t.transparent).component.base.into();
+        let hovered: Color = c.background(t.transparent).component.hover.into();
+        let pressed: Color = c.background(t.transparent).component.pressed.into();
+        s.background = Some(Background::Color(if press {
+            pressed
+        } else if hover {
+            hovered
+        } else {
+            base
+        }));
+        s.border_radius = 4.0.into();
+        s.border_width = 1.0;
+        s.border_color = c.bg_divider().into();
+        s.text_color = Some(on_bg(t));
+        s.icon_color = Some(on_bg(t));
+        s
+    };
+    Button::Custom {
+        active: Box::new(move |_, t| fill(t, false, false)),
+        disabled: Box::new(move |t| fill(t, false, false)),
+        hovered: Box::new(move |_, t| fill(t, true, false)),
+        pressed: Box::new(move |_, t| fill(t, true, true)),
+    }
+}
+
+/// A card holding several rows (Home).
+pub fn card() -> theme::Container<'static> {
+    theme::Container::custom(|t| {
+        let c = t.cosmic();
+        widget::container::Style {
+            background: Some(Color::from(c.background(t.transparent).component.base).into()),
+            border: Border { radius: 8.0.into(), width: 1.0, color: c.bg_divider().into() },
+            text_color: Some(on_bg(t)),
+            icon_color: Some(on_bg(t)),
+            ..Default::default()
+        }
+    })
+}
+
+/// The accent pill beside the open page in the sidebar.
+pub fn pill(visible: bool) -> theme::Container<'static> {
+    theme::Container::custom(move |t| widget::container::Style {
+        background: visible.then(|| Color::from(t.cosmic().accent_color()).into()),
+        border: Border { radius: 2.0.into(), ..Default::default() },
+        ..Default::default()
+    })
+}
+
+/// Grey text: descriptions and the account type.
+pub fn quiet() -> theme::Text {
+    theme::Text::Custom(|t| cosmic::iced::widget::text::Style {
+        color: Some({
+            let mut c = on_bg(t);
+            c.a = 0.72;
+            c
+        }),
+        ..Default::default()
+    })
+}
+
+/// The round picture holder when there's no account picture.
+pub fn avatar_bg() -> theme::Container<'static> {
+    theme::Container::custom(|t| widget::container::Style {
+        background: tint(t, 0.12),
+        border: Border { radius: 999.0.into(), ..Default::default() },
+        icon_color: Some(on_bg(t)),
+        ..Default::default()
+    })
+}
diff --git a/cosmic-settings/src/lapin/view.rs b/cosmic-settings/src/lapin/view.rs
new file mode 100644
index 0000000..04cd0cd
--- /dev/null
+++ b/cosmic-settings/src/lapin/view.rs
@@ -0,0 +1,285 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Windows 11 Settings: the sidebar, the title bar's back arrow, the
+//! breadcrumb page title, category pages and Home.
+
+use std::path::PathBuf;
+use std::sync::LazyLock;
+
+use cosmic::iced::{Alignment, Length};
+use cosmic::widget::{self, button, column, container, icon, row, text};
+use cosmic::{Apply, Element};
+use cosmic_settings_page::{Binder, Entity};
+
+use super::categories::{Layout, PRIVACY_ID, UPDATE_ID};
+use super::{Msg, State, style};
+use crate::app::Message;
+
+pub const SIDEBAR_WIDTH: f32 = 280.0;
+const CONTENT_MAX: f32 = 1000.0;
+
+/// The signed-in person, for the top of the sidebar.
+pub struct Account {
+    pub name: String,
+    pub avatar: Option<PathBuf>,
+}
+
+impl Default for Account {
+    fn default() -> Self {
+        let uid = std::fs::read_to_string("/proc/self/status").ok().and_then(|s| {
+            s.lines()
+                .find_map(|l| l.strip_prefix("Uid:"))
+                .and_then(|v| v.split_whitespace().next().map(str::to_string))
+        });
+        let passwd = std::fs::read_to_string("/etc/passwd").unwrap_or_default();
+        let entry = passwd
+            .lines()
+            .map(|l| l.split(':').map(str::to_string).collect::<Vec<_>>())
+            .find(|f| f.get(2) == uid.as_ref());
+        let login = entry
+            .as_ref()
+            .and_then(|f| f.first().cloned())
+            .or_else(|| std::env::var("USER").ok())
+            .unwrap_or_default();
+        let full = entry
+            .as_ref()
+            .and_then(|f| f.get(4).map(|g| g.split(',').next().unwrap_or("").trim().to_string()))
+            .filter(|g| !g.is_empty());
+        let avatar = [
+            PathBuf::from(format!("/var/lib/AccountsService/icons/{login}")),
+            dirs::home_dir().unwrap_or_default().join(".face"),
+        ]
+        .into_iter()
+        .find(|p| p.exists());
+        Account { name: full.unwrap_or(login), avatar }
+    }
+}
+
+/// A full-colour icon from the Win11 icon theme, falling back to the
+/// system icon of that name.
+fn colour_icon(name: &str) -> icon::Handle {
+    static DIRS: LazyLock<Vec<PathBuf>> = LazyLock::new(|| {
+        let mut bases: Vec<PathBuf> = Vec::new();
+        if let Some(d) = dirs::data_dir() {
+            bases.push(d.join("icons"));
+        }
+        let data = std::env::var("XDG_DATA_DIRS").unwrap_or_else(|_| "/usr/local/share:/usr/share".into());
+        bases.extend(data.split(':').filter(|d| !d.is_empty()).map(|d| PathBuf::from(d).join("icons")));
+        let mut out = Vec::new();
+        for theme in ["Win11-dark", "Win11"] {
+            for base in &bases {
+                for ctx in ["preferences", "apps", "categories", "devices", "places", "status", "actions"] {
+                    for size in ["scalable", "32", "48", "24"] {
+                        out.push(base.join(theme).join(ctx).join(size));
+                    }
+                }
+            }
+        }
+        out
+    });
+    DIRS.iter()
+        .map(|d| d.join(format!("{name}.svg")))
+        .find(|p| p.exists())
+        .map(icon::from_path)
+        .unwrap_or_else(|| icon::from_name(name).handle())
+}
+
+fn avatar(account: &Account, size: f32) -> Element<'static, Message> {
+    match &account.avatar {
+        Some(p) => widget::image(widget::image::Handle::from_path(p))
+            .width(Length::Fixed(size))
+            .height(Length::Fixed(size))
+            .border_radius(size / 2.0)
+            .into(),
+        None => container(icon::from_name("avatar-default-symbolic").size((size * 0.5) as u16))
+            .width(Length::Fixed(size))
+            .height(Length::Fixed(size))
+            .center(Length::Fixed(size))
+            .class(style::avatar_bg())
+            .into(),
+    }
+}
+
+/// Windows 11's Settings sidebar: the account at the top, "Find a setting",
+/// then Home and the categories with their colour icons.
+pub fn sidebar<'a>(pages: &'a Binder<crate::pages::Message>, state: &'a State, active: Entity, query: &'a str) -> Element<'a, Message> {
+    let open = state.layout.top_of(pages, active);
+    let account = row::with_capacity(2)
+        .spacing(16)
+        .align_y(Alignment::Center)
+        .push(avatar(&state.account, 64.0))
+        .push(
+            column::with_capacity(2)
+                .spacing(2)
+                .push(text::heading(state.account.name.clone()))
+                .push(text::caption("Local Account").class(style::quiet())),
+        );
+    let mut search = widget::search_input("Find a setting", query)
+        .on_input(|s| Message::Lapin(Msg::Search(s)))
+        .width(Length::Fill);
+    if !query.is_empty() {
+        search = search.on_clear(Message::Lapin(Msg::Search(String::new())));
+    }
+
+    let mut items = column::with_capacity(state.layout.categories.len() + 1).spacing(4);
+    for &page in std::iter::once(&state.layout.home).chain(state.layout.categories.iter()) {
+        let info = &pages.info[page];
+        let selected = page == open;
+        let entry = row::with_capacity(3)
+            .spacing(14)
+            .align_y(Alignment::Center)
+            .push(
+                container(widget::Space::new().width(3).height(16))
+                    .class(style::pill(selected)),
+            )
+            .push(icon(colour_icon(&info.icon_name)).size(20))
+            .push(text::body(info.title.clone()));
+        items = items.push(
+            button::custom(entry)
+                .padding([9, 12, 9, 0])
+                .width(Length::Fill)
+                .class(style::nav_item(selected))
+                .on_press(Message::Page(page)),
+        );
+    }
+
+    column::with_capacity(3)
+        .push(container(account).padding([4, 4, 20, 4]))
+        .push(container(search).padding([0, 0, 12, 0]))
+        .push(widget::scrollable(items).height(Length::Fill))
+        .width(Length::Fixed(SIDEBAR_WIDTH))
+        .padding([8, 12, 12, 16])
+        .into()
+}
+
+/// Title bar: Windows' back arrow and "Settings" at the left.
+pub fn header_start(state: &State) -> Vec<Element<'_, Message>> {
+    let back = button::custom(icon::from_name("go-previous-symbolic").size(16))
+        .padding([8, 12])
+        .class(style::nav_item(false))
+        .on_press_maybe((!state.history.is_empty()).then_some(Message::Lapin(Msg::Back)));
+    vec![
+        back.into(),
+        text::body(super::TITLE).apply(container).padding([0, 0, 0, 4]).into(),
+    ]
+}
+
+/// The page title as Windows writes it: "System  >  Display", where the
+/// earlier parts are dimmer and take you back up.
+pub fn breadcrumb<'a>(pages: &'a Binder<crate::pages::Message>, page: Entity, own_title: Option<&'a str>) -> Element<'a, Message> {
+    let mut chain = vec![page];
+    let mut at = page;
+    while let Some(parent) = pages.info.get(at).and_then(|i| i.parent) {
+        chain.push(parent);
+        at = parent;
+    }
+    chain.reverse();
+    let last = chain.len() - 1;
+    let mut r = row::with_capacity(chain.len() * 2).spacing(12).align_y(Alignment::Center);
+    for (i, &p) in chain.iter().enumerate() {
+        let title = if i == last { own_title.unwrap_or(pages.info[p].title.as_str()) } else { pages.info[p].title.as_str() };
+        if i == last {
+            r = r.push(text::title2(title));
+        } else {
+            r = r.push(
+                button::custom(text::title2(title).class(style::quiet()))
+                    .padding(0)
+                    .class(cosmic::theme::Button::Text)
+                    .on_press(Message::Page(p)),
+            );
+            r = r.push(icon::from_name("go-next-symbolic").size(16).apply(container).class(cosmic::theme::Container::default()));
+        }
+    }
+    container(r).padding([4, 0, 20, 0]).into()
+}
+
+/// A Windows row: icon, title, grey description, and an arrow at the end.
+fn page_row<'a>(icon_name: &str, title: &'a str, description: &'a str, msg: Message) -> Element<'a, Message> {
+    let mut words = column::with_capacity(2).spacing(2).push(text::body(title));
+    if !description.is_empty() {
+        words = words.push(text::caption(description).class(style::quiet()));
+    }
+    button::custom(
+        row::with_capacity(4)
+            .spacing(16)
+            .align_y(Alignment::Center)
+            .push(icon::from_name(icon_name.to_string()).size(20))
+            .push(words.width(Length::Fill))
+            .push(icon::from_name("go-next-symbolic").size(16)),
+    )
+    .padding([14, 16])
+    .width(Length::Fill)
+    .class(style::row_card())
+    .on_press(msg)
+    .into()
+}
+
+fn page_frame<'a>(head: Element<'a, Message>, body: Element<'a, Message>) -> Element<'a, Message> {
+    let content = column::with_capacity(2)
+        .push(head)
+        .push(body)
+        .max_width(CONTENT_MAX)
+        .width(Length::Fill)
+        .padding([8, 40, 32, 24]);
+    widget::scrollable(content).height(Length::Fill).width(Length::Fill).into()
+}
+
+/// A category: its pages as rows, as on Windows' System page.
+pub fn category_view<'a>(pages: &'a Binder<crate::pages::Message>, page: Entity) -> Element<'a, Message> {
+    let info = &pages.info[page];
+    let body: Element<'a, Message> = if info.id == UPDATE_ID {
+        let card = row::with_capacity(3)
+            .spacing(16)
+            .align_y(Alignment::Center)
+            .push(icon(colour_icon("system-software-update")).size(40))
+            .push(
+                column::with_capacity(2)
+                    .spacing(2)
+                    .push(text::title4("Check for updates"))
+                    .push(text::caption("System, app and firmware updates. Update moves into Settings in a later stage.").class(style::quiet()))
+                    .width(Length::Fill),
+            )
+            .push(button::suggested("Open Update").on_press(Message::Lapin(Msg::OpenUpdate)));
+        container(card).padding(20).width(Length::Fill).class(style::card()).into()
+    } else if info.id == PRIVACY_ID {
+        container(
+            column::with_capacity(2)
+                .spacing(4)
+                .push(text::body("Security and app permissions"))
+                .push(text::caption("These settings arrive in a later stage (Privacy & security).").class(style::quiet())),
+        )
+        .padding(20)
+        .width(Length::Fill)
+        .class(style::card())
+        .into()
+    } else {
+        let kids = pages.sub_pages(page).unwrap_or_default();
+        let mut list = column::with_capacity(kids.len()).spacing(4);
+        for &k in kids {
+            let ki = &pages.info[k];
+            list = list.push(page_row(&ki.icon_name, ki.title.as_str(), ki.description.as_str(), Message::Page(k)));
+        }
+        list.into()
+    };
+    page_frame(breadcrumb(pages, page, None), body)
+}
+
+/// Home: a few cards of the settings people change most, as on Windows.
+pub fn home_view<'a>(pages: &'a Binder<crate::pages::Message>, layout: &'a Layout) -> Element<'a, Message> {
+    let find = |id: &str| pages.find_page_by_id(id).map(|(e, _)| e);
+    let card = |title: &'static str, ids: &[&str]| -> Element<'a, Message> {
+        let mut c = column::with_capacity(ids.len() + 1).spacing(4).push(text::heading(title).apply(container).padding([0, 0, 8, 0]));
+        for id in ids {
+            if let Some(e) = find(id) {
+                let i = &pages.info[e];
+                c = c.push(page_row(&i.icon_name, i.title.as_str(), i.description.as_str(), Message::Page(e)));
+            }
+        }
+        container(c).padding(16).width(Length::Fill).class(style::card()).into()
+    };
+    let body = column::with_capacity(3)
+        .spacing(16)
+        .push(card("Recommended settings", &["display", "sound", "wifi", "bluetooth"]))
+        .push(card("Personalize your device", &["wallpaper", "appearance"]))
+        .push(card("Your account", &["users"]));
+    page_frame(breadcrumb(pages, layout.home, None), body.into())
+}
