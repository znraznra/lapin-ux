+// SPDX-License-Identifier: GPL-3.0-only
+//! Windows pages for settings Lapin UX already has: Personalization >
+//! Taskbar and Start, System > Display > Night light, System > Notifications
+//! and System > Multitasking. They read and write the same settings stores
+//! the Lapin shell and notification daemon watch (`dev.lapinux.Shell`,
+//! `dev.lapinux.Notifications`), so changes apply at once.
+
+use cosmic::{Apply, Element};
+use cosmic::widget::list_column::IntoListItem;
+use cosmic::iced::Length;
+use cosmic::widget::{self, settings, text};
+use cosmic_config::{Config, ConfigGet, ConfigSet};
+use cosmic_settings_page::{self as page, Binder, Section, section};
+use serde::{Deserialize, Serialize};
+use slotmap::SlotMap;
+
+type PMsg = crate::pages::Message;
+
+const SHELL: &str = "dev.lapinux.Shell";
+const NOTIFY: &str = "dev.lapinux.Notifications";
+
+// The shell's own value types, by name (RON stores enum variants by name).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, Default)]
+pub enum Alignment {
+    #[default]
+    Center,
+    Left,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, Default)]
+pub enum Combine {
+    #[default]
+    Always,
+    WhenFull,
+    Never,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, Default)]
+pub enum SmallButtons {
+    Always,
+    #[default]
+    WhenFull,
+    Never,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, Default)]
+pub enum MultiDisplay {
+    #[default]
+    AllTaskbars,
+    WhereOpen,
+    MainAndWhereOpen,
+}
+
+/// The notification daemon's schedule and per-app rules (same field names).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Schedule {
+    pub enabled: bool,
+    pub start: u32,
+    pub end: u32,
+}
+impl Default for Schedule {
+    fn default() -> Self {
+        Schedule { enabled: false, start: 22 * 60, end: 7 * 60 }
+    }
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct AppRule {
+    pub app: String,
+    pub enabled: bool,
+    pub banners: bool,
+}
+
+/// Web search engines offered in Start (`{}` is the query).
+const ENGINES: [(&str, &str); 6] = [
+    ("DuckDuckGo", ""),
+    ("Google", "https://www.google.com/search?q={}"),
+    ("Bing", "https://www.bing.com/search?q={}"),
+    ("Startpage", "https://www.startpage.com/do/search?q={}"),
+    ("Brave Search", "https://search.brave.com/search?q={}"),
+    ("Ecosia", "https://www.ecosia.org/search?q={}"),
+];
+
+/// Night light's range, as in Lapin's shell (warmest to coolest).
+const WARMEST: u32 = 1200;
+const COOLEST: u32 = 6500;
+const DEFAULT_KELVIN: u32 = 4000;
+
+pub fn strength_from_kelvin(k: u32) -> u8 {
+    let k = if k == 0 { DEFAULT_KELVIN } else { k.clamp(WARMEST, COOLEST) };
+    (((COOLEST - k) * 100 + (COOLEST - WARMEST) / 2) / (COOLEST - WARMEST)) as u8
+}
+pub fn kelvin_from_strength(s: u8) -> u32 {
+    COOLEST - (COOLEST - WARMEST) * u32::from(s.min(100)) / 100
+}
+
+/// Every setting these pages show.
+#[derive(Debug, Default)]
+pub struct Prefs {
+    pub show_search: bool,
+    pub touch_keyboard_button: bool,
+    pub alignment: Alignment,
+    pub auto_hide: bool,
+    pub combine: Combine,
+    pub small: SmallButtons,
+    pub multi_display: MultiDisplay,
+    pub desktop_corner: bool,
+    pub peek: bool,
+    pub seconds: bool,
+    pub web_results: bool,
+    pub web_search: String,
+    pub night_on: bool,
+    pub night_strength: u8,
+    pub night_schedule: Option<(u16, u16)>,
+    pub snap_assist: bool,
+    pub dnd: bool,
+    pub dnd_schedule: Schedule,
+    pub rules: Vec<AppRule>,
+    pub apps: Vec<String>,
+}
+
+impl Prefs {
+    pub fn load() -> Prefs {
+        let shell = Config::new(SHELL, 1).ok();
+        let notify = Config::new(NOTIFY, 1).ok();
+        fn get<T: serde::de::DeserializeOwned>(c: &Option<Config>, key: &str) -> Option<T> {
+            c.as_ref()?.get::<T>(key).ok()
+        }
+        let rules: Vec<AppRule> = get(&notify, "app_rules").unwrap_or_default();
+        let mut apps: Vec<String> = get(&notify, "seen_apps").unwrap_or_default();
+        for r in &rules {
+            if !apps.contains(&r.app) {
+                apps.push(r.app.clone());
+            }
+        }
+        apps.sort_by_key(|a| a.to_lowercase());
+        Prefs {
+            show_search: get(&shell, "show_search").unwrap_or(true),
+            touch_keyboard_button: get(&shell, "touch_keyboard_button").unwrap_or(false),
+            alignment: get(&shell, "alignment").unwrap_or_default(),
+            auto_hide: get(&shell, "auto_hide").unwrap_or(false),
+            combine: get(&shell, "combine_buttons").unwrap_or_default(),
+            small: get(&shell, "small_buttons").unwrap_or_default(),
+            multi_display: get(&shell, "multi_display").unwrap_or_default(),
+            desktop_corner: get(&shell, "show_desktop_corner").unwrap_or(true),
+            peek: !get::<bool>(&shell, "no_desktop_peek").unwrap_or(false),
+            seconds: get(&shell, "clock_seconds").unwrap_or(false),
+            web_results: !get::<bool>(&shell, "hide_web_search").unwrap_or(false),
+            web_search: get(&shell, "web_search").unwrap_or_default(),
+            night_on: get(&shell, "night_light").unwrap_or(false),
+            night_strength: strength_from_kelvin(get(&shell, "night_light_kelvin").unwrap_or(0)),
+            night_schedule: get(&shell, "night_light_schedule").unwrap_or(None),
+            snap_assist: !get::<bool>(&shell, "no_snap_assist").unwrap_or(false),
+            dnd: get(&notify, "do_not_disturb").unwrap_or(false),
+            dnd_schedule: get(&notify, "dnd_schedule").unwrap_or_default(),
+            rules,
+            apps,
+        }
+    }
+
+    fn app_enabled(&self, app: &str) -> bool {
+        self.rules.iter().find(|r| r.app == app).is_none_or(|r| r.enabled)
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum Msg {
+    ShowSearch(bool),
+    TouchKeyboard(bool),
+    Alignment(usize),
+    AutoHide(bool),
+    Combine(usize),
+    Small(usize),
+    MultiDisplay(usize),
+    DesktopCorner(bool),
+    Peek(bool),
+    Seconds(bool),
+    WebResults(bool),
+    Engine(usize),
+    NightOn(bool),
+    NightStrength(u8),
+    NightSchedule(bool),
+    NightFrom(usize),
+    NightTo(usize),
+    SnapAssist(bool),
+    Dnd(bool),
+    DndSchedule(bool),
+    DndFrom(usize),
+    DndTo(usize),
+    App(String, bool),
+}
+
+fn save<T: Serialize>(id: &str, key: &str, value: &T) {
+    if let Ok(c) = Config::new(id, 1)
+        && let Err(e) = c.set(key, value)
+    {
+        tracing::warn!("Lapin Settings: saving {id}/{key}: {e}");
+    }
+}
+
+/// Times offered for schedules: every half hour.
+fn time_labels() -> &'static [String] {
+    static T: std::sync::OnceLock<Vec<String>> = std::sync::OnceLock::new();
+    T.get_or_init(|| {
+        (0..48)
+            .map(|i| {
+                let (h, m) = (i / 2, (i % 2) * 30);
+                let h12 = if h % 12 == 0 { 12 } else { h % 12 };
+                format!("{h12}:{m:02} {}", if h < 12 { "AM" } else { "PM" })
+            })
+            .collect()
+    })
+}
+fn slot(minutes: u32) -> usize {
+    ((minutes / 30) as usize).min(47)
+}
+
+/// Applies a change: remembers it and writes it where the shell or the
+/// notification daemon will pick it up.
+pub fn update(pages: &mut Binder<PMsg>, msg: Msg) -> cosmic::app::Task<crate::Message> {
+    let Some(p) = pages.resource_mut::<Prefs>() else { return cosmic::Task::none() };
+    match msg {
+        Msg::ShowSearch(v) => (p.show_search = v, save(SHELL, "show_search", &v)).1,
+        Msg::TouchKeyboard(v) => (p.touch_keyboard_button = v, save(SHELL, "touch_keyboard_button", &v)).1,
+        Msg::Alignment(i) => {
+            p.alignment = if i == 1 { Alignment::Left } else { Alignment::Center };
+            save(SHELL, "alignment", &p.alignment);
+        }
+        Msg::AutoHide(v) => (p.auto_hide = v, save(SHELL, "auto_hide", &v)).1,
+        Msg::Combine(i) => {
+            p.combine = [Combine::Always, Combine::WhenFull, Combine::Never][i.min(2)];
+            save(SHELL, "combine_buttons", &p.combine);
+        }
+        Msg::Small(i) => {
+            p.small = [SmallButtons::Always, SmallButtons::WhenFull, SmallButtons::Never][i.min(2)];
+            save(SHELL, "small_buttons", &p.small);
+        }
+        Msg::MultiDisplay(i) => {
+            p.multi_display = [MultiDisplay::AllTaskbars, MultiDisplay::MainAndWhereOpen, MultiDisplay::WhereOpen][i.min(2)];
+            save(SHELL, "multi_display", &p.multi_display);
+        }
+        Msg::DesktopCorner(v) => (p.desktop_corner = v, save(SHELL, "show_desktop_corner", &v)).1,
+        Msg::Peek(v) => (p.peek = v, save(SHELL, "no_desktop_peek", &!v)).1,
+        Msg::Seconds(v) => (p.seconds = v, save(SHELL, "clock_seconds", &v)).1,
+        Msg::WebResults(v) => (p.web_results = v, save(SHELL, "hide_web_search", &!v)).1,
+        Msg::Engine(i) => {
+            p.web_search = ENGINES[i.min(ENGINES.len() - 1)].1.to_string();
+            save(SHELL, "web_search", &p.web_search);
+        }
+        Msg::NightOn(v) => (p.night_on = v, save(SHELL, "night_light", &v)).1,
+        Msg::NightStrength(s) => {
+            p.night_strength = s;
+            save(SHELL, "night_light_kelvin", &kelvin_from_strength(s));
+        }
+        Msg::NightSchedule(on) => {
+            p.night_schedule = on.then_some(p.night_schedule.unwrap_or((21 * 60, 7 * 60)));
+            save(SHELL, "night_light_schedule", &p.night_schedule);
+        }
+        Msg::NightFrom(i) | Msg::NightTo(i) => {
+            let (mut from, mut to) = p.night_schedule.unwrap_or((21 * 60, 7 * 60));
+            if matches!(msg, Msg::NightFrom(_)) {
+                from = (i * 30) as u16;
+            } else {
+                to = (i * 30) as u16;
+            }
+            p.night_schedule = Some((from, to));
+            save(SHELL, "night_light_schedule", &p.night_schedule);
+        }
+        Msg::SnapAssist(v) => (p.snap_assist = v, save(SHELL, "no_snap_assist", &!v)).1,
+        Msg::Dnd(on) => {
+            p.dnd = on;
+            // The daemon applies it at once over D-Bus (and saves it).
+            return cosmic::task::future(async move {
+                set_dnd(on).await;
+                crate::Message::None
+            });
+        }
+        Msg::DndSchedule(on) => {
+            p.dnd_schedule.enabled = on;
+            save(NOTIFY, "dnd_schedule", &p.dnd_schedule);
+        }
+        Msg::DndFrom(i) => {
+            p.dnd_schedule.start = (i * 30) as u32;
+            save(NOTIFY, "dnd_schedule", &p.dnd_schedule);
+        }
+        Msg::DndTo(i) => {
+            p.dnd_schedule.end = (i * 30) as u32;
+            save(NOTIFY, "dnd_schedule", &p.dnd_schedule);
+        }
+        Msg::App(app, on) => {
+            match p.rules.iter_mut().find(|r| r.app == app) {
+                Some(r) => r.enabled = on,
+                None => p.rules.push(AppRule { app, enabled: on, banners: true }),
+            }
+            save(NOTIFY, "app_rules", &p.rules);
+        }
+    }
+    cosmic::Task::none()
+}
+
+async fn set_dnd(on: bool) {
+    let Ok(conn) = zbus::Connection::session().await else { return };
+    if let Ok(proxy) = zbus::Proxy::new(&conn, NOTIFY, "/dev/lapinux/Notifications", NOTIFY).await {
+        let _ = proxy.set_property("DoNotDisturb", on).await;
+    }
+}
+
+fn m(msg: Msg) -> PMsg {
+    PMsg::Lapin(msg)
+}
+
+fn toggle<'a>(title: &'a str, description: Option<&'a str>, on: bool, f: fn(bool) -> Msg) -> Item<'a> {
+    let mut item = settings::item::builder(title);
+    if let Some(d) = description {
+        item = item.description(d);
+    }
+    item.toggler(on, move |v| m(f(v))).into_list_item()
+}
+
+fn choice<'a>(title: &'a str, description: Option<&'a str>, options: &'static [&'static str], selected: usize, f: fn(usize) -> Msg) -> Item<'a> {
+    let mut item = settings::item::builder(title);
+    if let Some(d) = description {
+        item = item.description(d);
+    }
+    Element::from(item.control(widget::dropdown(options, Some(selected), move |i| m(f(i))))).into_list_item()
+}
+
+fn times<'a>(title: &'a str, minutes: u32, f: fn(usize) -> Msg) -> Item<'a> {
+    settings::item::builder(title)
+        .control(widget::dropdown(time_labels(), Some(slot(minutes)), move |i| m(f(i))))
+        .apply(Element::from)
+        .into_list_item()
+}
+
+fn prefs(binder: &Binder<PMsg>) -> &Prefs {
+    static EMPTY: std::sync::OnceLock<Prefs> = std::sync::OnceLock::new();
+    binder.resource::<Prefs>().unwrap_or_else(|| EMPTY.get_or_init(Prefs::default))
+}
+
+/// A page made of Lapin sections.
+macro_rules! lapin_page {
+    ($name:ident, $id:literal, $icon:literal, $title:literal, $desc:literal, [$(($stitle:expr, $rows:expr)),* $(,)?]) => {
+        #[derive(Default)]
+        pub struct $name {
+            entity: page::Entity,
+        }
+        impl page::Page<PMsg> for $name {
+            fn set_id(&mut self, entity: page::Entity) {
+                self.entity = entity;
+            }
+            fn info(&self) -> page::Info {
+                page::Info::new($id, $icon).title($title).description($desc)
+            }
+            fn content(&self, sections: &mut SlotMap<section::Entity, Section<PMsg>>) -> Option<page::Content> {
+                Some(vec![$(sections.insert(section_view::<$name>($stitle, $rows))),*])
+            }
+        }
+        impl page::AutoBind<PMsg> for $name {}
+    };
+}
+
+type Item<'a> = widget::list_column::ListItem<'a, PMsg>;
+type Rows = for<'a> fn(&'a Binder<PMsg>, &'a Prefs) -> Vec<Item<'a>>;
+
+fn section_view<P: page::Page<PMsg>>(title: &'static str, f: Rows) -> Section<PMsg> {
+    let mut s = Section::default();
+    if !title.is_empty() {
+        s = s.title(title);
+    }
+    s.view::<P>(move |binder, _page, section| {
+        // Built fresh each frame from the shared settings.
+        let rows = f(binder, prefs(binder));
+        let mut sec = settings::section();
+        if !section.title.is_empty() {
+            sec = sec.title(&section.title);
+        }
+        rows.into_iter()
+            .fold(sec, |s, r| match r {
+                widget::list_column::ListItem::Element(e) => s.add(e),
+                widget::list_column::ListItem::Button(b) => s.add(b),
+            })
+            .into()
+    })
+}
+
+// --- Personalization > Taskbar -------------------------------------------
+
+const ALIGN: [&str; 2] = ["Center", "Left"];
+const WHEN: [&str; 3] = ["Always", "When taskbar is full", "Never"];
+const MULTI: [&str; 3] = ["All taskbars", "Main taskbar and taskbar where window is open", "Taskbar where window is open"];
+
+fn taskbar_items<'a>(_: &'a Binder<PMsg>, p: &'a Prefs) -> Vec<Item<'a>> {
+    vec![
+        toggle("Search", Some("Show the Search box on the taskbar"), p.show_search, Msg::ShowSearch),
+        toggle("Touch keyboard", Some("Show the touch keyboard button"), p.touch_keyboard_button, Msg::TouchKeyboard),
+    ]
+}
+
+fn taskbar_behaviors<'a>(_: &'a Binder<PMsg>, p: &'a Prefs) -> Vec<Item<'a>> {
+    let multi = match p.multi_display {
+        MultiDisplay::AllTaskbars => 0,
+        MultiDisplay::MainAndWhereOpen => 1,
+        MultiDisplay::WhereOpen => 2,
+    };
+    vec![
+        choice("Taskbar alignment", None, &ALIGN, usize::from(p.alignment == Alignment::Left), Msg::Alignment),
+        toggle("Automatically hide the taskbar", None, p.auto_hide, Msg::AutoHide),
+        choice("Combine taskbar buttons and hide labels", None, &WHEN, p.combine as usize, Msg::Combine),
+        choice("Show smaller taskbar buttons", None, &WHEN, p.small as usize, Msg::Small),
+        choice("When using multiple displays, show my taskbar apps on", None, &MULTI, multi, Msg::MultiDisplay),
+        toggle("Select the far corner of the taskbar to show the desktop", None, p.desktop_corner, Msg::DesktopCorner),
+        toggle("Peek at the desktop when hovering the far corner", None, p.peek, Msg::Peek),
+        toggle("Show seconds in system tray clock", None, p.seconds, Msg::Seconds),
+    ]
+}
+
+lapin_page!(Taskbar, "lapin-taskbar", "user-desktop-symbolic", "Taskbar", "Taskbar behaviors, system pins", [
+    ("Taskbar items", taskbar_items),
+    ("Taskbar behaviors", taskbar_behaviors),
+]);
+
+// --- Personalization > Start ----------------------------------------------
+
+fn start_rows<'a>(_: &'a Binder<PMsg>, p: &'a Prefs) -> Vec<Item<'a>> {
+    let engine = ENGINES.iter().position(|(_, url)| *url == p.web_search).unwrap_or(0);
+    static NAMES: std::sync::OnceLock<Vec<&'static str>> = std::sync::OnceLock::new();
+    let names: &'static [&'static str] = NAMES.get_or_init(|| ENGINES.iter().map(|(n, _)| *n).collect());
+    vec![
+        toggle("Show web results in search", Some("Offer \"Search the web\" when you search from Start"), p.web_results, Msg::WebResults),
+        choice("Search engine", Some("Used for web results"), names, engine, Msg::Engine),
+    ]
+}
+
+lapin_page!(Start, "lapin-start", "view-app-grid-symbolic", "Start", "Search, web results", [("", start_rows)]);
+
+// --- System > Display > Night light ---------------------------------------
+
+fn night_rows<'a>(_: &'a Binder<PMsg>, p: &'a Prefs) -> Vec<Item<'a>> {
+    let mut rows = vec![
+        toggle("Night light", Some("Use warmer colors to help block blue light"), p.night_on, Msg::NightOn),
+        settings::item::builder("Strength")
+            .control(
+                widget::slider(0..=100, p.night_strength, |v| m(Msg::NightStrength(v)))
+                    .width(Length::Fixed(250.0)),
+            )
+            .apply(Element::from)
+            .into_list_item(),
+        toggle("Schedule night light", None, p.night_schedule.is_some(), Msg::NightSchedule),
+    ];
+    if let Some((from, to)) = p.night_schedule {
+        rows.push(times("Turn on", u32::from(from), Msg::NightFrom));
+        rows.push(times("Turn off", u32::from(to), Msg::NightTo));
+    }
+    rows
+}
+
+lapin_page!(NightLight, "lapin-night-light", "night-light-symbolic", "Night light", "Warmer colors, schedule", [("", night_rows)]);
+
+// --- System > Notifications -----------------------------------------------
+
+fn dnd_rows<'a>(_: &'a Binder<PMsg>, p: &'a Prefs) -> Vec<Item<'a>> {
+    let s = p.dnd_schedule;
+    let mut rows = vec![
+        toggle("Do not disturb", Some("Notifications go straight to the notification center"), p.dnd, Msg::Dnd),
+        toggle("Turn on do not disturb automatically", Some("During these times"), s.enabled, Msg::DndSchedule),
+    ];
+    if s.enabled {
+        rows.push(times("From", s.start, Msg::DndFrom));
+        rows.push(times("To", s.end, Msg::DndTo));
+    }
+    rows
+}
+
+fn app_rows<'a>(_: &'a Binder<PMsg>, p: &'a Prefs) -> Vec<Item<'a>> {
+    if p.apps.is_empty() {
+        return vec![Element::from(text::body("Apps appear here after they send a notification.")).into_list_item()];
+    }
+    p.apps
+        .iter()
+        .map(|app| {
+            let name = app.clone();
+            let on = p.app_enabled(app);
+            settings::item::builder(name.clone())
+                .icon(widget::icon::from_name(name.to_lowercase()).fallback(Some(widget::icon::IconFallback::Names(vec!["application-x-executable-symbolic".into()]))).size(20))
+                .toggler(on, move |v| m(Msg::App(name.clone(), v)))
+                .into_list_item()
+        })
+        .collect()
+}
+
+lapin_page!(Notifications, "lapin-notifications", "preferences-system-notifications-symbolic", "Notifications", "Alerts from apps and system, do not disturb", [
+    ("", dnd_rows),
+    ("Notifications from apps and other senders", app_rows),
+]);
+
+// --- System > Multitasking -------------------------------------------------
+
+fn snap_rows<'a>(_: &'a Binder<PMsg>, p: &'a Prefs) -> Vec<Item<'a>> {
+    vec![toggle(
+        "Snap windows",
+        Some("When I snap a window, suggest what I can snap next to it"),
+        p.snap_assist,
+        Msg::SnapAssist,
+    )]
+}
+
+/// Multitasking's "Advanced": COSMIC's own window and workspace pages.
+fn advanced_rows<'a>(binder: &'a Binder<PMsg>, _: &'a Prefs) -> Vec<Item<'a>> {
+    ["window-management", "workspaces"]
+        .iter()
+        .filter_map(|id| binder.find_page_by_id(id))
+        .map(|(entity, info)| crate::widget::go_next_item(info.title.as_str(), PMsg::Page(entity)).into_list_item())
+        .collect()
+}
+
+lapin_page!(Multitasking, "lapin-multitasking", "view-grid-symbolic", "Multitasking", "Snap windows, desktops", [
+    ("", snap_rows),
+    ("Advanced", advanced_rows),
+]);
+
+/// Registers the pages and the shared settings; returns them by id.
+pub fn register(pages: &mut Binder<PMsg>) {
+    pages.resource_register::<Prefs>();
+    if let Some(p) = pages.resource_mut::<Prefs>() {
+        *p = Prefs::load();
+    }
+    let _ = pages.register::<Taskbar>();
+    let _ = pages.register::<Start>();
+    let _ = pages.register::<NightLight>();
+    let _ = pages.register::<Notifications>();
+    let _ = pages.register::<Multitasking>();
+}
+
+/// Re-reads the settings (when a Lapin page opens), in case the shell or
+/// the notification centre changed them.
+pub fn reload(pages: &mut Binder<PMsg>) {
+    if let Some(p) = pages.resource_mut::<Prefs>() {
+        *p = Prefs::load();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn strength_round_trip() {
+        assert_eq!(strength_from_kelvin(0), strength_from_kelvin(DEFAULT_KELVIN));
+        for s in [0u8, 25, 50, 75, 100] {
+            assert_eq!(strength_from_kelvin(kelvin_from_strength(s)), s);
+        }
+    }
+
+    #[test]
+    fn times() {
+        assert_eq!(time_labels()[0], "12:00 AM");
+        assert_eq!(time_labels()[43], "9:30 PM");
+        assert_eq!(slot(22 * 60), 44);
+    }
+}
+
+/// System > Display gets a "Night light" row at the top, as on Windows,
+/// opening Lapin's Night light page.
+pub fn add_night_light_row(pages: &mut Binder<PMsg>) {
+    let (Some((display, _)), Some((night, _))) = (pages.find_page_by_id("display"), pages.find_page_by_id("lapin-night-light")) else {
+        return;
+    };
+    let row = Section::default().title("Brightness & color").view::<crate::pages::display::Page>(move |binder, _page, section| {
+        let on = prefs(binder).night_on;
+        settings::section()
+            .title(&section.title)
+            .add(crate::widget::go_next_with_item("Night light", text::body(if on { "On" } else { "Off" }), PMsg::Page(night)))
+            .into()
+    });
+    let id = pages.sections.insert(row);
+    if let Some(content) = pages.content.get_mut(display) {
+        content.insert(0, id);
+    }
+}
