From c709dcb9cbd2e3cd4d1924557d593edc5f35518e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 8 Nov 2026 01:53:32 +0800
Subject: [PATCH] Lapin UX: Transparency effects switch, rabbit as the default
 Start icon

- Personalization > Colors has "Transparency effects" in the Lapin
  session (saved in dev.lapinux.Shell, off by default): the taskbar is
  opaque unless it's on (#55).
- Taskbar > Start button icon: the rabbit is Lapin UX's own and listed
  first as the default; the earlier default is "Squares" (#56).

COSMIC's session is unchanged.

Refs #55, Refs #56
---
 cosmic-settings/src/lapin/search.rs           |  1 +
 cosmic-settings/src/lapin/settings.rs         | 13 ++++++++-----
 .../src/pages/desktop/appearance/mod.rs       | 19 +++++++++++++++++++
 .../desktop/appearance/mode_and_colors.rs     |  8 ++++++++
 4 files changed, 36 insertions(+), 5 deletions(-)

diff --git a/cosmic-settings/src/lapin/search.rs b/cosmic-settings/src/lapin/search.rs
index 88c6f3e..8280339 100644
--- a/cosmic-settings/src/lapin/search.rs
+++ b/cosmic-settings/src/lapin/search.rs
@@ -38,6 +38,7 @@ const LAPIN_ROWS: &[(&str, &str)] = &[
     ("lapin-taskbar", "Show seconds in system tray clock"),
     ("time-date", "Show seconds in the taskbar clock"),
     ("display", "Make this my main display"),
+    ("appearance", "Transparency effects"),
     ("lapin-fonts", "System font"),
     ("lapin-fonts", "Monospace font"),
     ("lapin-fonts", "Text smoothing"),
diff --git a/cosmic-settings/src/lapin/settings.rs b/cosmic-settings/src/lapin/settings.rs
index 13c60b2..2ce2fd1 100644
--- a/cosmic-settings/src/lapin/settings.rs
+++ b/cosmic-settings/src/lapin/settings.rs
@@ -963,11 +963,13 @@ lapin_page!(Fonts, "lapin-fonts", "preferences-desktop-font-symbolic", "Fonts",
 lapin_page!(Pointer, "lapin-pointer", "input-mouse-symbolic", "Mouse pointer", "Pointer style, colour, size", [("", pointer_rows)]);
 
 /// Start button pictures (ids the shell knows) and their names.
+/// The rabbit is Lapin UX's own and the default (#56); "squares" was the
+/// earlier default. A saved "rabbit" shows as the default.
 const START_ICONS: [(&str, &str); 6] = [
-    ("", "Lapin UX"),
+    ("", "Rabbit (Lapin UX)"),
+    ("squares", "Squares"),
     ("dots", "Dots"),
     ("circle", "Circle"),
-    ("rabbit", "Rabbit"),
     ("distro", "My system's logo"),
     ("custom", "Custom picture…"),
 ];
@@ -983,11 +985,12 @@ fn start_icon_preview(id: &str) -> widget::icon::Handle {
             });
             match logo {
                 Some(l) => widget::icon::from_name(l).size(32).handle(),
-                None => preset("default"),
+                None => preset("rabbit"),
             }
         }
-        "custom" => custom_start_icon().map(widget::icon::from_path).unwrap_or_else(|| preset("default")),
-        "" => preset("default"),
+        "custom" => custom_start_icon().map(widget::icon::from_path).unwrap_or_else(|| preset("rabbit")),
+        "" | "rabbit" => preset("rabbit"),
+        "squares" => preset("default"),
         other => preset(other),
     }
 }
diff --git a/cosmic-settings/src/pages/desktop/appearance/mod.rs b/cosmic-settings/src/pages/desktop/appearance/mod.rs
index f0575d7..73928be 100644
--- a/cosmic-settings/src/pages/desktop/appearance/mod.rs
+++ b/cosmic-settings/src/pages/desktop/appearance/mod.rs
@@ -65,6 +65,16 @@ pub struct Page {
 
     tk_config: Option<Config>,
     day_time: bool,
+    /// Lapin UX: "Transparency effects" (#55), in dev.lapinux.Shell.
+    lapin_transparency: bool,
+}
+
+/// Lapin UX's own setting: a see-through, blurred taskbar (off by default).
+fn lapin_transparency() -> bool {
+    cosmic::cosmic_config::Config::new("dev.lapinux.Shell", 1)
+        .ok()
+        .and_then(|c| cosmic::cosmic_config::ConfigGet::get::<bool>(&c, "transparency_effects").ok())
+        .unwrap_or(false)
 }
 
 impl Default for Page {
@@ -94,6 +104,7 @@ impl From<theme_manager::Manager> for Page {
             theme_manager,
             tk_config,
             day_time: true,
+            lapin_transparency: lapin_transparency(),
         }
     }
 }
@@ -164,6 +175,8 @@ pub enum Message {
     Glass(f32),
     FrostedPanel(bool),
     FrostedApplets(bool),
+    /// Lapin UX: "Transparency effects".
+    LapinTransparency(bool),
     FrostedSystemInterface(bool),
     FrostedWindows(bool),
 }
@@ -591,6 +604,12 @@ impl Page {
                 });
                 tasks.push(self.drawer.update_frosted_panel(v));
             }
+            Message::LapinTransparency(v) => {
+                self.lapin_transparency = v;
+                if let Ok(c) = cosmic::cosmic_config::Config::new("dev.lapinux.Shell", 1) {
+                    let _ = cosmic::cosmic_config::ConfigSet::set(&c, "transparency_effects", v);
+                }
+            }
             Message::FrostedApplets(v) => {
                 theme_staged = self.theme_manager.set_frosted_applets(v).map(|_| {
                     self.drawer.reset(&self.theme_manager);
diff --git a/cosmic-settings/src/pages/desktop/appearance/mode_and_colors.rs b/cosmic-settings/src/pages/desktop/appearance/mode_and_colors.rs
index 01b31d0..bdb16a2 100644
--- a/cosmic-settings/src/pages/desktop/appearance/mode_and_colors.rs
+++ b/cosmic-settings/src/pages/desktop/appearance/mode_and_colors.rs
@@ -24,9 +24,17 @@ pub fn section() -> Section<crate::pages::Message> {
             let descriptions = &section.descriptions;
             let theme_manager = &page.theme_manager;
 
+            // Lapin UX: "Transparency effects" (the taskbar is opaque unless
+            // it's on, #55). COSMIC's session doesn't show it.
+            let transparency = crate::lapin::enabled().then(|| {
+                settings::item::builder("Transparency effects")
+                    .description("A see-through, blurred taskbar")
+                    .toggler(page.lapin_transparency, Message::LapinTransparency)
+            });
             let mut section = settings::section()
                 .title(&section.title)
                 .add(theme_mode(page, section, &label_keys))
+                .add_maybe(transparency)
                 .add(auto_switch(page, section, &label_keys))
                 .add(accent_color_palette(page, section, &label_keys))
                 .add(application_background(page, section, &label_keys))
-- 
