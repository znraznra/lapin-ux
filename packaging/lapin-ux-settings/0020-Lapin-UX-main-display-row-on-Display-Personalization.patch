+// --- Personalization > Fonts (#40) --------------------------------------------
+
+/// How apps that use the system's font settings (GTK, Qt, Firefox,
+/// Electron) smooth text.
+const TEXT_SMOOTHING: [(&str, &str); 3] = [
+    ("rgb", "Sharper (most screens)"),
+    ("bgr", "Sharper (BGR screens)"),
+    ("grayscale", "Standard"),
+];
+/// Lapin's own text contrast: 0 = as drawn, steps of 0.25 up to 2.
+const TEXT_CONTRAST_STEP: f64 = 0.25;
+const TEXT_CONTRAST_DEFAULT: f64 = 0.5;
+
+/// GTK's settings (swapped per session, so other desktops keep theirs) and
+/// Lapin's session font file (~/.config/lapin-ux/fonts.conf, read only in
+/// the Lapin session) for Qt, Firefox and Electron.
+fn apply_text_smoothing(mode: &str) {
+    let (aa, order, rgba) = match mode {
+        "bgr" => ("rgba", "bgr", "bgr"),
+        "grayscale" => ("grayscale", "rgb", "none"),
+        _ => ("rgba", "rgb", "rgb"),
+    };
+    for (key, value) in [("font-antialiasing", aa), ("font-rgba-order", order), ("font-hinting", "slight")] {
+        let _ = std::process::Command::new("gsettings")
+            .args(["set", "org.gnome.desktop.interface", key, value])
+            .status();
+    }
+    let Some(config) = dirs::config_dir() else { return };
+    let dir = config.join("lapin-ux");
+    let _ = std::fs::create_dir_all(&dir);
+    let xml = format!(
+        "<?xml version=\"1.0\"?>\n<!DOCTYPE fontconfig SYSTEM \"urn:fontconfig:fonts.dtd\">\n\
+         <!-- Written by Settings > Personalization > Fonts; used only in the Lapin UX session. -->\n\
+         <fontconfig>\n  <match target=\"font\">\n\
+         \x20   <edit name=\"antialias\" mode=\"assign\"><bool>true</bool></edit>\n\
+         \x20   <edit name=\"rgba\" mode=\"assign\"><const>{rgba}</const></edit>\n\
+         \x20 </match>\n</fontconfig>\n"
+    );
+    if let Err(e) = std::fs::write(dir.join("fonts.conf"), xml) {
+        tracing::warn!("Lapin Settings: writing the font settings: {e}");
+    }
+}
+
+fn font_rows<'a>(_: &'a Binder<PMsg>, p: &'a Prefs) -> Vec<Item<'a>> {
+    static NAMES: std::sync::OnceLock<Vec<&'static str>> = std::sync::OnceLock::new();
+    let names: &'static [&'static str] = NAMES.get_or_init(|| TEXT_SMOOTHING.iter().map(|(_, n)| *n).collect());
+    let selected = TEXT_SMOOTHING.iter().position(|(id, _)| *id == p.text_smoothing).unwrap_or(0);
+    let step = (p.text_contrast / TEXT_CONTRAST_STEP).round().clamp(0.0, 8.0) as u32;
+    let label = if step == 0 { "Off".to_string() } else { step.to_string() };
+    vec![
+        settings::item::builder("Text smoothing")
+            .description("Sharper suits most screens; pick Standard if letters show coloured edges")
+            .control(widget::dropdown(names, Some(selected), |i| m(Msg::TextSmoothing(i))))
+            .apply(Element::from)
+            .into_list_item(),
+        settings::item::builder("Text contrast")
+            .description("Darker, crisper letters in Lapin UX's own apps. Reopen an app to see it")
+            .control(
+                widget::row::with_capacity(2)
+                    .spacing(12)
+                    .align_y(cosmic::iced::Alignment::Center)
+                    .push(widget::text::body(label))
+                    .push(
+                        widget::slider(0..=8u32, step, |v| m(Msg::TextContrast(v)))
+                            .on_release(m(Msg::TextContrastDone))
+                            .width(Length::Fixed(250.0)),
+                    ),
+            )
+            .apply(Element::from)
+            .into_list_item(),
+    ]
+}
+
+lapin_page!(Fonts, "lapin-fonts", "preferences-desktop-font-symbolic", "Fonts", "Text smoothing, text contrast", [("", font_rows)]);
+
