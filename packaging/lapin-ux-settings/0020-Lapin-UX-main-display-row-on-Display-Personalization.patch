+/// Settings > System > Display > "Make this my main display" (#31): the
+/// chosen monitor's connector name and "make model" (Lapin's shell and
+/// notifications read them; a monitor moved to another port is found by
+/// its model).
+pub fn main_display() -> (String, String) {
+    let c = Config::new(SHELL, 1).ok();
+    let get = |k: &str| c.as_ref().and_then(|c| c.get::<String>(k).ok()).unwrap_or_default();
+    (get("main_display"), get("main_display_model"))
+}
+
+pub fn set_main_display(name: &str, model: &str) {
+    save(SHELL, "main_display", &name.to_string());
+    save(SHELL, "main_display_model", &model.to_string());
+}
+
+/// "Make Model", the same way the shell writes it.
+pub fn display_model(make: Option<&str>, model: &str) -> String {
+    format!("{} {}", make.unwrap_or("").trim(), model.trim()).trim().to_string()
+}
+
+/// Which of `outputs` (connector name, "make model", top-left corner) is
+/// the main display: the chosen one by name, else by model, else a laptop
+/// panel, else the top-left one (the same rule as the shell's).
+pub fn pick_main(outputs: &[(String, String, (i32, i32))], chosen: &(String, String)) -> Option<usize> {
+    let by_name = (!chosen.0.is_empty()).then(|| outputs.iter().position(|(n, _, _)| *n == chosen.0)).flatten();
+    by_name
+        .or_else(|| (!chosen.1.is_empty()).then(|| outputs.iter().position(|(_, m, _)| *m == chosen.1)).flatten())
+        .or_else(|| outputs.iter().position(|(n, _, _)| ["eDP", "LVDS", "DSI"].iter().any(|p| n.starts_with(p))))
+        .or_else(|| outputs.iter().enumerate().min_by_key(|(i, (_, _, (x, y)))| (*y, *x, *i)).map(|(i, _)| i))
+}
