+/// The top of Windows' System page: the wallpaper in a small screen, the
+/// PC's name, model and Rename; at the far right, Update and when it last
+/// checked. Rename opens About (where the name is changed) and Update opens
+/// the Update page.
+fn system_top<'a>(pages: &'a Binder<crate::pages::Message>, state: &'a State) -> Element<'a, Message> {
+    let d = &state.device;
+    let find = |id: &str| pages.find_page_by_id(id).map(|(e, _)| e);
+    let screen: Element<'a, Message> = match &d.wallpaper {
+        Some(p) => widget::image(widget::image::Handle::from_path(p))
+            .content_fit(cosmic::iced::ContentFit::Cover)
+            .width(Length::Fixed(152.0))
+            .height(Length::Fixed(95.0))
+            .border_radius(4.0)
+            .into(),
+        None => widget::Space::new().width(152).height(95).into(),
+    };
+    let screen = container(screen).padding(3).class(style::screen());
+    let mut who = column::with_capacity(3).spacing(2).push(text::title4(d.name.clone()));
+    if let Some(m) = &d.model {
+        who = who.push(text::body(m.clone()).class(style::quiet()));
+    }
+    who = who.push(
+        button::link("Rename")
+            .padding(0)
+            .on_press_maybe(find("about").map(Message::Page)),
+    );
+    let update = button::custom(
+        row::with_capacity(2)
+            .spacing(12)
+            .align_y(Alignment::Center)
+            .push(icon(colour_icon("system-software-update")).size(28))
+            .push(
+                column::with_capacity(2)
+                    .spacing(2)
+                    .push(text::heading("Update"))
+                    .push(text::caption(super::device::last_checked_text(d.last_check, std::time::SystemTime::now())).class(style::quiet())),
+            ),
+    )
+    .padding([8, 12])
+    .class(style::nav_item(false))
+    .on_press_maybe(find(UPDATE_ID).map(Message::Page));
+    row::with_capacity(3)
+        .spacing(20)
+        .align_y(Alignment::Center)
+        .push(screen)
+        .push(who.width(Length::Fill))
+        .push(update)
+        .apply(container)
+        .padding([0, 0, 20, 0])
+        .into()
+}
