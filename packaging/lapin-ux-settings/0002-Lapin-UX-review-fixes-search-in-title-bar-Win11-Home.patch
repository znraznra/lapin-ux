index 0000000..6a36f15
--- /dev/null
+++ b/cosmic-settings/src/lapin/device.rs
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! What the top of Windows' System page shows: the wallpaper in a small
+//! screen, this PC's name and model, and when updates were last checked.
+
+use std::path::PathBuf;
+use std::time::{Duration, SystemTime};
+
+#[derive(Debug, Default, Clone)]
+pub struct Device {
+    /// The computer's name (hostname).
+    pub name: String,
+    /// "Lenovo ThinkPad X1 Carbon Gen 11", when the firmware says.
+    pub model: Option<String>,
+    pub wallpaper: Option<PathBuf>,
+    /// When Lapin UX's Update last looked for updates.
+    pub last_check: Option<SystemTime>,
+}
+
+fn read_trim(path: &str) -> Option<String> {
+    std::fs::read_to_string(path).ok().map(|s| s.trim().to_string()).filter(|s| !s.is_empty())
+}
+
+/// Firmware placeholders that aren't a real model name.
+fn real(s: &str) -> bool {
+    let l = s.to_ascii_lowercase();
+    !["to be filled", "system product name", "default string", "not specified", "o.e.m.", "none"]
+        .iter()
+        .any(|bad| l.contains(bad))
+}
+
+fn model() -> Option<String> {
+    let vendor = read_trim("/sys/class/dmi/id/sys_vendor").filter(|v| real(v));
+    // Lenovo keeps the marketing name in product_version.
+    let product = read_trim("/sys/class/dmi/id/product_version")
+        .filter(|p| vendor.as_deref().is_some_and(|v| v.eq_ignore_ascii_case("LENOVO")) && real(p))
+        .or_else(|| read_trim("/sys/class/dmi/id/product_name").filter(|p| real(p)))?;
+    Some(match vendor {
+        Some(v) if !product.to_lowercase().starts_with(&v.to_lowercase()) => format!("{v} {product}"),
+        _ => product,
+    })
+}
+
+/// The wallpaper COSMIC's background service shows (all screens).
+fn wallpaper() -> Option<PathBuf> {
+    let file = dirs::config_dir()?.join("cosmic/com.system76.CosmicBackground/v1/all");
+    let text = std::fs::read_to_string(file).ok()?;
+    let start = text.find("Path(\"")? + 6;
+    let end = text[start..].find('"')? + start;
+    let path = PathBuf::from(&text[start..end]);
+    path.is_file().then_some(path)
+}
+
+/// Where Lapin UX's Update writes the time of its last check (seconds since
+/// 1970, one number). Shared with crates/lapin-ux-update.
+pub fn last_check_file() -> Option<PathBuf> {
+    Some(dirs::state_dir()?.join("lapin-ux/update-last-check"))
+}
+
+fn last_check() -> Option<SystemTime> {
+    let secs: u64 = std::fs::read_to_string(last_check_file()?).ok()?.trim().parse().ok()?;
+    Some(SystemTime::UNIX_EPOCH + Duration::from_secs(secs))
+}
+
+impl Device {
+    pub fn read() -> Self {
+        Device {
+            name: read_trim("/proc/sys/kernel/hostname").or_else(|| read_trim("/etc/hostname")).unwrap_or_else(|| "This PC".into()),
+            model: model(),
+            wallpaper: wallpaper(),
+            last_check: last_check(),
+        }
+    }
+}
+
+/// "Last checked: 3 hours ago", as on Windows.
+pub fn last_checked_text(when: Option<SystemTime>, now: SystemTime) -> String {
+    let Some(when) = when else { return "Not checked yet".into() };
+    let secs = now.duration_since(when).map(|d| d.as_secs()).unwrap_or(0);
+    let ago = |n: u64, unit: &str| format!("{n} {unit}{} ago", if n == 1 { "" } else { "s" });
+    let text = match secs {
+        0..60 => "just now".to_string(),
+        60..3600 => ago(secs / 60, "minute"),
+        3600..86400 => ago(secs / 3600, "hour"),
+        _ => ago(secs / 86400, "day"),
+    };
+    format!("Last checked: {text}")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn checked_text() {
+        let now = SystemTime::UNIX_EPOCH + Duration::from_secs(1_000_000);
+        let at = |s: u64| Some(now - Duration::from_secs(s));
+        assert_eq!(last_checked_text(None, now), "Not checked yet");
+        assert_eq!(last_checked_text(at(5), now), "Last checked: just now");
+        assert_eq!(last_checked_text(at(60), now), "Last checked: 1 minute ago");
+        assert_eq!(last_checked_text(at(3 * 3600 + 5), now), "Last checked: 3 hours ago");
+        assert_eq!(last_checked_text(at(2 * 86400), now), "Last checked: 2 days ago");
+    }
+
+    #[test]
+    fn placeholders() {
+        assert!(!real("To Be Filled By O.E.M."));
+        assert!(!real("System Product Name"));
+        assert!(real("ThinkPad X1 Carbon Gen 11"));
+    }
+}
