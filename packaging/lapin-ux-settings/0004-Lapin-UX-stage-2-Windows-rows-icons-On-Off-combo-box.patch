+// SPDX-License-Identifier: GPL-3.0-only
+//! Rows COSMIC shows as lists or segmented buttons, drawn as Windows 11
+//! draws them: one row with a drop-down. Each COSMIC page calls in here from
+//! a single `if crate::lapin::enabled()` line, so the page code is untouched
+//! otherwise.
+
+use cosmic::Element;
+use cosmic::widget::{self, segmented_button, settings};
+
+use crate::pages::input;
+use crate::pages::power::{self, backend::PowerProfile};
+
+/// Windows' names for the power modes.
+const POWER_MODES: [&str; 3] = ["Best power efficiency", "Balanced", "Best performance"];
+const POWER_PROFILES: [PowerProfile; 3] = [PowerProfile::Battery, PowerProfile::Balanced, PowerProfile::Performance];
+
+/// System > Power & battery: "Power mode" with a drop-down.
+pub fn power_mode_row<'a>(available: &[PowerProfile], current: PowerProfile) -> Element<'a, power::Message> {
+    let _ = available;
+    let selected = POWER_PROFILES.iter().position(|p| *p == current);
+    settings::item::builder("Power mode")
+        .description("Optimize your device based on power use and performance")
+        .control(widget::dropdown(&POWER_MODES[..], selected, |i| {
+            power::Message::PowerProfileChange(POWER_PROFILES[i.min(2)])
+        }))
+        .into()
+}
+
+const BUTTONS: [&str; 2] = ["Left", "Right"];
+
+/// Bluetooth & devices > Mouse: "Primary mouse button" with a drop-down.
+pub fn primary_button_row<'a>(model: &segmented_button::SingleSelectModel) -> Element<'a, input::Message> {
+    let left = model.iter().next();
+    let right = model.iter().nth(1);
+    let selected = model.position(model.active()).map(usize::from);
+    settings::item::builder("Primary mouse button")
+        .control(widget::dropdown(&BUTTONS[..], selected, move |i| {
+            let entity = if i == 0 { left } else { right };
+            input::Message::PrimaryButtonSelected(entity.unwrap_or_default(), false)
+        }))
+        .into()
+}
+
+/// A row whose control is a button, as Windows places "Add a language",
+/// "Add" and similar buttons: inside the row, at the right.
+pub fn button_row<'a, M: Clone + 'static>(title: &'a str, description: &'a str, label: &'a str, msg: M) -> Element<'a, M> {
+    settings::item::builder(title)
+        .description(description)
+        .control(widget::button::standard(label).on_press(msg))
+        .into()
+}
