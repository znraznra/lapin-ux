+    ("photos", "image-x-generic-symbolic"),
+    ("calendar", "x-office-calendar-symbolic"),
+    ("terminal", "utilities-terminal-symbolic"),
+    ("text editor", "accessories-text-editor-symbolic"),
+    // About
+    ("device name", "computer-symbolic"),
+    ("hardware model", "computer-symbolic"),
+    ("memory", "utilities-system-monitor-symbolic"),
+    ("processor", "applications-system-symbolic"),
+    ("graphics", "video-display-symbolic"),
+    ("disk", "drive-harddisk-symbolic"),
+    ("operating system", "computer-symbolic"),
+    ("windowing system", "preferences-system-windows-symbolic"),
+];
+
+pub fn row_icon(title: &str) -> Option<&'static str> {
+    let t = title.to_lowercase();
+    RULES.iter().find(|(k, _)| t.contains(k)).map(|(_, icon)| *icon)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::row_icon;
+
+    #[test]
+    fn picks() {
+        assert_eq!(row_icon("Night light"), Some("night-light-symbolic"));
+        assert_eq!(row_icon("Refresh rate"), Some("view-refresh-symbolic"));
+        assert_eq!(row_icon("Time zone"), Some("web-browser-symbolic"));
+        assert_eq!(row_icon("Automatically switch between light and dark modes"), Some("preferences-desktop-theme-symbolic"));
+        assert_eq!(row_icon("Something else"), None);
+    }
+}
