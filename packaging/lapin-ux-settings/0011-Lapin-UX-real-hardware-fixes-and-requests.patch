+/// Start button pictures (ids the shell knows) and their names.
+const START_ICONS: [(&str, &str); 6] = [
+    ("", "Lapin UX"),
+    ("dots", "Dots"),
+    ("circle", "Circle"),
+    ("rabbit", "Rabbit"),
+    ("distro", "My system's logo"),
+    ("custom", "Custom picture…"),
+];
+
+const PRESET_DIR: &str = "/usr/share/lapin-ux/start-icons";
+
+fn start_icon_preview(id: &str) -> widget::icon::Handle {
+    let preset = |name: &str| widget::icon::from_path(std::path::PathBuf::from(format!("{PRESET_DIR}/{name}.svg")));
+    match id {
+        "distro" => {
+            let logo = std::fs::read_to_string("/etc/os-release").ok().and_then(|t| {
+                t.lines().find_map(|l| l.strip_prefix("LOGO=").map(|v| v.trim_matches('"').to_string()))
+            });
+            match logo {
+                Some(l) => widget::icon::from_name(l).size(32).handle(),
+                None => preset("default"),
+            }
+        }
+        "custom" => custom_start_icon().map(widget::icon::from_path).unwrap_or_else(|| preset("default")),
+        "" => preset("default"),
+        other => preset(other),
+    }
+}
+
+fn data_home() -> Option<std::path::PathBuf> {
+    std::env::var_os("XDG_DATA_HOME")
+        .map(std::path::PathBuf::from)
+        .filter(|p| p.is_absolute())
+        .or_else(|| std::env::var_os("HOME").map(|h| std::path::PathBuf::from(h).join(".local/share")))
+}
+
+fn custom_start_icon() -> Option<std::path::PathBuf> {
+    let d = data_home()?.join("lapin-ux");
+    ["svg", "png"].iter().map(|e| d.join(format!("start-icon.{e}"))).find(|p| p.is_file())
+}
+
+fn copy_start_icon(src: &std::path::Path) -> std::io::Result<()> {
+    let ext = match src.extension().and_then(|e| e.to_str()).map(str::to_ascii_lowercase).as_deref() {
+        Some("svg") => "svg",
+        Some("png") => "png",
+        _ => return Err(std::io::Error::other("only SVG and PNG pictures can be used")),
+    };
+    let dir = data_home().ok_or_else(|| std::io::Error::other("no home folder"))?.join("lapin-ux");
+    std::fs::create_dir_all(&dir)?;
+    for old in ["svg", "png"] {
+        let _ = std::fs::remove_file(dir.join(format!("start-icon.{old}")));
+    }
+    std::fs::copy(src, dir.join(format!("start-icon.{ext}")))?;
+    Ok(())
+}
+
+fn start_icon_row<'a>(p: &'a Prefs) -> Item<'a> {
+    static NAMES: std::sync::OnceLock<Vec<&'static str>> = std::sync::OnceLock::new();
+    let names: &'static [&'static str] = NAMES.get_or_init(|| START_ICONS.iter().map(|(_, n)| *n).collect());
+    let selected = START_ICONS.iter().position(|(id, _)| *id == p.start_icon).unwrap_or(0);
+    let mut controls = widget::row::with_capacity(3)
+        .spacing(12)
+        .align_y(cosmic::iced::Alignment::Center)
+        .push(widget::icon(start_icon_preview(&p.start_icon)).size(24))
+        .push(widget::dropdown(names, Some(selected), |i| m(Msg::StartIcon(i))));
+    if p.start_icon == "custom" {
+        controls = controls.push(widget::button::standard("Browse").on_press(m(Msg::StartIconBrowse)));
+    }
+    settings::item::builder("Start button icon")
+        .description("One of Lapin UX's pictures, your system's logo or a picture of your own")
+        .control(controls)
+        .apply(Element::from)
+        .into_list_item()
+}
+
+fn taskbar_icon_rows<'a>(_: &'a Binder<PMsg>, p: &'a Prefs) -> Vec<Item<'a>> {
+    vec![start_icon_row(p)]
+}
+
 lapin_page!(Taskbar, "lapin-taskbar", "user-desktop-symbolic", "Taskbar", "Taskbar behaviors, system pins", [
     ("Taskbar items", taskbar_items),
     ("Taskbar behaviors", taskbar_behaviors),
+    ("Start button", taskbar_icon_rows),
 ]);
 
