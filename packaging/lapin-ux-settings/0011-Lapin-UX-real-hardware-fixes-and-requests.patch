+fn round_picture(path: &std::path::Path) -> Option<widget::image::Handle> {
+    static CACHE: std::sync::Mutex<Option<(PathBuf, Option<widget::image::Handle>)>> = std::sync::Mutex::new(None);
+    let mut cache = CACHE.lock().ok()?;
+    if let Some((p, h)) = cache.as_ref()
+        && p == path
+    {
+        return h.clone();
+    }
+    const SIDE: u32 = 192;
+    let made = (|| {
+        let img = image::ImageReader::open(path).ok()?.with_guessed_format().ok()?.decode().ok()?;
+        let (w, h) = (img.width(), img.height());
+        let side = w.min(h).max(1);
+        let sq = img.crop_imm((w - side) / 2, (h - side) / 2, side, side);
+        let mut rgba = sq.resize_exact(SIDE, SIDE, image::imageops::FilterType::CatmullRom).to_rgba8();
+        let r = SIDE as f32 / 2.0;
+        for (x, y, px) in rgba.enumerate_pixels_mut() {
+            let (dx, dy) = (x as f32 + 0.5 - r, y as f32 + 0.5 - r);
+            let cover = (r - (dx * dx + dy * dy).sqrt() + 0.5).clamp(0.0, 1.0);
+            px[3] = (px[3] as f32 * cover).round() as u8;
+        }
+        Some(widget::image::Handle::from_rgba(SIDE, SIDE, rgba.into_raw()))
+    })();
+    *cache = Some((path.to_path_buf(), made.clone()));
+    made
+}
+
 fn avatar(account: &Account, size: f32) -> Element<'static, Message> {
     match &account.avatar {
-        Some(p) => widget::image(widget::image::Handle::from_path(p))
+        // Cut to a circle once (centre square), so a picture of any shape
+        // is round, like Windows'.
+        Some(p) => widget::image(round_picture(p).unwrap_or_else(|| widget::image::Handle::from_path(p)))
             .width(Length::Fixed(size))
             .height(Length::Fixed(size))
-            .border_radius(size / 2.0)
+            .content_fit(cosmic::iced::ContentFit::Fill)
             .into(),
         None => container(icon::from_name("avatar-default-symbolic").size((size * 0.5) as u16))
             .width(Length::Fixed(size))
