 cosmic-settings/src/lapin/search.rs    |  1 +
 cosmic-settings/src/lapin/settings.rs  | 10 ++++++++++
 cosmic-settings/src/pages/time/date.rs | 16 ++++++++++++++++
 4 files changed, 28 insertions(+)

