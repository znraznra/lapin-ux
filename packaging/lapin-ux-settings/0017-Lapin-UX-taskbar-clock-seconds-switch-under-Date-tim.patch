+++ b/cosmic-settings/src/lapin/settings.rs
@@ -230,6 +230,16 @@ pub enum Msg {
     SignIn(super::signin::Msg),
 }
 
+/// The taskbar clock's "show seconds" switch (`dev.lapinux.Shell`
+/// `clock_seconds`), shared by Taskbar behaviors and Date & time (#38).
+pub fn taskbar_seconds() -> bool {
+    Config::new(SHELL, 1).ok().and_then(|c| c.get::<bool>("clock_seconds").ok()).unwrap_or(false)
+}
+
+pub fn set_taskbar_seconds(on: bool) {
+    save(SHELL, "clock_seconds", &on);
+}
+
 fn save<T: Serialize>(id: &str, key: &str, value: &T) {
     if let Ok(c) = Config::new(id, 1)
         && let Err(e) = c.set(key, value)
