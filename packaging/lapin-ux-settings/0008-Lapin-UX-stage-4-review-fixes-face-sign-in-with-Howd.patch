+/// Howdy's state for this user (lapin-ux-howdy ships with Lapin UX).
+async fn face_status() -> Face {
+    match rows::output("lapin-ux-howdy", &["status", &login()]).await {
+        Ok(out) => Face::parse(&out),
+        Err(_) => Face::default(),
+    }
+}
+
+/// Runs a lapin-ux-howdy command as root (the admin prompt asks first).
+async fn howdy_root(args: &[&str]) -> Result<(), String> {
+    let helper = which::which("lapin-ux-howdy").map_err(|_| "lapin-ux-howdy is missing.".to_string())?;
+    let helper = helper.to_string_lossy().into_owned();
+    let mut all = vec![helper.as_str()];
+    all.extend_from_slice(args);
+    rows::output("pkexec", &all).await.map(drop)
+}
