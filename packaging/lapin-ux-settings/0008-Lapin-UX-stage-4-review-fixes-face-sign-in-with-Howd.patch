+/// What `lapin-ux-howdy status` reports.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Face {
+    pub installed: bool,
+    pub faces: usize,
+    pub on: bool,
+    /// (device path, name), infrared cameras first.
+    pub cameras: Vec<(String, String)>,
+    /// The cameras' names, for the drop-down.
+    pub names: Vec<String>,
+}
+
+impl Face {
+    pub fn parse(out: &str) -> Face {
+        let mut f = Face::default();
+        for l in out.lines() {
+            let Some((k, v)) = l.split_once('=') else { continue };
+            match k {
+                "installed" => f.installed = v == "yes",
+                "faces" => f.faces = v.trim().parse().unwrap_or(0),
+                "pam" => f.on = v == "yes",
+                "cam" => {
+                    let (path, name) = v.split_once('\t').unwrap_or((v, v));
+                    f.cameras.push((path.to_string(), name.to_string()));
+                    f.names.push(name.to_string());
+                }
+                _ => {}
+            }
+        }
+        f
+    }
 }
 
