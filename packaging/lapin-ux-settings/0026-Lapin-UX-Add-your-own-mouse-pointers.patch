@@ -0,0 +1,226 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Adding and removing pointer themes (#57): unpack an archive or copy a
+//! folder into `~/.local/share/icons`, and remember what was added so only
+//! those can be removed from Settings. System themes and themes the user
+//! installed some other way are never touched.
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+const MAX_DEPTH: usize = 3;
+
+/// `~/.local/state/lapin-ux/pointers-added`: one folder name per line.
+pub fn state_file() -> PathBuf {
+    let home = std::env::var_os("HOME").map(PathBuf::from).unwrap_or_default();
+    let state = std::env::var_os("XDG_STATE_HOME").map(PathBuf::from).unwrap_or_else(|| home.join(".local/state"));
+    state.join("lapin-ux").join("pointers-added")
+}
+
+/// `~/.local/share/icons`, where added themes go.
+pub fn icons_dir() -> PathBuf {
+    let home = std::env::var_os("HOME").map(PathBuf::from).unwrap_or_default();
+    std::env::var_os("XDG_DATA_HOME").map(PathBuf::from).unwrap_or_else(|| home.join(".local/share")).join("icons")
+}
+
+pub fn added(state: &Path) -> Vec<String> {
+    std::fs::read_to_string(state).unwrap_or_default().lines().map(str::trim).filter(|l| !l.is_empty()).map(String::from).collect()
+}
+
+fn remember(state: &Path, name: &str) -> std::io::Result<()> {
+    let mut all = added(state);
+    if !all.iter().any(|n| n == name) {
+        all.push(name.to_string());
+    }
+    if let Some(dir) = state.parent() {
+        std::fs::create_dir_all(dir)?;
+    }
+    std::fs::write(state, all.join("\n") + "\n")
+}
+
+/// Folders under `root` (down to a few levels) that hold a `cursors/` folder.
+pub fn find_themes(root: &Path) -> Vec<PathBuf> {
+    fn walk(dir: &Path, depth: usize, out: &mut Vec<PathBuf>) {
+        if dir.join("cursors").is_dir() {
+            out.push(dir.to_path_buf());
+            return;
+        }
+        if depth >= MAX_DEPTH {
+            return;
+        }
+        let Ok(rd) = std::fs::read_dir(dir) else { return };
+        let mut subs: Vec<PathBuf> = rd.flatten().map(|e| e.path()).filter(|p| p.is_dir() && !p.is_symlink()).collect();
+        subs.sort();
+        for s in subs {
+            walk(&s, depth + 1, out);
+        }
+    }
+    let mut out = Vec::new();
+    walk(root, 0, &mut out);
+    out
+}
+
+fn copy_dir(from: &Path, to: &Path) -> std::io::Result<()> {
+    std::fs::create_dir_all(to)?;
+    for e in std::fs::read_dir(from)? {
+        let e = e?;
+        let (src, dst) = (e.path(), to.join(e.file_name()));
+        let ty = e.file_type()?;
+        if ty.is_symlink() {
+            // Pointer themes link names to each other (left_ptr -> default); keep links
+            // that stay inside the theme, drop the rest.
+            let target = std::fs::read_link(&src)?;
+            if target.is_relative() && !target.components().any(|c| matches!(c, std::path::Component::ParentDir)) {
+                let _ = std::os::unix::fs::symlink(target, dst);
+            }
+        } else if ty.is_dir() {
+            copy_dir(&src, &dst)?;
+        } else {
+            std::fs::copy(&src, &dst)?;
+        }
+    }
+    Ok(())
+}
+
+/// A folder name that is safe to create under the icons folder.
+fn safe_name(raw: &str) -> String {
+    let n: String = raw.chars().map(|c| if c.is_alphanumeric() || matches!(c, '-' | '_' | '.' | ' ') { c } else { '_' }).collect();
+    let n = n.trim().trim_matches('.').to_string();
+    if n.is_empty() || n == "default" { "pointers".into() } else { n }
+}
+
+/// Unpacks an archive (`.tar.gz`, `.tar.xz`, `.zip`…) into a scratch folder.
+fn unpack(archive: &Path, into: &Path) -> Result<(), String> {
+    for tool in ["bsdtar", "tar"] {
+        match Command::new(tool).arg("-xf").arg(archive).arg("-C").arg(into).output() {
+            Ok(o) if o.status.success() => return Ok(()),
+            Ok(_) => continue,
+            Err(_) => continue,
+        }
+    }
+    Err("This file couldn't be opened. Use a .tar.gz, .tar.xz or .zip file, or a folder.".into())
+}
+
+/// Adds the pointer theme(s) in `source` (an archive or a folder) under `icons`.
+/// Returns the folder names added. Existing folders of the same name are not replaced.
+pub fn add(source: &Path, icons: &Path, state: &Path, scratch_parent: &Path) -> Result<Vec<String>, String> {
+    const NOT_POINTERS: &str = "This doesn't look like a pointer theme (it has no \"cursors\" folder).";
+    let scratch = scratch_parent.join(format!("lapin-pointers-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&scratch);
+    std::fs::create_dir_all(&scratch).map_err(|e| format!("Couldn't prepare the files: {e}"))?;
+    let result = (|| {
+        let root = if source.is_dir() {
+            source.to_path_buf()
+        } else {
+            unpack(source, &scratch)?;
+            scratch.clone()
+        };
+        let mut themes = find_themes(&root);
+        if themes.is_empty() {
+            return Err(NOT_POINTERS.to_string());
+        }
+        std::fs::create_dir_all(icons).map_err(|e| format!("Couldn't use {}: {e}", icons.display()))?;
+        let mut done = Vec::new();
+        for t in themes.drain(..) {
+            let raw = t.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default();
+            // A bare folder or archive root has no useful name: use the file's.
+            let raw = if t == root && !source.is_dir() { source.file_stem().map(|n| n.to_string_lossy().into_owned()).unwrap_or(raw.clone()) } else { raw };
+            let name = safe_name(raw.trim_end_matches(".tar"));
+            let dest = icons.join(&name);
+            if dest.exists() {
+                return Err(format!("You already have a pointer theme called \"{name}\"."));
+            }
+            copy_dir(&t, &dest).map_err(|e| {
+                let _ = std::fs::remove_dir_all(&dest);
+                format!("Couldn't copy the pointers: {e}")
+            })?;
+            remember(state, &name).map_err(|e| format!("Couldn't note the new pointers: {e}"))?;
+            done.push(name);
+        }
+        Ok(done)
+    })();
+    let _ = std::fs::remove_dir_all(&scratch);
+    result
+}
+
+/// Removes a theme this tool added (and only that).
+pub fn remove(name: &str, icons: &Path, state: &Path) -> Result<(), String> {
+    if name.contains('/') || name.is_empty() || !added(state).iter().any(|n| n == name) {
+        return Err("Only pointers added here can be removed here.".into());
+    }
+    let dir = icons.join(name);
+    if dir.is_dir() && !dir.is_symlink() {
+        std::fs::remove_dir_all(&dir).map_err(|e| format!("Couldn't remove them: {e}"))?;
+    }
+    let rest: Vec<String> = added(state).into_iter().filter(|n| n != name).collect();
+    std::fs::write(state, if rest.is_empty() { String::new() } else { rest.join("\n") + "\n" }).map_err(|e| e.to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn tmp(tag: &str) -> PathBuf {
+        let d = std::env::temp_dir().join(format!("lapin-ptr-{tag}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&d);
+        std::fs::create_dir_all(&d).unwrap();
+        d
+    }
+
+    fn make_theme(dir: &Path) {
+        std::fs::create_dir_all(dir.join("cursors")).unwrap();
+        std::fs::write(dir.join("cursors/left_ptr"), b"x").unwrap();
+        std::os::unix::fs::symlink("left_ptr", dir.join("cursors/arrow")).unwrap();
+        std::os::unix::fs::symlink("../../etc/passwd", dir.join("cursors/evil")).unwrap();
+        std::fs::write(dir.join("index.theme"), "[Icon Theme]\nName=Test\n").unwrap();
+    }
+
+    #[test]
+    fn finds_nested_themes() {
+        let root = tmp("find");
+        make_theme(&root.join("a/Bibata"));
+        make_theme(&root.join("Other"));
+        std::fs::create_dir_all(root.join("docs")).unwrap();
+        let found = find_themes(&root);
+        assert_eq!(found.len(), 2);
+        assert!(found.iter().any(|p| p.ends_with("Bibata")));
+        let _ = std::fs::remove_dir_all(&root);
+    }
+
+    #[test]
+    fn adds_a_folder_then_removes_only_what_it_added() {
+        let (src, icons, st) = (tmp("src"), tmp("icons"), tmp("state").join("added"));
+        make_theme(&src.join("MyPointers"));
+        let scratch = tmp("scratch");
+        let done = add(&src.join("MyPointers"), &icons, &st, &scratch).unwrap();
+        assert_eq!(done, ["MyPointers"]);
+        assert!(icons.join("MyPointers/cursors/left_ptr").exists());
+        // The harmless link stays, the one that points out of the theme is dropped.
+        assert!(icons.join("MyPointers/cursors/arrow").is_symlink());
+        assert!(!icons.join("MyPointers/cursors/evil").exists() && !icons.join("MyPointers/cursors/evil").is_symlink());
+        assert_eq!(added(&st), ["MyPointers"]);
+        // A second add of the same name is refused, not overwritten.
+        assert!(add(&src.join("MyPointers"), &icons, &st, &scratch).unwrap_err().contains("already have"));
+        // A theme the user installed some other way can't be removed here.
+        make_theme(&icons.join("Mine"));
+        assert!(remove("Mine", &icons, &st).is_err());
+        assert!(icons.join("Mine").exists());
+        remove("MyPointers", &icons, &st).unwrap();
+        assert!(!icons.join("MyPointers").exists());
+        assert!(added(&st).is_empty());
+    }
+
+    #[test]
+    fn adds_an_archive_and_refuses_a_non_theme() {
+        let (src, icons, st, scratch) = (tmp("asrc"), tmp("aicons"), tmp("astate").join("added"), tmp("ascratch"));
+        make_theme(&src.join("pack/Big Cursor"));
+        let ok = Command::new("tar").arg("-czf").arg(src.join("pack.tar.gz")).arg("-C").arg(src.join("pack")).arg(".").status();
+        if ok.is_ok_and(|s| s.success()) {
+            let done = add(&src.join("pack.tar.gz"), &icons, &st, &scratch).unwrap();
+            assert_eq!(done, ["Big Cursor"]);
+            assert!(icons.join("Big Cursor/cursors/left_ptr").exists());
+        }
+        std::fs::create_dir_all(src.join("empty/docs")).unwrap();
+        assert!(add(&src.join("empty"), &icons, &st, &scratch).unwrap_err().contains("doesn't look like a pointer theme"));
+        assert_eq!(safe_name("../x/y"), "_x_y");
+    }
+}
