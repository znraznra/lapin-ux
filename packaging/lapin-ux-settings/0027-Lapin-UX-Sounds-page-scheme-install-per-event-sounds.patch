+        set_file(&user, "borealis", "desktop-login", &mine).unwrap();
+        assert!(matches!(choice(&user, "desktop-login"), Choice::File(_)));
+        assert!(set_file(&user, "borealis", "desktop-login", &user.join("x.txt")).is_err());
+        use_scheme_sound(&user, "desktop-login");
