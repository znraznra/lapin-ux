+
+    #[test]
+    fn install_then_remove_only_what_was_added() {
+        let (src, user, st, scratch) = (tmp("s"), tmp("u"), tmp("st").join("added"), tmp("sc"));
+        scheme(&src.join("Ocean"), "Ocean waves");
+        assert_eq!(install(&src.join("Ocean"), &user, &st, &scratch).unwrap(), ["Ocean"]);
+        assert_eq!(themes(std::slice::from_ref(&user)), [("Ocean".to_string(), "Ocean waves".to_string())]);
+        assert!(install(&src.join("Ocean"), &user, &st, &scratch).unwrap_err().contains("already have"));
+        scheme(&user.join("sounds/Mine"), "Mine");
+        assert!(remove("Mine", &user, &st).is_err() && user.join("sounds/Mine").exists());
+        remove("Ocean", &user, &st).unwrap();
+        assert!(!user.join("sounds/Ocean").exists() && added(&st).is_empty());
+        std::fs::create_dir_all(src.join("none/docs")).unwrap();
+        assert!(install(&src.join("none"), &user, &st, &scratch).unwrap_err().contains("doesn't look like"));
