+// --- Personalization > Sounds (#58) -------------------------------------------
+
+/// "No sounds" first, then every installed scheme: (ids, names).
+fn sound_lists() -> (Vec<String>, Vec<String>) {
+    let mut ids = vec![String::new()];
+    let mut names = vec!["No sounds".to_string()];
+    for (i, n) in sounds_add::themes(&sounds_add::data_dirs()) {
+        ids.push(i);
+        names.push(n);
+    }
+    (ids, names)
+}
+
+const SOUND_CHOICES: [&str; 3] = ["The scheme's sound", "No sound", "Choose a file\u{2026}"];
+
+fn sound_rows<'a>(_: &'a Binder<PMsg>, p: &'a Prefs) -> Vec<Item<'a>> {
+    let sel = p.sound_ids.iter().position(|i| *i == p.sound_scheme).unwrap_or(0);
+    let mine = !p.sound_scheme.is_empty() && sounds_add::added(&sounds_add::state_file()).iter().any(|a| *a == p.sound_scheme);
+    let mut buttons = widget::row::with_capacity(2).spacing(8);
+    if mine {
+        buttons = buttons.push(widget::button::standard("Remove").on_press(m(Msg::RemoveScheme)));
+    }
+    buttons = buttons.push(widget::button::standard("Install a scheme\u{2026}").on_press(m(Msg::InstallScheme)));
+    let mut rows = vec![
+        settings::item::builder("Sound scheme")
+            .description(match &p.sound_note {
+                Some(n) => n.clone(),
+                None => "The sounds for sign-in, notifications, volume and more. Install a scheme from a .tar.gz, .tar.xz or .zip file, or a folder.".to_string(),
+            })
+            .control(widget::dropdown(&p.sound_names, Some(sel), |i| m(Msg::SoundScheme(i))))
+            .apply(Element::from)
+            .into_list_item(),
+        settings::item::builder("Your own schemes").control(buttons).apply(Element::from).into_list_item(),
+    ];
+    if p.sound_scheme.is_empty() {
+        return rows;
+    }
+    let user = sounds_add::user_data();
+    for (e, (event, label)) in sounds_add::EVENTS.iter().enumerate() {
+        let (cur, desc) = match sounds_add::choice(&user, event) {
+            sounds_add::Choice::Scheme => (0, "From the scheme".to_string()),
+            sounds_add::Choice::Silent => (1, "No sound".to_string()),
+            sounds_add::Choice::File(f) => (2, f.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default()),
+        };
+        rows.push(
+            settings::item::builder(*label)
+                .description(desc)
+                .control(
+                    widget::row::with_capacity(2)
+                        .spacing(8)
+                        .align_y(cosmic::iced::Alignment::Center)
+                        .push(widget::button::standard("Test").on_press(m(Msg::SoundTest(e))))
+                        .push(widget::dropdown(&SOUND_CHOICES, Some(cur), move |i| m(Msg::SoundEvent(e, i)))),
+                )
+                .apply(Element::from)
+                .into_list_item(),
+        );
+    }
+    rows
+}
+
+lapin_page!(Sounds, "lapin-sounds", "audio-volume-high-symbolic", "Sounds", "Sound scheme, sounds for events", [("", sound_rows)]);
