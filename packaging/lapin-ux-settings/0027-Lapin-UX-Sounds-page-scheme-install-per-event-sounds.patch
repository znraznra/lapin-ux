@@ -0,0 +1,294 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Sound schemes and per-event sounds (#58). Lapin plays sounds from the scheme
+//! named in `dev.lapinux.Shell` `sound_theme`; the user's per-event choices live
+//! in `~/.local/share/sounds/lapin-ux-custom`, so no installed scheme is edited.
+//! Mirrors `lapin_ux_core::sound` (Settings builds without Lapin's crates).
+
+use super::pointers_add::{copy_dir, safe_name, unpack};
+use std::path::{Path, PathBuf};
+
+pub const CUSTOM: &str = "lapin-ux-custom";
+pub const DEFAULT: &str = "borealis";
+
+/// (freedesktop name, label, group): same list as `lapin_ux_core::sound::EVENTS`.
+pub const EVENTS: &[(&str, &str)] = &[
+    ("desktop-login", "Sign in"),
+    ("desktop-logout", "Sign out"),
+    ("message-new-instant", "Notification"),
+    ("dialog-warning", "Warning"),
+    ("dialog-error", "Error"),
+    ("dialog-question", "Question"),
+    ("battery-low", "Low battery"),
+    ("battery-caution", "Critical battery"),
+    ("device-added", "Device connected"),
+    ("device-removed", "Device disconnected"),
+    ("trash-empty", "Empty Recycle Bin"),
+    ("camera-shutter", "Screenshot"),
+    ("audio-volume-change", "Volume change"),
+];
+
+const EXTS: [&str; 5] = ["oga", "ogg", "wav", "flac", "mp3"];
+
+fn home() -> PathBuf {
+    std::env::var_os("HOME").map(PathBuf::from).unwrap_or_default()
+}
+pub fn user_data() -> PathBuf {
+    std::env::var_os("XDG_DATA_HOME").map(PathBuf::from).unwrap_or_else(|| home().join(".local/share"))
+}
+pub fn data_dirs() -> Vec<PathBuf> {
+    let mut v = vec![user_data()];
+    let sys = std::env::var("XDG_DATA_DIRS").unwrap_or_else(|_| "/usr/local/share:/usr/share".into());
+    v.extend(sys.split(':').filter(|s| !s.is_empty()).map(PathBuf::from));
+    v
+}
+pub fn state_file() -> PathBuf {
+    let st = std::env::var_os("XDG_STATE_HOME").map(PathBuf::from).unwrap_or_else(|| home().join(".local/state"));
+    st.join("lapin-ux").join("sounds-added")
+}
+
+/// Installed schemes: (folder, display name).
+pub fn themes(dirs: &[PathBuf]) -> Vec<(String, String)> {
+    let mut out: Vec<(String, String)> = Vec::new();
+    for d in dirs {
+        let Ok(rd) = std::fs::read_dir(d.join("sounds")) else { continue };
+        for e in rd.flatten() {
+            let id = e.file_name().to_string_lossy().into_owned();
+            let Ok(index) = std::fs::read_to_string(e.path().join("index.theme")) else { continue };
+            if id == CUSTOM || id == "freedesktop" || out.iter().any(|(i, _)| *i == id) {
+                continue;
+            }
+            let name = index.lines().find_map(|l| l.strip_prefix("Name=")).map(|n| n.trim().to_string()).filter(|n| !n.is_empty()).unwrap_or_else(|| id.clone());
+            out.push((id, name));
+        }
+    }
+    out.sort_by_key(|(_, n)| n.to_lowercase());
+    out
+}
+
+pub fn added(state: &Path) -> Vec<String> {
+    std::fs::read_to_string(state).unwrap_or_default().lines().map(str::trim).filter(|l| !l.is_empty()).map(String::from).collect()
+}
+
+/// What the user chose for `event`.
+#[derive(Debug, PartialEq)]
+pub enum Choice {
+    Scheme,
+    Silent,
+    File(PathBuf),
+}
+
+fn custom_dir(user: &Path) -> PathBuf {
+    user.join("sounds").join(CUSTOM).join("stereo")
+}
+
+pub fn choice(user: &Path, event: &str) -> Choice {
+    let dir = custom_dir(user);
+    if dir.join(format!("{event}.silent")).exists() {
+        return Choice::Silent;
+    }
+    for ext in EXTS {
+        let p = dir.join(format!("{event}.{ext}"));
+        if p.is_file() {
+            return Choice::File(p);
+        }
+    }
+    Choice::Scheme
+}
+
+fn clear(user: &Path, event: &str) {
+    let dir = custom_dir(user);
+    let _ = std::fs::remove_file(dir.join(format!("{event}.silent")));
+    for ext in EXTS {
+        let _ = std::fs::remove_file(dir.join(format!("{event}.{ext}")));
+    }
+}
+
+fn ensure_custom(user: &Path, scheme: &str) -> std::io::Result<PathBuf> {
+    let dir = custom_dir(user);
+    std::fs::create_dir_all(&dir)?;
+    let index = dir.parent().map(|p| p.join("index.theme")).unwrap_or_default();
+    std::fs::write(index, format!("[Sound Theme]\nName=Lapin UX (your sounds)\nInherits={scheme}\nDirectories=stereo\n\n[stereo]\nOutputProfile=stereo\n"))?;
+    Ok(dir)
+}
+
+pub fn use_scheme_sound(user: &Path, event: &str) {
+    clear(user, event);
+}
+
+pub fn set_silent(user: &Path, scheme: &str, event: &str) -> Result<(), String> {
+    let dir = ensure_custom(user, scheme).map_err(|e| e.to_string())?;
+    clear(user, event);
+    std::fs::write(dir.join(format!("{event}.silent")), b"").map_err(|e| e.to_string())
+}
+
+pub fn set_file(user: &Path, scheme: &str, event: &str, file: &Path) -> Result<(), String> {
+    let ext = file.extension().map(|e| e.to_string_lossy().to_lowercase()).unwrap_or_default();
+    if !EXTS.contains(&ext.as_str()) {
+        return Err("Use an .ogg, .oga, .wav, .flac or .mp3 file.".into());
+    }
+    let dir = ensure_custom(user, scheme).map_err(|e| e.to_string())?;
+    clear(user, event);
+    std::fs::copy(file, dir.join(format!("{event}.{ext}"))).map(|_| ()).map_err(|e| format!("Couldn't copy the sound: {e}"))
+}
+
+/// The file Lapin would play for `event` with `scheme` (for Test).
+pub fn current_file(dirs: &[PathBuf], scheme: &str, event: &str) -> Option<PathBuf> {
+    if let Some(user) = dirs.first() {
+        match choice(user, event) {
+            Choice::Silent => return None,
+            Choice::File(f) => return Some(f),
+            Choice::Scheme => {}
+        }
+    }
+    for t in [scheme, "freedesktop"] {
+        for d in dirs {
+            for sub in ["stereo", ""] {
+                for ext in ["oga", "ogg", "wav"] {
+                    let p = d.join("sounds").join(t).join(sub).join(format!("{event}.{ext}"));
+                    if p.is_file() {
+                        return Some(p);
+                    }
+                }
+            }
+        }
+    }
+    None
+}
+
+fn find_schemes(root: &Path) -> Vec<PathBuf> {
+    fn walk(dir: &Path, depth: usize, out: &mut Vec<PathBuf>) {
+        if dir.join("index.theme").is_file() && (dir.join("stereo").is_dir() || has_audio(dir)) {
+            out.push(dir.to_path_buf());
+            return;
+        }
+        if depth >= 3 {
+            return;
+        }
+        let Ok(rd) = std::fs::read_dir(dir) else { return };
+        let mut subs: Vec<PathBuf> = rd.flatten().map(|e| e.path()).filter(|p| p.is_dir() && !p.is_symlink()).collect();
+        subs.sort();
+        for s in subs {
+            walk(&s, depth + 1, out);
+        }
+    }
+    fn has_audio(d: &Path) -> bool {
+        std::fs::read_dir(d).map(|rd| rd.flatten().any(|e| matches!(e.path().extension().and_then(|x| x.to_str()), Some("oga" | "ogg" | "wav")))).unwrap_or(false)
+    }
+    let mut out = Vec::new();
+    walk(root, 0, &mut out);
+    out
+}
+
+/// Install a scheme from an archive or folder into `<user>/sounds`.
+pub fn install(source: &Path, user: &Path, state: &Path, scratch_parent: &Path) -> Result<Vec<String>, String> {
+    let scratch = scratch_parent.join(format!("lapin-sounds-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&scratch);
+    std::fs::create_dir_all(&scratch).map_err(|e| format!("Couldn't prepare the files: {e}"))?;
+    let res = (|| {
+        let root = if source.is_dir() {
+            source.to_path_buf()
+        } else {
+            unpack(source, &scratch)?;
+            scratch.clone()
+        };
+        let found = find_schemes(&root);
+        if found.is_empty() {
+            return Err("This doesn't look like a sound scheme (it has no index.theme with sounds).".to_string());
+        }
+        let sounds = user.join("sounds");
+        std::fs::create_dir_all(&sounds).map_err(|e| e.to_string())?;
+        let mut done = Vec::new();
+        for t in found {
+            let raw = t.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default();
+            let raw = if t == root && !source.is_dir() { source.file_stem().map(|n| n.to_string_lossy().into_owned()).unwrap_or(raw.clone()) } else { raw };
+            let name = safe_name(raw.trim_end_matches(".tar"));
+            if name == CUSTOM || name == "freedesktop" {
+                return Err("That name is reserved.".into());
+            }
+            let dest = sounds.join(&name);
+            if dest.exists() {
+                return Err(format!("You already have a sound scheme called \"{name}\"."));
+            }
+            copy_dir(&t, &dest).map_err(|e| {
+                let _ = std::fs::remove_dir_all(&dest);
+                format!("Couldn't copy the sounds: {e}")
+            })?;
+            let mut all = added(state);
+            all.push(name.clone());
+            if let Some(p) = state.parent() {
+                std::fs::create_dir_all(p).map_err(|e| e.to_string())?;
+            }
+            std::fs::write(state, all.join("\n") + "\n").map_err(|e| e.to_string())?;
+            done.push(name);
+        }
+        Ok(done)
+    })();
+    let _ = std::fs::remove_dir_all(&scratch);
+    res
+}
+
+/// Remove a scheme this page installed (and only that).
+pub fn remove(name: &str, user: &Path, state: &Path) -> Result<(), String> {
+    if name.contains('/') || name.is_empty() || !added(state).iter().any(|n| n == name) {
+        return Err("Only sound schemes added here can be removed here.".into());
+    }
+    let dir = user.join("sounds").join(name);
+    if dir.is_dir() && !dir.is_symlink() {
+        std::fs::remove_dir_all(&dir).map_err(|e| format!("Couldn't remove it: {e}"))?;
+    }
+    let rest: Vec<String> = added(state).into_iter().filter(|n| n != name).collect();
+    std::fs::write(state, if rest.is_empty() { String::new() } else { rest.join("\n") + "\n" }).map_err(|e| e.to_string())
+}
