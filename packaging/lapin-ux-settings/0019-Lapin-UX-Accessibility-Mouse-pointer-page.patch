+// --- Accessibility > Mouse pointer (#24) ------------------------------------
+
+/// Pointer styles: the Windows 11-style pack (downloaded on this computer by
+/// lapin-ux-cursors, never shipped), or the system's own pointer.
+const POINTER_STYLES: [(&str, &str); 3] = [
+    ("light", "Extra pointers, light"),
+    ("dark", "Extra pointers, dark"),
+    ("system", "The system's pointer"),
+];
+
+/// The pack's busy animation colours (its `variants` folders).
+const POINTER_BUSY: [&str; 11] =
+    ["default", "classic", "green", "red", "purple", "indigo", "sunset", "squid", "amber", "candy", "inverted"];
+
+/// Sizes offered by the slider, as on Windows (1 = normal).
+const POINTER_SIZE_MIN: u32 = 24;
+const POINTER_SIZE_STEP: u32 = 8;
+
+/// What's in use now, for accounts that set it before this page existed.
+fn pointer_style_now() -> String {
+    let default = std::env::var_os("HOME")
+        .map(|h| std::path::PathBuf::from(h).join(".local/share/icons/default/index.theme"))
+        .and_then(|p| std::fs::read_to_string(p).ok())
+        .unwrap_or_default();
+    if default.contains("Cursor-Concept-W11") { "light".into() } else { "system".into() }
+}
+
+/// Runs lapin-ux-cursors for the chosen style and busy colour (it downloads
+/// the pack the first time and keeps it, so later changes are quick).
+fn run_pointer_tool(p: &mut Prefs) -> cosmic::app::Task<crate::Message> {
+    p.pointer_busy_now = true;
+    p.pointer_error = None;
+    let mut args: Vec<String> = Vec::new();
+    match p.pointer_style.as_str() {
+        "system" => args.push("--system".into()),
+        style => {
+            if style == "dark" {
+                args.push("--dark".into());
+            }
+            args.push("--variant".into());
+            args.push(p.pointer_busy.clone());
+        }
+    }
+    cosmic::task::future(async move {
+        let r = match tokio::process::Command::new("lapin-ux-cursors").args(&args).output().await {
+            Ok(out) if out.status.success() => Ok(()),
+            Ok(out) => {
+                let err = String::from_utf8_lossy(&out.stderr);
+                Err(err.lines().rev().find(|l| !l.trim().is_empty()).unwrap_or("The pointer tool stopped with an error.").trim().to_string())
+            }
+            Err(e) => Err(format!("lapin-ux-cursors couldn't start: {e}")),
+        };
+        crate::Message::PageMessage(PMsg::Lapin(Msg::PointerDone(r)))
+    })
+}
+
+fn pointer_rows<'a>(_: &'a Binder<PMsg>, p: &'a Prefs) -> Vec<Item<'a>> {
+    static STYLES: std::sync::OnceLock<Vec<&'static str>> = std::sync::OnceLock::new();
+    let styles: &'static [&'static str] = STYLES.get_or_init(|| POINTER_STYLES.iter().map(|(_, n)| *n).collect());
+    let style_i = POINTER_STYLES.iter().position(|(id, _)| *id == p.pointer_style).unwrap_or(2);
+    let status = if p.pointer_busy_now {
+        "Getting the pointers…".to_string()
+    } else if let Some(e) = &p.pointer_error {
+        format!("They couldn't be installed: {e}")
+    } else if p.pointer_style == "system" {
+        "The pointer your system uses in every desktop".to_string()
+    } else {
+        "\u{201C}Cursor Concept W11 Tail HDPi\u{201D} by JepriCreations, downloaded and converted on this computer".to_string()
+    };
+    let mut rows = vec![
+        settings::item::builder("Mouse pointer style")
+            .description(status)
+            .control(widget::dropdown(styles, Some(style_i), |i| m(Msg::PointerStyle(i))))
+            .apply(Element::from)
+            .into_list_item(),
+    ];
+    if p.pointer_style != "system" {
+        let busy_i = POINTER_BUSY.iter().position(|b| *b == p.pointer_busy).unwrap_or(0);
+        rows.push(
+            settings::item::builder("Busy pointer colour")
+                .description("The spinning circle while an app is working")
+                .control(widget::dropdown(&POINTER_BUSY, Some(busy_i), |i| m(Msg::PointerBusy(i))))
+                .apply(Element::from)
+                .into_list_item(),
+        );
+    }
+    let step = (p.pointer_size.saturating_sub(POINTER_SIZE_MIN) / POINTER_SIZE_STEP + 1).clamp(1, 8);
+    rows.push(
+        settings::item::builder("Size")
+            .description("Applies everywhere after you sign out and back in")
+            .control(
+                widget::row::with_capacity(2)
+                    .spacing(12)
+                    .align_y(cosmic::iced::Alignment::Center)
+                    .push(widget::text::body(step.to_string()))
+                    .push(
+                        widget::slider(1..=8u32, step, |v| m(Msg::PointerSize(POINTER_SIZE_MIN + (v - 1) * POINTER_SIZE_STEP)))
+                            .on_release(m(Msg::PointerSizeDone))
+                            .width(Length::Fixed(250.0)),
+                    ),
+            )
+            .apply(Element::from)
+            .into_list_item(),
+    );
+    rows
+}
+
+lapin_page!(Pointer, "lapin-pointer", "input-mouse-symbolic", "Mouse pointer", "Pointer style, colour, size", [("", pointer_rows)]);
+
 /// Start button pictures (ids the shell knows) and their names.
 const START_ICONS: [(&str, &str); 6] = [
     ("", "Lapin UX"),
@@ -920,6 +1072,7 @@ pub fn register(pages: &mut Binder<PMsg>) {
     let _ = pages.register::<Multitasking>();
     let _ = pages.register::<Clipboard>();
     let _ = pages.register::<LockScreen>();
+    let _ = pages.register::<Pointer>();
     let _ = pages.register::<super::apps::Page>();
     let _ = pages.register::<super::storage::Page>();
     let _ = pages.register::<super::storage::TempPage>();
