+    /// Lapin UX: the file system type and the source (device or share address)
+    /// of the mount that holds `path`, read from the mount table.
+    #[cfg(target_os = "linux")]
+    fn lapin_mount_info(path: &Path) -> Option<(String, String)> {
+        let path = fs::canonicalize(path).ok()?;
+        let mounts = procfs::process::Process::myself().ok()?.mountinfo().ok()?;
+        mounts
+            .iter()
+            .filter(|m| path.starts_with(&m.mount_point))
+            .max_by_key(|m| m.mount_point.as_os_str().len())
+            .map(|m| (m.fs_type.clone(), m.mount_source.clone().unwrap_or_default()))
+    }
+
