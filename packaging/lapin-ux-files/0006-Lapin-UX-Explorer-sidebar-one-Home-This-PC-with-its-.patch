+    /// Lapin UX: the This PC page, every drive with how full it is.
+    fn lapin_pc_view(&self) -> Element<'_, Message> {
+        let cosmic_theme::Spacing {
+            space_xxs, space_xs, space_s, ..
+        } = theme::spacing();
+        // (name, icon, location, path to measure)
+        let mut drives: Vec<(String, icon::Handle, Location, Option<PathBuf>)> = vec![(
+            fl!("filesystem"),
+            icon::from_name("drive-harddisk-symbolic").size(32).handle(),
+            Location::Path(PathBuf::from("/")),
+            Some(PathBuf::from("/")),
+        )];
+        let mut items: Vec<_> = self.mounter_items.values().flatten().collect();
+        items.sort_by(|a, b| LANGUAGE_SORTER.compare(&a.name(), &b.name()));
+        for item in items {
+            let path = item.path();
+            let location = match (&path, item.is_remote()) {
+                (Some(p), true) => Location::Network(item.uri(), item.name(), Some(p.clone())),
+                (Some(p), false) => Location::Path(p.clone()),
+                (None, _) => Location::Network(item.uri(), item.name(), None),
+            };
+            let handle = item
+                .icon(false)
+                .unwrap_or_else(|| icon::from_name("drive-harddisk-symbolic").size(32).handle());
+            drives.push((item.name(), handle, location, path));
+        }
+        let mut list = widget::column::with_capacity(drives.len() + 2)
+            .spacing(space_s)
+            .padding(space_s)
+            .push(widget::text::title4(fl!("devices-and-drives")));
+        for (name, handle, location, path) in drives {
+            let mut text = widget::column::with_capacity(3).spacing(space_xxs).push(widget::text::body(name));
+            if let Some((free, total)) = path.as_deref().and_then(disk_space) {
+                let used = if total == 0 { 0.0 } else { 1.0 - free as f32 / total as f32 };
+                text = text
+                    .push(widget::progress_bar::determinate_linear(used).width(Length::Fixed(260.0)).girth(Length::Fixed(10.0)))
+                    .push(widget::text::caption(fl!(
+                        "free-of",
+                        free = tab::format_size_public(free),
+                        total = tab::format_size_public(total)
+                    )));
+            }
+            list = list.push(
+                widget::button::custom(
+                    widget::row::with_capacity(2)
+                        .spacing(space_xs)
+                        .align_y(Alignment::Center)
+                        .push(icon::icon(handle).size(48))
+                        .push(text),
+                )
+                .padding(space_xs)
+                .class(theme::Button::MenuItem)
+                .on_press(Message::TabMessage(None, tab::Message::Location(location))),
+            );
+        }
+        widget::scrollable(list).height(Length::Fill).into()
+    }
