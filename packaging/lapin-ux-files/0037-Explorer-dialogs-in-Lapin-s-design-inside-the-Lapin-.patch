+
+/// Lapin UX (#163): dialog buttons. Outside a Lapin session these are
+/// COSMIC's own buttons, untouched.
+mod lapin_dlg_button {
+    use super::*;
+    use cosmic::widget::button::Catalog;
+
+    fn square(kind: fn() -> theme::Button) -> theme::Button {
+        fn sq(mut s: cosmic::widget::button::Style) -> cosmic::widget::button::Style {
+            s.border_radius = 4.0.into();
+            s
+        }
+        theme::Button::Custom {
+            active: Box::new(move |f, t| sq(t.active(f, false, &kind()))),
+            disabled: Box::new(move |t| sq(t.disabled(&kind()))),
+            hovered: Box::new(move |f, t| sq(t.hovered(f, false, &kind()))),
+            pressed: Box::new(move |f, t| sq(t.pressed(f, false, &kind()))),
+        }
+    }
+
+    fn build<'a>(
+        label: impl Into<std::borrow::Cow<'a, str>>,
+        cosmic: fn(std::borrow::Cow<'a, str>) -> widget::button::TextButton<'a, Message>,
+        kind: fn() -> theme::Button,
+    ) -> widget::button::TextButton<'a, Message> {
+        let label = label.into();
+        if crate::config::lapin_session() {
+            widget::button::text(label).class(square(kind))
+        } else {
+            cosmic(label)
+        }
+    }
+
+    pub fn suggested<'a>(label: impl Into<std::borrow::Cow<'a, str>>) -> widget::button::TextButton<'a, Message> {
+        build(label, |l| widget::button::suggested(l), || theme::Button::Suggested)
+    }
+    pub fn standard<'a>(label: impl Into<std::borrow::Cow<'a, str>>) -> widget::button::TextButton<'a, Message> {
+        build(label, |l| widget::button::standard(l), || theme::Button::Standard)
+    }
+    pub fn destructive<'a>(label: impl Into<std::borrow::Cow<'a, str>>) -> widget::button::TextButton<'a, Message> {
+        build(label, |l| widget::button::destructive(l), || theme::Button::Destructive)
+    }
+}
+
+/// Lapin UX (#163): Explorer's dialogs in Lapin's design: a plain light
+/// panel with the message, and a grey band with the buttons, right-aligned
+/// with the main action first. Outside a Lapin session this builds COSMIC's
+/// own dialog, with the same parts in the same order.
+struct LapinDialog<'a> {
+    title: Option<std::borrow::Cow<'a, str>>,
+    icon: Option<Element<'a, Message>>,
+    body: Option<std::borrow::Cow<'a, str>>,
+    controls: Vec<Element<'a, Message>>,
+    primary: Option<Element<'a, Message>>,
+    secondary: Option<Element<'a, Message>>,
+    tertiary: Option<Element<'a, Message>>,
+    width: Option<Length>,
+    height: Option<Length>,
+    max_width: Option<f32>,
+    max_height: Option<f32>,
+}
+
+fn lapin_dialog<'a>() -> LapinDialog<'a> {
+    LapinDialog {
+        title: None,
+        icon: None,
+        body: None,
+        controls: Vec::new(),
+        primary: None,
+        secondary: None,
+        tertiary: None,
+        width: None,
+        height: None,
+        max_width: None,
+        max_height: None,
+    }
+}
+
+impl<'a> LapinDialog<'a> {
+    fn title(mut self, v: impl Into<std::borrow::Cow<'a, str>>) -> Self {
+        self.title = Some(v.into());
+        self
+    }
+    fn icon(mut self, v: impl Into<Element<'a, Message>>) -> Self {
+        self.icon = Some(v.into());
+        self
+    }
+    fn body(mut self, v: impl Into<std::borrow::Cow<'a, str>>) -> Self {
+        self.body = Some(v.into());
+        self
+    }
+    fn control(mut self, v: impl Into<Element<'a, Message>>) -> Self {
+        self.controls.push(v.into());
+        self
+    }
+    fn primary_action(mut self, v: impl Into<Element<'a, Message>>) -> Self {
+        self.primary = Some(v.into());
+        self
+    }
+    fn secondary_action(mut self, v: impl Into<Element<'a, Message>>) -> Self {
+        self.secondary = Some(v.into());
+        self
+    }
+    fn tertiary_action(mut self, v: impl Into<Element<'a, Message>>) -> Self {
+        self.tertiary = Some(v.into());
+        self
+    }
+    #[allow(dead_code)]
+    fn width(mut self, v: impl Into<Length>) -> Self {
+        self.width = Some(v.into());
+        self
+    }
+    #[allow(dead_code)]
+    fn height(mut self, v: impl Into<Length>) -> Self {
+        self.height = Some(v.into());
+        self
+    }
+    #[allow(dead_code)]
+    fn max_width(mut self, v: impl Into<cosmic::iced::Pixels>) -> Self {
+        self.max_width = Some(v.into().0);
+        self
+    }
+    #[allow(dead_code)]
+    fn max_height(mut self, v: impl Into<cosmic::iced::Pixels>) -> Self {
+        self.max_height = Some(v.into().0);
+        self
+    }
+}
+
+impl<'a> From<LapinDialog<'a>> for Element<'a, Message> {
+    fn from(d: LapinDialog<'a>) -> Self {
+        if !crate::config::lapin_session() {
+            let mut c = widget::dialog();
+            if let Some(v) = d.title {
+                c = c.title(v);
+            }
+            if let Some(v) = d.icon {
+                c = c.icon(v);
+            }
+            if let Some(v) = d.body {
+                c = c.body(v);
+            }
+            for v in d.controls {
+                c = c.control(v);
+            }
+            if let Some(v) = d.primary {
+                c = c.primary_action(v);
+            }
+            if let Some(v) = d.secondary {
+                c = c.secondary_action(v);
+            }
+            if let Some(v) = d.tertiary {
+                c = c.tertiary_action(v);
+            }
+            if let Some(v) = d.width {
+                c = c.width(v);
+            }
+            if let Some(v) = d.height {
+                c = c.height(v);
+            }
+            if let Some(v) = d.max_width {
+                c = c.max_width(v);
+            }
+            if let Some(v) = d.max_height {
+                c = c.max_height(v);
+            }
+            return c.into();
+        }
+        let cosmic_theme::Spacing { space_xxs, space_xs, space_s, space_m, .. } = theme::spacing();
+        let mut text = widget::column::with_capacity(2 + d.controls.len()).spacing(space_xs);
+        if let Some(title) = d.title {
+            text = text.push(widget::text::heading(title));
+        }
+        if let Some(body) = d.body {
+            text = text.push(widget::container(widget::scrollable(widget::text::body(body))).max_height(300.0));
+        }
+        for control in d.controls {
+            text = text.push(control);
+        }
+        let mut message = widget::row::with_capacity(2).spacing(space_m);
+        if let Some(icon) = d.icon {
+            message = message.push(icon);
+        }
+        message = message.push(text.width(Length::Fill));
+
+        // Windows-style order: the main action first, then the others.
+        let mut buttons = widget::row::with_capacity(4).spacing(space_xxs).align_y(Alignment::Center);
+        if let Some(v) = d.tertiary {
+            buttons = buttons.push(v);
+        }
+        buttons = buttons.push(widget::space::horizontal());
+        if let Some(v) = d.primary {
+            buttons = buttons.push(v);
+        }
+        if let Some(v) = d.secondary {
+            buttons = buttons.push(v);
+        }
+
+        let panel = widget::container(message)
+            .padding([space_m, space_m + space_s])
+            .width(Length::Fill)
+            .class(lapin_layer_style());
+        let band = widget::container(buttons)
+            .padding([space_xs + 2, space_m + space_s])
+            .width(Length::Fill)
+            .class(tab::lapin_band_style());
+        let mut column = widget::container(widget::column::with_children([panel.into(), band.into()]))
