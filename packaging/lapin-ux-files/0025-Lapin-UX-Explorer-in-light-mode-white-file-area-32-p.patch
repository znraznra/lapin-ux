+
+/// Lapin UX: the layer under the address row: plain white in light mode,
+/// the usual window colour in dark mode.
+fn lapin_layer_style() -> theme::Container<'static> {
+    theme::Container::custom(|t| {
+        let c = t.cosmic();
+        let bg: cosmic::iced::Color = if c.is_dark {
+            c.background(false).base.into()
+        } else {
+            cosmic::iced::Color::WHITE
+        };
+        cosmic::iced::widget::container::Style {
+            background: Some(bg.into()),
+            text_color: Some(c.background(false).on.into()),
+            ..Default::default()
+        }
+    })
+}
+
+/// Lapin UX: the details pane: a light grey card in light mode, COSMIC's
+/// card in dark mode.
+fn lapin_details_style() -> theme::Container<'static> {
+    theme::Container::custom(|t| {
+        let c = t.cosmic();
+        let bg: cosmic::iced::Color = if c.is_dark {
+            c.primary(false).base.into()
+        } else {
+            cosmic::iced::Color::from_rgb8(0xf9, 0xf9, 0xf9)
+        };
+        cosmic::iced::widget::container::Style {
+            background: Some(bg.into()),
+            text_color: Some(c.primary(false).on.into()),
+            ..Default::default()
+        }
+    })
+}
+
+/// Lapin UX: the search box: the same lightly rounded box as the address,
+/// not a pill, with no outline until it's focused.
+fn lapin_box_input() -> theme::TextInput {
+    use cosmic::widget::text_input::StyleSheet;
+    fn boxed(mut a: cosmic::widget::text_input::Appearance, t: &cosmic::Theme) -> cosmic::widget::text_input::Appearance {
+        a.border_radius = t.cosmic().corner_radii.radius_s.into();
+        a
+    }
+    fn flat(mut a: cosmic::widget::text_input::Appearance, t: &cosmic::Theme) -> cosmic::widget::text_input::Appearance {
+        a.border_width = 0.0;
+        boxed(a, t)
+    }
+    theme::TextInput::Custom {
+        active: Box::new(|t| flat(t.active(&theme::TextInput::Search), t)),
+        error: Box::new(|t| boxed(t.error(&theme::TextInput::Search), t)),
+        hovered: Box::new(|t| flat(t.hovered(&theme::TextInput::Search), t)),
+        focused: Box::new(|t| boxed(t.focused(&theme::TextInput::Search), t)),
+        disabled: Box::new(|t| boxed(t.disabled(&theme::TextInput::Search), t)),
+    }
+}
+
+/// Lapin UX: the open place in the navigation pane: a soft grey box (the
+/// hover colour of the rows), not a pill.
+fn lapin_pane_selected() -> theme::Button {
+    use cosmic::widget::button::Catalog;
+    theme::Button::Custom {
+        active: Box::new(|f, t| t.hovered(f, false, &theme::Button::MenuItem)),
+        disabled: Box::new(|t| t.disabled(&theme::Button::MenuItem)),
+        hovered: Box::new(|f, t| t.pressed(f, false, &theme::Button::MenuItem)),
+        pressed: Box::new(|f, t| t.pressed(f, false, &theme::Button::MenuItem)),
+    }
+}
