+    /// Lapin UX: History, Options, About or Add network drive in the details
+    /// pane: the page's name and a close button, then the page, in the same
+    /// layout as the details.
+    fn lapin_pane_page_view(&self, page: &ContextPage) -> Option<Element<'_, Message>> {
+        let cosmic_theme::Spacing { space_xs, space_s, .. } = theme::spacing();
+        let (title, body): (String, Element<'_, Message>) = match page {
+            ContextPage::About => (
+                fl!("about"),
+                widget::about(&self.about, |url| Message::LaunchUrl(url.to_string())),
+            ),
+            ContextPage::EditHistory => (fl!("edit-history"), self.edit_history()),
+            ContextPage::Settings => (fl!("options"), self.settings()),
+            ContextPage::NetworkDrive => {
+                let mut input = widget::text_input(fl!("enter-server-address"), &self.network_drive_input);
+                let button = if self.network_drive_connecting.is_some() {
+                    widget::button::standard(fl!("connecting"))
+                } else {
+                    input = input
+                        .on_input(Message::NetworkDriveInput)
+                        .on_submit(|_| Message::NetworkDriveSubmit);
+                    widget::button::standard(fl!("connect")).on_press(Message::NetworkDriveSubmit)
+                };
+                (
+                    fl!("add-network-drive"),
+                    widget::column::with_capacity(3)
+                        .spacing(space_s)
+                        .push(input)
+                        .push(widget::row::with_capacity(2).push(widget::space::horizontal()).push(button.class(tab::lapin_box_button())))
+                        .push(self.network_drive())
+                        .into(),
+                )
+            }
+            ContextPage::Preview(..) => return None,
+        };
+        let header = widget::row::with_capacity(3)
+            .align_y(Alignment::Center)
+            .push(widget::text::title4(title))
+            .push(widget::space::horizontal())
+            .push(
+                widget::button::icon(icon::from_name("window-close-symbolic").size(16))
+                    .on_press(Message::ToggleContextPage(page.clone())),
+            );
+        Some(
+            widget::container(widget::scrollable(
+                widget::column::with_capacity(2)
+                    .spacing(space_s)
+                    .padding([space_xs, space_s])
+                    .push(header)
+                    .push(body),
+            ))
+            .width(Length::Fixed(360.0))
+            .height(Length::Fill)
+            .into(),
+        )
+    }
