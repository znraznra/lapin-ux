+/// Lapin UX (#153): a mapped network drive: always listed under This PC,
+/// connected when opened. Kept in Lapin's own `dev.lapinux.Explorer`.
+#[derive(Clone, Debug, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+pub struct LapinMapped {
+    pub name: String,
+    pub uri: String,
+}
+
+const LAPIN_EXPLORER_CONFIG: &str = "dev.lapinux.Explorer";
+
+pub fn lapin_mapped_load() -> Vec<LapinMapped> {
+    use cosmic::cosmic_config::ConfigGet;
+    cosmic::cosmic_config::Config::new(LAPIN_EXPLORER_CONFIG, 1)
+        .ok()
+        .and_then(|c| c.get::<Vec<LapinMapped>>("mapped_drives").ok())
+        .unwrap_or_default()
+}
+
+pub fn lapin_mapped_save(drives: &[LapinMapped]) {
+    use cosmic::cosmic_config::ConfigSet;
+    if let Ok(config) = cosmic::cosmic_config::Config::new(LAPIN_EXPLORER_CONFIG, 1)
+        && let Err(err) = config.set("mapped_drives", drives.to_vec())
+    {
+        log::warn!("failed to save mapped drives: {err}");
+    }
+}
+
+/// Lapin UX: a name for a share from its address ("share on 192.168.1.55").
+pub fn lapin_mapped_name(uri: &str) -> String {
+    let rest = uri.split_once("://").map_or(uri, |(_, r)| r).trim_end_matches('/');
+    match rest.split_once('/') {
+        Some((host, share)) if !share.is_empty() => format!("{} ({host})", share.rsplit('/').next().unwrap_or(share)),
+        _ => rest.to_string(),
+    }
+}
