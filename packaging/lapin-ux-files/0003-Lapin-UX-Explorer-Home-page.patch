+    /// Lapin UX: the Home page (#73): quick-access folders (the sidebar's
+    /// favourites) and the files used most recently.
+    fn lapin_home_view(&self) -> Element<'_, Message> {
+        let cosmic_theme::Spacing {
+            space_xxs, space_xs, space_s, ..
+        } = theme::spacing();
+        let mut place_buttons: Vec<Element<'_, Message>> = Vec::new();
+        for favorite in &self.config.favorites {
+            let Some(path) = favorite.path_opt() else { continue };
+            let name = favorite.display_name().unwrap_or_else(|| fl!("filesystem"));
+            let location = match favorite {
+                Favorite::Network { uri, name, path } => {
+                    Location::Network(uri.clone(), name.clone(), Some(path.to_owned()))
+                }
+                _ => Location::Path(path.clone()),
+            };
+            place_buttons.push(
+                widget::button::custom(
+                    widget::row::with_capacity(2)
+                        .spacing(space_xs)
+                        .align_y(Alignment::Center)
+                        .push(icon::icon(tab::folder_icon_symbolic(&path, 24)).size(24))
+                        .push(widget::text::body(name)),
+                )
+                .padding(space_xs)
+                .class(theme::Button::MenuItem)
+                .on_press(Message::TabMessage(None, tab::Message::Location(location)))
+                .into(),
+            );
+        }
+        let places = widget::flex_row(place_buttons).row_spacing(space_xs).column_spacing(space_xs);
+        let mut recent = widget::column::with_capacity(12).spacing(space_xxs);
+        if let Ok(files) = recently_used_xbel::parse_file() {
+            let mut shown = 0;
+            for bookmark in files.bookmarks.into_iter().rev() {
+                if shown == 12 {
+                    break;
+                }
+                let Some(path) = tab::uri_to_path(bookmark.href) else { continue };
+                let (Some(name), true) = (path.file_name().map(|n| n.to_string_lossy().into_owned()), path.exists()) else { continue };
+                let parent = path.parent().map(|p| p.display().to_string()).unwrap_or_default();
+                recent = recent.push(
+                    widget::button::custom(
+                        widget::row::with_capacity(3)
+                            .spacing(space_xs)
+                            .align_y(Alignment::Center)
+                            .push(icon::icon(crate::mime_icon::mime_icon(crate::mime_icon::mime_for_path(&path, None, false), 24)).size(24))
+                            .push(widget::text::body(name))
+                            .push(widget::space::horizontal())
+                            .push(widget::text::caption(parent)),
+                    )
+                    .width(Length::Fill)
+                    .padding(space_xs)
+                    .class(theme::Button::MenuItem)
+                    .on_press(Message::LapinOpen(path)),
+                );
+                shown += 1;
+            }
+            if shown == 0 {
+                recent = recent.push(widget::text::body(fl!("recents")));
+            }
+        }
+        widget::scrollable(
+            widget::column::with_capacity(4)
+                .spacing(space_s)
+                .padding(space_s)
+                .push(widget::text::title4(fl!("home")))
+                .push(places)
+                .push(widget::text::title4(fl!("recents")))
+                .push(recent),
+        )
+        .height(Length::Fill)
+        .into()
+    }
+
