+    /// Lapin UX (#101): twice a second while file operations run. Opens the
+    /// progress window, samples each operation's speed, sets the title to the
+    /// overall percentage, and closes the window when everything is done.
+    fn lapin_progress_tick(&mut self) -> Task<Message> {
+        let now = Instant::now();
+        let mut total = 0.0;
+        let mut count = 0;
+        for (id, (op, controller)) in &self.pending_operations {
+            if !op.show_progress_notification() {
+                continue;
+            }
+            let (bytes, progress) = (controller.bytes(), controller.progress());
+            total += progress;
+            count += 1;
+            let speed = self.lapin_speed.entry(*id).or_insert_with(|| LapinSpeed {
+                last: now,
+                last_bytes: bytes,
+                last_progress: progress,
+                samples: VecDeque::new(),
+                eta: None,
+            });
+            let dt = now.duration_since(speed.last).as_secs_f64();
+            if dt < 0.4 {
+                continue;
+            }
+            if controller.is_paused() {
+                speed.last = now;
+                speed.eta = None;
+                continue;
+            }
+            speed.samples.push_back(bytes.saturating_sub(speed.last_bytes) as f64 / dt);
+            if speed.samples.len() > 60 {
+                speed.samples.pop_front();
+            }
+            let rate = f64::from(progress - speed.last_progress) / dt;
+            // Smoothed, so the time left doesn't jump with every sample.
+            speed.eta = (rate > 0.0).then(|| f64::from(1.0 - progress) / rate).map(|eta| match speed.eta {
+                Some(old) => old * 0.7 + eta * 0.3,
+                None => eta,
+            });
+            speed.last = now;
+            speed.last_bytes = bytes;
+            speed.last_progress = progress;
+        }
+        self.lapin_speed.retain(|id, _| self.pending_operations.contains_key(id));
+
+        if self.progress_operations.is_empty() {
+            self.lapin_progress_hidden = false;
+            if let Some(id) = self.lapin_progress_window.take() {
+                self.windows.remove(&id);
+                return window::close(id);
+            }
+            return Task::none();
+        }
+        if self.lapin_progress_hidden {
+            return Task::none();
+        }
+        let percent = if count == 0 { 100 } else { (total / count as f32 * 100.0) as i32 };
+        let title = fl!("percent-complete", percent = percent);
+        if let Some(id) = self.lapin_progress_window {
+            return self.set_window_title(title, id);
+        }
+        let mut settings = window::Settings {
+            decorations: true,
+            min_size: Some(Size::new(420.0, 160.0)),
+            resizable: true,
+            size: Size::new(480.0, 260.0),
+            transparent: true,
+            ..Default::default()
+        };
+        #[cfg(target_os = "linux")]
+        {
+            // The dialog id, so it floats.
+            settings.platform_specific.application_id = "com.system76.CosmicFilesDialog".to_string();
+        }
+        let (id, command) = window::open(settings);
+        self.windows.insert(id, Window::new(WindowKind::LapinProgress));
+        self.lapin_progress_window = Some(id);
+        Task::batch([command.map(|_id| cosmic::action::none()), self.set_window_title(title, id)])
+    }
+
+    /// Lapin UX (#101): one section per running operation: what it does, a
+    /// progress bar with Pause and Cancel, and under More details the speed
+    /// graph, the item in hand, the time and the items left.
+    fn lapin_progress_view(&self) -> Element<'_, Message> {
+        let cosmic_theme::Spacing {
+            space_xxs, space_xs, space_s, ..
+        } = theme::spacing();
+        let details = self.lapin_progress_details;
+        let mut column = widget::column::with_capacity(8).spacing(space_s).padding(space_s);
+        for id in &self.progress_operations {
+            let Some((op, controller)) = self.pending_operations.get(id) else {
+                if let Some(op) = self.complete_operations.get(id) {
+                    column = column.push(widget::text::body(op.completed_text()));
+                }
+                continue;
+            };
+            let progress = controller.progress();
+            let paused = controller.is_paused();
+            let mut section = widget::column::with_capacity(4).spacing(space_xxs);
+            section = section.push(widget::text::heading(op.pending_text(progress, controller.state())));
+            section = section.push(
+                widget::row::with_capacity(3)
+                    .spacing(space_xs)
+                    .align_y(Alignment::Center)
+                    .push(widget::determinate_linear(progress).width(Length::Fill).girth(Length::Fixed(8.0)))
+                    .push(widget::tooltip(
+                        widget::button::icon(icon::from_name(if paused {
+                            "media-playback-start-symbolic"
+                        } else {
+                            "media-playback-pause-symbolic"
+                        }))
+                        .on_press(Message::PendingPause(*id, !paused)),
+                        widget::text::body(if paused { fl!("resume") } else { fl!("pause") }),
+                        widget::tooltip::Position::Top,
+                    ))
+                    .push(widget::tooltip(
+                        widget::button::icon(icon::from_name("window-close-symbolic")).on_press(Message::PendingCancel(*id)),
+                        widget::text::body(fl!("cancel")),
+                        widget::tooltip::Position::Top,
+                    )),
+            );
+            if details {
+                let speed = self.lapin_speed.get(id);
+                let samples: Vec<f64> = speed.map(|s| s.samples.iter().copied().collect()).unwrap_or_default();
+                let peak = samples.iter().copied().fold(1.0_f64, f64::max);
+                // The speed graph: one bar per half second, newest at the right.
+                let mut graph = widget::row::with_capacity(61).spacing(1).align_y(Alignment::End).height(Length::Fixed(64.0));
+                graph = graph.push(widget::space::horizontal());
+                for v in &samples {
+                    let h = ((v / peak) * 60.0).max(1.0) as f32;
+                    graph = graph.push(
+                        widget::container(widget::space::horizontal().width(Length::Fixed(5.0)))
+                            .height(Length::Fixed(h))
+                            .class(theme::Container::custom(|theme| {
+                                let accent: cosmic::iced::Color = theme.cosmic().accent_color().into();
+                                widget::container::Style {
+                                    background: Some(cosmic::iced::Background::Color(accent)),
+                                    ..Default::default()
+                                }
+                            })),
+                    );
+                }
+                section = section.push(
+                    widget::container(graph)
+                        .padding(2)
+                        .width(Length::Fill)
+                        .class(theme::Container::Card),
+                );
+                let now = samples.last().copied().unwrap_or(0.0);
+                let (done, all) = controller.items();
+                let mut facts = widget::column::with_capacity(4);
+                if controller.bytes() > 0 {
+                    facts = facts.push(widget::text::body(fl!("speed-now", speed = tab::format_size_public(now as u64))));
+                }
+                let name = controller.current();
+                if !name.is_empty() {
+                    facts = facts.push(widget::text::body(fl!("item-name", name = name)));
+                }
+                if let Some(eta) = speed.and_then(|s| s.eta).filter(|_| !paused) {
+                    let eta = eta.ceil() as u64;
+                    facts = facts.push(widget::text::body(if eta >= 3600 {
+                        fl!("time-left-hours", hours = (eta / 3600), minutes = (eta % 3600 / 60))
+                    } else if eta >= 60 {
+                        fl!("time-left-minutes", minutes = (eta / 60), seconds = (eta % 60))
+                    } else {
+                        fl!("time-left-seconds", seconds = eta)
+                    }));
+                }
+                if all > 0 {
+                    facts = facts.push(widget::text::body(fl!("items-left", items = all.saturating_sub(done))));
+                }
+                section = section.push(facts);
+            }
+            column = column.push(section);
+        }
+        column = column.push(
+            widget::button::link(if details { fl!("fewer-details") } else { fl!("more-details") })
+                .on_press(Message::LapinProgressDetails(!details))
+                .padding(0),
+        );
+        let _ = space_xs;
+        widget::container(widget::scrollable(column))
+            .width(Length::Fill)
+            .height(Length::Fill)
+            .class(theme::Container::Background)
+            .into()
+    }
+
     fn update_nav_model(&mut self) {
         let mut nav_model = segmented_button::ModelBuilder::default();
 
