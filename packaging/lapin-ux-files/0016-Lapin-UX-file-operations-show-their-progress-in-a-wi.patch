     fn footer(&self) -> Option<Element<'_, Message>> {
-        if self.progress_operations.is_empty() {
+        // Lapin UX shows progress in a window of its own (#101), unless you
+        // closed that window: then it's here, as in COSMIC.
+        if self.progress_operations.is_empty()
+            || (crate::config::lapin_session() && !self.lapin_progress_hidden)
+        {
             return None;
         }
 
@@ -7006,6 +7238,7 @@ impl Application for App {
                     };
                 }
                 WindowKind::DesktopViewOptions => self.desktop_view_options(),
+                WindowKind::LapinProgress => self.lapin_progress_view(),
                 WindowKind::Dialogs(id) => match self.dialog() {
                     Some(element) => return widget::autosize::autosize(element, id.clone()).into(),
                     None => widget::space::horizontal().into(),
@@ -7483,6 +7716,13 @@ impl Application for App {
             subscriptions.push(dialog.subscription());
         };
 
+        if crate::config::lapin_session()
+            && (!self.progress_operations.is_empty() || self.lapin_progress_window.is_some())
+        {
+            subscriptions
+                .push(iced::time::every(Duration::from_millis(500)).map(|_| Message::LapinProgressTick));
+        }
+
         Subscription::batch(subscriptions)
     }
 }
