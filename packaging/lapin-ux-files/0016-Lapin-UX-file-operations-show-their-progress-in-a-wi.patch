@@ -53,6 +63,37 @@ impl Controller {
         }
     }
 
+    pub fn add_bytes(&self, bytes: u64) {
+        self.inner.bytes.fetch_add(bytes, atomic::Ordering::Relaxed);
+    }
+
+    pub fn bytes(&self) -> u64 {
+        self.inner.bytes.load(atomic::Ordering::Relaxed)
+    }
+
+    pub fn set_items(&self, done: u64, total: u64) {
+        self.inner.items_done.store(done, atomic::Ordering::Relaxed);
+        self.inner.items_total.store(total, atomic::Ordering::Relaxed);
+    }
+
+    /// (done, in all); (0, 0) when the operation doesn't count items.
+    pub fn items(&self) -> (u64, u64) {
+        (
+            self.inner.items_done.load(atomic::Ordering::Relaxed),
+            self.inner.items_total.load(atomic::Ordering::Relaxed),
+        )
+    }
+
+    pub fn set_current(&self, name: String) {
+        if let Ok(mut c) = self.inner.current.lock() {
+            *c = name;
+        }
+    }
+
+    pub fn current(&self) -> String {
+        self.inner.current.lock().map(|c| c.clone()).unwrap_or_default()
+    }
+
     pub fn progress(&self) -> f32 {
         self.inner.progress.load(atomic::Ordering::Relaxed)
     }
