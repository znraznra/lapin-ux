+    /// Lapin UX: the file a Properties window shows.
+    fn lapin_window_item(&self, id: window::Id) -> Option<&tab::Item> {
+        let Some(Window { kind: WindowKind::Preview(entity_opt, kind), .. }) = self.windows.get(&id) else {
