+
+/// Lapin UX: what the Properties window's General page has been changed to,
+/// kept until OK or Apply.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct LapinPropsDraft {
+    pub name: String,
+    pub read_only: bool,
+    pub hidden: bool,
+    pub choosing_app: bool,
+}
+
+#[derive(Clone, Debug)]
+pub enum LapinPropsEdit {
+    Name(String),
+    ReadOnly(bool),
+    Hidden(bool),
+    ChooseApp,
+}
+
+impl Item {
+    /// Lapin UX: the General page's values as the file is now.
+    pub fn lapin_props_initial(&self) -> LapinPropsDraft {
+        #[cfg(unix)]
+        let read_only = {
+            use std::os::unix::fs::MetadataExt;
+            self.file_metadata().is_some_and(|m| m.mode() & 0o222 == 0)
+        };
+        #[cfg(not(unix))]
+        let read_only = false;
+        LapinPropsDraft {
+            name: self.name.trim_start_matches('.').to_string(),
+            read_only,
+            hidden: self.name.starts_with('.'),
+            choosing_app: false,
+        }
+    }
+
+    /// Lapin UX: the type as people know it ("PNG File", "File folder").
+    pub fn lapin_type_text(&self) -> String {
+        if self.metadata.is_dir() {
+            return fl!("type-folder");
+        }
+        match self.path_opt().and_then(|p| p.extension()).and_then(|e| e.to_str()) {
+            Some(ext) if !ext.is_empty() && ext.len() <= 8 => {
+                format!("{} (.{})", fl!("type-file", ext = ext.to_uppercase()), ext)
+            }
+            _ => fl!("type-plain"),
+        }
+    }
+
+    /// Lapin UX: the Properties window's General page, laid out as people
+    /// know it: icon and name, then sections split by lines.
+    pub fn lapin_general_view<'a>(
+        &'a self,
+        mime_app_cache: &'a mime_app::MimeAppCache,
+        military_time: bool,
+        draft: &LapinPropsDraft,
+    ) -> Element<'a, Message> {
+        let cosmic_theme::Spacing { space_xxs, space_s, .. } = theme::spacing();
+        let label_width = 130.0;
+        let row = |label: String, value: Element<'a, Message>| -> Element<'a, Message> {
+            widget::row::with_capacity(2)
+                .align_y(Alignment::Center)
+                .push(widget::text::body(label).width(Length::Fixed(label_width)))
+                .push(value)
+                .into()
+        };
+        let text = |s: String| -> Element<'a, Message> { widget::text::body(s).into() };
+        let mut column = widget::column::with_capacity(16).spacing(space_s);
+        column = column.push(
+            widget::row::with_capacity(2)
+                .spacing(space_s)
+                .align_y(Alignment::Center)
+                .push(widget::container(self.preview()).width(Length::Fixed(label_width - space_s as f32)).height(Length::Fixed(40.0)))
+                .push(
+                    widget::text_input("", draft.name.clone())
+                        .on_input(|name| Message::LapinPropsEdit(LapinPropsEdit::Name(name))),
+                ),
+        );
+        column = column.push(widget::divider::horizontal::default());
+        column = column.push(row(fl!("type-of-file"), text(self.lapin_type_text())));
+        if !self.metadata.is_dir() {
+            let apps = mime_app_cache.get_apps_for_mime(&self.mime, false);
+            let current = apps.iter().find(|(app, _)| app.is_default(&self.mime)).or(apps.first());
+            let mut value = widget::row::with_capacity(4).spacing(space_xxs).align_y(Alignment::Center);
+            if let Some((app, _)) = current {
+                value = value
+                    .push(widget::icon::icon(app.icon()).size(16))
+                    .push(widget::text::body(app.name.clone()));
+            }
+            value = value.push(widget::space::horizontal()).push(
+                widget::button::standard(fl!("change"))
+                    .class(lapin_box_button())
+                    .on_press(Message::LapinPropsEdit(LapinPropsEdit::ChooseApp)),
+            );
+            column = column.push(row(fl!("opens-with"), value.width(Length::Fill).into()));
+            if draft.choosing_app {
+                let mut list = widget::column::with_capacity(apps.len()).spacing(2);
+                for (app, _) in &apps {
+                    list = list.push(
+                        widget::button::custom(
+                            widget::row::with_capacity(2)
+                                .spacing(space_xxs)
+                                .align_y(Alignment::Center)
+                                .push(widget::icon::icon(app.icon()).size(16))
+                                .push(widget::text::body(app.name.clone())),
+                        )
+                        .width(Length::Fill)
+                        .class(theme::Button::MenuItem)
+                        .on_press(Message::SetOpenWith(self.mime.clone(), app.id.clone())),
+                    );
+                }
+                column = column.push(
+                    widget::row::with_capacity(2)
+                        .push(widget::space::horizontal().width(Length::Fixed(label_width)))
+                        .push(list),
+                );
+            }
+        }
+        column = column.push(widget::divider::horizontal::default());
+        if let Some(parent) = self.path_opt().and_then(|p| p.parent()) {
+            column = column.push(row(fl!("location"), text(parent.display().to_string())));
+        }
+        if let Some(metadata) = self.file_metadata() {
+            if metadata.is_dir() {
+                let size = match &self.dir_size {
+                    DirSize::Calculating(_) => fl!("calculating"),
+                    DirSize::Directory(size) => { let size = *size; format!("{} ({})", format_size(size), fl!("bytes", bytes = size)) }
+                    DirSize::NotDirectory => String::new(),
+                    DirSize::Error(err) => err.clone(),
+                };
+                if !size.is_empty() {
+                    column = column.push(row(fl!("props-size"), text(size)));
+                }
+                if let Some(children) = self.metadata.children_count() {
+                    column = column.push(row(fl!("props-contains"), text(fl!("status-items", items = children))));
+                }
+            } else {
+                let len = metadata.len();
+                column = column.push(row(fl!("props-size"), text(format!("{} ({})", format_size(len), fl!("bytes", bytes = len)))));
+                #[cfg(unix)]
+                {
+                    use std::os::unix::fs::MetadataExt;
+                    let on_disk = metadata.blocks() * 512;
+                    column = column.push(row(
+                        fl!("size-on-disk"),
+                        text(format!("{} ({})", format_size(on_disk), fl!("bytes", bytes = on_disk))),
+                    ));
+                }
+            }
+            column = column.push(widget::divider::horizontal::default());
+            let long = |time: SystemTime| -> String {
+                let Ok(ts) = jiff::Timestamp::try_from(time) else { return String::new() };
+                let zoned = ts.to_zoned(jiff::tz::TimeZone::system());
+                if military_time {
+                    zoned.strftime("%A, %-d %B %Y, %H:%M:%S").to_string()
+                } else {
+                    zoned.strftime("%A, %-d %B %Y, %-I:%M:%S %P").to_string()
+                }
+            };
+            for (label, time) in [
+                (fl!("props-created"), metadata.created()),
+                (fl!("props-modified"), metadata.modified()),
+                (fl!("props-accessed"), metadata.accessed()),
+            ] {
+                if let Ok(time) = time {
+                    column = column.push(row(label, text(long(time))));
+                }
+            }
+        }
+        column = column.push(widget::divider::horizontal::default());
+        column = column.push(row(
+            fl!("attributes"),
+            widget::row::with_capacity(2)
+                .spacing(space_s)
+                .push(
+                    widget::checkbox(draft.read_only)
+                        .label(fl!("read-only"))
+                        .on_toggle(|on| Message::LapinPropsEdit(LapinPropsEdit::ReadOnly(on))),
+                )
+                .push(
+                    widget::checkbox(draft.hidden)
+                        .label(fl!("hidden"))
+                        .on_toggle(|on| Message::LapinPropsEdit(LapinPropsEdit::Hidden(on))),
+                )
+                .into(),
+        ));
+        column.into()
+    }
+}
