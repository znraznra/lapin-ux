diff --git a/src/tab.rs b/src/tab.rs
index be2d779..166ab85 100644
--- a/src/tab.rs
+++ b/src/tab.rs
@@ -3089,7 +3089,24 @@ fn lapin_widths() -> [f32; 3] {
 
 /// Lapin UX: the width of a column-resize handle in the headings.
 const LAPIN_HANDLE: f32 = 8.0;
+/// Lapin UX (#212): one line of body text in a fixed-width column, cut with an
+/// ellipsis and clipped so it never wraps or spills into the next column.
+fn lapin_cell<'a>(text: String, width: f32) -> Element<'a, Message> {
+    let text = crate::app::lapin_ellipsize(&text, width);
+    widget::container(widget::text::body(text).wrapping(text::Wrapping::None))
+        .width(Length::Fixed(width))
+        .clip(true)
+        .into()
+}
+
 fn modified_cell<'a>(modified: String, kind: Option<String>, width: f32) -> Element<'a, Message> {
+    if lapin_columns() {
+        let mut row = widget::row::with_capacity(2).push(lapin_cell(modified, width));
+        if let Some(kind) = kind {
+            row = row.push(lapin_cell(kind, lapin_widths()[1]));
+        }
+        return row.into();
+    }
     match kind {
         Some(kind) => widget::row::with_capacity(2)
             .push(widget::text::body(modified).width(Length::Fixed(width)))
@@ -3103,6 +3120,35 @@ fn modified_cell<'a>(modified: String, kind: Option<String>, width: f32) -> Elem
     }
 }
 
+fn lapin_size_cell<'a>(text: String, width: f32) -> Element<'a, Message> {
+    if lapin_columns() {
+        lapin_cell(text, width)
+    } else {
+        widget::text::body(text).width(Length::Fixed(width)).into()
+    }
+}
+
+/// Lapin UX (#212): a column heading on one line, cut with an ellipsis (room is
+/// kept for the sort arrow) and clipped, so it never wraps over the rows.
+fn lapin_heading_label<'a>(name: String, width: Length, sorted: bool) -> Element<'a, Message> {
+    if !lapin_columns() {
+        return widget::text::heading(name).into();
+    }
+    match width {
+        Length::Fixed(w) => {
+            let room = w - if sorted { 22.0 } else { 0.0 };
+            widget::container(
+                widget::text::heading(crate::app::lapin_ellipsize(&name, room.max(0.0)))
+                    .wrapping(text::Wrapping::None),
+            )
+            .width(Length::Fixed(room.max(0.0)))
+            .clip(true)
+            .into()
+        }
+        _ => widget::text::heading(name).wrapping(text::Wrapping::None).into(),
+    }
+}
+
 /// Which half of the location row to build (Lapin UX splits it).
 #[derive(Clone, Copy, Debug, PartialEq, Eq)]
 pub enum LocationPart {
