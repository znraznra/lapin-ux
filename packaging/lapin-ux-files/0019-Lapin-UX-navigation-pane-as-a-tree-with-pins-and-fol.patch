+    /// Lapin UX (#143): the navigation pane as a tree. Every entry of the
+    /// model is a row: a chevron when it can be opened out, its icon and name,
+    /// and a pin for pinned folders. Same handlers as COSMIC's `nav_bar`.
+    fn lapin_tree_pane(&self) -> Element<'_, cosmic::Action<Message>> {
+        use cosmic::widget::dnd_destination::DndDestination;
+        let cosmic_theme::Spacing { space_xxs, space_xs, .. } = theme::spacing();
+        let app = |m: Message| cosmic::Action::App(m);
+        let mut column = widget::column::with_capacity(self.nav_model.len() + 4).spacing(2);
+        for entity in self.nav_model.iter() {
+            if self.nav_model.divider_above(entity) == Some(true) {
+                column = column.push(
+                    widget::container(widget::divider::horizontal::default()).padding([space_xxs, space_xs]),
+                );
+            }
+            let indent = self.nav_model.indent(entity).unwrap_or(0);
+            let tree = self.nav_model.data::<LapinTree>(entity);
+            let this_pc = matches!(self.nav_model.data::<LapinNav>(entity), Some(LapinNav::ThisPc));
+            let chevron: Element<'_, cosmic::Action<Message>> = if this_pc {
+                widget::button::icon(
+                    icon::from_name(if self.lapin_drives_collapsed { "go-next-symbolic" } else { "go-down-symbolic" }).size(12),
+                )
+                .padding(4)
+                .on_press(app(Message::NavMenuAction(NavMenuAction::LapinToggleDrives)))
+                .into()
+            } else if let Some(tree) = tree.filter(|t| t.expandable) {
+                widget::button::icon(
+                    icon::from_name(if self.lapin_expanded.contains(&tree.path) { "go-down-symbolic" } else { "go-next-symbolic" })
+                        .size(12),
+                )
+                .padding(4)
+                .on_press(app(Message::LapinTreeToggle(tree.path.clone())))
+                .into()
+            } else {
+                widget::space::horizontal().width(Length::Fixed(20.0)).into()
+            };
+            let mut row = widget::row::with_capacity(5)
+                .spacing(space_xxs)
+                .align_y(Alignment::Center)
+                .push(widget::space::horizontal().width(Length::Fixed(f32::from(indent) * 16.0)))
+                .push(chevron);
+            if let Some(icon) = self.nav_model.icon(entity) {
+                row = row.push(icon.clone());
+            }
+            row = row.push(
+                widget::text::body(self.nav_model.text(entity).unwrap_or_default().to_string())
+                    .width(Length::Fill)
+                    .wrapping(cosmic::iced::widget::text::Wrapping::None),
+            );
+            if self.nav_model.data::<FavoriteIndex>(entity).is_some() {
+                row = row.push(icon::from_name("view-pin-symbolic").size(14));
+            } else if self.nav_model.is_closable(entity) {
+                row = row.push(
+                    widget::button::icon(icon::from_name("media-eject-symbolic").size(14))
+                        .padding(4)
+                        .on_press(app(Message::NavBarClose(entity))),
+                );
+            }
+            let button = widget::button::custom(row)
+                .width(Length::Fill)
+                .padding([6, space_xxs])
+                .class(if self.nav_model.is_active(entity) {
+                    theme::Button::Standard
+                } else {
+                    theme::Button::MenuItem
+                })
+                .on_press(cosmic::Action::Cosmic(cosmic::app::Action::NavBar(entity)));
+            let area = crate::mouse_area::MouseArea::new(button).on_middle_press(move |_| {
+                cosmic::Action::App(Message::NavMenuAction(NavMenuAction::OpenInNewTab(entity)))
+            });
+            let mut menu = widget::context_menu(
+                area,
+                Some(cosmic::widget::menu::items(&HashMap::new(), self.nav_menu_items(entity))),
+            )
+            .on_surface_action(|action| cosmic::Action::Surface(action.flatten()));
+            if let Some(id) = self.core().main_window_id() {
+                menu = menu.window_id(id);
+            }
+            column = column.push(
+                DndDestination::for_data::<ClipboardPaste>(menu, move |data, action| {
+                    cosmic::Action::App(Message::DndDropNav(entity, data, action))
+                })
+                .on_enter(move |_, _, _| cosmic::Action::App(Message::DndEnterNav(entity)))
+                .on_leave(|| cosmic::Action::App(Message::DndExitNav)),
+            );
+        }
+        widget::container(widget::scrollable(column.padding([space_xxs, space_xs])))
+            .width(Length::Fixed(280.0))
+            .height(Length::Fill)
+            .into()
+    }
