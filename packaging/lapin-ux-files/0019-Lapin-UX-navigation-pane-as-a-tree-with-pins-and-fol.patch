+/// Lapin UX: a navigation pane row that is a folder in the tree (#143).
+#[derive(Clone, Debug)]
+struct LapinTree {
+    path: PathBuf,
+    depth: u16,
+    expandable: bool,
+}
+
+/// The folders in `dir` that aren't hidden, by name (at most 300).
+fn lapin_subfolders(dir: &Path) -> Vec<PathBuf> {
+    let mut dirs: Vec<PathBuf> = fs::read_dir(dir)
+        .map(|rd| {
+            rd.flatten()
+                .filter(|e| !e.file_name().to_string_lossy().starts_with('.'))
+                .map(|e| e.path())
+                .filter(|p| p.is_dir())
+                .take(300)
+                .collect()
+        })
+        .unwrap_or_default();
+    dirs.sort_by(|a, b| LANGUAGE_SORTER.compare(&a.to_string_lossy(), &b.to_string_lossy()));
+    dirs
+}
+
