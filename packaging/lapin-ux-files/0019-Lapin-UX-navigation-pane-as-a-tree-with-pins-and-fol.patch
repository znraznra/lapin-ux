+    /// Lapin UX: the folders inside `dir`, as tree rows under it (and theirs,
+    /// for the ones that are opened out).
+    fn lapin_tree_children(
+        mut model: segmented_button::ModelBuilder<segmented_button::SingleSelect>,
+        dir: &Path,
+        depth: u16,
+        expanded: &BTreeSet<PathBuf>,
+    ) -> segmented_button::ModelBuilder<segmented_button::SingleSelect> {
+        for path in lapin_subfolders(dir) {
+            let name = path.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default();
+            let tree = LapinTree { path: path.clone(), depth, expandable: !lapin_subfolders(&path).is_empty() };
+            let open = tree.expandable && expanded.contains(&path);
+            let location = Location::Path(path.clone());
+            let handle = tab::folder_icon_symbolic(&path, 16);
+            model = model.insert(move |b| b.text(name.clone()).icon(icon::icon(handle.clone()).size(16)).data(location.clone()).data(tree.clone()));
+            if open && depth < 12 {
+                model = Self::lapin_tree_children(model, &path, depth + 1, expanded);
+            }
+        }
+        model
+    }
