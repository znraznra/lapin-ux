         headings.push(heading_item(fl!("size"), Length::Fixed(size_width), HeadingOptions::Size));
         let heading_row = widget::row::with_children(headings)
         .align_y(Alignment::Center)
@@ -6395,8 +6444,11 @@ impl Tab {
         let size = self.size_opt.get().unwrap_or_else(|| Size::new(0.0, 0.0));
         //TODO: allow resizing?
         let name_width = 300.0;
-        let modified_width = 200.0;
-        let size_width = 100.0;
+        let (modified_width, size_width) = if lapin_columns() {
+            (lapin_widths()[0], lapin_widths()[2])
