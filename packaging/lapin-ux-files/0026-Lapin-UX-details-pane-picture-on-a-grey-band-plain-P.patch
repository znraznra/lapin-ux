+/// Lapin UX: Compact view (smaller row spacing in the details view). Kept in
+/// Lapin's own `dev.lapinux.Explorer` settings.
+static LAPIN_COMPACT: atomic::AtomicBool = atomic::AtomicBool::new(false);
+const LAPIN_EXPLORER_CONFIG: &str = "dev.lapinux.Explorer";
+
+pub fn lapin_compact() -> bool {
+    LAPIN_COMPACT.load(atomic::Ordering::Relaxed)
+}
+
+pub fn lapin_compact_load() {
+    use cosmic::cosmic_config::ConfigGet;
+    if let Ok(config) = cosmic::cosmic_config::Config::new(LAPIN_EXPLORER_CONFIG, 1)
+        && let Ok(on) = config.get::<bool>("compact_view")
+    {
+        LAPIN_COMPACT.store(on, atomic::Ordering::Relaxed);
+    }
+}
+
+pub fn lapin_compact_toggle() {
+    use cosmic::cosmic_config::ConfigSet;
+    let on = !lapin_compact();
+    LAPIN_COMPACT.store(on, atomic::Ordering::Relaxed);
+    if let Ok(config) = cosmic::cosmic_config::Config::new(LAPIN_EXPLORER_CONFIG, 1)
+        && let Err(err) = config.set("compact_view", on)
+    {
+        log::warn!("failed to save compact view: {err}");
+    }
+}
+
+/// Lapin UX: the grey band behind the picture in the details pane.
+pub fn lapin_band_style() -> theme::Container<'static> {
+    theme::Container::custom(|t| {
+        let c = t.cosmic();
+        let bg: cosmic::iced::Color = if c.is_dark {
+            c.primary(false).base.into()
+        } else {
+            cosmic::iced::Color::from_rgb8(0xf3, 0xf3, 0xf3)
+        };
+        cosmic::iced::widget::container::Style {
+            background: Some(bg.into()),
+            ..Default::default()
+        }
+    })
+}
+
+/// Lapin UX: a plain button: a lightly rounded box with a thin outline, not
+/// a pill.
+pub fn lapin_box_button() -> theme::Button {
+    use cosmic::widget::button::Catalog;
+    fn boxed(mut s: cosmic::widget::button::Style, t: &cosmic::Theme) -> cosmic::widget::button::Style {
+        let c = t.cosmic();
+        s.border_radius = c.corner_radii.radius_s.into();
+        s.border_width = 1.0;
+        s.border_color = c.background(false).component.divider.into();
+        s
+    }
+    // Light mode: near-white, a touch darker on hover and press.
+    fn shade(mut s: cosmic::widget::button::Style, t: &cosmic::Theme, v: u8) -> cosmic::widget::button::Style {
+        if !t.cosmic().is_dark {
+            s.background = Some(cosmic::iced::Color::from_rgb8(v, v, v).into());
+        }
+        boxed(s, t)
+    }
+    theme::Button::Custom {
+        active: Box::new(|f, t| shade(t.active(f, false, &theme::Button::Standard), t, 0xfb)),
+        disabled: Box::new(|t| boxed(t.disabled(&theme::Button::Standard), t)),
+        hovered: Box::new(|f, t| shade(t.hovered(f, false, &theme::Button::Standard), t, 0xf6)),
+        pressed: Box::new(|f, t| shade(t.pressed(f, false, &theme::Button::Standard), t, 0xf0)),
+    }
+}
