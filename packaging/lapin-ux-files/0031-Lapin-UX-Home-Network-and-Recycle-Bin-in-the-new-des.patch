+
+/// Lapin UX: the column headings over Home's file lists.
+fn lapin_file_headings<'a>() -> Element<'a, Message> {
+    let space_xs = theme::spacing().space_xs;
+    widget::row::with_capacity(3)
+        .padding([4, space_xs])
+        .push(widget::text::heading(fl!("name")).width(Length::FillPortion(3)))
+        .push(widget::text::heading(fl!("date-accessed")).width(Length::Fixed(200.0)))
+        .push(widget::text::heading(fl!("file-location")).width(Length::FillPortion(2)))
+        .into()
+}
+
+/// Lapin UX: one file on Home: icon and name, when it was last opened, and
+/// its folder.
+fn lapin_file_columns<'a>(path: &Path, name: String, parent: String) -> Element<'a, Message> {
+    let space_xs = theme::spacing().space_xs;
+    let accessed = std::fs::metadata(path)
+        .and_then(|m| m.accessed())
+        .ok()
+        .and_then(|t| jiff::Timestamp::try_from(t).ok())
+        .map(|ts| ts.to_zoned(jiff::tz::TimeZone::system()).strftime("%d/%m/%Y %-I:%M %P").to_string())
+        .unwrap_or_default();
+    widget::row::with_capacity(3)
+        .align_y(Alignment::Center)
+        .push(
+            widget::row::with_capacity(2)
+                .spacing(space_xs)
+                .align_y(Alignment::Center)
+                .width(Length::FillPortion(3))
+                .push(icon::icon(crate::mime_icon::mime_icon(crate::mime_icon::mime_for_path(path, None, false), 16)).size(16))
+                .push(widget::text::body(name)),
+        )
+        .push(widget::text::body(accessed).width(Length::Fixed(200.0)))
+        .push(
+            widget::text::body(parent)
+                .width(Length::FillPortion(2))
+                .wrapping(cosmic::iced::widget::text::Wrapping::None),
+        )
+        .into()
+}
