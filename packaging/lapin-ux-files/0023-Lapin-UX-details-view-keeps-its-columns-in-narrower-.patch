Subject: [PATCH] Lapin UX: details view keeps its columns in narrower windows

---
 src/tab.rs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/tab.rs b/src/tab.rs
index 09424fb..eeae92f 100644
--- a/src/tab.rs
+++ b/src/tab.rs
@@ -5626,7 +5626,7 @@ impl Tab {
         let modified_width = 200.0;
         let size_width = 100.0;
         let condensed = size.width
-            < (name_width + modified_width + size_width + if lapin_columns() { TYPE_WIDTH - 100.0 } else { 0.0 });
+            < (name_width + modified_width + size_width + if lapin_columns() { -120.0 } else { 0.0 });
 
         let (sort_name, sort_direction, _) = self.sort_options();
         let heading_item = |name, width, msg| {
@@ -6344,7 +6344,7 @@ impl Tab {
         let modified_width = 200.0;
         let size_width = 100.0;
         let condensed = size.width
-            < (name_width + modified_width + size_width + if lapin_columns() { TYPE_WIDTH - 100.0 } else { 0.0 });
+            < (name_width + modified_width + size_width + if lapin_columns() { -120.0 } else { 0.0 });
         let is_search = matches!(self.location, Location::Search(..));
         let icon_size = if condensed || is_search {
             icon_sizes.list_condensed()
