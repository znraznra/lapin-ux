+    /// Lapin UX: Back, Forward, Up and Refresh, the address bar, and the search box.
+    fn lapin_nav_row(&self) -> Element<'_, Message> {
+        let cosmic_theme::Spacing {
+            space_xxs, space_xs, space_s, ..
+        } = theme::spacing();
+        let entity = self.tab_model.active();
+        let tab = self.tab_model.data::<Tab>(entity);
+        let page = self.lapin_home || self.lapin_pc;
+        let nav = |name: &'static str, label: String, action: Action, enabled: bool| {
+            let b = widget::button::icon(icon::from_name(name).size(16));
+            widget::tooltip(
+                if enabled { b.on_press(action.message(None)) } else { b },
+                widget::text::body(label),
+                widget::tooltip::Position::Bottom,
+            )
+        };
+        let back = page || tab.is_some_and(|t| t.history_i > 0 && !t.history.is_empty());
+        let forward = !page && tab.is_some_and(|t| t.history_i + 1 < t.history.len());
+        let up = !page && tab.is_some_and(|t| t.location.path_opt().is_some_and(|p| p.parent().is_some()));
+        let (address, place): (Element<'_, Message>, String) = if self.lapin_home || self.lapin_pc {
+            let name = if self.lapin_home { fl!("home") } else { fl!("this-pc") };
+            (
+                widget::row::with_capacity(3)
+                    .spacing(space_xxs)
+                    .align_y(Alignment::Center)
+                    .push(icon::from_name(if self.lapin_home { "user-home-symbolic" } else { "computer-symbolic" }).size(16))
+                    .push(icon::from_name("go-next-symbolic").size(16))
+                    .push(widget::text::body(name.clone()))
+                    .into(),
+                name,
+            )
+        } else if let Some(tab) = tab {
+            (
+                tab.location_view_part(tab::LocationPart::Address)
+                    .map(move |message| Message::TabMessage(Some(entity), message)),
+                tab.title(),
+            )
+        } else {
+            (widget::space::horizontal().into(), String::new())
+        };
+        widget::row::with_capacity(7)
+            .spacing(space_xxs)
+            .align_y(Alignment::Center)
+            .padding([space_xxs, space_s])
+            .push(nav("go-previous-symbolic", fl!("back"), Action::HistoryPrevious, back))
+            .push(nav("go-next-symbolic", fl!("forward"), Action::HistoryNext, forward))
+            .push(nav("go-up-symbolic", fl!("up"), Action::LocationUp, up))
+            .push(nav("view-refresh-symbolic", fl!("reload-folder"), Action::Reload, !page))
+            .push(
+                widget::container(address)
+                    .width(Length::Fill)
+                    .height(Length::Fixed(36.0))
+                    .align_y(Alignment::Center)
+                    .padding([0, space_xs])
+                    .class(theme::Container::Card),
+            )
+            .push(
+                widget::text_input::search_input(fl!("search-place", name = place), self.search_get().unwrap_or(""))
+                    .width(Length::Fixed(260.0))
+                    .id(self.search_id.clone())
+                    .on_clear(Message::SearchClear)
+                    .on_input(Message::SearchInput),
+            )
+            .into()
+    }
+
+    /// Lapin UX: how many items there are and how many are selected (with
+    /// their size) at the left, the two view buttons at the right.
+    fn lapin_status_bar(&self) -> Element<'_, Message> {
+        let cosmic_theme::Spacing { space_xxs, space_s, .. } = theme::spacing();
+        let tab = self.tab_model.active_data::<Tab>();
+        let (mut items, mut selected, mut bytes, mut sized) = (0usize, 0usize, 0u64, true);
+        if let Some(list) = tab.and_then(|t| t.items_opt()) {
+            for item in list.iter() {
+                if item.hidden && !tab.is_some_and(|t| t.config.show_hidden) {
+                    continue;
+                }
+                items += 1;
+                if item.selected {
+                    selected += 1;
+                    match item.metadata.file_size() {
+                        Some(size) => bytes += size,
+                        None => sized = false,
+                    }
+                }
+            }
+        }
+        let page = self.lapin_home || self.lapin_pc;
+        let grid = tab.is_some_and(|t| t.config.view == tab::View::Grid);
+        let mut row = widget::row::with_capacity(8).spacing(space_s).align_y(Alignment::Center);
+        if !page {
+            row = row.push(widget::text::body(fl!("status-items", items = items)));
+            if selected > 0 {
+                row = row.push(widget::divider::vertical::default().height(Length::Fixed(14.0)));
+                row = row.push(widget::text::body(fl!("status-selected", items = selected)));
+                if sized && bytes > 0 {
+                    row = row.push(widget::text::body(tab::format_size_public(bytes)));
+                }
+            }
+        }
+        row = row.push(widget::space::horizontal());
+        if !page {
+            let view = |name: &'static str, label: String, action: Action, on: bool| {
+                widget::tooltip(
+                    widget::button::icon(icon::from_name(name).size(16))
+                        .selected(on)
+                        .on_press(action.message(None)),
+                    widget::text::body(label),
+                    widget::tooltip::Position::Top,
+                )
+            };
+            row = row
+                .push(view("view-list-symbolic", fl!("list-view"), Action::TabViewList, !grid))
+                .push(view("view-grid-symbolic", fl!("grid-view"), Action::TabViewGrid, grid));
+        }
+        widget::container(row)
+            .padding([space_xxs, space_s])
+            .width(Length::Fill)
+            .into()
+    }
+
+    /// The navigation pane: COSMIC's `nav_bar`, or the pane Lapin UX puts
+    /// beside the files itself.
+    fn nav_pane(&self) -> Option<Element<'_, cosmic::Action<Message>>> {
+        if !self.core.nav_bar_active() {
+            return None;
+        }
+
+        let nav_model = match self.mode {
+            Mode::App => &self.nav_model,
+            Mode::Desktop => return None,
+        };
+
+        let mut nav = cosmic::widget::nav_bar(nav_model, |entity| {
+            cosmic::Action::Cosmic(cosmic::app::Action::NavBar(entity))
+        })
+        .drag_id(self.nav_drag_id)
+        .on_dnd_enter(|entity, _| cosmic::Action::App(Message::DndEnterNav(entity)))
+        .on_dnd_leave(|_| cosmic::Action::App(Message::DndExitNav))
+        .on_dnd_drop(|entity, data, action| {
+            cosmic::Action::App(Message::DndDropNav(entity, data, action))
+        })
+        .on_context(|entity| cosmic::Action::App(Message::NavBarContext(entity)))
+        .on_close(|entity| cosmic::Action::App(Message::NavBarClose(entity)))
+        .on_middle_press(|entity| {
+            cosmic::Action::App(Message::NavMenuAction(NavMenuAction::OpenInNewTab(entity)))
+        })
+        .context_menu(self.nav_context_menu())
+        .close_icon(icon::from_name("media-eject-symbolic").size(16).icon());
+
+        #[cfg(feature = "wayland")]
+        {
+            nav = nav
+                .window_id_maybe(self.core().main_window_id())
+                .on_surface_action(|action| cosmic::Action::Surface(action.flatten()))
+        }
+
+        let mut nav = nav.into_container();
+
+        if !self.core.is_condensed() {
+            nav = nav.max_width(280);
+        }
+
+        Some(Element::from(
+            nav.width(Length::Shrink).height(Length::Fill),
+        ))
+    }
