+/// Lapin UX: which date group a file is in (0 today … 7 long ago), folders included.
+fn lapin_date_group(item: &Item, now: &jiff::Zoned) -> u8 {
+    let Some(then) = (match &item.metadata {
+        ItemMetadata::Path { metadata, .. } => metadata.modified().ok(),
+        _ => None,
+    })
+    .and_then(|time| jiff::Zoned::try_from(time).ok()) else {
+        return 7;
+    };
+    let (today, day) = (now.date(), then.date());
+    // Days since a fixed day, so two dates can be compared as numbers.
+    let number = |d: jiff::civil::Date| -> i64 {
+        jiff::civil::date(1970, 1, 1).until(d).map(|span| i64::from(span.get_days())).unwrap_or(0)
+    };
+    let (t, d) = (number(today), number(day));
+    let week_start = t - i64::from(today.weekday().to_monday_zero_offset());
+    let months = |x: jiff::civil::Date| i32::from(x.year()) * 12 + i32::from(x.month());
+    if d >= t {
+        0
+    } else if d == t - 1 {
+        1
+    } else if d >= week_start {
+        2
+    } else if d >= week_start - 7 {
+        3
+    } else if months(day) == months(today) {
+        4
+    } else if months(today) - months(day) == 1 {
+        5
+    } else if day.year() == today.year() {
+        6
+    } else {
+        7
+    }
+}
+fn lapin_group_name(group: u8) -> String {
+    match group {
+        0 => fl!("group-today"),
+        1 => fl!("group-yesterday"),
+        2 => fl!("group-this-week"),
+        3 => fl!("group-last-week"),
+        4 => fl!("group-this-month"),
+        5 => fl!("group-last-month"),
+        6 => fl!("group-this-year"),
+        _ => fl!("group-long-ago"),
+    }
+}
