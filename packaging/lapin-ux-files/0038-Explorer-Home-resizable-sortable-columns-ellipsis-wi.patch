-fn lapin_file_headings<'a>() -> Element<'a, Message> {
+/// Width of the grab handle at the right edge of each Home column heading.
+const LAPIN_HOME_HANDLE: f32 = 8.0;
+
+/// Lapin UX (#168): a file listed on Home.
+struct LapinHomeFile {
+    path: PathBuf,
+    name: String,
+    parent: String,
+    accessed: Option<std::time::SystemTime>,
+}
+
+impl LapinHomeFile {
+    fn new(path: PathBuf, name: Option<String>) -> Self {
+        let name = name
+            .or_else(|| path.file_name().map(|n| n.to_string_lossy().into_owned()))
+            .unwrap_or_else(|| path.display().to_string());
+        let parent = path.parent().map(|p| p.display().to_string()).unwrap_or_default();
+        let accessed = std::fs::metadata(&path).and_then(|m| m.accessed()).ok();
+        Self { path, name, parent, accessed }
+    }
+}
+
+/// Lapin UX (#168): sort Home's files by a column. With no choice the order
+/// stays as it came (most recently used first).
+fn lapin_sort_files(files: &mut [(Option<usize>, LapinHomeFile)], sort: Option<(u8, bool)>) {
+    let Some((column, ascending)) = sort else { return };
+    files.sort_by(|(_, a), (_, b)| {
+        let order = match column {
+            0 => a.name.to_lowercase().cmp(&b.name.to_lowercase()),
+            1 => a.accessed.cmp(&b.accessed),
+            _ => a.parent.to_lowercase().cmp(&b.parent.to_lowercase()),
+        };
+        if ascending { order } else { order.reverse() }
+    });
+}
+
+/// Lapin UX (#168): text cut to fit `px` of width, ending in an ellipsis. The
+/// widths are an estimate (the text renderer has no ellipsis of its own), so
+/// the cells also clip as a safety net.
+fn lapin_ellipsize(text: &str, px: f32) -> String {
+    const UNIT: f32 = 7.2;
+    let unit = |c: char| {
+        if c >= '\u{2E80}' {
+            2.0
+        } else if c.is_uppercase() {
+            1.25
+        } else {
+            1.0
+        }
+    };
+    let budget = (px / UNIT).floor();
+    if text.chars().map(unit).sum::<f32>() <= budget {
+        return text.to_string();
+    }
+    if budget < 2.0 {
+        return String::new();
+    }
+    let mut out = String::new();
+    let mut used = 1.0;
+    for c in text.chars() {
+        used += unit(c);
+        if used > budget {
+            break;
+        }
+        out.push(c);
+    }
+    out.push('\u{2026}');
+    out
+}
+
