-        .push(widget::text::heading(fl!("file-location")).width(Length::FillPortion(2)))
-        .into()
+    let mut row = widget::row::with_capacity(3).padding([4, space_xs]).align_y(Alignment::Center);
+    for (i, title) in [fl!("name"), fl!("date-accessed"), fl!("file-location")].into_iter().enumerate() {
+        let mut label = widget::row::with_capacity(2).spacing(space_xs).align_y(Alignment::Center).push(
+            widget::text::heading(title).wrapping(cosmic::iced::widget::text::Wrapping::None),
+        );
+        if let Some((column, ascending)) = layout.sort
+            && usize::from(column) == i
+        {
+            label = label.push(icon::from_name(if ascending { "pan-up-symbolic" } else { "pan-down-symbolic" }).size(12));
+        }
+        let handle = crate::mouse_area::MouseArea::new(
+            widget::container(cosmic::iced::widget::rule::vertical(1))
+                .width(Length::Fixed(LAPIN_HOME_HANDLE))
+                .height(Length::Fixed(16.0))
+                .center_x(Length::Fixed(LAPIN_HOME_HANDLE)),
+        )
+        .on_press(move |_| Message::LapinHomeColStart(i))
+        .on_drag_delta(move |dx| Message::LapinHomeColDrag(i, dx))
+        .on_drag_end(|_| Message::LapinHomeColSave);
+        row = row.push(
+            widget::container(
+                widget::row::with_capacity(2)
+                    .align_y(Alignment::Center)
+                    .push(
+                        crate::mouse_area::MouseArea::new(widget::container(label).width(Length::Fill))
+                            .on_press(move |_| Message::LapinHomeSort(i)),
+                    )
