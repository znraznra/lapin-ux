+/// Lapin UX (#168): how the lists on Home are laid out: the widths of the
+/// Name, Date accessed and File location columns, which sections are folded
+/// and how the lists are sorted. Kept in Lapin's own `dev.lapinux.Explorer`.
+#[derive(Clone, Debug, PartialEq, serde::Serialize, serde::Deserialize)]
+pub struct LapinHomeLayout {
+    pub widths: [f32; 3],
+    /// Quick access, Favorites, Recent.
+    pub collapsed: [bool; 3],
+    /// Column (0 name, 1 date, 2 location) and whether it is ascending.
+    pub sort: Option<(u8, bool)>,
+}
+
+impl Default for LapinHomeLayout {
+    fn default() -> Self {
+        Self {
+            widths: [320.0, 190.0, 360.0],
+            collapsed: [false; 3],
+            sort: None,
+        }
+    }
+}
+
+pub fn lapin_home_load() -> LapinHomeLayout {
+    use cosmic::cosmic_config::ConfigGet;
+    let mut layout = cosmic::cosmic_config::Config::new(LAPIN_EXPLORER_CONFIG, 1)
+        .ok()
+        .and_then(|c| c.get::<LapinHomeLayout>("home_layout").ok())
+        .unwrap_or_default();
+    for w in &mut layout.widths {
+        *w = w.clamp(60.0, 800.0);
+    }
+    layout
+}
+
+pub fn lapin_home_save(layout: &LapinHomeLayout) {
+    use cosmic::cosmic_config::ConfigSet;
+    if let Ok(config) = cosmic::cosmic_config::Config::new(LAPIN_EXPLORER_CONFIG, 1)
+        && let Err(err) = config.set("home_layout", layout.clone())
+    {
+        log::warn!("failed to save the Home layout: {err}");
+    }
+}
