+    /// Lapin UX (#143): the details pane sits beside the files, under the rows
+    /// that span the window, instead of in COSMIC's drawer over them.
+    fn lapin_details_pane(&self) -> Option<(Option<Entity>, &PreviewKind)> {
+        if !crate::config::lapin_session() || !matches!(self.mode, Mode::App) || !self.core.window.show_context {
+            return None;
+        }
+        match &self.context_page {
+            ContextPage::Preview(entity_opt, kind) => Some((*entity_opt, kind)),
+            _ => None,
+        }
+    }
+
     fn update_nav_model(&mut self) {
         let mut nav_model = segmented_button::ModelBuilder::default();
 
@@ -6368,7 +6380,7 @@ impl Application for App {
     }
 
     fn context_drawer(&self) -> Option<context_drawer::ContextDrawer<'_, Message>> {
-        if !self.core.window.show_context {
+        if !self.core.window.show_context || self.lapin_details_pane().is_some() {
             return None;
         }
 
@@ -7549,11 +7561,25 @@ impl Application for App {
                 .map(|pane: Element<'_, cosmic::Action<Message>>| {
                     pane.map(|action| Message::LapinAction(Box::new(action)))
                 });
