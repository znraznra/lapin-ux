+    /// Lapin UX: the details as people know them: the name, a "Details"
+    /// heading, then Type, Size, File location and the dates, with the values
+    /// at the right.
+    fn lapin_details<'a>(&'a self, military_time: bool) -> widget::Column<'a, Message, cosmic::Theme> {
+        let cosmic_theme::Spacing { space_xxs, space_s, .. } = theme::spacing();
+        let pair = |label: String, value: String| {
+            widget::row::with_capacity(2)
+                .spacing(space_s)
+                .push(widget::text::caption(label))
+                .push(
+                    widget::selectable_text::body(value)
+                        .width(Length::Fill)
+                        .align_x(cosmic::iced::alignment::Horizontal::Right),
+                )
+        };
+        let mut column = widget::column::with_capacity(10).spacing(space_xxs);
+        column = column.push(widget::selectable_text::title4(self.name.clone()));
+        column = column.push(widget::space::vertical().height(Length::Fixed(f32::from(space_xxs))));
+        column = column.push(widget::text::heading(fl!("details")));
+        let Some(metadata) = self.file_metadata() else {
+            return column.push(pair(fl!("type-column"), self.mime.to_string()));
+        };
+        let kind = if metadata.is_dir() {
+            fl!("type-folder")
+        } else {
+            match Path::new(&self.name).extension().and_then(|e| e.to_str()) {
+                Some(ext) if !ext.is_empty() && ext.len() <= 8 => fl!("type-file", ext = ext.to_uppercase()),
+                _ => fl!("type-plain"),
+            }
+        };
+        column = column.push(pair(fl!("type-column"), kind));
+        let size = if metadata.is_dir() {
+            match &self.dir_size {
+                DirSize::Calculating(_) => fl!("calculating"),
+                DirSize::Directory(size) => format_size(*size),
+                DirSize::NotDirectory => String::new(),
+                DirSize::Error(err) => err.clone(),
+            }
+        } else {
+            format!("{} ({})", format_size(metadata.len()), fl!("bytes", bytes = metadata.len()))
+        };
+        if !size.is_empty() {
+            column = column.push(pair(fl!("size"), size));
+        }
+        if metadata.is_dir()
+            && let Some(children) = self.metadata.children_count()
+        {
+            column = column.push(pair(fl!("contains"), fl!("status-items", items = children)));
+        }
+        if let Some(parent) = self.path_opt().and_then(|p| p.parent()) {
+            column = column.push(pair(fl!("file-location"), parent.display().to_string()));
+        }
+        let date_time_formatter = date_time_formatter(military_time);
+        let time_formatter = time_formatter(military_time);
+        for (label, time) in [
+            (fl!("date-created"), metadata.created()),
+            (fl!("date-modified"), metadata.modified()),
+            (fl!("date-accessed"), metadata.accessed()),
+        ] {
+            if let Ok(time) = time {
+                column = column.push(pair(label, format_time(time, &date_time_formatter, &time_formatter).to_string()));
+            }
+        }
+        if let Some(path) = self.path_opt()
+            && let Ok((width, height)) = image::image_dimensions(path)
+        {
+            column = column.push(pair(fl!("dimensions"), format!("{width} x {height}")));
+        }
+        column
+    }
+
     pub fn preview_view<'a>(
         &'a self,
         mime_app_cache_opt: Option<&'a mime_app::MimeAppCache>,
@@ -2619,6 +2690,10 @@ impl Item {
             let (width, height) = img;
             details = details.push(widget::text::body(format!("{width}x{height}")));
         }
+        if crate::config::lapin_session() {
+            // Lapin UX (#143): the name, then label and value pairs.
+            details = self.lapin_details(military_time);
+        }
         column = column.push(details);
 
         if let Some(metadata) = self.file_metadata()
