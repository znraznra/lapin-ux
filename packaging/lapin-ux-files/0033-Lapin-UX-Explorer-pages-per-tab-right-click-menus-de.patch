+/// Lapin UX (#169): the right-click menu of an item on Home or This PC. The
+/// target is the item that was right-clicked (`App::lapin_page_selected`).
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub enum LapinPageAction {
+    Open,
+    OpenInNewTab,
+    OpenFolder,
+    CopyPath,
+    Properties,
+    Unpin,
+    RemoveFromRecent,
+    Disconnect,
+}
+
+impl MenuAction for LapinPageAction {
+    type Message = Message;
+
+    fn message(&self) -> Self::Message {
+        Message::LapinPageAction(*self)
+    }
+}
