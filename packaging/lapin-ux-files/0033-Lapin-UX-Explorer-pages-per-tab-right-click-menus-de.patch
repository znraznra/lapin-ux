+    /// Lapin UX: points `lapin_home` / `lapin_pc` at the active tab's page and
+    /// lets the sidebar highlight follow it (#175).
+    fn lapin_sync_pages(&mut self) {
+        let page = self.lapin_pages.get(&self.tab_model.active()).copied();
+        // A pick belongs to the page it was made on (#170).
+        self.lapin_page_selected = None;
+        self.lapin_page_preview = None;
+        self.lapin_page_click = None;
+        self.lapin_home = page == Some(LapinNav::Home);
+        self.lapin_pc = page == Some(LapinNav::ThisPc);
+        if let Some(page) = page {
+            let id = self
+                .nav_model
+                .iter()
+                .find(|&id| self.nav_model.data::<LapinNav>(id) == Some(&page));
+            if let Some(id) = id {
+                self.nav_model.activate(id);
+            }
+        }
+    }
