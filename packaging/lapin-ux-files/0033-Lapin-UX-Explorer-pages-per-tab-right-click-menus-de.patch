+    /// Lapin UX (#153): forget the mapped drive for `uri` and disconnect it.
+    fn lapin_disconnect(&mut self, uri: &str) -> Task<Message> {
+        self.lapin_mapped.retain(|d| !uri.starts_with(d.uri.trim_end_matches('/')));
+        tab::lapin_mapped_save(&self.lapin_mapped);
+        let mut tasks = Vec::new();
+        for (key, items) in &self.mounter_items {
+            for item in items.iter() {
+                if item.is_mounted()
+                    && uri.starts_with(item.uri().trim_end_matches('/'))
+                    && let Some(mounter) = MOUNTERS.get(key)
+                {
+                    tasks.push(mounter.unmount(item.clone()).map(|()| cosmic::action::none()));
+                }
+            }
+        }
+        self.update_nav_model();
+        tasks.push(Task::done(cosmic::Action::App(Message::LapinNavSelectThisPc)));
+        Task::batch(tasks)
+    }
+
+    /// Lapin UX: what opening a drive on This PC does.
+    fn lapin_pc_open_message(&self, location: &Location) -> Message {
+        match location {
+            Location::Network(uri, _, None) if self.lapin_mapped.iter().any(|d| d.uri == *uri) => {
+                Message::LapinOpenMapped(uri.clone())
+            }
+            _ => Message::TabMessage(None, tab::Message::Location(location.clone())),
+        }
+    }
+
+    /// Lapin UX (#169): the path an item on Home or This PC stands for.
+    fn lapin_page_path(&self, key: &str) -> Option<PathBuf> {
+        if let Some(p) = key
+            .strip_prefix("d:")
+            .or_else(|| key.strip_prefix("p:"))
+            .or_else(|| key.strip_prefix("r:"))
+        {
+            return Some(PathBuf::from(p));
+        }
+        let name = key.strip_prefix("pc:")?;
+        self.lapin_pc_drives().into_iter().find(|d| d.0 == name).and_then(|d| d.3)
+    }
+
+    /// Lapin UX (#169, #170): pick an item on Home or This PC, so it shows
+    /// highlighted and the details pane describes it.
+    fn lapin_page_pick(&mut self, key: String) {
+        self.lapin_page_preview = self.lapin_page_path(&key).and_then(|path| {
+            match tab::item_from_path(&path, IconSizes::default()) {
+                Ok(item) => Some(PreviewKind::Custom(PreviewItem(Box::new(item)))),
+                Err(err) => {
+                    log::warn!("failed to get item from path {}: {}", path.display(), err);
+                    None
+                }
+            }
+        });
+        self.lapin_page_selected = Some(key);
+    }
+
+    /// Lapin UX (#169): the index of a pinned item in the favorites.
+    fn lapin_favorite_index(&self, path: &Path) -> Option<usize> {
+        self.config
+            .favorites
+            .iter()
+            .position(|f| f.path_opt().as_deref() == Some(path))
+    }
+
+    /// Lapin UX (#169): right-click on an item of Home or This PC picks it and
+    /// opens a menu for it, the way the file list's items have one.
+    fn lapin_page_menu<'a>(&'a self, key: String, content: Element<'a, Message>) -> Element<'a, Message> {
+        let path = self.lapin_page_path(&key);
+        let button = |label: String, action: LapinPageAction| {
+            widget::menu::Item::Button(label, None, action)
+        };
+        let mut items: Vec<widget::menu::Item<LapinPageAction, String>> = Vec::with_capacity(6);
+        items.push(button(fl!("open"), LapinPageAction::Open));
+        let is_dir = path.as_deref().is_some_and(Path::is_dir);
+        if key.starts_with("p:") || key.starts_with("r:") {
+            if path.as_deref().and_then(Path::parent).is_some() {
+                items.push(button(fl!("open-item-location"), LapinPageAction::OpenFolder));
+            }
+        } else if is_dir {
+            items.push(button(fl!("open-in-new-tab"), LapinPageAction::OpenInNewTab));
+        }
+        if path.is_some() {
+            items.push(button(fl!("copy-path"), LapinPageAction::CopyPath));
+            items.push(button(fl!("properties"), LapinPageAction::Properties));
+        }
+        if let Some(p) = path.as_deref() {
+            if !key.starts_with("pc:") && !key.starts_with("r:") && self.lapin_favorite_index(p).is_some() {
+                items.push(button(fl!("unpin-from-home"), LapinPageAction::Unpin));
+            }
+        }
+        if key.starts_with("r:") {
+            items.push(button(fl!("remove-from-recents"), LapinPageAction::RemoveFromRecent));
+        }
+        if let Some(name) = key.strip_prefix("pc:")
+            && self.lapin_pc_drives().iter().any(|d| {
+                d.0 == name && matches!(&d.2, Location::Network(uri, ..) if self.lapin_mapped.iter().any(|m| uri.starts_with(m.uri.trim_end_matches('/'))))
+            })
+        {
+            items.push(button(fl!("disconnect-network-drive"), LapinPageAction::Disconnect));
+        }
+        let mut menu = widget::context_menu(
+            content,
+            Some(widget::menu::items(&HashMap::new(), items)),
+        )
+        .on_open(Message::LapinPageSelect(key))
+        .on_surface_action(Message::Surface);
+        if let Some(id) = self.core().main_window_id() {
+            menu = menu.window_id(id);
+        }
+        menu.into()
+    }
