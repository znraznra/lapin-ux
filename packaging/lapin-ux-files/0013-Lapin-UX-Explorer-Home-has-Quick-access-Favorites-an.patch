+                    .rev()
+                    .filter_map(|b| tab::uri_to_path(b.href))
+                    .filter(|p| p.exists())
+                    .take(200)
+                    .collect()
+            })
+            .unwrap_or_default();
+
+        let tile = |path: &PathBuf, name: String, location: Location, unpin: Option<usize>| -> Element<'_, Message> {
+            let mut row = widget::row::with_capacity(3)
+                .spacing(space_xs)
+                .align_y(Alignment::Center)
+                .push(icon::icon(tab::folder_icon_symbolic(path, 24)).size(24))
+                .push(
+                    widget::column::with_capacity(2)
+                        .push(widget::text::body(name))
+                        .push(widget::text::caption(if unpin.is_some() { fl!("pinned") } else { fl!("recent-folder") })),
+                );
+            if let Some(i) = unpin {
+                row = row.push(
+                    widget::tooltip(
+                        widget::button::icon(icon::from_name("view-pin-symbolic").size(16)).on_press(Message::LapinUnpin(i)),
+                        widget::text::body(fl!("unpin-from-home")),
+                        widget::tooltip::Position::Bottom,
+                    ),
+                );
+            }
+            widget::button::custom(row)
+                .width(Length::Fixed(240.0))
+                .padding(space_xs)
+                .class(theme::Button::MenuItem)
+                .on_press(Message::TabMessage(None, tab::Message::Location(location)))
+                .into()
+        };
+
+        let mut quick: Vec<Element<'_, Message>> = Vec::new();
+        let mut pinned_dirs: Vec<PathBuf> = Vec::new();
+        let mut pinned_files = widget::column::with_capacity(8).spacing(space_xxs);
+        let mut any_file = false;
+        for (i, favorite) in self.config.favorites.iter().enumerate() {
