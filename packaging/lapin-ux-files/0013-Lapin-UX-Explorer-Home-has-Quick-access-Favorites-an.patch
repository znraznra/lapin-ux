-                _ => Location::Path(path.clone()),
-            };
-            place_buttons.push(
-                widget::button::custom(
+            if path.is_dir() || matches!(favorite, Favorite::Network { .. }) {
+                let location = match favorite {
+                    Favorite::Network { uri, name, path } => {
+                        Location::Network(uri.clone(), name.clone(), Some(path.to_owned()))
+                    }
+                    _ => Location::Path(path.clone()),
+                };
+                pinned_dirs.push(path.clone());
+                quick.push(tile(&path, name, location, Some(i)));
+            } else {
+                any_file = true;
+                let parent = path.parent().map(|p| p.display().to_string()).unwrap_or_default();
+                pinned_files = pinned_files.push(
                     widget::row::with_capacity(2)
+                        .align_y(Alignment::Center)
+                        .push(
+                            widget::button::custom(
+                                widget::row::with_capacity(4)
+                                    .spacing(space_xs)
+                                    .align_y(Alignment::Center)
+                                    .push(icon::icon(crate::mime_icon::mime_icon(crate::mime_icon::mime_for_path(&path, None, false), 24)).size(24))
+                                    .push(widget::text::body(name))
+                                    .push(widget::space::horizontal())
+                                    .push(widget::text::caption(parent)),
+                            )
+                            .width(Length::Fill)
+                            .padding(space_xs)
+                            .class(theme::Button::MenuItem)
+                            .on_press(Message::LapinOpen(path.clone())),
+                        )
+                        .push(widget::tooltip(
+                            widget::button::icon(icon::from_name("view-pin-symbolic").size(16)).on_press(Message::LapinUnpin(i)),
+                            widget::text::body(fl!("unpin-from-home")),
+                            widget::tooltip::Position::Bottom,
+                        )),
+                );
+            }
+        }
+        // Folders you used recently: the folders of your recent files.
+        let mut recent_dirs: Vec<PathBuf> = Vec::new();
+        for f in &recent_files {
+            let Some(dir) = f.parent() else { continue };
+            if recent_dirs.len() == 8 {
+                break;
+            }
+            if !pinned_dirs.iter().any(|p| p == dir) && !recent_dirs.iter().any(|p| p == dir) && dir.is_dir() {
+                recent_dirs.push(dir.to_path_buf());
+            }
+        }
+        for dir in recent_dirs {
+            let name = dir.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_else(|| dir.display().to_string());
+            quick.push(tile(&dir, name, Location::Path(dir.clone()), None));
+        }
+        let quick = widget::flex_row(quick).row_spacing(space_xs).column_spacing(space_xs);
+
+        let mut recent = widget::column::with_capacity(12).spacing(space_xxs);
+        let mut shown = 0;
+        for path in recent_files.iter().take(12) {
+            let Some(name) = path.file_name().map(|n| n.to_string_lossy().into_owned()) else { continue };
+            let parent = path.parent().map(|p| p.display().to_string()).unwrap_or_default();
+            recent = recent.push(
+                widget::button::custom(
+                    widget::row::with_capacity(4)
                         .spacing(space_xs)
                         .align_y(Alignment::Center)
-                        .push(icon::icon(tab::folder_icon_symbolic(&path, 24)).size(24))
-                        .push(widget::text::body(name)),
+                        .push(icon::icon(crate::mime_icon::mime_icon(crate::mime_icon::mime_for_path(path, None, false), 24)).size(24))
+                        .push(widget::text::body(name))
