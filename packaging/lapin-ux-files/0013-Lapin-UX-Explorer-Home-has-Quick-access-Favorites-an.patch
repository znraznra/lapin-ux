+                let mut favorites = self.config.favorites.clone();
+                if i < favorites.len() {
+                    favorites.remove(i);
+                    config_set!(favorites, favorites);
+                    return self.update_config();
+                }
+            }
             Message::AddToSidebar(entity_opt) => {
                 let mut favorites = self.config.favorites.clone();
                 // check if the selected entity is in the current tab
