+                if crate::config::lapin_session()
+                    && (dirs::home_dir().as_deref() == Some(path.as_path()) || !path.is_dir())
+                {
                     continue;
                 }
                 let name = favorite.display_name().unwrap_or_else(|| fl!("filesystem"));
