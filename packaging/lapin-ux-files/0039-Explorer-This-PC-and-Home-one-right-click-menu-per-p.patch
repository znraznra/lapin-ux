+                        if !key.starts_with("pc:") {
+                            items.push(button(fl!("unpin-from-home"), LapinPageAction::Unpin));
+                        }
+                    } else if key.starts_with("pc:") {
+                        items.push(button(fl!("pin-to-home"), LapinPageAction::PinToHome));
