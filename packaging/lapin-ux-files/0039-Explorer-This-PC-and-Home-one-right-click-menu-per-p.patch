-                items.push(button(fl!("unpin-from-home"), LapinPageAction::Unpin));
+            if key.starts_with("r:") {
+                items.push(button(fl!("remove-from-recents"), LapinPageAction::RemoveFromRecent));
+            }
+            if let Some(name) = key.strip_prefix("pc:")
+                && self.lapin_pc_drives().iter().any(|d| {
+                    d.0 == name && matches!(&d.2, Location::Network(uri, ..) if self.lapin_mapped.iter().any(|m| uri.starts_with(m.uri.trim_end_matches('/'))))
+                })
+            {
+                items.push(button(fl!("disconnect-network-drive"), LapinPageAction::Disconnect));
+            }
+        } else {
+            items.push(button(fl!("lapin-refresh"), LapinPageAction::Refresh));
+            if self.lapin_pc {
+                items.push(button(fl!("map-network-drive-menu"), LapinPageAction::MapDrive));
             }
         }
-        if key.starts_with("r:") {
-            items.push(button(fl!("remove-from-recents"), LapinPageAction::RemoveFromRecent));
-        }
-        if let Some(name) = key.strip_prefix("pc:")
-            && self.lapin_pc_drives().iter().any(|d| {
-                d.0 == name && matches!(&d.2, Location::Network(uri, ..) if self.lapin_mapped.iter().any(|m| uri.starts_with(m.uri.trim_end_matches('/'))))
-            })
-        {
-            items.push(button(fl!("disconnect-network-drive"), LapinPageAction::Disconnect));
-        }
-        let mut menu = widget::context_menu(
-            content,
-            Some(widget::menu::items(&HashMap::new(), items)),
-        )
-        .on_open(Message::LapinPageSelect(key))
-        .on_surface_action(Message::Surface);
+        let area = crate::mouse_area::MouseArea::new(content)
+            .on_right_press(|_| Message::LapinPageSelect(String::new()));
