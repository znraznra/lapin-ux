+
+    /// Lapin UX (#169): the page's scrollable with its right-click menu: the
+    /// picked item's, or the page's own on empty space. The menu wraps the
+    /// scrollable, not each item, so its popup anchors in window coordinates
+    /// (inside a scrollable it lands below the item).
+    fn lapin_page_scroll<'a>(&'a self, content: Element<'a, Message>) -> Element<'a, Message> {
         let button = |label: String, action: LapinPageAction| {
             widget::menu::Item::Button(label, None, action)
