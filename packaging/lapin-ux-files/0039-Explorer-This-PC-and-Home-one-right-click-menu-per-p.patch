+            let path = self.lapin_page_path(&key);
+            items.push(button(fl!("open"), LapinPageAction::Open));
+            let is_dir = path.as_deref().is_some_and(Path::is_dir);
+            if key.starts_with("p:") || key.starts_with("r:") {
+                if path.as_deref().and_then(Path::parent).is_some() {
+                    items.push(button(fl!("open-item-location"), LapinPageAction::OpenFolder));
+                }
+            } else if is_dir {
+                items.push(button(fl!("open-in-new-tab"), LapinPageAction::OpenInNewTab));
+            }
+            if let Some(p) = path.as_deref() {
+                if !key.starts_with("r:") {
