+/// Lapin UX (#216): the first field of a passwd GECOS entry (the account's
+/// full name), or `None` when it is empty.
+fn gecos_full_name(gecos: &str) -> Option<String> {
+    let name = gecos.split(',').next().unwrap_or("").trim();
+    (!name.is_empty()).then(|| name.to_string())
+}
+
+/// Lapin UX (#216): what the signed-in user's own folder is called: the
+/// account's full name, else the user name. Only used in a Lapin session.
+pub fn lapin_user_label() -> Option<String> {
+    static LABEL: std::sync::OnceLock<Option<String>> = std::sync::OnceLock::new();
+    LABEL
+        .get_or_init(|| {
+            let mut buf = vec![0u8; 4096];
+            let mut pwd: libc::passwd = unsafe { std::mem::zeroed() };
+            let mut result: *mut libc::passwd = std::ptr::null_mut();
+            // SAFETY: `pwd`, `buf` and `result` outlive the call and `buf`'s
+            // length is passed along; the strings are copied out before return.
+            let rc = unsafe {
+                libc::getpwuid_r(
+                    libc::getuid(),
+                    &mut pwd,
+                    buf.as_mut_ptr().cast(),
+                    buf.len(),
+                    &mut result,
+                )
+            };
+            if rc == 0 && !result.is_null() {
+                let cstr = |p: *const libc::c_char| {
+                    (!p.is_null()).then(|| unsafe { std::ffi::CStr::from_ptr(p) }.to_string_lossy().into_owned())
+                };
+                if let Some(full) = cstr(pwd.pw_gecos).and_then(|g| gecos_full_name(&g)) {
+                    return Some(full);
+                }
+                if let Some(user) = cstr(pwd.pw_name).filter(|u| !u.is_empty()) {
+                    return Some(user);
+                }
+            }
+            std::env::var("USER").ok().filter(|u| !u.is_empty())
+        })
+        .clone()
+}
+
+/// Lapin UX (#216): the label of the user's own folder. In a Lapin session
+/// "Home" only means the start page, so the folder carries the user's name;
+/// COSMIC's own session keeps "Home".
+pub fn home_folder_label() -> String {
+    if lapin_session() {
+        if let Some(name) = lapin_user_label() {
+            return name;
+        }
+    }
+    crate::fl!("home")
+}
+
