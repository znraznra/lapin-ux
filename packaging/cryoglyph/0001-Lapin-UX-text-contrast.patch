+/// Lapin UX (#40): text contrast for this program, read when it starts.
+/// Only in a Lapin UX session: `LAPIN_UX_TEXT_CONTRAST` (for testing), else
+/// Settings > Personalization > Fonts (`dev.lapinux.Shell` `text_contrast`),
+/// else the default below. Anywhere else 0, so text renders as upstream.
+fn text_contrast() -> f64 {
+    static VALUE: std::sync::OnceLock<f64> = std::sync::OnceLock::new();
+    *VALUE.get_or_init(|| {
+        let lapin = std::env::var("XDG_CURRENT_DESKTOP")
+            .is_ok_and(|d| d.split(':').any(|d| d == "LapinUX"));
+        if !lapin {
+            return 0.0;
+        }
+        let from_settings = || {
+            let config = std::env::var_os("XDG_CONFIG_HOME")
+                .map(std::path::PathBuf::from)
+                .or_else(|| std::env::var_os("HOME").map(|h| std::path::PathBuf::from(h).join(".config")))?;
+            std::fs::read_to_string(config.join("cosmic/dev.lapinux.Shell/v1/text_contrast")).ok()
+        };
+        std::env::var("LAPIN_UX_TEXT_CONTRAST")
+            .ok()
+            .or_else(from_settings)
+            .and_then(|v| v.trim().parse::<f64>().ok())
+            .filter(|v| v.is_finite())
+            .map(|v| v.clamp(0.0, 2.0))
+            .unwrap_or(LAPIN_DEFAULT_TEXT_CONTRAST)
+    })
+}
+
+const LAPIN_DEFAULT_TEXT_CONTRAST: f64 = 0.5;
