+
+    /// Lapin UX (#28): the area of the X screen not covered by the taskbar
+    /// (any layer-shell exclusive zone), in X coordinates, for
+    /// `_NET_WORKAREA`. One rectangle for the whole X screen, as X has it:
+    /// each edge of the screen gives up the most any monitor on that edge
+    /// reserves.
+    /// Only in the Lapin UX session: in COSMIC's own, as stock COSMIC.
+    pub fn update_xwayland_workarea(&mut self) {
+        static LAPIN: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| {
+            std::env::var("XDG_CURRENT_DESKTOP").is_ok_and(|d| d.split(':').any(|d| d == "LapinUX"))
+        });
+        if !*LAPIN {
+            return;
+        }
+        let scale = self.xwayland_scale.unwrap_or(1.);
+        let area = {
+            let shell = self.shell.read();
+            let zones = shell
+                .outputs()
+                .map(|o| {
+                    let geo = o.geometry().as_logical();
+                    let mut zone = layer_map_for_output(o).non_exclusive_zone();
+                    zone.loc += geo.loc;
+                    (geo, zone)
+                })
+                .collect::<Vec<_>>();
+            let Some(bbox) = zones.iter().map(|(g, _)| *g).reduce(|a, b| a.merge(b)) else {
+                return;
+            };
+            let (right, bottom) = (bbox.loc.x + bbox.size.w, bbox.loc.y + bbox.size.h);
+            let (mut l, mut t, mut r, mut b) = (0, 0, 0, 0);
+            for (g, z) in &zones {
+                if g.loc.x == bbox.loc.x {
+                    l = l.max(z.loc.x - g.loc.x);
+                }
+                if g.loc.y == bbox.loc.y {
+                    t = t.max(z.loc.y - g.loc.y);
+                }
+                if g.loc.x + g.size.w == right {
+                    r = r.max((g.loc.x + g.size.w) - (z.loc.x + z.size.w));
+                }
+                if g.loc.y + g.size.h == bottom {
+                    b = b.max((g.loc.y + g.size.h) - (z.loc.y + z.size.h));
+                }
+            }
+            let x = |v: i32| (v.max(0) as f64 * scale).round() as u32;
+            // The X screen starts at 0,0.
+            [
+                x(l),
+                x(t),
+                x(bbox.size.w - l - r),
+                x(bbox.size.h - t - b),
+            ]
+        };
+        if let Some(xstate) = self.xwayland_state.as_mut()
+            && xstate.xwm.is_some()
+            && xstate.workarea != Some(area)
+        {
+            xstate.workarea = Some(area);
+            if xstate.workarea_thread.send(area).is_err() {
+                warn!("Lapin UX: _NET_WORKAREA thread died");
+            }
+        }
     }
 
