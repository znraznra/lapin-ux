+
+/// Lapin UX (#28): publishes `_NET_WORKAREA` on the X root window, the
+/// screen minus the taskbar (layer-shell exclusive zones), so X11 apps that
+/// place their own pop-ups (Steam's "friend is playing" toasts) keep them
+/// above the taskbar instead of on it. Its own X connection, like xrdb.
+fn workarea_thread(rx: Receiver<[u32; 4]>, display: u32) {
+    use smithay::reexports::x11rb::{
+        connection::Connection,
+        protocol::xproto::{AtomEnum, ConnectionExt as _, PropMode},
+        rust_connection::RustConnection,
+        wrapper::ConnectionExt as _,
+    };
+    let Ok(mut area) = rx.recv() else { return };
+    let (conn, screen) = match RustConnection::connect(Some(&format!(":{display}"))) {
+        Ok(c) => c,
+        Err(err) => {
+            warn!(?err, "Lapin UX: no X connection for _NET_WORKAREA");
+            return;
+        }
+    };
+    let root = conn.setup().roots[screen].root;
+    let atom = |name: &str| {
+        conn.intern_atom(false, name.as_bytes())
+            .ok()
+            .and_then(|c| c.reply().ok())
+            .map(|r| r.atom)
+    };
+    let (Some(workarea), Some(supported)) = (atom("_NET_WORKAREA"), atom("_NET_SUPPORTED")) else {
+        return;
+    };
+    let _ = conn.change_property32(PropMode::APPEND, root, supported, AtomEnum::ATOM, &[workarea]);
+    loop {
+        // Only the newest one matters.
+        while let Ok(newer) = rx.try_recv() {
+            area = newer;
+        }
+        if let Err(err) = conn
+            .change_property32(PropMode::REPLACE, root, workarea, AtomEnum::CARDINAL, &area)
+            .map(|_| ())
+            .and_then(|_| conn.flush())
+        {
+            warn!(?err, "Lapin UX: couldn't set _NET_WORKAREA");
+            return;
+        }
+        match rx.recv() {
+            Ok(a) => area = a,
+            Err(_) => return,
+        }
+    }
 }
 
