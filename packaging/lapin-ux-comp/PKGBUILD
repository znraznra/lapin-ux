# Maintainer: CHANGE ME <you@example.com>
#
# Lapin UX's build of the COSMIC compositor: upstream cosmic-comp at a
# pinned commit plus the patches in this folder (lapin_shell_v1: snap
# layouts, taskbar attention, desktop peek, night light, touchpad swipes for
# the shell, and a window open animation). Installed next to cosmic-comp as
# `lapin-ux-comp`; the Lapin UX session uses it when it's there.
#
# packaging/arch builds and installs this automatically together with Lapin
# UX; this PKGBUILD is only for building the compositor on its own:
#
#   cd packaging/lapin-ux-comp && makepkg -si

pkgname=lapin-ux-comp
_commit=8cb1802caada438bb5cc7670dfabdaca5fad0502
pkgver=1.11.0.r0.8cb1802
pkgrel=1
pkgdesc="COSMIC compositor with Lapin UX's additions (snap layouts, peek, night light, gestures)"
arch=('x86_64' 'aarch64')
url="https://github.com/pop-os/cosmic-comp"
license=('GPL-3.0-only')
depends=('libinput' 'libxkbcommon' 'mesa' 'pixman' 'seatd' 'systemd-libs' 'wayland' 'libdisplay-info' 'fontconfig')
makedepends=('cargo' 'git' 'clang')
source=("cosmic-comp::git+https://github.com/pop-os/cosmic-comp.git#commit=${_commit}"
        "0001-Add-lapin_shell_v1-snap-to-a-fraction-of-the-work-ar.patch"
        "0002-lapin_shell-v2-desktop-peek-night-light-shell-touchp.patch"
        "0003-Lapin-UX-app-icon-and-title-at-the-left-of-the-title.patch"
        "0004-Lapin-UX-night-light-uniform-on-the-KMS-path-screen-.patch"
        "0005-lapin_shell-v3-report-the-Alt-key-to-the-shell-Alt-T.patch")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
    cd cosmic-comp
    for p in "$srcdir"/*.patch; do
        git apply "$p"
    done
    # Build with the system's stable toolchain.
    rm -f rust-toolchain rust-toolchain.toml
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd cosmic-comp
    CARGO_TARGET_DIR=target cargo build --release --frozen
}

package() {
    cd cosmic-comp
    install -Dm755 target/release/cosmic-comp "$pkgdir/usr/bin/lapin-ux-comp"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
