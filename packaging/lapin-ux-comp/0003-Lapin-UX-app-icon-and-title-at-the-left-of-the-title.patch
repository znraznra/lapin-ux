From 6b8320b8f6213c149e273d6344118e273580d8e4 Mon Sep 17 00:00:00 2001
From: Lapin UX <arnz.lee16@gmail.com>
Date: Tue, 20 Oct 2026 09:15:42 +0800
Subject: [PATCH 3/3] Lapin UX: app icon and title at the left of the title
 bar, as in Windows

---
 src/shell/element/window.rs | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/src/shell/element/window.rs b/src/shell/element/window.rs
index 15277a0..a690d21 100644
--- a/src/shell/element/window.rs
+++ b/src/shell/element/window.rs
@@ -877,8 +877,23 @@ impl Decorations<CosmicWindowInternal, Message> for DefaultDecorations {
         let sharp_corners = win.window.is_maximized(false)
             || (win.is_tiled() && !win.appearance_conf.lock().unwrap().clip_tiled_windows);
 
+        // Lapin UX: Windows puts the app's icon and the title at the left,
+        // not the title in the middle. The icon is looked up by app id, as
+        // the window-stack tabs do.
+        let title = win.last_title.lock().unwrap().clone();
+        let app_id = win.window.app_id();
         let mut header = cosmic::widget::header_bar()
-            .title(win.last_title.lock().unwrap().clone())
+            .start(
+                cosmic::widget::container(
+                    cosmic::widget::row::with_children(vec![
+                        cosmic::widget::icon::from_name(app_id).size(16).icon().into(),
+                        cosmic::widget::text::body(title).wrapping(cosmic::iced::widget::text::Wrapping::None).into(),
+                    ])
+                    .spacing(10)
+                    .align_y(cosmic::iced::Alignment::Center),
+                )
+                .padding([0, 0, 0, 4]),
+            )
             .on_drag(Message::DragStart)
             .on_close(Message::Close)
             .focused(win.window.is_activated(false))
