diff --git a/src/config/mod.rs b/src/config/mod.rs
index be509e7..805dad6 100644
--- a/src/config/mod.rs
+++ b/src/config/mod.rs
@@ -153,11 +153,41 @@ pub struct ScreenFilter {
     pub inverted: bool,
     #[serde(skip_serializing_if = "Option::is_none")]
     pub color_filter: Option<ColorFilter>,
+    /// Lapin UX night light: colour temperature in kelvin, 0 when off.
+    #[serde(default, skip_serializing_if = "is_zero")]
+    pub night_light: u32,
+}
+
+fn is_zero(v: &u32) -> bool {
+    *v == 0
 }
 
 impl ScreenFilter {
     pub fn is_noop(&self) -> bool {
-        !self.inverted && self.color_filter.is_none()
+        !self.inverted && self.color_filter.is_none() && self.night_light == 0
+    }
+
+    /// Per-channel gains for the night light (1.0 each when off), from the
+    /// black-body colour of the temperature, normalised so 6500 K is white.
+    pub fn night_light_gains(&self) -> [f32; 3] {
+        if self.night_light == 0 {
+            return [1.0; 3];
+        }
+        let t = self.night_light.clamp(1000, 6500) as f32 / 100.0;
+        let r = if t <= 66.0 { 1.0 } else { (1.292_936_2 * (t - 60.0).powf(-0.133_204_76)).clamp(0.0, 1.0) };
+        let g = if t <= 66.0 {
+            ((99.470_8 * t.ln() - 161.119_57) / 255.0).clamp(0.0, 1.0)
+        } else {
+            (1.129_890_9 * (t - 60.0).powf(-0.075_514_85)).clamp(0.0, 1.0)
+        };
+        let b = if t >= 66.0 {
+            1.0
+        } else if t <= 19.0 {
+            0.0
+        } else {
+            ((138.517_73 * (t - 10.0).ln() - 305.044_8) / 255.0).clamp(0.0, 1.0)
+        };
+        [r, g, b]
     }
 }
 
