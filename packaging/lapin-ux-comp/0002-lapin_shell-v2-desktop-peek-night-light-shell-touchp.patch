+
+    fn peek(&mut self, enabled: bool) {
+        let outputs: Vec<_> = {
+            let mut shell = self.common.shell.write();
+            if shell.peek == enabled {
+                return;
+            }
+            shell.peek = enabled;
+            shell.outputs().cloned().collect()
+        };
+        for output in outputs {
+            self.backend.schedule_render(&output);
+        }
+    }
+
+    fn night_light(&mut self, kelvin: u32) {
+        let kelvin = if kelvin == 0 { 0 } else { kelvin.clamp(1200, 6500) };
+        let mut config = self.common.config.dynamic_conf.screen_filter_mut();
+        if config.night_light == kelvin {
+            return;
+        }
+        let mut updated = (*config).clone();
+        updated.night_light = kelvin;
+        if let Err(err) = self.backend.update_screen_filter(&updated) {
+            tracing::warn!("Failed to apply night light: {}", err);
+        } else {
+            *config = updated;
+        }
+    }
 }
