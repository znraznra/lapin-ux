@@ -1735,6 +1735,48 @@ impl FloatingLayout {
         }
     }
 
+    /// Place a window in part of the work area (fractions of its width and
+    /// height), like a snapped half but any size: thirds, two-thirds…
+    pub fn snap_to_fraction(&mut self, element: &CosmicMapped, x: f64, y: f64, w: f64, h: f64) {
+        let output = self.space.outputs().next().unwrap().clone();
+        let layers = layer_map_for_output(&output);
+        let area = layers.non_exclusive_zone();
+        std::mem::drop(layers);
+        let (_, inner) = self.gaps();
+        let px = |f: f64, len: i32| (f * len as f64).round() as i32;
+        let left = area.loc.x + px(x, area.size.w);
+        let top = area.loc.y + px(y, area.size.h);
+        let right = area.loc.x + px(x + w, area.size.w);
+        let bottom = area.loc.y + px(y + h, area.size.h);
+        // Full gap at the screen edges, half between neighbours.
+        let gap = |at_edge: bool| if at_edge { inner } else { inner / 2 };
+        let l = left + gap(x <= 0.0);
+        let t = top + gap(y <= 0.0);
+        let r = right - gap(x + w >= 1.0);
+        let b = bottom - gap(y + h >= 1.0);
+        let pos: Point<i32, Local> = Point::from((l, t));
+        let size: Size<i32, Logical> = Size::from(((r - l).max(1), (b - t).max(1)));
+
+        let start = self.space.element_geometry(element).map(RectExt::as_local);
+        let mut tiled_state = element.floating_tiled.lock().unwrap();
+        if tiled_state.is_none() {
+            let last = element
+                .maximized_state
+                .lock()
+                .unwrap()
+                .take()
+                .map(|state| state.original_geometry)
+                .or(start);
+            *element.last_geometry.lock().unwrap() = last;
+        }
+        *tiled_state = None;
+        std::mem::drop(tiled_state);
+        element.set_tiled(true);
+        element.set_maximized(false);
+        element.moved_since_mapped.store(true, Ordering::SeqCst);
+        self.map_internal(element.clone(), Some(pos), Some(size), start);
+    }
+
     pub fn snap_to_corner(&self, mapped: &CosmicMapped, corners: &TiledCorners) {
         *mapped.floating_tiled.lock().unwrap() = Some(*corners);
         mapped.set_tiled(true);
