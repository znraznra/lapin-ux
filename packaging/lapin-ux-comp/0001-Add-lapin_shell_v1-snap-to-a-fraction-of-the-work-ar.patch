+/// The window whose ext_foreign_toplevel_handle_v1 has this identifier.
+pub fn window_from_identifier<'a, W: Window + 'static, D>(state: &'a D, identifier: &str) -> Option<&'a W>
+where
+    D: ToplevelInfoHandler<Window = W>,
+{
+    state.toplevel_info_state().toplevels.iter().find(|w| {
+        w.user_data().get::<ToplevelState>().is_some_and(|inner| {
+            inner.lock().unwrap().foreign_handle.as_ref().is_some_and(|h| h.identifier() == identifier)
+        })
+    })
+}
+
+/// The identifier of a window's ext_foreign_toplevel_handle_v1.
+pub fn identifier_of<W: Window + 'static>(window: &W) -> Option<String> {
+    let inner = window.user_data().get::<ToplevelState>()?;
+    let inner = inner.lock().unwrap();
+    inner.foreign_handle.as_ref().map(|h| h.identifier().to_string())
+}
