@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+use smithay::wayland::seat::WaylandFocus;
+
+use crate::state::State;
+use crate::wayland::protocols::{
+    lapin_shell::{LapinShellHandler, LapinShellState},
+    toplevel_info::window_from_identifier,
+};
+
+impl LapinShellHandler for State {
+    fn lapin_shell_state(&mut self) -> &mut LapinShellState {
+        &mut self.common.lapin_shell_state
+    }
+
+    fn snap(&mut self, identifier: &str, x: f64, y: f64, width: f64, height: f64) {
+        let Some(window) = window_from_identifier(self, identifier).cloned() else { return };
+        let Some(surface) = window.wl_surface().map(|s| s.into_owned()) else { return };
+        let mut shell = self.common.shell.write();
+        let seat = shell.seats.last_active().clone();
+        let Some(mapped) = shell.element_for_surface(&surface).cloned() else { return };
+        let Some(workspace) = shell.space_for_mut(&mapped) else { return };
+        if mapped.is_maximized(false) {
+            workspace.unmaximize_request(&mapped);
+        }
+        // Snapping works on floating windows; take it out of tiling first.
+        if !workspace.is_floating(&window) {
+            workspace.toggle_floating_window(&seat, &mapped);
+        }
+        if workspace.floating_layer.mapped().any(|m| m == &mapped) {
+            workspace.floating_layer.snap_to_fraction(&mapped, x, y, width, height);
+        }
+    }
+}
