@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! lapin_shell_v1: snap a window into part of the work area, and tell the
+//! shell when a window asks for attention.
+
+pub use generated::lapin_shell_manager_v1;
+
+#[allow(non_snake_case, non_upper_case_globals, non_camel_case_types)]
+mod generated {
+    use smithay::reexports::wayland_server;
+
+    pub mod __interfaces {
+        use wayland_backend;
+        wayland_scanner::generate_interfaces!("resources/protocols/lapin-shell-v1.xml");
+    }
+    use self::__interfaces::*;
+
+    wayland_scanner::generate_server_code!("resources/protocols/lapin-shell-v1.xml");
+}
+
+use lapin_shell_manager_v1::LapinShellManagerV1;
+use smithay::{
+    reexports::wayland_server::{Client, DataInit, Dispatch, DisplayHandle, GlobalDispatch, New},
+    wayland::{Dispatch2, GlobalDispatch2},
+};
+use wayland_backend::server::{ClientId, GlobalId};
+
+pub trait LapinShellHandler {
+    fn lapin_shell_state(&mut self) -> &mut LapinShellState;
+    /// Place the window in this part of its work area (fractions 0..1).
+    fn snap(&mut self, identifier: &str, x: f64, y: f64, width: f64, height: f64);
+}
+
+#[derive(Debug)]
+pub struct LapinShellState {
+    pub global: GlobalId,
+    managers: Vec<LapinShellManagerV1>,
+}
+
+pub struct LapinShellGlobalData {
+    filter: Box<dyn for<'a> Fn(&'a Client) -> bool + Send + Sync>,
+}
+
+pub struct LapinShellManagerData;
+
+impl LapinShellState {
+    pub fn new<D, F>(dh: &DisplayHandle, client_filter: F) -> Self
+    where
+        D: GlobalDispatch<LapinShellManagerV1, LapinShellGlobalData> + 'static,
+        F: for<'a> Fn(&'a Client) -> bool + Send + Sync + 'static,
+    {
+        let global = dh.create_global::<D, LapinShellManagerV1, _>(1, LapinShellGlobalData { filter: Box::new(client_filter) });
+        LapinShellState { global, managers: Vec::new() }
+    }
+
+    /// Tell every shell client that a window wants attention.
+    pub fn attention(&self, identifier: &str) {
+        for m in &self.managers {
+            m.attention(identifier.to_string());
+        }
+    }
+}
+
+impl<D> GlobalDispatch2<LapinShellManagerV1, D> for LapinShellGlobalData
+where
+    D: Dispatch<LapinShellManagerV1, LapinShellManagerData> + LapinShellHandler + 'static,
+{
+    fn bind(&self, state: &mut D, _handle: &DisplayHandle, _client: &Client, resource: New<LapinShellManagerV1>, data_init: &mut DataInit<'_, D>) {
+        let m = data_init.init(resource, LapinShellManagerData);
+        state.lapin_shell_state().managers.push(m);
+    }
+
+    fn can_view(&self, client: &Client) -> bool {
+        (self.filter)(client)
+    }
+}
+
+impl<D> Dispatch2<LapinShellManagerV1, D> for LapinShellManagerData
+where
+    D: LapinShellHandler + 'static,
+{
+    fn request(
+        &self,
+        state: &mut D,
+        _client: &Client,
+        _resource: &LapinShellManagerV1,
+        request: lapin_shell_manager_v1::Request,
+        _dhandle: &DisplayHandle,
+        _data_init: &mut DataInit<'_, D>,
+    ) {
+        match request {
+            lapin_shell_manager_v1::Request::Snap { identifier, x, y, width, height } => {
+                let f = |v: u32| (v.min(10_000) as f64) / 10_000.0;
+                if width > 0 && height > 0 {
+                    state.snap(&identifier, f(x), f(y), f(width), f(height));
+                }
+            }
+            lapin_shell_manager_v1::Request::Destroy => {}
+        }
+    }
+
+    fn destroyed(&self, state: &mut D, _client: ClientId, resource: &LapinShellManagerV1) {
+        state.lapin_shell_state().managers.retain(|m| m != resource);
+    }
+}
