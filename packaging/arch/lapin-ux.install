_fc=50-lapin-ux-selawik.conf

post_install() {
    # Selawik is the system font (see the README's "One system font").
    ln -sf "/usr/share/fontconfig/conf.avail/$_fc" "/etc/fonts/conf.d/$_fc"
    fc-cache -s >/dev/null 2>&1 || true
    for t in Lapin-UX Lapin-UX-dark Win11 Win11-dark; do
        gtk-update-icon-cache -q -t -f "/usr/share/icons/$t" >/dev/null 2>&1 || true
    done
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -f "/etc/fonts/conf.d/$_fc"
    fc-cache -s >/dev/null 2>&1 || true
}
