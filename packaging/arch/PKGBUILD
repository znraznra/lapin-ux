# Maintainer: CHANGE ME <you@example.com>
#
# Builds Lapin UX from this source tree:
#
#   cd packaging/arch && makepkg -si
#
# To build from a published repository instead, replace the `source`
# array with: source=("lapin::git+https://github.com/CHANGE-ME/lapin-ux.git")
# and point `_src` at "$srcdir/lapin-ux".

pkgname=lapin-ux-desktop-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Lapin UX: a familiar Linux desktop (taskbar, Start menu, notifications) built on COSMIC components"
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only')
depends=(
    # Compositor and reused, unbranded COSMIC services
    'cosmic-comp'
    'cosmic-settings-daemon'
    'cosmic-bg'
    'cosmic-osd'
    'cosmic-idle'
    'cosmic-greeter'           # lock screen
    'cosmic-launcher'          # Alt+Tab window switcher (until Lapin UX has its own)
    'cosmic-screenshot'        # Super+Shift+S
    'cosmic-icon-theme'
    'adwaita-icon-theme'       # battery and power-mode icons missing from cosmic-icon-theme
    'xdg-desktop-portal-cosmic'
    'inter-font'               # interface font
    'noto-fonts-emoji'         # colour emoji in the emoji panel and apps
    'fontconfig'
    # Runtime libraries
    'libxkbcommon'
    'wayland'
    'dbus'
    'systemd-libs'
    'xdg-utils'
    # Quick settings
    'networkmanager'           # Wi-Fi and network status
    'upower'                   # battery
    'wireplumber'              # volume (wpctl)
)
optdepends=(
    'bluez: Bluetooth in quick settings'
    'power-profiles-daemon: Energy saver in quick settings'
    'libpulse: choosing the sound output in quick settings (pactl)'
    'gnome-keyring: saved passwords and SSH keys'
    'papirus-icon-theme: broader app icon coverage'
    'xdg-desktop-portal-gtk: file pickers for GTK apps'
    'localsearch: search inside documents from Start'
    'accountsservice: changing the account picture'
)
makedepends=('cargo' 'git' 'python' 'python-numpy' 'python-pillow')
provides=('lapin-ux-desktop')
conflicts=('lapin-ux-desktop')
options=('!lto')

_src="$startdir/../.."

prepare() {
    cd "$_src"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_src"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --frozen --release --workspace
    [ -f data/wallpapers/lapin-ux-dark.jpg ] || python tools/make-wallpaper.py data/wallpapers
}

check() {
    cd "$_src"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo test --frozen --release -p lapin-ux-core -p lapin-ux-session
}

package() {
    cd "$_src"
    local bin
    for bin in lapin-ux-session lapin-ux-shell lapin-ux-notifyd; do
        install -Dm755 "$srcdir/target/release/$bin" "$pkgdir/usr/bin/$bin"
    done
    install -Dm755 data/session/start-lapin-ux        "$pkgdir/usr/bin/start-lapin-ux"
    install -Dm644 data/session/lapin-ux.desktop      "$pkgdir/usr/share/wayland-sessions/lapin-ux.desktop"
    install -Dm644 data/systemd/lapin-ux-session.target "$pkgdir/usr/lib/systemd/user/lapin-ux-session.target"
    install -Dm644 data/portals/lapin-ux-portals.conf "$pkgdir/usr/share/xdg-desktop-portal/lapin-ux-portals.conf"
    install -Dm644 data/wallpapers/lapin-ux-dark.jpg  "$pkgdir/usr/share/backgrounds/lapin-ux/lapin-ux-dark.jpg"
    install -Dm644 data/wallpapers/lapin-ux-light.jpg "$pkgdir/usr/share/backgrounds/lapin-ux/lapin-ux-light.jpg"
    install -Dm644 data/icons/lapin-ux-start.svg      "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.lapinux.Shell.svg"
    install -Dm644 LICENSE                          "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
