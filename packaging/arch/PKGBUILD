package_lapin-ux-settings() {
    pkgdesc="Settings for Lapin UX: COSMIC Settings with Windows 11's layout"
    url="https://github.com/pop-os/cosmic-settings"
    license=('GPL-3.0-only')
    # Same as Arch's cosmic-settings 1:1.10.0-1 (unchanged in 1.11.0).
    depends=('accountsservice' 'adw-gtk-theme' 'cosmic-icon-theme' 'cosmic-randr'
             'fontconfig' 'glibc' 'iso-codes' 'libgcc' 'libinput' 'libpipewire'
             'libpulse' 'libxkbcommon' 'networkmanager' 'nm-connection-editor'
             'pipewire-pulse' 'systemd-libs' 'ttf-opensans' 'wayland'
             # Lapin's pages: admin prompts (uninstall, cleanup, updates,
             # face sign-in), checkupdates/paccache, lsblk/findmnt.
             'polkit' 'pacman-contrib' 'util-linux')
    optdepends=('power-profiles-daemon: power modes'
                'fprintd: Fingerprint recognition in Sign-in options'
                'howdy-git: Facial recognition in Sign-in options (AUR)'
                'flatpak: Flatpak apps in Installed apps and Update'
                'fwupd: firmware updates in Update'
                'xdg-desktop-portal: app permissions in Privacy & security')
    provides=('cosmic-settings')
    conflicts=('cosmic-settings')
    cd "$srcdir/cosmic-settings"
    CARGO_HOME="$srcdir/cargo-settings" just rootdir="$pkgdir" install
    install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}

