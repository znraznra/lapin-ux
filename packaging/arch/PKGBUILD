# Maintainer: CHANGE ME <you@example.com>
#
# Builds Lapin from this source tree:
#
#   cd packaging/arch && makepkg -si
#
# To build from a published repository instead, replace the `source`
# array with: source=("lapin::git+https://github.com/CHANGE-ME/lapin.git")
# and point `_src` at "$srcdir/lapin".

pkgname=lapin-desktop-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Lapin: a familiar Linux desktop (taskbar, Start menu, notifications) built on COSMIC components"
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only')
depends=(
    # Compositor and reused, unbranded COSMIC services
    'cosmic-comp'
    'cosmic-settings-daemon'
    'cosmic-bg'
    'cosmic-osd'
    'cosmic-idle'
    'cosmic-greeter'           # lock screen
    'cosmic-launcher'          # Alt+Tab window switcher (until Lapin has its own)
    'cosmic-screenshot'        # Super+Shift+S
    'cosmic-icon-theme'
    'xdg-desktop-portal-cosmic'
    'inter-font'               # interface font
    'fontconfig'
    # Runtime libraries
    'libxkbcommon'
    'wayland'
    'dbus'
    'systemd-libs'
    'xdg-utils'
)
optdepends=(
    'gnome-keyring: saved passwords and SSH keys'
    'papirus-icon-theme: broader app icon coverage'
    'xdg-desktop-portal-gtk: file pickers for GTK apps'
)
makedepends=('cargo' 'git' 'python' 'python-numpy' 'python-pillow')
provides=('lapin-desktop')
conflicts=('lapin-desktop')
options=('!lto')

_src="$startdir/../.."

prepare() {
    cd "$_src"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_src"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --frozen --release --workspace
    [ -f data/wallpapers/lapin-dark.jpg ] || python tools/make-wallpaper.py data/wallpapers
}

check() {
    cd "$_src"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo test --frozen --release -p lapin-core -p lapin-session
}

package() {
    cd "$_src"
    local bin
    for bin in lapin-session lapin-shell lapin-notifyd; do
        install -Dm755 "$srcdir/target/release/$bin" "$pkgdir/usr/bin/$bin"
    done
    install -Dm755 data/session/start-lapin        "$pkgdir/usr/bin/start-lapin"
    install -Dm644 data/session/lapin.desktop      "$pkgdir/usr/share/wayland-sessions/lapin.desktop"
    install -Dm644 data/systemd/lapin-session.target "$pkgdir/usr/lib/systemd/user/lapin-session.target"
    install -Dm644 data/portals/lapin-portals.conf "$pkgdir/usr/share/xdg-desktop-portal/lapin-portals.conf"
    install -Dm644 data/wallpapers/lapin-dark.jpg  "$pkgdir/usr/share/backgrounds/lapin/lapin-dark.jpg"
    install -Dm644 data/wallpapers/lapin-light.jpg "$pkgdir/usr/share/backgrounds/lapin/lapin-light.jpg"
    install -Dm644 data/icons/lapin-start.svg      "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.lapin.Shell.svg"
    install -Dm644 LICENSE                          "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
