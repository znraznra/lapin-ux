    provides=('cosmic-greeter')
    conflicts=('cosmic-greeter')
    cd "$srcdir/cosmic-greeter"
    just rootdir="$pkgdir" install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

