# Maintainer: CHANGE ME <you@example.com>
#
# Builds and installs everything Lapin UX needs in one go:
#
#   ./install.sh                      (from the repository root), or
#   cd packaging/arch && makepkg -si
#
# makepkg -s installs every dependency below from the Arch repositories
# automatically; the font and both icon sets ship inside this repository,
# and Lapin UX's compositor build (lapin-ux-comp) is built alongside.

pkgbase=lapin-ux-desktop-git
pkgname=('lapin-ux-desktop-git' 'lapin-ux-comp' 'lapin-ux-greeter' 'lapin-ux-osk' 'lapin-ux-osd' 'lapin-ux-settings' 'lapin-ux-portal')
pkgver=0.1.0
pkgrel=1
pkgdesc="Lapin UX: a familiar Linux desktop (taskbar, Start menu, notifications) built on COSMIC components"
arch=('x86_64' 'aarch64')
url="https://github.com/znraznra/lapin-ux"
# Our code: GPL-3.0. Bundled third-party assets keep their own licences:
# Selawik (OFL-1.1, Microsoft), Fluent UI System Icons (MIT, Microsoft),
# Fluent Emoji (MIT, Microsoft), Win11 icon theme (GPL-3.0, yeyushengfan258). See README "Third-party assets".
license=('GPL-3.0-only' 'OFL-1.1' 'MIT')
makedepends=(
    'cargo' 'git' 'clang' 'python' 'python-numpy' 'python-pillow' 'gtk-update-icon-cache'
    # lapin-ux-comp (COSMIC compositor) build
    'libinput' 'libxkbcommon' 'mesa' 'pixman' 'seatd' 'systemd-libs' 'wayland' 'libdisplay-info' 'fontconfig'
    # lapin-ux-greeter (COSMIC greeter and lock screen) build
    'just' 'pam' 'dav1d'
    # lapin-ux-portal build
    'pipewire'
)
# Everything below is pinned to COSMIC's stable release epoch-1.11.0.
# Lapin UX's compositor: upstream cosmic-comp plus our patches.
_comp_commit=8cb1802caada438bb5cc7670dfabdaca5fad0502
# The lock and sign-in screens: upstream cosmic-greeter plus our patches.
_greeter_commit=80e8a104b75a01ab8df52bca7b8bde6dbcdb8133
# The touch keyboard: upstream cosmic-osk plus our patches.
_osk_commit=6b146a2b0a23d88ae84223ad06c6813bda5a9386
# Volume/brightness pop-ups and the admin prompt: cosmic-osd plus our patch.
_osd_commit=4f96e98981712f02b98f704a6f19c4c6a58b378b
# Settings: COSMIC Settings with Lapin's
# Windows 11 layout (packaging/lapin-ux-settings) and title bar.
_settings_commit=f1d00fc06e18203e880771617657067c10c43321
# File dialogs: COSMIC's portal built against COSMIC Files plus our patch.
_portal_commit=f448ddfb296bf7bb23517b24b2f532559a334a1c
_files_commit=3cc4b8003e8d08349c7ced8a9cdd10cdfa45d38c
source=("cosmic-comp::git+https://github.com/pop-os/cosmic-comp.git#commit=${_comp_commit}"
        "cosmic-greeter::git+https://github.com/pop-os/cosmic-greeter.git#commit=${_greeter_commit}"
        "cosmic-osk::git+https://github.com/pop-os/cosmic-osk.git#commit=${_osk_commit}"
        "cosmic-osd::git+https://github.com/pop-os/cosmic-osd.git#commit=${_osd_commit}"
        "cosmic-settings::git+https://github.com/pop-os/cosmic-settings.git#commit=${_settings_commit}"
        "xdg-desktop-portal-cosmic::git+https://github.com/pop-os/xdg-desktop-portal-cosmic.git#commit=${_portal_commit}"
        "cosmic-files::git+https://github.com/pop-os/cosmic-files.git#commit=${_files_commit}")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')
options=('!lto')

_src="$startdir/../.."

prepare() {
    export RUSTUP_TOOLCHAIN=stable
    local host
    host="$(rustc -vV | sed -n 's/host: //p')"
    cd "$_src"
    cargo fetch --locked --target "$host"

    cd "$srcdir/cosmic-comp"
    git reset -q --hard && git clean -fdq   # also drop files our patches added
    git apply "$_src"/packaging/lapin-ux-comp/*.patch
    rm -f rust-toolchain rust-toolchain.toml   # build with the system's stable toolchain
    cargo fetch --locked --target "$host"

    cd "$srcdir/cosmic-greeter"
    git reset -q --hard && git clean -fdq
    for p in "$_src"/packaging/lapin-ux-greeter/*.patch; do git apply "$p"; done
    rm -f rust-toolchain rust-toolchain.toml
    cargo fetch --locked --target "$host"

    cd "$srcdir/cosmic-osk"
    git reset -q --hard && git clean -fdq
    git apply "$_src"/packaging/lapin-ux-osk/*.patch
    rm -f rust-toolchain rust-toolchain.toml
    cargo fetch --locked --target "$host"

    cd "$srcdir/cosmic-osd"
    git reset -q --hard && git clean -fdq
    git apply "$_src"/packaging/lapin-ux-osd/*.patch
    rm -f rust-toolchain rust-toolchain.toml
    cargo fetch --locked --target "$host"

    # Settings builds with its own cargo home so Lapin's libcosmic patch (title
    # bar) applies to its private libcosmic copy; the lockfile stays as is.
    cd "$srcdir/cosmic-settings"
    git reset -q --hard && git clean -fdq
    local p
    for p in "$_src"/packaging/lapin-ux-settings/*.patch; do
        [ -e "$p" ] && git apply "$p"
    done
    rm -f rust-toolchain rust-toolchain.toml
    CARGO_HOME="$srcdir/cargo-settings" cargo fetch --locked --target "$host"
    _patch_libcosmic "$srcdir/cargo-settings"

    cd "$srcdir/cosmic-files"
    git reset -q --hard && git clean -fdq
    git apply "$_src"/packaging/lapin-ux-portal/*.patch
    cd "$srcdir/xdg-desktop-portal-cosmic"
    git reset -q --hard && git clean -fdq
    git apply "$_src"/packaging/lapin-ux-portal/portal/*.patch
    rm -f rust-toolchain rust-toolchain.toml
    # Use the patched COSMIC Files for the file dialogs.
    cargo fetch --config "$_files_patch" --target "$host"
}

# Applies Lapin's libcosmic patch to every libcosmic copy in a cargo home.
_patch_libcosmic() {
    local dir patched=0
    for dir in "$1"/git/checkouts/libcosmic-*/*/; do
        [ -f "$dir/src/widget/header_bar.rs" ] || continue
        if [ ! -f "$dir/src/lapin.rs" ]; then
            for p in "$_src"/packaging/lapin-ux-libcosmic/*.patch; do git -C "$dir" apply "$p"; done
        fi
        patched=1
    done
    [ "$patched" = 1 ] || { echo "libcosmic not found in $1" >&2; return 1; }
}

_files_patch='patch."https://github.com/pop-os/cosmic-files".cosmic-files.path="../cosmic-files"'

build() {
    export RUSTUP_TOOLCHAIN=stable
    cd "$_src"
    CARGO_TARGET_DIR="$srcdir/target" cargo build --frozen --release --workspace
    [ -f data/wallpapers/lapin-ux-dark.jpg ] || python tools/make-wallpaper.py data/wallpapers

    cd "$srcdir/cosmic-comp"
    CARGO_TARGET_DIR="$srcdir/comp-target" cargo build --frozen --release

    cd "$srcdir/cosmic-greeter"
    just build-release --frozen

    cd "$srcdir/cosmic-osk"
    just build-release --frozen

    cd "$srcdir/cosmic-osd"
    just build-release --frozen

    cd "$srcdir/cosmic-settings"
    CARGO_HOME="$srcdir/cargo-settings" just build-release --frozen

    cd "$srcdir/xdg-desktop-portal-cosmic"
    cargo build --release --offline --config "$_files_patch"
}

check() {
    export RUSTUP_TOOLCHAIN=stable
    cd "$_src"
    CARGO_TARGET_DIR="$srcdir/target" cargo test --frozen --release -p lapin-ux-core -p lapin-ux-session
}

package_lapin-ux-desktop-git() {
    # lapin-ux-comp is built by this PKGBUILD and installed with it by
    # `makepkg -i` (it can't be listed as a dependency of its own build).
    depends=(
        # Reused, unbranded COSMIC services
        'cosmic-comp'              # fallback compositor
        'cosmic-settings-daemon'
        'cosmic-bg'
        'cosmic-osd'
        'cosmic-idle'
        'cosmic-greeter'           # login and lock screen (lapin-ux-greeter provides it)
        'cosmic-launcher'
        'cosmic-screenshot'        # Super+Shift+S
        'cosmic-randr'             # Win+P display switching, auto-rotate
        'cosmic-icon-theme'        # fallback for icons neither icon set has
        'adwaita-icon-theme'
        'xdg-desktop-portal-cosmic'
        'xdg-desktop-portal-gtk'   # file pickers for GTK apps
        # Fonts: Selawik is bundled; these only supply characters it lacks
        'fontconfig'
        'noto-fonts'               # Greek, Cyrillic and other scripts
        'noto-fonts-cjk'           # Chinese, Japanese, Korean
        # Runtime libraries and tools
        'libxkbcommon' 'wayland' 'dbus' 'systemd-libs' 'xdg-utils' 'glib2'
        # Quick settings, Start and account
        'networkmanager'           # Wi-Fi, VPN, hotspot
        'upower'                   # battery
        'wireplumber'              # volume (wpctl)
        'pipewire-audio'           # system sounds (pw-play)
        'pacman-contrib'           # checkupdates and paccache, for Update and Storage
        'wl-clipboard'             # snips go on the clipboard (wl-copy)
        'iio-sensor-proxy'         # auto-rotate on tablets and convertibles
        'python-pillow'            # lapin-ux-cursors (optional pointer pack)
        'libpulse'                 # sound output and per-app volume (pactl)
        'bluez' 'bluez-utils'      # Bluetooth
        'power-profiles-daemon'    # Energy saver
        'accountsservice'          # account picture
        'localsearch'              # search inside documents from Start
        'gnome-keyring'            # saved passwords and SSH keys
    )
    optdepends=('fprintd: fingerprint sign-in (set up in Settings > Accounts > Sign-in options; the sign-in panel shows its prompts)'
                'howdy-git: face sign-in with an infrared camera, like Windows Hello (AUR; set up in Settings > Accounts > Sign-in options)'
                'flatpak: Flatpak apps in Update, Installed apps and app permissions'
                'fwupd: firmware updates in Settings > Update')
    provides=('lapin-ux-desktop')
    conflicts=('lapin-ux-desktop' 'win11-icon-theme' 'win11-icon-theme-git' 'sound-theme-borealis')
    install=lapin-ux.install

    cd "$_src"
    local bin
    for bin in lapin-ux-session lapin-ux-shell lapin-ux-notifyd lapin-ux-taskmgr lapin-ux-control lapin-ux-update lapin-ux-welcome; do
        install -Dm755 "$srcdir/target/release/$bin" "$pkgdir/usr/bin/$bin"
    done
    install -Dm755 data/session/start-lapin-ux        "$pkgdir/usr/bin/start-lapin-ux"
    install -Dm644 data/session/lapin-ux.desktop      "$pkgdir/usr/share/wayland-sessions/lapin-ux.desktop"
    install -Dm644 data/systemd/lapin-ux-session.target "$pkgdir/usr/lib/systemd/user/lapin-ux-session.target"
    install -Dm644 data/portals/lapin-ux-portals.conf "$pkgdir/usr/share/xdg-desktop-portal/lapin-ux-portals.conf"
    install -Dm644 data/wallpapers/lapin-ux-dark.jpg  "$pkgdir/usr/share/backgrounds/lapin-ux/lapin-ux-dark.jpg"
    install -Dm644 data/wallpapers/lapin-ux-light.jpg "$pkgdir/usr/share/backgrounds/lapin-ux/lapin-ux-light.jpg"
    install -Dm644 data/icons/lapin-ux-start.svg      "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.lapinux.Shell.svg"
    install -Dm644 LICENSE                          "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm755 tools/lapin-ux-cursors           "$pkgdir/usr/bin/lapin-ux-cursors"
    # Clean removal: restores desktop settings, then removes the packages.
    install -Dm755 tools/lapin-ux-uninstall         "$pkgdir/usr/bin/lapin-ux-uninstall"
    # Settings > Sign-in options > Facial recognition (Howdy, optional).
    install -Dm755 tools/lapin-ux-howdy             "$pkgdir/usr/bin/lapin-ux-howdy"
    install -Dm644 data/polkit/dev.lapinux.howdy.policy "$pkgdir/usr/share/polkit-1/actions/dev.lapinux.howdy.policy"
    install -Dm644 -t "$pkgdir/usr/share/applications" data/apps/*.desktop

    # System sounds: Borealis by Ivica Ico Bukvic (Artistic; see its COPYING).
    mkdir -p "$pkgdir/usr/share/sounds"
    cp -a data/sounds/borealis "$pkgdir/usr/share/sounds/borealis"
    install -Dm644 data/sounds/borealis/COPYING "$pkgdir/usr/share/licenses/$pkgname/Borealis-sounds.txt"

    # The one system font: Selawik (OFL-1.1, Microsoft), unmodified, plus the
    # fontconfig rule that makes it the font for sans-serif/serif/system-ui.
    install -Dm644 -t "$pkgdir/usr/share/fonts/lapin-ux-selawik" data/fonts/selawik/*.ttf
    install -Dm644 data/fonts/selawik/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/Selawik-OFL.txt"
    install -Dm644 data/fontconfig/50-lapin-ux-selawik.conf "$pkgdir/usr/share/fontconfig/conf.avail/50-lapin-ux-selawik.conf"
    # Emoji: Lapin Fluent Emoji, built from Microsoft's Fluent Emoji (MIT) by
    # tools/make-fluent-emoji.py; the fontconfig rule above makes it the emoji font.
    install -Dm644 data/fonts/fluent-emoji/LapinFluentEmoji.ttf "$pkgdir/usr/share/fonts/lapin-ux-fluent-emoji/LapinFluentEmoji.ttf"
    install -Dm644 data/fonts/fluent-emoji/LICENSE-fluentui-emoji "$pkgdir/usr/share/licenses/$pkgname/Fluent-Emoji-MIT.txt"
    install -dm755 "$pkgdir/usr/share/fontconfig/conf.default"
    ln -s ../conf.avail/50-lapin-ux-selawik.conf "$pkgdir/usr/share/fontconfig/conf.default/50-lapin-ux-selawik.conf"

    # Symbolic icons: Fluent UI System Icons (MIT, Microsoft), see tools/make-fluent-icons.py.
    mkdir -p "$pkgdir/usr/share/icons"
    cp -a data/icons/Lapin-UX data/icons/Lapin-UX-dark "$pkgdir/usr/share/icons/"
    install -Dm644 data/icons/Lapin-UX/LICENSE-fluentui-system-icons \
        "$pkgdir/usr/share/licenses/$pkgname/Fluent-UI-System-Icons-MIT.txt"

    # App, folder and file icons: Win11 icon theme (GPL-3.0, yeyushengfan258),
    # shipped in third_party/ and installed with its own installer.
    local win11="$srcdir/win11-icon-theme"
    rm -rf "$win11" && cp -a third_party/win11-icon-theme "$win11"
    (cd "$win11" && ./install.sh -d "$pkgdir/usr/share/icons" >/dev/null)
    rm -f "$pkgdir"/usr/share/icons/Win11*/icon-theme.cache
    install -Dm644 third_party/win11-icon-theme/COPYING "$pkgdir/usr/share/licenses/$pkgname/Win11-icon-theme-GPL-3.0.txt"
    install -Dm644 third_party/win11-icon-theme/AUTHORS "$pkgdir/usr/share/licenses/$pkgname/Win11-icon-theme-AUTHORS"
}

package_lapin-ux-comp() {
    pkgdesc="COSMIC compositor with Lapin UX's snap layouts and taskbar attention support"
    url="https://github.com/pop-os/cosmic-comp"
    license=('GPL-3.0-only')
    depends=('libinput' 'libxkbcommon' 'mesa' 'pixman' 'seatd' 'systemd-libs' 'wayland' 'libdisplay-info' 'fontconfig')
    install -Dm755 "$srcdir/comp-target/release/cosmic-comp" "$pkgdir/usr/bin/lapin-ux-comp"
    install -Dm644 "$srcdir/cosmic-comp/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

