def cur_images(data):
    """Frames of a .cur file: (PIL image RGBA, hotspot x, hotspot y)."""
    from PIL import Image
    _, kind, count = struct.unpack_from("<HHH", data, 0)
    out = []
    for i in range(count):
        w, h, _, _, hx, hy, size, offset = struct.unpack_from("<BBBBHHII", data, 6 + 16 * i)
        blob = data[offset:offset + size]
        if blob[:8] == b"\x89PNG\r\n\x1a\n":
            img = Image.open(io.BytesIO(blob))
        else:
            # Wrap the single bitmap as a one-image .ico so Pillow decodes it.
            ico = struct.pack("<HHH", 0, 1, 1) + struct.pack("<BBBBHHII", w, h, 0, 0, 1, 32, size, 22) + blob
            img = Image.open(io.BytesIO(ico))
        img = img.convert("RGBA")
        out.append((img, hx, hy))
    return out


def ani_frames(data):
    """Frames of an .ani file: list of (images of one frame, delay ms)."""
    assert data[:4] == b"RIFF" and data[8:12] == b"ACON"
    pos, icons, rates, seq, jif = 12, [], None, None, 6
    def chunks(start, end):
        p = start
        while p + 8 <= end:
            cid, size = data[p:p + 4], struct.unpack_from("<I", data, p + 4)[0]
            yield cid, p + 8, size
            p += 8 + size + (size & 1)
    for cid, at, size in chunks(12, len(data)):
        if cid == b"anih":
            jif = struct.unpack_from("<I", data, at + 28)[0] or 6
        elif cid == b"rate":
            rates = list(struct.unpack_from("<%dI" % (size // 4), data, at))
        elif cid == b"seq ":
            seq = list(struct.unpack_from("<%dI" % (size // 4), data, at))
        elif cid == b"LIST" and data[at:at + 4] == b"fram":
            for c2, a2, s2 in chunks(at + 4, at + size):
                if c2 == b"icon":
                    icons.append(cur_images(data[a2:a2 + s2]))
    order = seq or list(range(len(icons)))
    frames = []
    for n, idx in enumerate(order):
        j = rates[n] if rates and n < len(rates) else jif
        frames.append((icons[idx], max(1, round(j * 1000 / 60))))
    return frames


def xcursor(frames):
    """Build an Xcursor file. frames: list of (images, delay)."""
    chunks = []
    for images, delay in frames:
        for img, hx, hy in images:
            w, h = img.size
            nominal = max(1, round(w * 3 / 4))  # a 32 px Windows cursor is X size 24
            raw = img.tobytes()
            px = bytearray(len(raw))
            for i in range(0, len(raw), 4):
                r, g, b, a = raw[i], raw[i + 1], raw[i + 2], raw[i + 3]
                px[i:i + 4] = (b * a // 255, g * a // 255, r * a // 255, a)
            head = struct.pack("<IIIIIIIII", 36, 0xFFFD0002, nominal, 1, w, h, hx, hy, delay)
            chunks.append((nominal, head + bytes(px)))
    chunks.sort(key=lambda c: c[0])
    ntoc = len(chunks)
    out = bytearray(struct.pack("<4sIII", b"Xcur", 16, 0x10000, ntoc))
    pos = 16 + 12 * ntoc
    for nominal, body in chunks:
        out += struct.pack("<III", 0xFFFD0002, nominal, pos)
        pos += len(body)
    for _, body in chunks:
        out += body
    return bytes(out)


def fetch(dest):
    print("Downloading the cursor pack…")
    last = None
    for url in (REPO_ZIP, REPO_ZIP_LATEST):
        try:
            with urllib.request.urlopen(url, timeout=60) as r:
                data = r.read()
        except Exception as e:  # noqa: BLE001 - any network failure: try the next
            last = e
            print(f"Couldn't download {url}: {e}", file=sys.stderr)
            continue
        part = os.path.join(dest, str(len(os.listdir(dest))))
        zipfile.ZipFile(io.BytesIO(data)).extractall(part)
        for root, dirs, _ in os.walk(part):
            if "assets" in dirs and os.path.isdir(os.path.join(root, "assets", "light")):
                return os.path.join(root, "assets")
        print(f"{url} doesn't contain the cursor files in the expected layout.", file=sys.stderr)
    if last is not None:
        sys.exit(f"Couldn't download the cursor pack (no internet connection?): {last}")
    sys.exit("The download doesn't contain the cursor files (the upstream pack changed its layout).")


def lapin_copy_dir():
    """Where Lapin UX's own copy of the pointer settings is kept while another
    desktop's are in place (tools/lapin-ux-uninstall, "per session"), or None
    when the live settings are Lapin UX's (#23: run at install time from
    another desktop, this mustn't change that desktop's pointer)."""
    if "LapinUX" in os.environ.get("XDG_CURRENT_DESKTOP", "").split(":"):
        return None
    state = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "lapin-ux")
    if os.path.exists(os.path.join(state, "lapin-active")):
        return None
    return os.path.join(state, "lapin-desktop")


def set_pointer(theme_dir):
    """Make theme_dir (or None: the system's) the pointer, in the live
    settings or in Lapin UX's own copy."""
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    store = lapin_copy_dir()
    if store is not None:
        os.makedirs(os.path.join(store, "dconf"), exist_ok=True)
        os.makedirs(os.path.join(store, "pointer"), exist_ok=True)
        with open(os.path.join(store, "dconf", "cursor-theme"), "w") as f:
            f.write(f"'{theme_dir}'\n" if theme_dir else "")
        index = os.path.join(store, "pointer", "default")
        for p in (index, index + ".absent"):
            if os.path.exists(p):
                os.remove(p)
        if theme_dir:
            with open(index, "w") as f:
                f.write(f"[Icon Theme]\nName=Default\nInherits={theme_dir}\n")
        else:
            open(index + ".absent", "w").close()
        print("Saved for Lapin UX: it's used the next time you sign in to Lapin UX "
              "(this desktop keeps its own pointer).")
        return
    index = os.path.join(data_home, "icons", "default", "index.theme")
    if theme_dir:
        os.makedirs(os.path.dirname(index), exist_ok=True)
        with open(index, "w") as f:
            f.write(f"[Icon Theme]\nName=Default\nInherits={theme_dir}\n")
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", theme_dir],
                       stderr=subprocess.DEVNULL, check=False)
        apply_now(theme_dir)
        print("It's now your mouse pointer. GTK apps and apps you start from now on use it at once; "
              "the rest pick it up when you sign out and back in.")
        return
    try:
        with open(index) as f:
            ours = f"Inherits={THEME_DIR}" in f.read()
    except OSError:
        ours = False
    if ours:
        os.remove(index)
    current = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "cursor-theme"],
                             capture_output=True, text=True, check=False).stdout.strip().strip("'")
    if current == THEME_DIR:
        subprocess.run(["gsettings", "reset", "org.gnome.desktop.interface", "cursor-theme"],
                       stderr=subprocess.DEVNULL, check=False)
    restore_env()
    print("Back to the system's mouse pointer (log out and back in for every app to pick it up).")


def _state_file():
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "lapin-ux", "xcursor-env")


def _env_cmd(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, check=False, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None


def apply_now(theme_dir):
    """Tell what is running right now (#57): the user's systemd and D-Bus
    environments get the new XCURSOR_THEME, so apps started afterwards use it.
    GTK apps follow the gsettings key live. (The compositor's own pointer and
    apps that are already open read it when you sign in again.)

    Only inside the Lapin UX session, and the value it replaced is written to
    ~/.local/state/lapin-ux/xcursor-env so `lapin-ux-desktop-settings leave`
    (and Back to the system's pointer) can hand it back to other desktops."""
    if "LapinUX" not in os.environ.get("XDG_CURRENT_DESKTOP", "").split(":"):
        return
    mark = _state_file()
    if not os.path.exists(mark):
        out = _env_cmd(["systemctl", "--user", "show-environment"])
        if out is None or out.returncode != 0:
            return   # can't read the old value: don't change it
        prior = ""
        for line in out.stdout.splitlines():
            if line.startswith("XCURSOR_THEME="):
                prior = line.split("=", 1)[1]
        try:
            os.makedirs(os.path.dirname(mark), exist_ok=True)
            # Written whole and moved into place, so a failed write never leaves an
            # empty file behind that would read as "there was no theme".
            fd, tmp = tempfile.mkstemp(dir=os.path.dirname(mark), prefix=".xcursor-env.")
            try:
                with os.fdopen(fd, "w") as f:
                    f.write(prior + "\n")
                os.replace(tmp, mark)
            except OSError:
                try:
                    os.unlink(tmp)
                except OSError:
                    pass
                return   # can't remember the old value: don't change it
        except OSError:
            return   # can't remember the old value: don't change it
    var = f"XCURSOR_THEME={theme_dir}"
    _env_cmd(["systemctl", "--user", "set-environment", var])
    _env_cmd(["dbus-update-activation-environment", "--systemd", var])


def restore_env():
    """Give the user's environments the XCURSOR_THEME they had before apply_now."""
    mark = _state_file()
    try:
        with open(mark) as f:
            raw = f.read()
    except OSError:
        return
    if not raw:
        return   # a zero-byte file is not a saved value (an unset one holds a newline)
    prior = raw.strip()
    def ok(r):
        return r is not None and r.returncode == 0
    if prior:
        done = ok(_env_cmd(["systemctl", "--user", "set-environment", f"XCURSOR_THEME={prior}"]))
        dbus = f"XCURSOR_THEME={prior}"
    else:
        done = ok(_env_cmd(["systemctl", "--user", "unset-environment", "XCURSOR_THEME"]))
        # D-Bus can't forget a variable; the stock pointer theme name is harmless.
        dbus = "XCURSOR_THEME=default"
    if shutil.which("dbus-update-activation-environment"):
        done = ok(_env_cmd(["dbus-update-activation-environment", dbus])) and done
    if not done:
        return   # keep the saved value so a later restore can try again
    try:
        os.remove(mark)
    except OSError:
        pass


def cached_pack():
    """The pack from an earlier download (kept in ~/.cache/lapin-ux), so
    changing the colour in Settings doesn't download it again."""
    cache = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                         "lapin-ux", "cursor-pack")
    assets = os.path.join(cache, "assets")
    if os.path.isdir(os.path.join(assets, "light")):
        return assets
    with tempfile.TemporaryDirectory() as tmp:
        found = fetch(tmp)
        os.makedirs(cache, exist_ok=True)
        if os.path.isdir(assets):
            shutil.rmtree(assets)
        shutil.copytree(found, assets)
    return assets


def theme_dirs():
    """Folders pointer themes are installed in, most personal first."""
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    dirs = [os.path.join(data_home, "icons"), os.path.expanduser("~/.icons")]
    for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":"):
        if d:
            dirs.append(os.path.join(d, "icons"))
    return dirs


def use_theme(name):
    """Make an installed pointer theme (a folder with cursors/ in an icons
    folder) the pointer (#57)."""
    if not name or "/" in name or name in (".", "..", "default"):
        sys.exit(f"Not a pointer theme name: {name!r}")
    if not any(os.path.isdir(os.path.join(d, name, "cursors")) for d in theme_dirs()):
        sys.exit(f"No pointer theme called {name!r} is installed.")
    set_pointer(name)


def use_system():
    """Stop using the pack: the system's pointer again (the pack stays
    installed, so switching back is quick)."""
    set_pointer(None)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dark", action="store_true", help="the dark (black) pointers instead of the light ones")
    ap.add_argument("--variant", default="default", help="busy animation colour (default, classic, green, …)")
    ap.add_argument("--from", dest="src", help="a folder that already holds the pack")
    ap.add_argument("--no-default", action="store_true", help="install, but don't make it your pointer")
    ap.add_argument("--system", action="store_true", help="go back to the system's own pointer")
    ap.add_argument("--theme", help="use an installed pointer theme (its folder name)")
    args = ap.parse_args()
    if args.system:
        use_system()
        return
    if args.theme:
        # The restore point first, as below, so uninstalling can put the
        # old pointer back.
        here = os.path.join(os.path.dirname(os.path.abspath(__file__)), "lapin-ux-uninstall")
        try:
            subprocess.run([here if os.path.exists(here) else "lapin-ux-uninstall", "--snapshot"], check=False)
        except OSError:
            pass
        use_theme(args.theme)
        return
    try:
        import PIL  # noqa: F401
    except ImportError:
        sys.exit("Pillow is needed: sudo pacman -S python-pillow")
    # Save the restore point before changing the pointer settings, so the
    # uninstaller can put the old pointer back (this may run before the first
    # Lapin UX sign-in).
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), "lapin-ux-uninstall")
    tool = here if os.path.exists(here) else "lapin-ux-uninstall"
    try:
        subprocess.run([tool, "--snapshot"], check=False)
    except OSError:
        pass

    with tempfile.TemporaryDirectory() as tmp:
        assets = args.src
        if assets and os.path.isdir(os.path.join(assets, "cursor", "assets")):
            assets = os.path.join(assets, "cursor", "assets")
        elif assets and os.path.isdir(os.path.join(assets, "assets")):
            assets = os.path.join(assets, "assets")
        if not assets:
            assets = cached_pack()
        theme = os.path.join(assets, "dark" if args.dark else "light")
        variant = os.path.join(theme, "variants", args.variant)
        if not os.path.isdir(variant):
            variant = os.path.join(theme, "variants", "default")

        data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
        out = os.path.join(data_home, "icons", THEME_DIR)
        cursors = os.path.join(out, "cursors")
        os.makedirs(cursors, exist_ok=True)
        for role, names in NAMES.items():
            if role in ("wait", "appstarting"):
                path = os.path.join(variant, role + ".ani")
                with open(path, "rb") as f:
                    blob = xcursor(ani_frames(f.read()))
            else:
                path = os.path.join(theme, role + ".cur")
                with open(path, "rb") as f:
                    blob = xcursor([(cur_images(f.read()), 0)])
            with open(os.path.join(cursors, names[0]), "wb") as f:
                f.write(blob)
            for alias in names[1:]:
                link = os.path.join(cursors, alias)
                if os.path.lexists(link):
                    os.remove(link)
                os.symlink(names[0], link)
        with open(os.path.join(out, "index.theme"), "w") as f:
            f.write("[Icon Theme]\n"
                    f"Name={THEME_NAME}\n"
                    "Comment=Cursor design by JepriCreations (https://www.deviantart.com/jepricreations, "
                    "https://jepricreations.com). Converted for personal use; not for redistribution.\n"
                    "Inherits=Adwaita\n")
        with open(os.path.join(out, "CREDITS"), "w") as f:
            f.write("Cursor Concept W11 Tail HDPi — cursor design by JepriCreations.\n"
                    "https://www.deviantart.com/jepricreations\nhttps://jepricreations.com\n"
                    "The author doesn't allow the pack to be redistributed; this copy was made on this\n"
                    "computer for its user's own use by lapin-ux-cursors.\n")
        print(f"Installed {THEME_NAME} in {out}")

    if args.no_default:
        return
    # The "default" cursor theme is what apps use when nothing else is set.
    set_pointer(THEME_DIR)


if __name__ == "__main__":
    main()
